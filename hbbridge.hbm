# Shared product components; entry points belong to their .hbp targets.
-w3 -es2
-mt
-head=full
-Lzig-out/lib
-lhbbridge_zig
-lhbnetio
-prgflag=-DHB_EXTERN
-Isrc/c/third_party/zlib
-Iincludes
sddsqlt3.hbc
sddodbc.hbc
hbhttpd.hbc
hbtcpio.hbc
{HB_HTTP_TLS='1'}hbssl.hbc
{HB_HTTP_TLS='1'}-prgflag=-DHBBRIDGE_HTTP_TLS

src/hb/transports/protheus/hbbridgeframing.hb
src/hb/transports/protheus/hbbridgeadapter.hb
src/hb/transports/protheus/hbbridgeserver.hb
src/hb/transports/netio/hbbridgenetio.hb
src/hb/transports/http/hbbridgehttp.hb
src/hb/host/hbbridgeconfig.hb
src/hb/host/hbbridgeini.hb
src/hb/host/hbbridgelifecycle.hb
src/hb/core/hbbridgedispatcher.hb
src/hb/services/hbbridgeservices.hb
src/hb/services/hbbridgequery.hb
src/hb/addons/hbbridgeaddon.hb
src/hb/telemetry/hbbridgesyslog.hb
src/c/hbbridgezig.c
src/c/hbbridgetime.c
src/c/hbbridgeutf8.c
src/c/hbbridgedecoder.c
src/c/hbbridgecompressor.c
