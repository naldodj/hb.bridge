# Shared product components; entry points belong to their .hbp targets.
-w3 -es2
-mt
-head=full
-Lzig-out/lib
-lhbbridge_zig
-lhbnetio
-prgflag=-DHB_EXTERN
-Isrc/c/third_party/zlib
-Iincludes
sddsqlt3.hbc
sddodbc.hbc

