# Shared product components; entry points belong to their .hbp targets.
-w3 -es2
-mt
-head=full
-Lzig-out/lib
-lhbbridge_zig
-lhbnetio
-prgflag=-DHB_EXTERN
-Isrc/c/third_party/zlib
-Iincludes
sddsqlt3.hbc
sddodbc.hbc
hbhttpd.hbc
hbtcpio.hbc
{HB_HTTP_TLS='1'}hbssl.hbc
{HB_HTTP_TLS='1'}-prgflag=-DHBBRIDGE_HTTP_TLS

src/hb/transports/protheus/hbbridge.framing.hb
src/hb/transports/protheus/hbbridge.adapter.hb
src/hb/transports/protheus/hbbridge.server.hb
src/hb/transports/netio/hbbridge.netio.hb
src/hb/transports/http/hbbridge.http.hb
src/hb/host/hbbridge.config.hb
src/hb/host/hbbridge.ini.hb
src/hb/host/hbbridge.life.cycle.hb
src/hb/core/hbbridge.dispatcher.hb
src/hb/services/hbbridge.services.hb
src/hb/services/hbbridge.query.hb
src/hb/addons/hbbridge.addon.hb
src/hb/telemetry/hbbridge.syslog.hb
src/c/hbbridge.zig.c
src/c/hbbridge.time.c
src/c/hbbridge.utf8.c
src/c/hbbridge.decoder.c
src/c/hbbridge.compressor.c
