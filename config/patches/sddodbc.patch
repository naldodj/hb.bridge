+/* Pooling is process policy. Physical reuse/reset is owned by the Windows
+ * ODBC 3.8 driver manager, never by an application cache of RDDSQL handles.
+ * Other platforms retain their existing default-off lifecycle until accepted.
+ */
+#if defined( HB_OS_WIN ) && ODBCVER >= 0x0380 && defined( SQL_OV_ODBC3_80 )
+   #define HBBRIDGE_ODBC_POOL_SUPPORTED 1
+#endif
+
+static HB_CRITICAL_NEW( s_odbcPoolMutex );
+static HB_BOOL s_odbcPoolEnabled = HB_FALSE;
+static HB_BOOL s_odbcPoolFrozen = HB_FALSE;
+/* Keep one matching environment reference alive between logical leases.
+ * Its DBC is never connected and holds no credentials or network socket.
+ */
+static SQLHENV s_odbcPoolAnchorEnv = SQL_NULL_HENV;
+static SQLHDBC s_odbcPoolAnchorDBC = SQL_NULL_HDBC;
+
+HB_FUNC( HBBRIDGEODBCPOOLING )
+{
+   const char * mode = hb_parc( 1 );
+   HB_BOOL valid = HB_FALSE;
+   HB_BOOL enabled = HB_FALSE;
+
+   if( mode && hb_parclen( 1 ) == 3 && strcmp( mode, "off" ) == 0 )
+      valid = HB_TRUE;
+   else if( mode && hb_parclen( 1 ) == 6 && strcmp( mode, "driver" ) == 0 )
+   {
+#if defined( HBBRIDGE_ODBC_POOL_SUPPORTED )
+      valid = enabled = HB_TRUE;
+#endif
+   }
+   if( valid )
+   {
+      hb_threadEnterCriticalSection( &s_odbcPoolMutex );
+      if( enabled != s_odbcPoolEnabled )
+      {
+         if( s_odbcPoolFrozen )
+            valid = HB_FALSE;
+         else
+         {
+#if defined( HBBRIDGE_ODBC_POOL_SUPPORTED )
+            /* An option substitution is not successful configuration. */
+            valid = SQLSetEnvAttr( SQL_NULL_HENV, SQL_ATTR_CONNECTION_POOLING,
+               ( SQLPOINTER ) ( HB_PTRUINT ) ( enabled ? SQL_CP_ONE_PER_DRIVER : SQL_CP_OFF ),
+               SQL_IS_UINTEGER ) == SQL_SUCCESS;
+            if( valid )
+               s_odbcPoolEnabled = enabled;
+#else
+            valid = HB_FALSE;
+#endif
+         }
+      }
+      hb_threadLeaveCriticalSection( &s_odbcPoolMutex );
+   }
+   hb_retl( valid );
+}
+
+HB_FUNC( HBBRIDGEODBCPOOLINGINFO )
+{
+   PHB_ITEM result = hb_hashNew( NULL );
+   PHB_ITEM key = hb_itemNew( NULL );
+   PHB_ITEM value = hb_itemNew( NULL );
+   HB_BOOL enabled, frozen, retained;
+
+   hb_threadEnterCriticalSection( &s_odbcPoolMutex );
+   enabled = s_odbcPoolEnabled;
+   frozen = s_odbcPoolFrozen;
+   retained = s_odbcPoolAnchorEnv != SQL_NULL_HENV;
+   hb_threadLeaveCriticalSection( &s_odbcPoolMutex );
+   hb_hashAdd( result, hb_itemPutC( key, "mode" ), hb_itemPutC( value, enabled ? "driver" : "off" ) );
+   hb_hashAdd( result, hb_itemPutC( key, "frozen" ), hb_itemPutL( value, frozen ) );
+#if defined( HBBRIDGE_ODBC_POOL_SUPPORTED )
+   hb_hashAdd( result, hb_itemPutC( key, "supported" ), hb_itemPutL( value, HB_TRUE ) );
+#else
+   hb_hashAdd( result, hb_itemPutC( key, "supported" ), hb_itemPutL( value, HB_FALSE ) );
+#endif
+   hb_hashAdd( result, hb_itemPutC( key, "environmentRetained" ), hb_itemPutL( value, retained ) );
+   hb_itemRelease( key );
+   hb_itemRelease( value );
+   hb_itemReturnRelease( result );
+}
+
+static HB_BOOL odbcPoolingBegin( void )
+{
+   HB_BOOL enabled;
+   hb_threadEnterCriticalSection( &s_odbcPoolMutex );
+   s_odbcPoolFrozen = HB_TRUE;
+   enabled = s_odbcPoolEnabled;
+   hb_threadLeaveCriticalSection( &s_odbcPoolMutex );
+   return enabled;
+}
+
+static HB_BOOL odbcPoolingEnvironment( SQLHENV environment )
+{
+#if defined( HBBRIDGE_ODBC_POOL_SUPPORTED )
+   SQLUINTEGER version = 0, match = SQL_CP_RELAXED_MATCH;
+
+   return SQLSetEnvAttr( environment, SQL_ATTR_ODBC_VERSION,
+             ( SQLPOINTER ) ( HB_PTRUINT ) SQL_OV_ODBC3_80, SQL_IS_UINTEGER ) == SQL_SUCCESS &&
+          SQLGetEnvAttr( environment, SQL_ATTR_ODBC_VERSION, &version, sizeof( version ), NULL ) == SQL_SUCCESS &&
+          version == SQL_OV_ODBC3_80 &&
+          SQLSetEnvAttr( environment, SQL_ATTR_CP_MATCH,
+             ( SQLPOINTER ) ( HB_PTRUINT ) SQL_CP_STRICT_MATCH, SQL_IS_UINTEGER ) == SQL_SUCCESS &&
+          SQLGetEnvAttr( environment, SQL_ATTR_CP_MATCH, &match, sizeof( match ), NULL ) == SQL_SUCCESS &&
+          match == SQL_CP_STRICT_MATCH;
+#else
+   HB_SYMBOL_UNUSED( environment );
+   return HB_FALSE;
+#endif
+}
+
+/* The matching shared environment must outlive individual connections:
+ * releasing its last reference destroys its native pool. A disconnected
+ * anchor DBC selects that shared environment without opening a database.
+ */
+static HB_BOOL odbcPoolingAnchor( void )
+{
+   HB_BOOL ready = HB_FALSE;
+#if defined( HBBRIDGE_ODBC_POOL_SUPPORTED )
+   hb_threadEnterCriticalSection( &s_odbcPoolMutex );
+   if( s_odbcPoolAnchorEnv == SQL_NULL_HENV )
+   {
+      if( SQLAllocHandle( SQL_HANDLE_ENV, SQL_NULL_HANDLE, &s_odbcPoolAnchorEnv ) == SQL_SUCCESS )
+      {
+         if( ! odbcPoolingEnvironment( s_odbcPoolAnchorEnv ) )
+         {
+            SQLFreeHandle( SQL_HANDLE_ENV, s_odbcPoolAnchorEnv );
+            s_odbcPoolAnchorEnv = SQL_NULL_HENV;
+         }
+      }
+   }
+   if( s_odbcPoolAnchorEnv != SQL_NULL_HENV && s_odbcPoolAnchorDBC == SQL_NULL_HDBC )
+      SQLAllocHandle( SQL_HANDLE_DBC, s_odbcPoolAnchorEnv, &s_odbcPoolAnchorDBC );
+   ready = s_odbcPoolAnchorEnv != SQL_NULL_HENV && s_odbcPoolAnchorDBC != SQL_NULL_HDBC;
+   hb_threadLeaveCriticalSection( &s_odbcPoolMutex );
+#endif
+   return ready;
+}
+
+HB_FUNC( HBBRIDGEODBCPOOLINGCLOSE )
+{
+   HB_BOOL released = HB_TRUE;
+   hb_threadEnterCriticalSection( &s_odbcPoolMutex );
+#if defined( HBBRIDGE_ODBC_POOL_SUPPORTED )
+   if( s_odbcPoolAnchorDBC != SQL_NULL_HDBC )
+   {
+      released = SQLFreeHandle( SQL_HANDLE_DBC, s_odbcPoolAnchorDBC ) == SQL_SUCCESS;
+      if( released )
+         s_odbcPoolAnchorDBC = SQL_NULL_HDBC;
+   }
+   if( released && s_odbcPoolAnchorEnv != SQL_NULL_HENV )
+   {
+      released = SQLFreeHandle( SQL_HANDLE_ENV, s_odbcPoolAnchorEnv ) == SQL_SUCCESS;
+      if( released )
+         s_odbcPoolAnchorEnv = SQL_NULL_HENV;
+   }
+#endif
+   hb_threadLeaveCriticalSection( &s_odbcPoolMutex );
+   hb_retl( released );
+}
+
+#if defined( HBBRIDGE_ODBC_POOL_SUPPORTED )
+static HB_BOOL odbcPoolingVersion( SQLHDBC connection, SQLUSMALLINT attribute )
+{
+   SQLCHAR version[ 32 ];
+   SQLSMALLINT length = 0;
+   int major, minor;
+
+   if( SQLGetInfoA( connection, attribute, version, sizeof( version ), &length ) != SQL_SUCCESS ||
+       length < 5 || length >= ( SQLSMALLINT ) sizeof( version ) || version[ 2 ] != '.' ||
+       version[ 0 ] < '0' || version[ 0 ] > '9' || version[ 1 ] < '0' || version[ 1 ] > '9' ||
+       version[ 3 ] < '0' || version[ 3 ] > '9' || version[ 4 ] < '0' || version[ 4 ] > '9' )
+      return HB_FALSE;
+   major = ( version[ 0 ] - '0' ) * 10 + version[ 1 ] - '0';
+   minor = ( version[ 3 ] - '0' ) * 10 + version[ 4 ] - '0';
+   return major > 3 || ( major == 3 && minor >= 80 );
+}
+#endif

