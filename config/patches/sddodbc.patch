+/* SQL text follows the VM codepage, not the operating-system codepage.
+ * Harbour's generic UTF-16 converter emits one unit per Unicode scalar;
+ * supplementary scalars need a surrogate pair for SQLExecDirectW.
+ */
+static O_HB_CHAR * odbcQueryDup( const char * text )
+{
+#if defined( UNICODE )
+   if( HB_CDP_ISUTF8( hb_vmCDP() ) )
+   {
+      HB_SIZE size = strlen( text ), offset = 0, written = 0;
+      HB_WCHAR32 scalar;
+      O_HB_CHAR * output;
+      if( ! hb_cdpUTF8Validate( text, size ) || size > HB_SIZE_MAX / sizeof( O_HB_CHAR ) - 1 )
+         return NULL;
+      output = ( O_HB_CHAR * ) hb_xgrab( ( size + 1 ) * sizeof( O_HB_CHAR ) );
+      while( offset < size )
+      {
+         hb_cdpUTF8GetU32( text, size, &offset, &scalar );
+         if( scalar > 0xFFFF )
+         {
+            scalar -= 0x10000;
+            output[ written++ ] = ( O_HB_CHAR ) ( 0xD800 + ( scalar >> 10 ) );
+            output[ written++ ] = ( O_HB_CHAR ) ( 0xDC00 + ( scalar & 0x3FF ) );
+         }
+         else
+            output[ written++ ] = ( O_HB_CHAR ) scalar;
+      }
+      output[ written ] = 0;
+      return output;
+   }
+#endif
+   return O_HB_CHARDUP( text );
+}

