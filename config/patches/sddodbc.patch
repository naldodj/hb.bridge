 /* --- SDD METHODS --- */
+/* hbBridge's optional timeout slots keep NIL/missing distinct from zero.
+ * SQLULEN follows native pointer capacity; JSON integers must remain exact.
+ */
+static double odbcTimeoutMax( HB_BOOL fLogin )
+{
+   return fLogin || sizeof( SQLULEN ) <= sizeof( SQLUINTEGER ) ?
+          ( double ) ( ( SQLUINTEGER ) -1 ) : 9007199254740991.0;
+}
+
+HB_FUNC( HBBRIDGEODBCTIMEOUTMAX )
+{
+   hb_retnint( ( HB_MAXINT ) odbcTimeoutMax( hb_parl( 1 ) ) );
+}
+
+static HB_BOOL odbcTimeoutNumber( PHB_ITEM pValue, HB_BOOL fLogin, SQLULEN * pulValue )
+{
+   double dValue;
+   *pulValue = 0;
+   if( ! pValue || ! HB_IS_NUMERIC( pValue ) )
+      return HB_FALSE;
+   dValue = hb_itemGetND( pValue );
+   if( ! ( dValue >= 0 && dValue <= odbcTimeoutMax( fLogin ) ) ||
+       dValue != ( double ) hb_itemGetNInt( pValue ) )
+      return HB_FALSE;
+   *pulValue = ( SQLULEN ) hb_itemGetNInt( pValue );
+   return HB_TRUE;
+}
+
+HB_FUNC( HBBRIDGEODBCTIMEOUTVALID )
+{
+   SQLULEN ulValue;
+   hb_retl( odbcTimeoutNumber( hb_param( 1, HB_IT_ANY ), hb_parl( 2 ), &ulValue ) );
+}
+
+static HB_BOOL odbcTimeoutValue( PHB_ITEM pArray, HB_SIZE nSlot, HB_BOOL fLogin,
+                                SQLULEN * pulValue, HB_BOOL * pfPresent )
+{
+   PHB_ITEM pValue = hb_arrayGetItemPtr( pArray, nSlot );
+   *pfPresent = pValue && ! HB_IS_NIL( pValue );
+   *pulValue = 0;
+   return ! *pfPresent || odbcTimeoutNumber( pValue, fLogin, pulValue );
+}
+
+static HB_BOOL odbcLoginTimeoutMatches( SQLHDBC hConn, SQLULEN ulValue )
+{
+   SQLULEN ulEffective = 0;
+#if ODBCVER >= 0x0300
+   return SQL_SUCCEEDED( SQLGetConnectAttr( hConn, SQL_ATTR_LOGIN_TIMEOUT, &ulEffective,
+                                           sizeof( ulEffective ), NULL ) ) && ulEffective == ulValue;
+#else
+   return SQL_SUCCEEDED( SQLGetConnectOption( hConn, SQL_LOGIN_TIMEOUT, &ulEffective ) ) &&
+          ulEffective == ulValue;
+#endif
+}
+
+static HB_BOOL odbcLoginTimeout( SQLHDBC hConn, SQLULEN ulValue )
+{
+#if ODBCVER >= 0x0300
+   if( ! SQL_SUCCEEDED( SQLSetConnectAttr( hConn, SQL_ATTR_LOGIN_TIMEOUT,
+                                         ( SQLPOINTER ) ( HB_PTRUINT ) ulValue, SQL_IS_UINTEGER ) ) )
+      return HB_FALSE;
+#else
+   if( ! SQL_SUCCEEDED( SQLSetConnectOption( hConn, SQL_LOGIN_TIMEOUT, ulValue ) ) )
+      return HB_FALSE;
+#endif
+   return odbcLoginTimeoutMatches( hConn, ulValue );
+}
+
+static HB_BOOL odbcQueryTimeout( SDDCONN * pConn, SQLHSTMT hStmt )
+{
+   SQLULEN ulEffective = 0;
+   if( ! pConn->fQueryTimeout )
+      return HB_TRUE;
+#if ODBCVER >= 0x0300
+   if( ! SQL_SUCCEEDED( SQLSetStmtAttr( hStmt, SQL_ATTR_QUERY_TIMEOUT,
+                                      ( SQLPOINTER ) ( HB_PTRUINT ) pConn->ulQueryTimeout, SQL_IS_UINTEGER ) ) )
+      return HB_FALSE;
+   return SQL_SUCCEEDED( SQLGetStmtAttr( hStmt, SQL_ATTR_QUERY_TIMEOUT, &ulEffective,
+                                        sizeof( ulEffective ), NULL ) ) && ulEffective == pConn->ulQueryTimeout;
+#else
+   if( ! SQL_SUCCEEDED( SQLSetStmtOption( hStmt, SQL_QUERY_TIMEOUT, pConn->ulQueryTimeout ) ) )
+      return HB_FALSE;
+   return SQL_SUCCEEDED( SQLGetStmtOption( hStmt, SQL_QUERY_TIMEOUT, &ulEffective ) ) &&
+          ulEffective == pConn->ulQueryTimeout;
+#endif
+}
