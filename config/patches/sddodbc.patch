+#if defined( UNICODE )
+/* The native U16 string converter treats surrogate units independently.
+ * Decode complete Unicode scalars for UTF-8 VM codepages; retain the native
+ * converter for other VM codepages. Reject malformed UTF-16 explicitly.
+ */
+static HB_BOOL odbcPutUTF8( PHB_ITEM * ppItem, const O_HB_CHAR * pText, HB_SIZE nUnits )
+{
+   HB_SIZE nIndex, nSize = 0, nOffset = 0;
+   int     iPass;
+   char *  pUTF8 = NULL;
+
+   for( iPass = 0; iPass < 2; ++iPass )
+   {
+      for( nIndex = 0; nIndex < nUnits; ++nIndex )
+      {
+         HB_WCHAR32 wc = pText[ nIndex ];
+         if( wc >= 0xD800 && wc <= 0xDBFF )
+         {
+            HB_WCHAR32 low;
+            if( ++nIndex >= nUnits )
+               goto failure;
+            low = pText[ nIndex ];
+            if( low < 0xDC00 || low > 0xDFFF )
+               goto failure;
+            wc = 0x10000 + ( ( wc - 0xD800 ) << 10 ) + low - 0xDC00;
+         }
+         else if( wc >= 0xDC00 && wc <= 0xDFFF )
+            goto failure;
+         if( iPass == 0 )
+         {
+            HB_SIZE nBytes = ( HB_SIZE ) hb_cdpUTF8CharSize( wc );
+            if( nSize > HB_SIZE_MAX - nBytes - 1 )
+               goto failure;
+            nSize += nBytes;
+         }
+         else
+            nOffset += hb_cdpU32CharToUTF8( pUTF8 + nOffset, wc );
+      }
+      if( iPass == 0 )
+         pUTF8 = ( char * ) hb_xgrab( nSize + 1 );
+   }
+   pUTF8[ nSize ] = '\0';
+   *ppItem = hb_itemPutCLPtr( *ppItem, pUTF8, nSize );
+   return HB_TRUE;
+
+failure:
+   if( pUTF8 )
+      hb_xfree( pUTF8 );
+   return HB_FALSE;
+}
+#endif
