+/* SQL_NO_TOTAL is valid while converting or streaming variable-length data.
+ * Accumulate raw units before text conversion, preserving surrogate pairs
+ * across chunks and embedded NULs. The buffer size is not a value size limit.
+ */
+static SQLRETURN odbcGetVarData( SQLHSTMT hStmt, SQLUSMALLINT ui,
+                                HB_BOOL fBinary, PHB_ITEM * ppItem, SQLLEN * piLen )
+{
+   O_HB_CHAR buffer[ 2048 ];
+   char *    pValue = NULL;
+   HB_SIZE   nLen = 0, nCapacity = 0;
+   HB_SIZE   nPayload = sizeof( buffer ) - ( fBinary ? 0 : sizeof( O_HB_CHAR ) );
+   SQLSMALLINT iTargetType;
+
+#if defined( UNICODE )
+   iTargetType = fBinary ? SQL_C_BINARY : SQL_C_WCHAR;
+#else
+   iTargetType = fBinary ? SQL_C_BINARY : SQL_C_CHAR;
+#endif
+
+   for( ;; )
+   {
+      SQLLEN    iLen = SQL_NULL_DATA;
+      SQLRETURN res = SQLGetData( hStmt, ui, iTargetType, buffer,
+                                  ( SQLLEN ) sizeof( buffer ), &iLen );
+      HB_SIZE   nChunk, nNeeded;
+      HB_BOOL   fMore = HB_FALSE;
+
+      if( ! SQL_SUCCEEDED( res ) )
+         break;
+      if( iLen == SQL_NULL_DATA )
+      {
+         if( nLen != 0 )
+            break;
+         if( *ppItem )
+            hb_itemClear( *ppItem );
+         else
+            *ppItem = hb_itemNew( NULL );
+         *piLen = SQL_NULL_DATA;
+         if( pValue )
+            hb_xfree( pValue );
+         return SQL_SUCCESS;
+      }
+      if( iLen == SQL_NO_TOTAL )
+      {
+         /* A final successful call must supply the actual byte count. */
+         if( res != SQL_SUCCESS_WITH_INFO )
+            break;
+         nChunk = nPayload;
+         fMore = HB_TRUE;
+      }
+      else
+      {
+         if( iLen < 0 )
+            break;
+         nChunk = ( HB_SIZE ) iLen;
+         if( nChunk > nPayload )
+         {
+            if( res != SQL_SUCCESS_WITH_INFO )
+               break;
+            nChunk = nPayload;
+            fMore = HB_TRUE;
+         }
+      }
+      if( ! fBinary && nChunk % sizeof( O_HB_CHAR ) != 0 )
+         break;
+      if( nLen > HB_SIZE_MAX - sizeof( O_HB_CHAR ) ||
+          nChunk > HB_SIZE_MAX - sizeof( O_HB_CHAR ) - nLen )
+         break;
+      nNeeded = nLen + nChunk + sizeof( O_HB_CHAR );
+      if( nNeeded > nCapacity )
+      {
+         HB_SIZE nNew = nCapacity ? nCapacity : sizeof( buffer );
+         while( nNew < nNeeded )
+         {
+            if( nNew > HB_SIZE_MAX / 2 )
+            {
+               nNew = nNeeded;
+               break;
+            }
+            nNew *= 2;
+         }
+         pValue = ( char * ) ( pValue ? hb_xrealloc( pValue, nNew ) : hb_xgrab( nNew ) );
+         nCapacity = nNew;
+      }
+      memcpy( pValue + nLen, buffer, nChunk );
+      nLen += nChunk;
+      if( ! fMore )
+      {
+         memset( pValue + nLen, 0, sizeof( O_HB_CHAR ) );
+         if( fBinary )
+            *ppItem = hb_itemPutCL( *ppItem, pValue, nLen );
+#if defined( UNICODE )
+         else if( HB_CDP_ISUTF8( hb_vmCDP() ) )
+         {
+            if( ! odbcPutUTF8( ppItem, ( O_HB_CHAR * ) pValue, nLen / sizeof( O_HB_CHAR ) ) )
+               break;
+         }
+#endif
+         else
+            *ppItem = O_HB_ITEMPUTSTRLEN( *ppItem, ( O_HB_CHAR * ) pValue,
+                                         nLen / sizeof( O_HB_CHAR ) );
+         hb_xfree( pValue );
+         *piLen = 0; /* Non-NULL; the item owns the complete value length. */
+         return SQL_SUCCESS;
+      }
+   }
+   if( pValue )
+      hb_xfree( pValue );
+   return SQL_ERROR;
+}
