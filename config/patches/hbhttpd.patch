+static int s_hex_val( unsigned char ch )
+{
+   if( ch >= '0' && ch <= '9' )
+      return ch - '0';
+   if( ch >= 'A' && ch <= 'F' )
+      return ch - 'A' + 10;
+   if( ch >= 'a' && ch <= 'f' )
+      return ch - 'a' + 10;
+   return -1;
+}
+
+HB_FUNC( UHTTPDSENDCLOCK )
+{
+   /* Use Harbour's elapsed-time clock, independently of civil clock changes. */
+   hb_retnint( ( HB_MAXINT ) hb_timerGet() );
+}
+
+HB_FUNC( HBBRIDGEHTTPDIPADDR2NUM )
+{
+   const char * szIP = hb_parc( 1 );
+   HB_SIZE nLen = hb_parclen( 1 );
+   HB_MAXUINT nAddr = 0;
+   int iPart;
+
+   if( szIP == NULL || nLen == 0 )
+   {
+      hb_ret();
+      return;
+   }
+
+   for( iPart = 0; iPart < 4; iPart++ )
+   {
+      unsigned int nVal = 0;
+      int nDigits = 0;
+
+      while( nLen > 0 && *szIP >= '0' && *szIP <= '9' )
+      {
+         nVal = nVal * 10 + ( unsigned int ) ( *szIP - '0' );
+         szIP++;
+         nLen--;
+         nDigits++;
+         if( nDigits > 3 || nVal > 255 )
+         {
+            hb_ret();
+            return;
+         }
+      }
+      if( nDigits == 0 )
+      {
+         hb_ret();
+         return;
+      }
+      if( iPart < 3 )
+      {
+         if( nLen == 0 || *szIP != '.' )
+         {
+            hb_ret();
+            return;
+         }
+         szIP++;
+         nLen--;
+      }
+      nAddr = ( nAddr << 8 ) | nVal;
+   }
+
+   if( nLen != 0 )
+   {
+      hb_ret();
+      return;
+   }
+
+   hb_retnint( ( HB_MAXINT ) nAddr );
+}
