+#if HB_OS_PATH_DELIM_CHR != '/'
+   const char * szSrc = hb_parc( 1 );
+   HB_SIZE nLen = hb_parclen( 1 );
+
+   if( szSrc != NULL && nLen > 0 && memchr( szSrc, '/', nLen ) != NULL )
+   {
+      char * szDst = ( char * ) hb_xgrab( nLen + 1 );
+      HB_SIZE i;
+
+      for( i = 0; i < nLen; i++ )
+         szDst[ i ] = ( szSrc[ i ] == '/' ) ? HB_OS_PATH_DELIM_CHR : szSrc[ i ];
+      szDst[ nLen ] = '\0';
+      hb_retclen_buffer( szDst, nLen );
+      return;
+   }
+#endif
+   hb_itemReturn( hb_param( 1, HB_IT_ANY ) );
+}
+
+HB_FUNC( UHTMLENCODE )
+{
+   const char * szSrc = hb_parc( 1 );
+   HB_SIZE nLen = hb_parclen( 1 );
+   HB_SIZE nOutLen = 0, i;
+   char * szDst, * p;
+
+   if( szSrc == NULL || nLen == 0 )
+   {
+      hb_retc_null();
+      return;
+   }
+
+   for( i = 0; i < nLen; i++ )
+   {
+      switch( szSrc[ i ] )
+      {
+         case '<':
+         case '>':
+            nOutLen += 4;
+            break;
+         case '&':
+            nOutLen += 5;
+            break;
+         case '"':
+            nOutLen += 6;
+            break;
+         default:
+            nOutLen++;
+            break;
+      }
+   }
+
+   if( nOutLen == nLen )
+   {
+      hb_retclen( szSrc, nLen );
+      return;
+   }
+
+   szDst = ( char * ) hb_xgrab( nOutLen + 1 );
+   p = szDst;
+   for( i = 0; i < nLen; i++ )
+   {
+      switch( szSrc[ i ] )
+      {
+         case '<':
+            memcpy( p, "&lt;", 4 );
+            p += 4;
+            break;
+         case '>':
+            memcpy( p, "&gt;", 4 );
+            p += 4;
+            break;
+         case '&':
+            memcpy( p, "&amp;", 5 );
+            p += 5;
+            break;
+         case '"':
+            memcpy( p, "&quot;", 6 );
+            p += 6;
+            break;
+         default:
+            *p++ = szSrc[ i ];
+            break;
+      }
+   }
+   *p = '\0';
+   hb_retclen_buffer( szDst, nOutLen );
+}
+
+HB_FUNC( UURLENCODE )
+{
+   static const char s_hex[] = "0123456789ABCDEF";
+   const char * szSrc = hb_parc( 1 );
+   HB_SIZE nLen = hb_parclen( 1 );
+   HB_SIZE nOutLen = 0, i;
+   char * szDst, * p;
+
+   if( szSrc == NULL || nLen == 0 )
+   {
+      hb_retc_null();
+      return;
+   }
+
+   for( i = 0; i < nLen; i++ )
+   {
+      unsigned char ch = ( unsigned char ) szSrc[ i ];
+      if( ch == ' ' )
+         nOutLen++;
+      else if( ch >= 127 || ch <= 31 || ch == '=' || ch == '&' || ch == '%' || ch == '+' )
+         nOutLen += 3;
+      else
+         nOutLen++;
+   }
+
+   szDst = ( char * ) hb_xgrab( nOutLen + 1 );
+   p = szDst;
+   for( i = 0; i < nLen; i++ )
+   {
+      unsigned char ch = ( unsigned char ) szSrc[ i ];
+      if( ch == ' ' )
+         *p++ = '+';
+      else if( ch >= 127 || ch <= 31 || ch == '=' || ch == '&' || ch == '%' || ch == '+' )
+      {
+         *p++ = '%';
+         *p++ = s_hex[ ch >> 4 ];
+         *p++ = s_hex[ ch & 0x0F ];
+      }
+      else
+         *p++ = ( char ) ch;
+   }
+   *p = '\0';
+   hb_retclen_buffer( szDst, nOutLen );
+}
+
+HB_FUNC( UURLDECODE )
+{
+   const char * szSrc = hb_parc( 1 );
+   HB_SIZE nLen = hb_parclen( 1 );
+   HB_SIZE i, j = 0;
+   char * szDst;
+
+   if( szSrc == NULL || nLen == 0 )
+   {
+      hb_retc_null();
+      return;
+   }
+
+   szDst = ( char * ) hb_xgrab( nLen + 1 );
+   for( i = 0; i < nLen; i++ )
+   {
+      if( szSrc[ i ] == '+' )
+         szDst[ j++ ] = ' ';
+      else if( szSrc[ i ] == '%' && i + 2 < nLen )
+      {
+         int iHi = s_hex_val( ( unsigned char ) szSrc[ i + 1 ] );
+         int iLo = s_hex_val( ( unsigned char ) szSrc[ i + 2 ] );
+         if( iHi >= 0 && iLo >= 0 )
+         {
+            szDst[ j++ ] = ( char ) ( ( iHi << 4 ) | iLo );
+            i += 2;
+         }
+         else
+            szDst[ j++ ] = '%';
+      }
+      else
+         szDst[ j++ ] = szSrc[ i ];
+   }
+   szDst[ j ] = '\0';
+   hb_retclen_buffer( szDst, j );
+}
+
+static HB_SIZE s_url_decode_to_buf( const char * szSrc, HB_SIZE nLen, char * szDst )
+{
+   HB_SIZE i, j = 0;
+
+   for( i = 0; i < nLen; i++ )
+   {
+      if( szSrc[ i ] == '+' )
+         szDst[ j++ ] = ' ';
+      else if( szSrc[ i ] == '%' && i + 2 < nLen )
+      {
+         int iHi = s_hex_val( ( unsigned char ) szSrc[ i + 1 ] );
+         int iLo = s_hex_val( ( unsigned char ) szSrc[ i + 2 ] );
+         if( iHi >= 0 && iLo >= 0 )
+         {
+            szDst[ j++ ] = ( char ) ( ( iHi << 4 ) | iLo );
+            i += 2;
+         }
+         else
+            szDst[ j++ ] = '%';
+      }
+      else
+         szDst[ j++ ] = szSrc[ i ];
+   }
+   szDst[ j ] = '\0';
+   return j;
+}
+
+static void s_hash_set_cl( PHB_ITEM pHash, const char * szKey, HB_SIZE nKeyLen, const char * szVal, HB_SIZE nValLen )
+{
+   PHB_ITEM pKey = hb_itemPutCL( NULL, szKey, nKeyLen );
+   PHB_ITEM pVal = hb_itemPutCL( NULL, szVal, nValLen );
+   hb_hashAdd( pHash, pKey, pVal );
+   hb_itemRelease( pKey );
+   hb_itemRelease( pVal );
+}
+
+static void s_hash_set_upper_cl( PHB_ITEM pHash, const char * szKey, HB_SIZE nKeyLen, const char * szVal, HB_SIZE nValLen )
+{
+   char * szUpper = ( char * ) hb_xgrab( nKeyLen + 1 );
+   HB_SIZE i;
+   PHB_ITEM pKey, pVal;
+
+   for( i = 0; i < nKeyLen; i++ )
+   {
+      unsigned char ch = ( unsigned char ) szKey[ i ];
+      szUpper[ i ] = ( ch >= 'a' && ch <= 'z' ) ? ( char ) ( ch - 'a' + 'A' ) : ( char ) ch;
+   }
+   szUpper[ nKeyLen ] = '\0';
+
+   pKey = hb_itemPutCLPtr( NULL, szUpper, nKeyLen );
+   pVal = hb_itemPutCL( NULL, szVal, nValLen );
+   hb_hashAdd( pHash, pKey, pVal );
+   hb_itemRelease( pKey );
+   hb_itemRelease( pVal );
+}
+
+static HB_BOOL s_ascii_ieq( const char * a, HB_SIZE nLen, const char * b )
+{
+   HB_SIZE i;
+   for( i = 0; i < nLen; i++ )
+   {
+      unsigned char ca = ( unsigned char ) a[ i ];
+      unsigned char cb = ( unsigned char ) b[ i ];
+      if( cb == '\0' )
+         return HB_FALSE;
+      if( ca >= 'a' && ca <= 'z' )
+         ca = ( unsigned char ) ( ca - 'a' + 'A' );
+      if( ca != cb )
+         return HB_FALSE;
+   }
+   return b[ nLen ] == '\0';
+}
+
+static const char * s_memmem_crlf( const char * pHay, HB_SIZE nHayLen, const char * pNeedle, HB_SIZE nNeedleLen )
+{
+   const char * p = pHay;
+   const char * pLimit;
+
+   if( nNeedleLen == 0 )
+      return pHay;
+   if( nHayLen < nNeedleLen )
+      return NULL;
+
+   pLimit = pHay + nHayLen - nNeedleLen + 1;
+   while( p < pLimit )
+   {
+      const char * pMatch = ( const char * ) memchr( p, ( unsigned char ) pNeedle[ 0 ], ( size_t ) ( pLimit - p ) );
+      if( pMatch == NULL )
+         return NULL;
+      if( nNeedleLen == 1 || memcmp( pMatch + 1, pNeedle + 1, nNeedleLen - 1 ) == 0 )
+         return pMatch;
+      p = pMatch + 1;
+   }
+   return NULL;
+}
+
+static void s_parse_query_pairs( const char * szData, HB_SIZE nLen, PHB_ITEM pHash, HB_BOOL lUtf8 )
+{
+   const char * p = szData;
+   const char * pEnd = szData + nLen;
+
+   while( p < pEnd )
+   {
+      const char * pAmp = ( const char * ) memchr( p, '&', ( size_t ) ( pEnd - p ) );
+      const char * pPartEnd = ( pAmp != NULL ) ? pAmp : pEnd;
+      HB_SIZE nPartLen = ( HB_SIZE ) ( pPartEnd - p );
+      const char * pEq = ( nPartLen > 0 ) ? ( const char * ) memchr( p, '=', nPartLen ) : NULL;
+
+      if( pEq != NULL )
+      {
+         HB_SIZE nKeyRaw = ( HB_SIZE ) ( pEq - p );
+         HB_SIZE nValRaw = ( HB_SIZE ) ( pPartEnd - ( pEq + 1 ) );
+         char * szKeyDec = ( char * ) hb_xgrab( nKeyRaw + 1 );
+         char * szValDec = ( char * ) hb_xgrab( nValRaw + 1 );
+         HB_SIZE nKeyDec = s_url_decode_to_buf( p, nKeyRaw, szKeyDec );
+         HB_SIZE nValDec = s_url_decode_to_buf( pEq + 1, nValRaw, szValDec );
+         PHB_ITEM pKey = hb_itemNew( NULL );
+         PHB_ITEM pVal = hb_itemNew( NULL );
+
+         if( lUtf8 )
+         {
+            hb_itemPutStrLenUTF8( pKey, szKeyDec, nKeyDec );
+            hb_itemPutStrLenUTF8( pVal, szValDec, nValDec );
+            hb_xfree( szKeyDec );
+            hb_xfree( szValDec );
+         }
+         else
+         {
+            hb_itemPutCLPtr( pKey, szKeyDec, nKeyDec );
+            hb_itemPutCLPtr( pVal, szValDec, nValDec );
+         }
+         hb_hashAdd( pHash, pKey, pVal );
+         hb_itemRelease( pKey );
+         hb_itemRelease( pVal );
+      }
+      else if( nPartLen > 0 )
+      {
+         char * szKeyDec = ( char * ) hb_xgrab( nPartLen + 1 );
+         HB_SIZE nKeyDec = s_url_decode_to_buf( p, nPartLen, szKeyDec );
+         PHB_ITEM pKey = hb_itemNew( NULL );
+         PHB_ITEM pNil = hb_itemNew( NULL );
+
+         if( lUtf8 )
+         {
+            hb_itemPutStrLenUTF8( pKey, szKeyDec, nKeyDec );
+            hb_xfree( szKeyDec );
+         }
+         else
+            hb_itemPutCLPtr( pKey, szKeyDec, nKeyDec );
+
+         hb_hashAdd( pHash, pKey, pNil );
+         hb_itemRelease( pKey );
+         hb_itemRelease( pNil );
+      }
+
+      if( pAmp == NULL )
+         break;
+      p = pAmp + 1;
+   }
+}
+
+HB_FUNC( PARSEREQUESTHEADERC )
+{
+   const char * szReq = hb_parc( 1 );
+   HB_SIZE nReqLen = hb_parclen( 1 );
+   const char * szEnd = hb_parc( 2 );
+   HB_SIZE nEndLen = hb_parclen( 2 );
+   PHB_ITEM pServer = hb_param( 3, HB_IT_HASH );
+   PHB_ITEM pCookie = hb_param( 4, HB_IT_HASH );
+   PHB_ITEM pGet = hb_param( 5, HB_IT_HASH );
+
+   const char * pHeaderEnd, * pAfter, * pLine, * pHeaderLimit;
+   HB_SIZE nAfterLen, nLineLen;
+   const char * pSp1, * pSp2, * pSp3;
+   const char * szMethod, * szUri, * szProto;
+   HB_SIZE nMethodLen, nUriLen, nProtoLen;
+   HB_BOOL lHasContentLength = HB_FALSE;
+   HB_MAXINT nContentLength = 0;
+
+   if( szReq == NULL || szEnd == NULL || nEndLen == 0 || pServer == NULL || pCookie == NULL || pGet == NULL )
+   {
+      hb_ret();
+      return;
+   }
+
+   pHeaderEnd = s_memmem_crlf( szReq, nReqLen, szEnd, nEndLen );
+   if( pHeaderEnd == NULL )
+   {
+      hb_ret();
+      return;
+   }
+
+   pAfter = pHeaderEnd + nEndLen;
+   nAfterLen = nReqLen - ( HB_SIZE ) ( pAfter - szReq );
+   pHeaderLimit = pHeaderEnd;
+
+   /* Parse request line */
+   {
+      const char * pCrLf = s_memmem_crlf( szReq, ( HB_SIZE ) ( pHeaderLimit - szReq ), "\r\n", 2 );
+      const char * pLineEnd = ( pCrLf != NULL ) ? pCrLf : pHeaderLimit;
+      nLineLen = ( HB_SIZE ) ( pLineEnd - szReq );
+
+      s_hash_set_cl( pServer, "REQUEST_ALL", 11, szReq, nLineLen );
+
+      pSp1 = ( const char * ) memchr( szReq, ' ', nLineLen );
+      if( pSp1 == NULL )
+      {
+         s_hash_set_cl( pServer, "REQUEST_METHOD", 14, szReq, nLineLen );
+         s_hash_set_cl( pServer, "REQUEST_URI", 11, "", 0 );
+         s_hash_set_cl( pServer, "SERVER_PROTOCOL", 15, "", 0 );
+         hb_storclen( pAfter, nAfterLen, 1 );
+         hb_ret();
+         return;
+      }
+
+      szMethod = szReq;
+      nMethodLen = ( HB_SIZE ) ( pSp1 - szReq );
+      pSp2 = ( const char * ) memchr( pSp1 + 1, ' ', ( size_t ) ( pLineEnd - ( pSp1 + 1 ) ) );
+      if( pSp2 == NULL )
+      {
+         szUri = pSp1 + 1;
+         nUriLen = ( HB_SIZE ) ( pLineEnd - szUri );
+         s_hash_set_cl( pServer, "REQUEST_METHOD", 14, szMethod, nMethodLen );
+         s_hash_set_cl( pServer, "REQUEST_URI", 11, szUri, nUriLen );
+         s_hash_set_cl( pServer, "SERVER_PROTOCOL", 15, "", 0 );
+         hb_storclen( pAfter, nAfterLen, 1 );
+         hb_ret();
+         return;
+      }
+
+      szUri = pSp1 + 1;
+      nUriLen = ( HB_SIZE ) ( pSp2 - szUri );
+      pSp3 = ( const char * ) memchr( pSp2 + 1, ' ', ( size_t ) ( pLineEnd - ( pSp2 + 1 ) ) );
+      szProto = pSp2 + 1;
+      nProtoLen = ( pSp3 != NULL ) ? ( HB_SIZE ) ( pSp3 - szProto ) : ( HB_SIZE ) ( pLineEnd - szProto );
+
+      s_hash_set_cl( pServer, "REQUEST_METHOD", 14, szMethod, nMethodLen );
+      s_hash_set_cl( pServer, "REQUEST_URI", 11, szUri, nUriLen );
+      s_hash_set_cl( pServer, "SERVER_PROTOCOL", 15, szProto, nProtoLen );
+
+      if( pSp3 != NULL || nProtoLen < 5 || memcmp( szProto, "HTTP/", 5 ) != 0 )
+      {
+         hb_storclen( pAfter, nAfterLen, 1 );
+         hb_ret();
+         return;
+      }
+
+      pLine = ( pCrLf != NULL ) ? pCrLf + 2 : pHeaderLimit;
+   }
+
+   /* Fix invalid queries: bind to root and split SCRIPT_NAME / QUERY_STRING */
+   {
+      const char * szFullUri = szUri;
+      HB_SIZE nFullUriLen = nUriLen;
+      char * szPrefixed = NULL;
+      const char * pQ;
+
+      if( nUriLen == 0 || szUri[ 0 ] != '/' )
+      {
+         szPrefixed = ( char * ) hb_xgrab( nUriLen + 2 );
+         szPrefixed[ 0 ] = '/';
+         if( nUriLen > 0 )
+            memcpy( szPrefixed + 1, szUri, nUriLen );
+         szPrefixed[ nUriLen + 1 ] = '\0';
+         szFullUri = szPrefixed;
+         nFullUriLen = nUriLen + 1;
+         s_hash_set_cl( pServer, "REQUEST_URI", 11, szFullUri, nFullUriLen );
+      }
+
+      pQ = ( const char * ) memchr( szFullUri, '?', nFullUriLen );
+      if( pQ != NULL )
+      {
+         HB_SIZE nScriptLen = ( HB_SIZE ) ( pQ - szFullUri );
+         HB_SIZE nQueryLen = nFullUriLen - nScriptLen - 1;
+         s_hash_set_cl( pServer, "SCRIPT_NAME", 11, szFullUri, nScriptLen );
+         s_hash_set_cl( pServer, "QUERY_STRING", 12, pQ + 1, nQueryLen );
+      }
+      else
+      {
+         s_hash_set_cl( pServer, "SCRIPT_NAME", 11, szFullUri, nFullUriLen );
+         s_hash_set_cl( pServer, "QUERY_STRING", 12, "", 0 );
+      }
+
+      if( szPrefixed != NULL )
+         hb_xfree( szPrefixed );
+   }
+
+   /* Initialize standard HTTP_* keys */
+   s_hash_set_cl( pServer, "HTTP_ACCEPT", 11, "", 0 );
+   s_hash_set_cl( pServer, "HTTP_ACCEPT_CHARSET", 19, "", 0 );
+   s_hash_set_cl( pServer, "HTTP_ACCEPT_ENCODING", 20, "", 0 );
+   s_hash_set_cl( pServer, "HTTP_ACCEPT_LANGUAGE", 20, "", 0 );
+   s_hash_set_cl( pServer, "HTTP_CONNECTION", 15, "", 0 );
+   s_hash_set_cl( pServer, "HTTP_HOST", 9, "", 0 );
+   s_hash_set_cl( pServer, "HTTP_KEEP_ALIVE", 15, "", 0 );
+   s_hash_set_cl( pServer, "HTTP_REFERER", 12, "", 0 );
+   s_hash_set_cl( pServer, "HTTP_USER_AGENT", 15, "", 0 );
+
+   /* Parse header lines */
+   while( pLine < pHeaderLimit )
+   {
+      const char * pCrLf = s_memmem_crlf( pLine, ( HB_SIZE ) ( pHeaderLimit - pLine ), "\r\n", 2 );
+      const char * pLineEnd = ( pCrLf != NULL ) ? pCrLf : pHeaderLimit;
+      const char * pColon;
+
+      if( pLine == pLineEnd )
+         break;
+
+      pColon = ( const char * ) memchr( pLine, ':', ( size_t ) ( pLineEnd - pLine ) );
+      if( pColon != NULL )
+      {
+         const char * szName = pLine;
+         HB_SIZE nNameLen = ( HB_SIZE ) ( pColon - pLine );
+         const char * szVal = pColon + 1;
+         const char * szValEnd = pLineEnd;
+         HB_SIZE nValLen;
+
+         while( szVal < szValEnd && *szVal == ' ' )
+            szVal++;
+         while( szValEnd > szVal && szValEnd[ -1 ] == ' ' )
+            szValEnd--;
+         nValLen = ( HB_SIZE ) ( szValEnd - szVal );
+
+         if( s_ascii_ieq( szName, nNameLen, "COOKIE" ) )
+         {
+            const char * pSemi;
+            HB_SIZE nSubLen;
+            const char * pEq;
+
+            s_hash_set_cl( pServer, "HTTP_COOKIE", 11, szVal, nValLen );
+            pSemi = ( const char * ) memchr( szVal, ';', nValLen );
+            nSubLen = ( pSemi != NULL ) ? ( HB_SIZE ) ( pSemi - szVal ) : nValLen;
+            pEq = ( const char * ) memchr( szVal, '=', nSubLen );
+            if( pEq != NULL )
+               s_hash_set_upper_cl( pCookie, szVal, ( HB_SIZE ) ( pEq - szVal ), pEq + 1, nSubLen - ( HB_SIZE ) ( pEq - szVal ) - 1 );
+         }
+         else if( s_ascii_ieq( szName, nNameLen, "ACCEPT-ENCODING" ) )
+         {
+            PHB_ITEM pKey = hb_itemPutCL( NULL, "HTTP_ACCEPT_ENCODING", 20 );
+            PHB_ITEM pCur = hb_hashGetItemPtr( pServer, pKey, HB_HASH_AUTOADD_NEVER );
+            if( pCur != NULL && hb_itemGetCLen( pCur ) > 0 )
+            {
+               HB_SIZE nCurLen = hb_itemGetCLen( pCur );
+               const char * szCur = hb_itemGetCPtr( pCur );
+               char * szNew = ( char * ) hb_xgrab( nCurLen + 1 + nValLen + 1 );
+               PHB_ITEM pNew;
+               memcpy( szNew, szCur, nCurLen );
+               szNew[ nCurLen ] = ',';
+               memcpy( szNew + nCurLen + 1, szVal, nValLen );
+               szNew[ nCurLen + 1 + nValLen ] = '\0';
+               pNew = hb_itemPutCLPtr( NULL, szNew, nCurLen + 1 + nValLen );
+               hb_hashAdd( pServer, pKey, pNew );
+               hb_itemRelease( pNew );
+            }
+            else
+            {
+               PHB_ITEM pNew = hb_itemPutCL( NULL, szVal, nValLen );
+               hb_hashAdd( pServer, pKey, pNew );
+               hb_itemRelease( pNew );
+            }
+            hb_itemRelease( pKey );
+         }
+         else if( s_ascii_ieq( szName, nNameLen, "TRANSFER-ENCODING" ) )
+         {
+            hb_storclen( pAfter, nAfterLen, 1 );
+            hb_ret();
+            return;
+         }
+         else if( s_ascii_ieq( szName, nNameLen, "CONTENT-LENGTH" ) )
+         {
+            HB_SIZE k;
+            if( lHasContentLength || nValLen == 0 )
+            {
+               hb_storclen( pAfter, nAfterLen, 1 );
+               hb_ret();
+               return;
+            }
+            nContentLength = 0;
+            for( k = 0; k < nValLen; k++ )
+            {
+               if( szVal[ k ] < '0' || szVal[ k ] > '9' )
+               {
+                  hb_storclen( pAfter, nAfterLen, 1 );
+                  hb_ret();
+                  return;
+               }
+               if( ( HB_MAXUINT ) nContentLength >
+                   ( ( ( ~( HB_MAXUINT ) 0 ) >> 1 ) - ( HB_MAXUINT ) ( szVal[ k ] - '0' ) ) / 10 )
+               {
+                  hb_storclen( pAfter, nAfterLen, 1 );
+                  hb_ret();
+                  return;
+               }
+               nContentLength = nContentLength * 10 + ( szVal[ k ] - '0' );
+            }
+            lHasContentLength = HB_TRUE;
+         }
+         else if( s_ascii_ieq( szName, nNameLen, "CONTENT-TYPE" ) )
+         {
+            s_hash_set_cl( pServer, "CONTENT_TYPE", 12, szVal, nValLen );
+         }
+         else
+         {
+            char * szKey = ( char * ) hb_xgrab( 5 + nNameLen + 1 );
+            HB_SIZE k;
+            PHB_ITEM pKey, pVal;
+
+            memcpy( szKey, "HTTP_", 5 );
+            for( k = 0; k < nNameLen; k++ )
+            {
+               unsigned char ch = ( unsigned char ) szName[ k ];
+               if( ch == '-' )
+                  szKey[ 5 + k ] = '_';
+               else if( ch >= 'a' && ch <= 'z' )
+                  szKey[ 5 + k ] = ( char ) ( ch - 'a' + 'A' );
+               else
+                  szKey[ 5 + k ] = ( char ) ch;
+            }
+            szKey[ 5 + nNameLen ] = '\0';
+
+            pKey = hb_itemPutCLPtr( NULL, szKey, 5 + nNameLen );
+            pVal = hb_itemPutCL( NULL, szVal, nValLen );
+            hb_hashAdd( pServer, pKey, pVal );
+            hb_itemRelease( pKey );
+            hb_itemRelease( pVal );
+         }
+      }
+
+      if( pCrLf == NULL )
+         break;
+      pLine = pCrLf + 2;
+   }
+
+   /* Parse QUERY_STRING into get hash */
+   {
+      PHB_ITEM pQsKey = hb_itemPutCL( NULL, "QUERY_STRING", 12 );
+      PHB_ITEM pQsVal = hb_hashGetItemPtr( pServer, pQsKey, HB_HASH_AUTOADD_NEVER );
+      if( pQsVal != NULL && hb_itemGetCLen( pQsVal ) > 0 )
+         s_parse_query_pairs( hb_itemGetCPtr( pQsVal ), hb_itemGetCLen( pQsVal ), pGet, HB_FALSE );
+      hb_itemRelease( pQsKey );
+   }
+
+   hb_storclen( pAfter, nAfterLen, 1 );
+   hb_retnint( nContentLength );
+}
+
+HB_FUNC( PARSEFORMURLENCODED )
+{
+   const char * szBody = hb_parc( 1 );
+   HB_SIZE nLen = hb_parclen( 1 );
+   PHB_ITEM pPost = hb_param( 2, HB_IT_HASH );
+   HB_BOOL lUtf8 = hb_parl( 3 );
+
+   if( szBody != NULL && nLen > 0 && pPost != NULL )
+      s_parse_query_pairs( szBody, nLen, pPost, lUtf8 );
+}
+
+HB_FUNC( BUILDRESPONSEHEADERS )
+{
+   const char * szHead = hb_parc( 1 );
+   HB_SIZE nHeadLen = hb_parclen( 1 );
+   PHB_ITEM pHeaders = hb_param( 2, HB_IT_ARRAY );
+   HB_SIZE nCount, i, nTotalLen = nHeadLen + 2;
+   char * szOut, * p;
+
+   if( szHead == NULL )
+      nHeadLen = 0;
+
+   nCount = ( pHeaders != NULL ) ? hb_arrayLen( pHeaders ) : 0;
+   for( i = 1; i <= nCount; i++ )
+   {
+      PHB_ITEM pPair = hb_arrayGetItemPtr( pHeaders, i );
+      if( pPair != NULL && HB_IS_ARRAY( pPair ) && hb_arrayLen( pPair ) >= 2 )
+         nTotalLen += hb_arrayGetCLen( pPair, 1 ) + 2 + hb_arrayGetCLen( pPair, 2 ) + 2;
+   }
+
+   szOut = ( char * ) hb_xgrab( nTotalLen + 1 );
+   p = szOut;
+   if( nHeadLen > 0 )
+   {
+      memcpy( p, szHead, nHeadLen );
+      p += nHeadLen;
+   }
+   for( i = 1; i <= nCount; i++ )
+   {
+      PHB_ITEM pPair = hb_arrayGetItemPtr( pHeaders, i );
+      if( pPair != NULL && HB_IS_ARRAY( pPair ) && hb_arrayLen( pPair ) >= 2 )
+      {
+         HB_SIZE nK = hb_arrayGetCLen( pPair, 1 );
+         HB_SIZE nV = hb_arrayGetCLen( pPair, 2 );
+         if( nK > 0 )
+         {
+            memcpy( p, hb_arrayGetCPtr( pPair, 1 ), nK );
+            p += nK;
+         }
+         *p++ = ':';
+         *p++ = ' ';
+         if( nV > 0 )
+         {
+            memcpy( p, hb_arrayGetCPtr( pPair, 2 ), nV );
+            p += nV;
+         }
+         *p++ = '\r';
+         *p++ = '\n';
+      }
+   }
+   *p++ = '\r';
+   *p++ = '\n';
+   *p = '\0';
+
+   hb_retclen_buffer( szOut, ( HB_SIZE ) ( p - szOut ) );
+}
+
+#pragma ENDDUMP
