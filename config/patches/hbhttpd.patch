+STATIC FUNCTION SendResponse( oServer, hSSL, hSocket, cResponse )
+
+   LOCAL cChunk := ""
+   LOCAL lSSL := oServer:lHasSSL .AND. oServer:hConfig[ "SSL" ]
+   LOCAL nLength := hb_BLen( cResponse ), nOffset := 1, nLen, nErr, nWait
+   LOCAL nChunkSize := oServer:hConfig[ "SendChunkSize" ]
+   LOCAL nTimeout := oServer:hConfig[ "SendTimeout" ], nTime := UHttpdSendClock()
+
+   /* A writable blocking socket can still block inside send(). */
+   IF ! lSSL .AND. hb_socketSetBlockingIO( hSocket, .F. ) < 0
+      Eval( oServer:hConfig[ "Trace" ], "send nonblocking error:", hb_socketGetError() )
+      RETURN .F.
+   ENDIF
+
+   DO WHILE nOffset <= nLength .AND. ! oServer:lStop
+      nWait := 1000
+      IF nTimeout > 0
+         nWait := Min( nWait, nTimeout - ( UHttpdSendClock() - nTime ) )
+         IF nWait <= 0
+            Eval( oServer:hConfig[ "Trace" ], "send timeout:", nOffset - 1, nLength )
+            RETURN .F.
+         ENDIF
+      ENDIF
+
+      IF hb_BLen( cChunk ) == 0
+         cChunk := hb_BSubStr( cResponse, nOffset, nChunkSize )
+      ENDIF
+      IF lSSL
+         /* Keep the same buffer and length while SSL_write() wants a retry. */
+         nLen := MY_SSL_WRITE( oServer:hConfig, hSSL, hSocket, cChunk, nWait, @nErr )
+      ELSE
+         nLen := hb_socketSend( hSocket, cChunk,,, nWait )
+         IF nLen < 0
+            nErr := hb_socketGetError()
+         ELSEIF nLen == 0
+            Eval( oServer:hConfig[ "Trace" ], "send closed:", nOffset - 1, nLength )
+            RETURN .F.
+         ENDIF
+      ENDIF
+
+      IF nLen > 0
+         nOffset += nLen
+         /* Only a bounded chunk is copied after a partial send. */
+         cChunk := hb_BSubStr( cChunk, nLen + 1 )
+      ELSEIF nLen < 0 .AND. nErr != HB_SOCKET_ERR_TIMEOUT .AND. nErr != HB_SOCKET_ERR_AGAIN
+         Eval( oServer:hConfig[ "Trace" ], "send error:", nErr, hb_socketErrorString( nErr ), nOffset - 1, nLength )
+         RETURN .F.
+      ENDIF
+   ENDDO
+
+   IF oServer:lStop
+      RETURN .F.
+   ENDIF
+
+   /* Plain accepted sockets are blocking before each response. */
+   IF ! lSSL .AND. hb_socketSetBlockingIO( hSocket, .T. ) < 0
+      Eval( oServer:hConfig[ "Trace" ], "send blocking restore error:", hb_socketGetError() )
+      RETURN .F.
+   ENDIF
+
+   RETURN nOffset > nLength
+
