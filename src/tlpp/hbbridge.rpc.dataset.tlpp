#include "totvs.ch"
#include "parmtype.ch"

namespace HBBridge.RDD

class HBBridgeRPCDataSet

    private data cSql as character
    private data cOrderBy as character
    private data cErrorCode as character
    private data cErrorMessage as character
    private data cAliasProfile as character

    private data jResult as json
    private data jFieldNames as json
    private data jBindings as json

    private data lTyped as logical

    private data nRowIndex as numeric
    private data nTotalRows as numeric
    private data nTotalFields as numeric

    private data oClient as object

    public method New(oClient as object) as object
    public method OpenSQL(cSql as character,jPage as json) as logical
    public method OpenSQLTyped(cSql as character,jBindings as json,jPage as json) as logical
    public method OpenPage(cSql as character,nPage as numeric,nSize as numeric,cOrderBy as character) as logical
    public method OpenPageTyped(cSql as character,jBindings as json,nPage as numeric,nSize as numeric,cOrderBy as character) as logical
    public method PreviousPage() as logical
    public method HasPreviousPage() as logical
    public method NextPage() as logical
    public method HasNextPage() as logical
    public method PageNumber() as numeric
    public method PageSize() as numeric
    public method HasTotals() as logical
    public method TotalRows() as numeric
    public method TotalPages() as numeric
    public method MoreToRead() as logical
    public method Header() as json
    public method FieldExist(cFieldName) as logical
    public method FieldInfo(cFieldName as character) as json
    public method FieldCount() as numeric
    public method FieldName(nPosition as numeric) as character
    public method GetRow() as json
    public method GetRows() as json
    public method GetOrderBy() as character
    public method FieldGet(cFieldName as character) as variant
    public method Skip()
    public method Eof() as logical
    public method Close()
    public method RowCount() as numeric
    public method ErrorCode() as character
    public method ErrorMessage() as character
    public method GetAliasProfile() as character
    public method SetAliasProfile(cAliasProfile) as character

    private method OpenRequest(cSql as character,jPage as json,jBindings as json,lTyped as logical) as logical

endclass

method New(oClient) class HBBridgeRPCDataSet

    self:oClient:=oClient
    if (ValType(self:oClient)=="U")
        self:oClient:=HBBridge.Client.HBBridgeClient():New()
    endif
    self:jResult:=nil
    self:jFieldNames:=nil
    self:jBindings:=nil
    self:lTyped:=.F.
    self:nRowIndex:=0
    self:nTotalRows:=0
    self:nTotalFields:=0
    self:cErrorCode:=""
    self:cErrorMessage:=""
    self:cAliasProfile:=""
    self:cSql:=""
    self:cOrderBy:=""

return(self)

method OpenSQL(cSql,jPage) class HBBridgeRPCDataSet

    paramtype 1 var cSql as character
    paramtype 2 var jPage as json optional

return(self:OpenRequest(cSql,jPage,nil,.F.))

method OpenSQLTyped(cSql,jBindings,jPage) class HBBridgeRPCDataSet

    paramtype 1 var cSql as character
    paramtype 3 var jPage as json optional

return(self:OpenRequest(cSql,jPage,jBindings,.T.))

method OpenRequest(cSql,jPage,jBindings,lTyped) class HBBridgeRPCDataSet

    local aNames as array

    local cRowKey:="" as character
    local cPosition:="" as character
    local cFieldName:="" as character
    local cAliasProfile:=self:cAliasProfile as character
    local cBindings:="" as character
    local cFailure:="" as character

    local jParams:=JSONObject():New() as json
    local jResponse as json
    local jFieldNames as json
    local jRequestBindings as json

    local lValid:=.F. as logical

    local nRow:=0 as numeric
    local nField:=0 as numeric
    local nFields:=0 as numeric
    local nPosition:=0 as numeric
    local nExpectedPages:=0 as numeric

    paramtype 1 var cSql as character
    paramtype 2 var jPage as json optional

    self:Close()
    self:cAliasProfile:=cAliasProfile
    if (lTyped)
        if (Empty(AllTrim(cSql)).or.Empty(AllTrim(cAliasProfile)).or.;
            (Chr(0) $ cSql).or.(Chr(0) $ cAliasProfile))
            self:cErrorCode:="INVALID_TYPED_REQUEST"
            self:cErrorMessage:="Typed SQL requires a nonempty profile and SQL without NUL."
            FreeObj(@jParams)
            return(.F.)
        endif
        if (!DataSetTypedBindings(jBindings,@cFailure))
            self:cErrorCode:=cFailure
            self:cErrorMessage:="Typed SQL bindings do not match the declared value contract."
            FreeObj(@jParams)
            return(.F.)
        endif
        if (ValType(jPage)=="J")
            if (!DataSetTypedPage(jPage))
                self:cErrorCode:="INVALID_PAGE"
                self:cErrorMessage:="Page requires valid exact bounds and a column-only orderBy."
                FreeObj(@jParams)
                return(.F.)
            endif
        endif
        // Keep immutable bytes independently of caller/client JSON objects.
        cBindings:=HBBridge.Client.HBBridgeJSON():Encode(jBindings)
        jRequestBindings:=JSONObject():New()
        if (!HBBridge.Client.HBBridgeJSON():Parse(cBindings,jRequestBindings))
            self:cErrorCode:="INVALID_BINDINGS"
            self:cErrorMessage:="Typed SQL bindings could not be copied without loss."
            FreeObj(@jRequestBindings)
            FreeObj(@jParams)
            return(.F.)
        endif
        jParams["requestVersion"]:=1
        jParams["bindings"]:=jRequestBindings
    endif
    if (ValType(jPage)=="J")
        lValid:=jPage:HasProperty("number").and.jPage:HasProperty("size").and.jPage:HasProperty("orderBy")
        if (lValid)
            lValid:=(ValType(jPage["number"])=="N").and.(ValType(jPage["size"])=="N").and.(ValType(jPage["orderBy"])=="C")
        endif
        if (lValid)
            lValid:=(jPage["number"]>=1).and.(jPage["number"]==Int(jPage["number"])).and.;
                (jPage["size"]>=1).and.(jPage["size"]==Int(jPage["size"])).and.!Empty(AllTrim(jPage["orderBy"]))
        endif
        if (!lValid)
            self:cErrorCode:="INVALID_PAGE"
            self:cErrorMessage:="Page requires a positive integer number and size and a nonempty orderBy."
            FreeObj(@jParams)
            return(.F.)
        endif
    endif
    lValid:=.F.
    jParams["alias"]:=self:cAliasProfile
    jParams["sql"]:=cSql
    if (ValType(jPage)=="J")
        jParams["page"]:=jPage
    endif
    jResponse:=self:oClient:CallService(IIf(lTyped,"RPCRDD.QueryTyped","RPCRDD.Query"),jParams)
    FreeObj(@jParams)

    if (ValType(jResponse)!="J")
        self:cErrorCode:="INVALID_RESULT"
        self:cErrorMessage:="SQL query result does not match the keyed dataset contract."
        return(.F.)
    endif

    if (jResponse:HasProperty("success"))
        if (ValType(jResponse["success"])=="L")
            lValid:=jResponse["success"]
        endif
    endif

    if (!lValid)
        self:cErrorCode:="QUERY_FAILED"
        self:cErrorMessage:="SQL query failed."
        if (jResponse:HasProperty("code"))
            if (ValType(jResponse["code"])=="C")
                self:cErrorCode:=jResponse["code"]
            endif
        endif
        if (jResponse:HasProperty("error"))
            if (ValType(jResponse["error"])=="C")
                self:cErrorMessage:=jResponse["error"]
            endif
        endif
        FreeObj(@jResponse)
        return(.F.)
    endif

    lValid:=(;
        jResponse:HasProperty("header");
        .and. jResponse:HasProperty("rows");
        .and. jResponse:HasProperty("rowCount");
        .and. jResponse:HasProperty("resultVersion");
    )

    if (lValid)
        lValid:=(;
            (ValType(jResponse["header"])=="J");
            .and. (ValType(jResponse["rows"])=="J");
            .and. (ValType(jResponse["rowCount"])=="N");
            .and. (ValType(jResponse["resultVersion"])=="N");
        )
    endif
    if (lValid)
        lValid:=(;
            (jResponse["resultVersion"]==IIf(lTyped,2,1));
            .and. (jResponse["rowCount"]>=0);
            .and. (jResponse["rowCount"]==Int(jResponse["rowCount"]));
        )
    endif
    if (lValid)
        if (ValType(jPage)=="J")
            lValid:=jResponse:HasProperty("page")
            if (lValid)
                lValid:=(ValType(jResponse["page"])=="J")
            endif
            if (lValid)
                lValid:=(;
                    jResponse["page"]:HasProperty("number");
                    .and. jResponse["page"]:HasProperty("size");
                    .and. jResponse["page"]:HasProperty("hasNext");
                    .and. jResponse["page"]:HasProperty("firstRow");
                    .and. jResponse["page"]:HasProperty("lastRow");
                )
            endif
            if (lValid)
                lValid:=(;
                    (ValType(jResponse["page"]["number"])=="N");
                    .and. (ValType(jResponse["page"]["size"])=="N");
                    .and. (ValType(jResponse["page"]["hasNext"])=="L");
                    .and. (ValType(jResponse["page"]["firstRow"])=="N");
                    .and. (ValType(jResponse["page"]["lastRow"])=="N");
                )
            endif
            if (lValid)
                lValid:=(;
                    (jResponse["page"]["number"]==jPage["number"]);
                    .and. (jResponse["page"]["size"]==jPage["size"]);
                    .and. (jResponse["rowCount"]<=jPage["size"]);
                )
            endif
            if (lValid)
                lValid:=((!jResponse["page"]["hasNext"]) .or. (jResponse["rowCount"]==jPage["size"]))
                if (jResponse["rowCount"]==0)
                    lValid:=(;
                        (lValid);
                        .and. (jResponse["page"]["firstRow"]==0);
                        .and. (jResponse["page"]["lastRow"]==0);
                    )
                else
                    lValid:=(;
                        (lValid);
                        .and. (jResponse["page"]["firstRow"]==(jPage["number"]-1)*jPage["size"]+1);
                        .and. (jResponse["page"]["lastRow"]==jResponse["page"]["firstRow"]+jResponse["rowCount"]-1);
                    )
                endif
            endif
        endif
    endif
    if (lValid)
        if (ValType(jPage)!="J")
            lValid:=!jResponse:HasProperty("page")
        endif
    endif
    if (lValid)
        if (jResponse:HasProperty("totalRows").or.jResponse:HasProperty("totalPages"))
            lValid:=jResponse:HasProperty("totalRows").and.jResponse:HasProperty("totalPages")
            if (lValid)
                lValid:=(ValType(jResponse["totalRows"])=="N").and.(ValType(jResponse["totalPages"])=="N")
            endif
            if (lValid)
                lValid:=(jResponse["totalRows"]>=0).and.(jResponse["totalRows"]<=9007199254740991).and.;
                    (jResponse["totalRows"]==Int(jResponse["totalRows"])).and.;
                    (jResponse["totalPages"]>=0).and.(jResponse["totalPages"]<=9007199254740991).and.;
                    (jResponse["totalPages"]==Int(jResponse["totalPages"]))
            endif
            if (lValid)
                if (ValType(jPage)=="J")
                    nExpectedPages:=Int(jResponse["totalRows"]/jPage["size"])+IIf(Mod(jResponse["totalRows"],jPage["size"])==0,0,1)
                else
                    nExpectedPages:=IIf(jResponse["rowCount"]>0,1,0)
                    lValid:=(jResponse["totalRows"]==jResponse["rowCount"])
                endif
                lValid:=lValid.and.(jResponse["totalPages"]==nExpectedPages)
            endif
        endif
    endif
    if (lValid)
        for nRow:=1 to jResponse["rowCount"]
            cRowKey:=tlpp.ToStr(nRow)
            if (!jResponse["rows"]:HasProperty(cRowKey))
                lValid:=.F.
                exit
            endif
            if (ValType(jResponse["rows"][cRowKey])!="J")
                lValid:=.F.
                exit
            endif
        next
    endif
    if (lValid)
        jFieldNames:=JSONObject():New()
        // GetNames() requires an array. Allocate it once per open,then cache
        // ordinal keys in JSON to avoid repeated copies,sorting or searches.
        aNames:=jResponse["header"]:GetNames()
        nFields:=Len(aNames)
        for nField:=1 to nFields
            cFieldName:=aNames[nField]
            if (ValType(jResponse["header"][cFieldName])!="J")
                lValid:=.F.
                exit
            endif
            if (!jResponse["header"][cFieldName]:HasProperty("position"))
                lValid:=.F.
                exit
            endif
            if (ValType(jResponse["header"][cFieldName]["position"])!="N")
                lValid:=.F.
                exit
            endif
            nPosition:=jResponse["header"][cFieldName]["position"]
            if ((nPosition<1).or.(nPosition>nFields).or.(nPosition!=Int(nPosition)))
                lValid:=.F.
                exit
            endif
            cPosition:=tlpp.ToStr(nPosition)
            if (jFieldNames:HasProperty(cPosition))
                lValid:=.F.
                exit
            endif
            jFieldNames[cPosition]:=cFieldName
        next
        aNames:=nil
    endif
    if (!lValid)
        self:cErrorCode:="INVALID_RESULT"
        self:cErrorMessage:="SQL query result does not match the keyed dataset contract."
        if (ValType(jFieldNames)=="J")
            FreeObj(@jFieldNames)
        endif
        FreeObj(@jResponse)
        return(.F.)
    endif

    if (lTyped)
        if (!DataSetTypedResult(jResponse,jPage,jFieldNames))
            self:cErrorCode:="INVALID_RESULT"
            self:cErrorMessage:="Typed SQL result does not match the version 2 dataset contract."
            FreeObj(@jFieldNames)
            FreeObj(@jResponse)
            return(.F.)
        endif
    endif

    // Own the complete response so nested JSON objects retain their lifetime.
    self:jResult:=jResponse
    self:jFieldNames:=jFieldNames
    self:nTotalRows:=jResponse["rowCount"]
    self:nTotalFields:=nFields
    self:nRowIndex:=IIf(self:nTotalRows>0,1,0)
    self:cAliasProfile:=cAliasProfile
    self:cSql:=cSql
    self:lTyped:=lTyped
    if (lTyped)
        self:jBindings:=JSONObject():New()
        HBBridge.Client.HBBridgeJSON():Parse(cBindings,self:jBindings)
    endif
    if (ValType(jPage)=="J")
        self:cOrderBy:=jPage["orderBy"]
    endif

return(.T.)

method OpenPage(cSql,nPage,nSize,cOrderBy) class HBBridgeRPCDataSet

    local jPage as json

    local lOpened:=.F. as logical

    paramtype 1 var cSql as character
    paramtype 2 var nPage as numeric
    paramtype 3 var nSize as numeric
    paramtype 4 var cOrderBy as character

    jPage:=JSONObject():New()
    jPage["number"]:=nPage
    jPage["size"]:=nSize
    jPage["orderBy"]:=cOrderBy

    lOpened:=self:OpenSQL(cSql,jPage)

    FreeObj(@jPage)

return(lOpened)

method OpenPageTyped(cSql,jBindings,nPage,nSize,cOrderBy) class HBBridgeRPCDataSet

    local jPage:=JSONObject():New() as json

    local lOpened:=.F. as logical

    paramtype 1 var cSql as character
    paramtype 3 var nPage as numeric
    paramtype 4 var nSize as numeric
    paramtype 5 var cOrderBy as character

    jPage["number"]:=nPage
    jPage["size"]:=nSize
    jPage["orderBy"]:=cOrderBy
    lOpened:=self:OpenSQLTyped(cSql,jBindings,jPage)
    FreeObj(@jPage)

return(lOpened)

method PreviousPage() class HBBridgeRPCDataSet

    local cSql as character
    local cOrderBy as character

    local jBindings as json

    local lOpened:=.F. as logical

    local nPage as numeric
    local nSize as numeric

    if (!self:HasPreviousPage())
        return(.F.)
    endif

    cSql:=self:cSql
    cOrderBy:=self:cOrderBy
    nPage:=(self:PageNumber()-1)
    nSize:=self:PageSize()

    if (self:lTyped)
        jBindings:=JSONObject():New()
        HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(self:jBindings),jBindings)
        lOpened:=self:OpenPageTyped(cSql,jBindings,nPage,nSize,cOrderBy)
        FreeObj(@jBindings)
        return(lOpened)
    endif

return(self:OpenPage(cSql,nPage,nSize,cOrderBy))

method HasPreviousPage() class HBBridgeRPCDataSet

    if (ValType(self:jResult)=="J").and.(self:jResult:HasProperty("page"))
        if (self:jResult["page"]:HasProperty("number"))
            return(self:jResult["page"]["number"]>1)
        endif
    endif

return(.F.)

method NextPage() class HBBridgeRPCDataSet

    local cSql as character
    local cOrderBy as character

    local jBindings as json

    local lOpened:=.F. as logical

    local nPage as numeric
    local nSize as numeric

    if (!self:HasNextPage())
        return(.F.)
    endif

    cSql:=self:cSql
    cOrderBy:=self:cOrderBy
    nPage:=(self:PageNumber()+1)
    nSize:=self:PageSize()

    if (self:lTyped)
        jBindings:=JSONObject():New()
        HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(self:jBindings),jBindings)
        lOpened:=self:OpenPageTyped(cSql,jBindings,nPage,nSize,cOrderBy)
        FreeObj(@jBindings)
        return(lOpened)
    endif

return(self:OpenPage(cSql,nPage,nSize,cOrderBy))

method HasNextPage() class HBBridgeRPCDataSet

    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("page")))
        if (self:jResult["page"]:HasProperty("hasNext"))
            return(self:jResult["page"]["hasNext"])
        endif
    endif

return(.F.)

method PageNumber() class HBBridgeRPCDataSet

    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("page")))
        if (self:jResult["page"]:HasProperty("number"))
            return(self:jResult["page"]["number"])
        endif
    endif

return(0)

method PageSize() class HBBridgeRPCDataSet

    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("page")))
        if self:jResult["page"]:HasProperty("size")
            return(self:jResult["page"]["size"])
        endif
    endif

return(0)

method HasTotals() class HBBridgeRPCDataSet

    if (ValType(self:jResult)=="J")
        return(!self:jResult:HasProperty("page").or.self:jResult:HasProperty("totalRows"))
    endif

return(.F.)

method TotalRows() as numeric class HBBridgeRPCDataSet

    if (ValType(self:jResult)=="J")
        if self:jResult:HasProperty("totalRows")
            return(self:jResult["totalRows"])
        endif
        if self:jResult:HasProperty("page")
            return(-1)
        endif
    endif

return(self:nTotalRows)

method TotalPages() as numeric class HBBridgeRPCDataSet

    if (ValType(self:jResult)=="J")
        if self:jResult:HasProperty("totalPages")
            return(self:jResult["totalPages"])
        endif
        if self:jResult:HasProperty("page")
            return(-1)
        endif
    endif

return(if(self:nTotalRows>0,1,0))

method MoreToRead() class HBBridgeRPCDataSet

    // Repeated calls keep the current record. Only an exhausted page can
    // fetch its successor; failures retain ErrorCode()/ErrorMessage().
    // False can mean end or failure: inspect ErrorCode() after the loop.
    if (self:Eof())
        if (!self:HasNextPage())
            return(.F.)
        endif
        if (!self:NextPage())
            return(.F.)
        endif
    endif

return(!self:Eof())

method Header() class HBBridgeRPCDataSet

    local jHeader:=JSONObject():New() as json

    // The caller owns this deep snapshot and releases it with FreeObj().
    if (ValType(self:jResult)=="J")
        HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(self:jResult["header"]), jHeader)
    endif

return(jHeader)

method FieldExist(cFieldName) class HBBridgeRPCDataSet

    local cKey as character

    paramtype 1 var cFieldName as character
    cKey:=Upper(AllTrim(cFieldName))

    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("header")))
        return(self:jResult["header"]:HasProperty(cKey))
    endif

return(.F.)

method FieldInfo(cFieldName) class HBBridgeRPCDataSet

    local cKey as character

    local jField:=JSONObject():New() as json

    paramtype 1 var cFieldName as character
    cKey:=Upper(AllTrim(cFieldName))

    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("header")))
        if (self:jResult["header"]:HasProperty(cKey))
            HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(self:jResult["header"][cKey]), jField)
        endif
    endif

return(jField)

method FieldCount() class HBBridgeRPCDataSet
return(self:nTotalFields)

method FieldName(nPosition) class HBBridgeRPCDataSet

    local cFieldNameKey as character

    paramtype 1 var nPosition as numeric

    if ((nPosition>=1).and.(nPosition<=self:nTotalFields).and.(nPosition==Int(nPosition)))
        cFieldNameKey:=tlpp.ToStr(nPosition)
        if (self:jFieldNames:HasProperty(cFieldNameKey))
            return(self:jFieldNames[cFieldNameKey])
        endif
    endif

return("")

method GetRow() class HBBridgeRPCDataSet

    local jRow:=JSONObject():New() as json

    if (!self:Eof())
        HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(self:jResult["rows"][tlpp.ToStr(self:nRowIndex)]), jRow)
    endif

return(jRow)

method GetRows() class HBBridgeRPCDataSet
    local jRows:=JSONObject():New() as json

    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("rows")))
        HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(self:jResult["rows"]), jRows)
    endif
return(jRows)

method GetOrderBy() class HBBridgeRPCDataSet
return(self:cOrderBy)

method FieldGet(cFieldName) class HBBridgeRPCDataSet

    local cKey as character
    local cRowKey as character

    if (self:Eof())
        return(nil)
    endif

    paramtype 1 var cFieldName as character

    cKey:=Upper(AllTrim(cFieldName))
    if ((self:jResult:HasProperty("header")).and.(self:jResult["header"]:HasProperty(cKey)))
        if (self:jResult:HasProperty("rows"))
            cRowKey:=tlpp.ToStr(self:nRowIndex)
            if ((self:jResult["rows"]:HasProperty(cRowKey)).and.(self:jResult["rows"][cRowKey]:HasProperty(cKey)))
                return(self:jResult["rows"][cRowKey][cKey])
            endif
        endif
    endif

return(nil)

method Skip() class HBBridgeRPCDataSet

    if (!self:Eof())
        self:nRowIndex++
    endif

return

method Eof() as logical class HBBridgeRPCDataSet
return((self:nRowIndex==0).or.(self:nRowIndex>self:nTotalRows))

method Close() class HBBridgeRPCDataSet

    local jResponse:=self:jResult as json
    local jFieldNames:=self:jFieldNames as json
    local jBindings:=self:jBindings as json

    self:jResult:=nil
    self:jFieldNames:=nil
    self:jBindings:=nil
    self:lTyped:=.F.
    self:nRowIndex:=0
    self:nTotalRows:=0
    self:nTotalFields:=0
    self:cSql:=""
    self:cOrderBy:=""
    self:cErrorCode:=""
    self:cErrorMessage:=""

    if (ValType(jResponse)=="J")
        FreeObj(@jResponse)
    endif

    if (ValType(jFieldNames)=="J")
        FreeObj(@jFieldNames)
    endif

    if (ValType(jBindings)=="J")
        FreeObj(@jBindings)
    endif

return

method RowCount() class HBBridgeRPCDataSet
return(self:nTotalRows)

method ErrorCode() class HBBridgeRPCDataSet
return(self:cErrorCode)

method ErrorMessage() class HBBridgeRPCDataSet
return(self:cErrorMessage)

method GetAliasProfile() class HBBridgeRPCDataSet
return(self:cAliasProfile)

method SetAliasProfile(cAliasProfile) class HBBridgeRPCDataSet
    local cLastAliasProfile:=self:cAliasProfile as character

    paramtype 1 var cAliasProfile as character
    if (!(cAliasProfile==cLastAliasProfile))
        self:Close()
    endif
    self:cAliasProfile:=cAliasProfile
return(cLastAliasProfile)

// JSONObject enumeration requires GetNames(). Keep records keyed and allocate
// each native names array once per validation boundary, not once per lookup.
static function DataSetTypedMembers(jValue as json,cAllowed as character,nExpected as numeric) as logical

    local aNames as array

    local lValid:=.T. as logical

    local nName:=0 as numeric
    local nNames:=0 as numeric

    if (ValType(jValue)!="J")
        return(.F.)
    endif
    aNames:=jValue:GetNames()
    nNames:=Len(aNames)
    lValid:=(nNames==nExpected)
    for nName:=1 to nNames
        if (("|" $ aNames[nName]).or.!("|"+aNames[nName]+"|" $ cAllowed))
            lValid:=.F.
            exit
        endif
    next
    aNames:=nil

return(lValid)

static function DataSetTypedInteger(xValue as variant,nMinimum as numeric,nMaximum as numeric) as logical

    if (ValType(xValue)!="N")
        return(.F.)
    endif
    if (!(xValue>=nMinimum).or.!(xValue<=nMaximum))
        return(.F.)
    endif

return(xValue==Int(xValue))

static function DataSetTypedNumber(xValue as variant) as logical

    local nMaximum:=1.7976931348623157*(10**308) as numeric

    if (ValType(xValue)!="N")
        return(.F.)
    endif

return((xValue==xValue).and.(xValue>=-nMaximum).and.(xValue<=nMaximum))

static function DataSetTypedDigits(cValue as character) as logical

    local nPosition:=0 as numeric
    local nLength:=Len(cValue) as numeric
    local nCode:=0 as numeric

    if (nLength==0)
        return(.F.)
    endif
    for nPosition:=1 to nLength
        nCode:=Asc(SubStr(cValue,nPosition,1))
        if ((nCode<48).or.(nCode>57))
            return(.F.)
        endif
    next

return(.T.)

static function DataSetTypedInt64(xValue as variant) as logical

    local cDigits:="" as character
    local cLimit:="9223372036854775807" as character

    local lNegative:=.F. as logical

    local nLength:=0 as numeric

    if (ValType(xValue)!="C")
        return(.F.)
    endif
    cDigits:=xValue
    lNegative:=(Left(cDigits,1)=="-")
    if (lNegative)
        cDigits:=SubStr(cDigits,2)
        cLimit:="9223372036854775808"
    endif
    nLength:=Len(cDigits)
    if (!DataSetTypedDigits(cDigits).or.(nLength>19))
        return(.F.)
    endif
    if ((nLength>1).and.(Left(cDigits,1)=="0"))
        return(.F.)
    endif
    if (lNegative.and.(cDigits=="0"))
        return(.F.)
    endif

return((nLength<19).or.(cDigits<=cLimit))

static function DataSetTypedDecimal(xValue as variant,nPrecision as numeric,nScale as numeric,lResult as logical) as logical

    local cDigits:="" as character
    local cInteger:="" as character
    local cFraction:="" as character

    local lNegative:=.F. as logical

    local nDot:=0 as numeric
    local nInteger:=0 as numeric
    local nFraction:=0 as numeric

    if (ValType(xValue)!="C")
        return(.F.)
    endif
    if (!DataSetTypedInteger(nPrecision,1,9007199254740991).or.;
        !DataSetTypedInteger(nScale,0,nPrecision))
        return(.F.)
    endif
    cDigits:=xValue
    lNegative:=(Left(cDigits,1)=="-")
    if (lNegative)
        cDigits:=SubStr(cDigits,2)
    endif
    nDot:=At(".",cDigits)
    if (nDot>0)
        cInteger:=Left(cDigits,nDot-1)
        cFraction:=SubStr(cDigits,nDot+1)
        if (!DataSetTypedDigits(cFraction))
            return(.F.)
        endif
    else
        cInteger:=cDigits
    endif
    if (!DataSetTypedDigits(cInteger))
        return(.F.)
    endif
    nInteger:=Len(cInteger)
    nFraction:=Len(cFraction)
    if ((nInteger>1).and.(Left(cInteger,1)=="0"))
        return(.F.)
    endif
    if (cInteger=="0")
        nInteger:=0
    endif
    if ((nInteger>nPrecision-nScale).or.(nFraction>nScale))
        return(.F.)
    endif
    if (lResult.and.(nFraction!=nScale))
        return(.F.)
    endif
    if (lNegative.and.Empty(StrTran(cInteger+cFraction,"0","")))
        return(.F.)
    endif

return(.T.)

static function DataSetTypedDate(xValue as variant) as logical

    local cDate:="" as character

    if (ValType(xValue)!="C")
        return(.F.)
    endif
    if ((Len(xValue)!=10).or.(SubStr(xValue,5,1)!="-").or.(SubStr(xValue,8,1)!="-"))
        return(.F.)
    endif
    cDate:=Left(xValue,4)+SubStr(xValue,6,2)+Right(xValue,2)
    if (!DataSetTypedDigits(cDate).or.(Left(cDate,4)=="0000"))
        return(.F.)
    endif

return(DToS(StoD(cDate))==cDate)

static function DataSetTypedBindings(jBindings as json,cFailure as character) as logical

    local aNames as array

    local cKey:="" as character
    local cType:="" as character
    local cMembers:="" as character

    local jBinding as json

    local lNull:=.F. as logical

    local nBinding:=0 as numeric
    local nBindings:=0 as numeric
    local nMembers:=0 as numeric
    local nMaximum:=9007199254740991 as numeric

    local xValue as variant

    cFailure:="INVALID_BINDINGS"
    if (ValType(jBindings)!="J")
        return(.F.)
    endif
    aNames:=jBindings:GetNames()
    nBindings:=Len(aNames)
    aNames:=nil
    for nBinding:=1 to nBindings
        cKey:=tlpp.ToStr(nBinding)
        if (!jBindings:HasProperty(cKey))
            return(.F.)
        endif
        jBinding:=jBindings[cKey]
        if (ValType(jBinding)!="J")
            return(.F.)
        endif
        if (!jBinding:HasProperty("type").or.!jBinding:HasProperty("isNull"))
            return(.F.)
        endif
        if ((ValType(jBinding["type"])!="C").or.(ValType(jBinding["isNull"])!="L"))
            return(.F.)
        endif
        cType:=jBinding["type"]
        if (!((cType=="text").or.(cType=="integer").or.(cType=="int64").or.;
            (cType=="number").or.(cType=="decimal").or.(cType=="boolean").or.(cType=="date")))
            cFailure:="UNSUPPORTED_BINDING_TYPE"
            return(.F.)
        endif
        lNull:=jBinding["isNull"]
        cMembers:="|type|isNull|"
        nMembers:=2
        if (!lNull)
            cMembers+="value|"
            nMembers++
        endif
        if (cType=="decimal")
            cMembers+="precision|scale|"
            nMembers+=2
        endif
        if (!DataSetTypedMembers(jBinding,cMembers,nMembers))
            return(.F.)
        endif
        if (cType=="decimal")
            if (!DataSetTypedInteger(jBinding["precision"],1,nMaximum))
                cFailure:="BINDING_RANGE_ERROR"
                return(.F.)
            endif
            if (!DataSetTypedInteger(jBinding["scale"],0,jBinding["precision"]))
                cFailure:="BINDING_RANGE_ERROR"
                return(.F.)
            endif
        endif
        if (lNull)
            loop
        endif
        xValue:=jBinding["value"]
        do case
        case cType=="text"
            if (ValType(xValue)!="C")
                return(.F.)
            endif
        case cType=="boolean"
            if (ValType(xValue)!="L")
                return(.F.)
            endif
        otherwise
            cFailure:="BINDING_RANGE_ERROR"
            do case
            case cType=="integer"
                if (!DataSetTypedInteger(xValue,-nMaximum,nMaximum))
                    return(.F.)
                endif
            case cType=="int64"
                if (!DataSetTypedInt64(xValue))
                    return(.F.)
                endif
            case cType=="number"
                if (!DataSetTypedNumber(xValue))
                    return(.F.)
                endif
            case cType=="decimal"
                if (!DataSetTypedDecimal(xValue,jBinding["precision"],jBinding["scale"],.F.))
                    return(.F.)
                endif
            case cType=="date"
                if (!DataSetTypedDate(xValue))
                    return(.F.)
                endif
            endcase
        endcase
        cFailure:="INVALID_BINDINGS"
    next

return(.T.)

static function DataSetTypedPage(jPage as json) as logical

    local cOrder:="" as character
    local cToken:="" as character
    local cColumn:="" as character
    local cDirection:="" as character
    local cChar:="" as character

    local nMaximum:=9007199254740991 as numeric
    local nComma:=0 as numeric
    local nSpace:=0 as numeric
    local nChar:=0 as numeric
    local nLength:=0 as numeric

    if (!DataSetTypedMembers(jPage,"|number|size|orderBy|",3))
        return(.F.)
    endif
    if (!DataSetTypedInteger(jPage["number"],1,nMaximum).or.;
        !DataSetTypedInteger(jPage["size"],1,nMaximum-1))
        return(.F.)
    endif
    if (jPage["number"]>Int((nMaximum-1)/jPage["size"]))
        return(.F.)
    endif
    if ((jPage["number"]*jPage["size"]+1)>nMaximum)
        return(.F.)
    endif
    if (ValType(jPage["orderBy"])!="C")
        return(.F.)
    endif
    cOrder:=AllTrim(jPage["orderBy"])
    if (Empty(cOrder))
        return(.F.)
    endif
    do while !Empty(cOrder)
        nComma:=At(",",cOrder)
        cToken:=AllTrim(IIf(nComma==0,cOrder,Left(cOrder,nComma-1)))
        nSpace:=At(" ",cToken)
        cColumn:=IIf(nSpace==0,cToken,Left(cToken,nSpace-1))
        cDirection:=IIf(nSpace==0,"ASC",Upper(AllTrim(SubStr(cToken,nSpace+1))))
        if (Empty(cColumn).or.!((cDirection=="ASC").or.(cDirection=="DESC")))
            return(.F.)
        endif
        nLength:=Len(cColumn)
        for nChar:=1 to nLength
            cChar:=Upper(SubStr(cColumn,nChar,1))
            if (!(cChar $ "ABCDEFGHIJKLMNOPQRSTUVWXYZ_"))
                if ((nChar==1).or.!(cChar $ "0123456789"))
                    return(.F.)
                endif
            endif
        next
        if (nComma==0)
            exit
        endif
        cOrder:=AllTrim(SubStr(cOrder,nComma+1))
        if (Empty(cOrder))
            return(.F.)
        endif
    enddo

return(.T.)

static function DataSetTypedMetadata(jField as json) as logical

    local aNames as array

    local cKey:="" as character
    local cType:="" as character
    local cJSONType:="" as character

    local jGroup as json

    local nName:=0 as numeric
    local nNames:=0 as numeric
    local nMaximum:=9007199254740991 as numeric

    local xValue as variant

    if (!DataSetTypedMembers(jField,"|position|rdd|source|wire|",4))
        return(.F.)
    endif
    jGroup:=jField["rdd"]
    if (!DataSetTypedMembers(jGroup,"|type|length|decimals|",3))
        return(.F.)
    endif
    if (!(ValType(jGroup["type"]) $ "CU"))
        return(.F.)
    endif
    if ((ValType(jGroup["length"])!="U").and.;
        !DataSetTypedInteger(jGroup["length"],0,nMaximum))
        return(.F.)
    endif
    if ((ValType(jGroup["decimals"])!="U").and.;
        !DataSetTypedInteger(jGroup["decimals"],0,nMaximum))
        return(.F.)
    endif
    jGroup:=jField["source"]
    if (!DataSetTypedMembers(jGroup,;
        "|typeCode|typeName|precision|precisionRadix|scale|characterLength|octetLength|nullable|catalog|schema|table|column|collation|",13))
        return(.F.)
    endif
    aNames:=jGroup:GetNames()
    nNames:=Len(aNames)
    for nName:=1 to nNames
        cKey:=aNames[nName]
        xValue:=jGroup[cKey]
        if (ValType(xValue)=="U")
            loop
        endif
        do case
        case cKey=="typeCode"
            if (!DataSetTypedInteger(xValue,-nMaximum,nMaximum))
                aNames:=nil
                return(.F.)
            endif
        case cKey=="precisionRadix"
            if (!DataSetTypedInteger(xValue,1,nMaximum))
                aNames:=nil
                return(.F.)
            endif
        case ("|"+cKey+"|") $ "|precision|scale|characterLength|octetLength|"
            if (!DataSetTypedInteger(xValue,0,nMaximum))
                aNames:=nil
                return(.F.)
            endif
        case cKey=="nullable"
            if (ValType(xValue)!="L")
                aNames:=nil
                return(.F.)
            endif
        otherwise
            if (ValType(xValue)!="C")
                aNames:=nil
                return(.F.)
            endif
        endcase
    next
    aNames:=nil
    jGroup:=jField["wire"]
    if (!DataSetTypedMembers(jGroup,"|kind|jsonType|encoding|",3))
        return(.F.)
    endif
    if ((ValType(jGroup["kind"])!="C").or.(ValType(jGroup["jsonType"])!="C"))
        return(.F.)
    endif
    cType:=jGroup["kind"]
    cJSONType:=jGroup["jsonType"]
    if ((cType=="text").or.(cType=="int64").or.(cType=="decimal").or.(cType=="date"))
        if ((cJSONType!="string").or.(ValType(jGroup["encoding"])!="C"))
            return(.F.)
        endif
        if (jGroup["encoding"]!="UTF-8")
            return(.F.)
        endif
    elseif ((cType=="integer").or.(cType=="number"))
        if ((cJSONType!="number").or.(ValType(jGroup["encoding"])!="U"))
            return(.F.)
        endif
    elseif (cType=="boolean")
        if ((cJSONType!="boolean").or.(ValType(jGroup["encoding"])!="U"))
            return(.F.)
        endif
    else
        return(.F.)
    endif
    if (cType=="decimal")
        jGroup:=jField["source"]
        if (!DataSetTypedInteger(jGroup["precision"],1,nMaximum))
            return(.F.)
        endif
        if (!DataSetTypedInteger(jGroup["scale"],0,jGroup["precision"]))
            return(.F.)
        endif
        if ((ValType(jGroup["precisionRadix"])!="N").or.(jGroup["precisionRadix"]!=10))
            return(.F.)
        endif
    endif

return(.T.)

static function DataSetTypedValue(xValue as variant,jField as json) as logical

    local cType:=jField["wire"]["kind"] as character

    if (ValType(xValue)=="U")
        // NULL may result from a join even when the source is nonnullable.
        return(.T.)
    endif
    do case
    case cType=="text"
        return(ValType(xValue)=="C")
    case cType=="integer"
        return(DataSetTypedInteger(xValue,-9007199254740991,9007199254740991))
    case cType=="int64"
        return(DataSetTypedInt64(xValue))
    case cType=="decimal"
        return(DataSetTypedDecimal(xValue,jField["source"]["precision"],jField["source"]["scale"],.T.))
    case cType=="number"
        return(DataSetTypedNumber(xValue))
    case cType=="boolean"
        return(ValType(xValue)=="L")
    case cType=="date"
        return(DataSetTypedDate(xValue))
    endcase

return(.F.)

static function DataSetTypedResult(jResult as json,jPage as json,jFieldNames as json) as logical

    local aNames as array

    local cField:="" as character
    local cKey:="" as character
    local cMembers:="|success|resultVersion|driver|header|rows|rowCount|totalRows|totalPages|" as character
    local cNul:=Chr(0) as character

    local jRow as json

    local nMembers:=8 as numeric
    local nFields:=0 as numeric
    local nField:=0 as numeric
    local nRows:=0 as numeric
    local nRow:=0 as numeric
    local nMaximum:=9007199254740991 as numeric

    if (ValType(jPage)=="J")
        cMembers+="page|"
        nMembers++
    endif
    if (!DataSetTypedMembers(jResult,cMembers,nMembers))
        return(.F.)
    endif
    if (ValType(jResult["driver"])!="C")
        return(.F.)
    endif
    if (Empty(jResult["driver"]).or.(cNul $ jResult["driver"]))
        return(.F.)
    endif
    if (!DataSetTypedInteger(jResult["rowCount"],0,nMaximum))
        return(.F.)
    endif
    nRows:=jResult["rowCount"]
    aNames:=jResult["rows"]:GetNames()
    nRow:=Len(aNames)
    aNames:=nil
    if (nRow!=nRows)
        return(.F.)
    endif
    aNames:=jFieldNames:GetNames()
    nFields:=Len(aNames)
    aNames:=nil
    for nField:=1 to nFields
        cField:=jFieldNames[tlpp.ToStr(nField)]
        if (Empty(cField).or.(cField!=Upper(AllTrim(cField))).or.(cNul $ cField))
            return(.F.)
        endif
        if (!DataSetTypedMetadata(jResult["header"][cField]))
            return(.F.)
        endif
    next
    if (ValType(jPage)=="J")
        if (!DataSetTypedMembers(jResult["page"],"|number|size|hasNext|firstRow|lastRow|",5))
            return(.F.)
        endif
    endif
    for nRow:=1 to nRows
        cKey:=tlpp.ToStr(nRow)
        jRow:=jResult["rows"][cKey]
        aNames:=jRow:GetNames()
        nField:=Len(aNames)
        aNames:=nil
        if (nField!=nFields)
            return(.F.)
        endif
        for nField:=1 to nFields
            cField:=jFieldNames[tlpp.ToStr(nField)]
            if (!jRow:HasProperty(cField))
                return(.F.)
            endif
            if (!DataSetTypedValue(jRow[cField],jResult["header"][cField]))
                return(.F.)
            endif
        next
    next

return(.T.)
