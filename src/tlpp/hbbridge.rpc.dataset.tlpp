#include "parmtype.ch"
#include "tlpp-core.th"

namespace HBBridge.RDD

class HBBridgeRPCDataSet

    private data cSql as character
    private data cOrderBy as character
    private data cErrorCode as character
    private data cErrorMessage as character
    private data cAliasProfile as character

    private data jResult as json
    private data jFieldNames as json

    private data oClient as object

    private data nRowIndex as numeric
    private data nTotalRows as numeric
    private data nTotalFields as numeric

    public method New(oClient as object) as object
    public method OpenSQL(cSql as character,jPage as json) as logical
    public method OpenPage(cSql as character,nPage as numeric,nSize as numeric,cOrderBy as character) as logical
    public method PreviousPage() as logical
    public method HasPreviousPage() as logical
    public method NextPage() as logical
    public method HasNextPage() as logical
    public method PageNumber() as numeric
    public method PageSize() as numeric
    public method HasTotals() as logical
    public method TotalRows() as numeric
    public method TotalPages() as numeric
    public method MoreToRead() as logical
    public method Header() as json
    public method FieldExist(cFieldName) as logical
    public method FieldInfo(cFieldName as character) as json
    public method FieldCount() as numeric
    public method FieldName(nPosition as numeric) as character
    public method GetRow() as json
    public method GetRows() as json
    public method GetOrderBy() as character
    public method FieldGet(cFieldName as character) as variant
    public method Skip()
    public method Eof() as logical
    public method Close()
    public method RowCount() as numeric
    public method ErrorCode() as character
    public method ErrorMessage() as character
    public method GetAliasProfile() as character
    public method SetAliasProfile(cAliasProfile) as character

endclass

method New(oClient) class HBBridgeRPCDataSet

    self:oClient:=oClient
    if (ValType(self:oClient)=="U")
        self:oClient:=HBBridge.Client.HBBridgeClient():New()
    endif
    self:jResult:=nil
    self:jFieldNames:=nil
    self:nRowIndex:=0
    self:nTotalRows:=0
    self:nTotalFields:=0
    self:cErrorCode:=""
    self:cErrorMessage:=""
    self:cAliasProfile:=""
    self:cSql:=""
    self:cOrderBy:=""

return(self)

method OpenSQL(cSql,jPage) class HBBridgeRPCDataSet

    local aNames as array

    local cRowKey:="" as character
    local cPosition:="" as character
    local cFieldName:="" as character
    local cAliasProfile:=self:cAliasProfile as character

    local jParams:=JSONObject():New() as json
    local jResponse as json
    local jFieldNames as json

    local lValid:=.F. as logical

    local nRow:=0 as numeric
    local nField:=0 as numeric
    local nFields:=0 as numeric
    local nPosition:=0 as numeric
    local nExpectedPages:=0 as numeric

    paramtype 1 var cSql as character
    paramtype 2 var jPage as json optional

    self:Close()
    self:cAliasProfile:=cAliasProfile
    if (ValType(jPage)=="J")
        lValid:=jPage:HasProperty("number").and.jPage:HasProperty("size").and.jPage:HasProperty("orderBy")
        if (lValid)
            lValid:=(ValType(jPage["number"])=="N").and.(ValType(jPage["size"])=="N").and.(ValType(jPage["orderBy"])=="C")
        endif
        if (lValid)
            lValid:=(jPage["number"]>=1).and.(jPage["number"]==Int(jPage["number"])).and.;
                (jPage["size"]>=1).and.(jPage["size"]==Int(jPage["size"])).and.!Empty(AllTrim(jPage["orderBy"]))
        endif
        if (!lValid)
            self:cErrorCode:="INVALID_PAGE"
            self:cErrorMessage:="Page requires a positive integer number and size and a nonempty orderBy."
            FreeObj(@jParams)
            return(.F.)
        endif
    endif
    lValid:=.F.
    jParams["alias"]:=self:cAliasProfile
    jParams["sql"]:=cSql
    if (ValType(jPage)=="J")
        jParams["page"]:=jPage
    endif
    jResponse:=self:oClient:CallService("RPCRDD.Query",jParams)
    FreeObj(@jParams)

    if (ValType(jResponse)!="J")
        self:cErrorCode:="INVALID_RESULT"
        self:cErrorMessage:="SQL query result does not match the keyed dataset contract."
        return(.F.)
    endif

    if (jResponse:HasProperty("success"))
        if (ValType(jResponse["success"])=="L")
            lValid:=jResponse["success"]
        endif
    endif

    if (!lValid)
        self:cErrorCode:="QUERY_FAILED"
        self:cErrorMessage:="SQL query failed."
        if (jResponse:HasProperty("code"))
            if (ValType(jResponse["code"])=="C")
                self:cErrorCode:=jResponse["code"]
            endif
        endif
        if (jResponse:HasProperty("error"))
            if (ValType(jResponse["error"])=="C")
                self:cErrorMessage:=jResponse["error"]
            endif
        endif
        FreeObj(@jResponse)
        return(.F.)
    endif

    lValid:=(;
        jResponse:HasProperty("header");
        .and. jResponse:HasProperty("rows");
        .and. jResponse:HasProperty("rowCount");
        .and. jResponse:HasProperty("resultVersion");
    )

    if (lValid)
        lValid:=(;
            (ValType(jResponse["header"])=="J");
            .and. (ValType(jResponse["rows"])=="J");
            .and. (ValType(jResponse["rowCount"])=="N");
            .and. (ValType(jResponse["resultVersion"])=="N");
        )
    endif
    if (lValid)
        lValid:=(;
            (jResponse["resultVersion"]==1);
            .and. (jResponse["rowCount"]>=0);
            .and. (jResponse["rowCount"]==Int(jResponse["rowCount"]));
        )
    endif
    if (lValid)
        if (ValType(jPage)=="J")
            lValid:=jResponse:HasProperty("page")
            if (lValid)
                lValid:=(ValType(jResponse["page"])=="J")
            endif
            if (lValid)
                lValid:=(;
                    jResponse["page"]:HasProperty("number");
                    .and. jResponse["page"]:HasProperty("size");
                    .and. jResponse["page"]:HasProperty("hasNext");
                    .and. jResponse["page"]:HasProperty("firstRow");
                    .and. jResponse["page"]:HasProperty("lastRow");
                )
            endif
            if (lValid)
                lValid:=(;
                    (ValType(jResponse["page"]["number"])=="N");
                    .and. (ValType(jResponse["page"]["size"])=="N");
                    .and. (ValType(jResponse["page"]["hasNext"])=="L");
                    .and. (ValType(jResponse["page"]["firstRow"])=="N");
                    .and. (ValType(jResponse["page"]["lastRow"])=="N");
                )
            endif
            if (lValid)
                lValid:=(;
                    (jResponse["page"]["number"]==jPage["number"]);
                    .and. (jResponse["page"]["size"]==jPage["size"]);
                    .and. (jResponse["rowCount"]<=jPage["size"]);
                )
            endif
            if (lValid)
                lValid:=((!jResponse["page"]["hasNext"]) .or. (jResponse["rowCount"]==jPage["size"]))
                if (jResponse["rowCount"]==0)
                    lValid:=(;
                        (lValid);
                        .and. (jResponse["page"]["firstRow"]==0);
                        .and. (jResponse["page"]["lastRow"]==0);
                    )
                else
                    lValid:=(;
                        (lValid);
                        .and. (jResponse["page"]["firstRow"]==(jPage["number"]-1)*jPage["size"]+1);
                        .and. (jResponse["page"]["lastRow"]==jResponse["page"]["firstRow"]+jResponse["rowCount"]-1);
                    )
                endif
            endif
        endif
    endif
    if (lValid)
        if (ValType(jPage)!="J")
            lValid:=!jResponse:HasProperty("page")
        endif
    endif
    if (lValid)
        if (jResponse:HasProperty("totalRows").or.jResponse:HasProperty("totalPages"))
            lValid:=jResponse:HasProperty("totalRows").and.jResponse:HasProperty("totalPages")
            if (lValid)
                lValid:=(ValType(jResponse["totalRows"])=="N").and.(ValType(jResponse["totalPages"])=="N")
            endif
            if (lValid)
                lValid:=(jResponse["totalRows"]>=0).and.(jResponse["totalRows"]<=9007199254740991).and.;
                    (jResponse["totalRows"]==Int(jResponse["totalRows"])).and.;
                    (jResponse["totalPages"]>=0).and.(jResponse["totalPages"]<=9007199254740991).and.;
                    (jResponse["totalPages"]==Int(jResponse["totalPages"]))
            endif
            if (lValid)
                if (ValType(jPage)=="J")
                    nExpectedPages:=Int(jResponse["totalRows"]/jPage["size"])+IIf(Mod(jResponse["totalRows"],jPage["size"])==0,0,1)
                else
                    nExpectedPages:=IIf(jResponse["rowCount"]>0,1,0)
                    lValid:=(jResponse["totalRows"]==jResponse["rowCount"])
                endif
                lValid:=lValid.and.(jResponse["totalPages"]==nExpectedPages)
            endif
        endif
    endif
    if (lValid)
        for nRow:=1 to jResponse["rowCount"]
            cRowKey:=tlpp.ToStr(nRow)
            if (!jResponse["rows"]:HasProperty(cRowKey))
                lValid:=.F.
                exit
            endif
            if (ValType(jResponse["rows"][cRowKey])!="J")
                lValid:=.F.
                exit
            endif
        next
    endif
    if (lValid)
        jFieldNames:=JSONObject():New()
        // GetNames() requires an array. Allocate it once per open,then cache
        // ordinal keys in JSON to avoid repeated copies,sorting or searches.
        aNames:=jResponse["header"]:GetNames()
        nFields:=Len(aNames)
        for nField:=1 to nFields
            cFieldName:=aNames[nField]
            if (ValType(jResponse["header"][cFieldName])!="J")
                lValid:=.F.
                exit
            endif
            if (!jResponse["header"][cFieldName]:HasProperty("position"))
                lValid:=.F.
                exit
            endif
            if (ValType(jResponse["header"][cFieldName]["position"])!="N")
                lValid:=.F.
                exit
            endif
            nPosition:=jResponse["header"][cFieldName]["position"]
            if ((nPosition<1).or.(nPosition>nFields).or.(nPosition!=Int(nPosition)))
                lValid:=.F.
                exit
            endif
            cPosition:=tlpp.ToStr(nPosition)
            if (jFieldNames:HasProperty(cPosition))
                lValid:=.F.
                exit
            endif
            jFieldNames[cPosition]:=cFieldName
        next
        aNames:=nil
    endif
    if (!lValid)
        self:cErrorCode:="INVALID_RESULT"
        self:cErrorMessage:="SQL query result does not match the keyed dataset contract."
        if (ValType(jFieldNames)=="J")
            FreeObj(@jFieldNames)
        endif
        FreeObj(@jResponse)
        return(.F.)
    endif

    // Own the complete response so nested JSON objects retain their lifetime.
    self:jResult:=jResponse
    self:jFieldNames:=jFieldNames
    self:nTotalRows:=jResponse["rowCount"]
    self:nTotalFields:=nFields
    self:nRowIndex:=IIf(self:nTotalRows>0,1,0)
    self:cAliasProfile:=cAliasProfile
    self:cSql:=cSql
    if (ValType(jPage)=="J")
        self:cOrderBy:=jPage["orderBy"]
    endif

return(.T.)

method OpenPage(cSql,nPage,nSize,cOrderBy) class HBBridgeRPCDataSet

    local jPage as json
    local lOpened:=.F. as logical

    paramtype 1 var cSql as character
    paramtype 2 var nPage as numeric
    paramtype 3 var nSize as numeric
    paramtype 4 var cOrderBy as character

    jPage:=JSONObject():New()
    jPage["number"]:=nPage
    jPage["size"]:=nSize
    jPage["orderBy"]:=cOrderBy

    lOpened:=self:OpenSQL(cSql,jPage)

    FreeObj(@jPage)

return(lOpened)

method PreviousPage() class HBBridgeRPCDataSet

    local cSql as character
    local cOrderBy as character
    local nPage as numeric
    local nSize as numeric

    if (!self:HasPreviousPage())
        return(.F.)
    endif

    cSql:=self:cSql
    cOrderBy:=self:cOrderBy
    nPage:=(self:PageNumber()-1)
    nSize:=self:PageSize()

return(self:OpenPage(cSql,nPage,nSize,cOrderBy))

method HasPreviousPage() class HBBridgeRPCDataSet

    if (ValType(self:jResult)=="J").and.(self:jResult:HasProperty("page"))
        if (self:jResult["page"]:HasProperty("number"))
            return(self:jResult["page"]["number"]>1)
        endif
    endif

return(.F.)

method NextPage() class HBBridgeRPCDataSet

    local cSql as character
    local cOrderBy as character
    local nPage as numeric
    local nSize as numeric

    if (!self:HasNextPage())
        return(.F.)
    endif

    cSql:=self:cSql
    cOrderBy:=self:cOrderBy
    nPage:=(self:PageNumber()+1)
    nSize:=self:PageSize()

return(self:OpenPage(cSql,nPage,nSize,cOrderBy))

method HasNextPage() class HBBridgeRPCDataSet

    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("page")))
        if (self:jResult["page"]:HasProperty("hasNext"))
            return(self:jResult["page"]["hasNext"])
        endif
    endif

return(.F.)

method PageNumber() class HBBridgeRPCDataSet

    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("page")))
        if (self:jResult["page"]:HasProperty("number"))
            return(self:jResult["page"]["number"])
        endif
    endif

return(0)

method PageSize() class HBBridgeRPCDataSet

    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("page")))
        if self:jResult["page"]:HasProperty("size")
            return(self:jResult["page"]["size"])
        endif
    endif

return(0)

method HasTotals() class HBBridgeRPCDataSet

    if (ValType(self:jResult)=="J")
        return(!self:jResult:HasProperty("page").or.self:jResult:HasProperty("totalRows"))
    endif

return(.F.)

method TotalRows() as numeric class HBBridgeRPCDataSet

    if (ValType(self:jResult)=="J")
        if self:jResult:HasProperty("totalRows")
            return(self:jResult["totalRows"])
        endif
        if self:jResult:HasProperty("page")
            return(-1)
        endif
    endif

return(self:nTotalRows)

method TotalPages() as numeric class HBBridgeRPCDataSet

    if (ValType(self:jResult)=="J")
        if self:jResult:HasProperty("totalPages")
            return(self:jResult["totalPages"])
        endif
        if self:jResult:HasProperty("page")
            return(-1)
        endif
    endif

return(if(self:nTotalRows>0,1,0))

method MoreToRead() class HBBridgeRPCDataSet

    // Repeated calls keep the current record. Only an exhausted page can
    // fetch its successor; failures retain ErrorCode()/ErrorMessage().
    // False can mean end or failure: inspect ErrorCode() after the loop.
    if (self:Eof())
        if (!self:HasNextPage())
            return(.F.)
        endif
        if (!self:NextPage())
            return(.F.)
        endif
    endif

return(!self:Eof())

method Header() class HBBridgeRPCDataSet

    local jHeader:=JSONObject():New() as json

    // The caller owns this deep snapshot and releases it with FreeObj().
    if (ValType(self:jResult)=="J")
        HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(self:jResult["header"]), jHeader)
    endif

return(jHeader)

method FieldExist(cFieldName) class HBBridgeRPCDataSet

    local cKey as character

    paramtype 1 var cFieldName as character
    cKey:=Upper(AllTrim(cFieldName))

    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("header")))
        return(self:jResult["header"]:HasProperty(cKey))
    endif

return(.F.)

method FieldInfo(cFieldName) class HBBridgeRPCDataSet

    local cKey as character

    local jField:=JSONObject():New() as json

    paramtype 1 var cFieldName as character
    cKey:=Upper(AllTrim(cFieldName))

    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("header")))
        if (self:jResult["header"]:HasProperty(cKey))
            HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(self:jResult["header"][cKey]), jField)
        endif
    endif

return(jField)

method FieldCount() class HBBridgeRPCDataSet
return(self:nTotalFields)

method FieldName(nPosition) class HBBridgeRPCDataSet

    local cFieldNameKey as character

    paramtype 1 var nPosition as numeric

    if ((nPosition>=1).and.(nPosition<=self:nTotalFields).and.(nPosition==Int(nPosition)))
        cFieldNameKey:=tlpp.ToStr(nPosition)
        if (self:jFieldNames:HasProperty(cFieldNameKey))
            return(self:jFieldNames[cFieldNameKey])
        endif
    endif

return("")

method GetRow() class HBBridgeRPCDataSet

    local jRow:=JSONObject():New() as json

    if (!self:Eof())
        HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(self:jResult["rows"][tlpp.ToStr(self:nRowIndex)]), jRow)
    endif

return(jRow)

method GetRows() class HBBridgeRPCDataSet
    local jRows:=JSONObject():New() as json
    if ((ValType(self:jResult)=="J").and.(self:jResult:HasProperty("rows")))
        HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(self:jResult["rows"]), jRows)
    endif
return(jRows)

method GetOrderBy() class HBBridgeRPCDataSet
return(self:cOrderBy)

method FieldGet(cFieldName) class HBBridgeRPCDataSet

    local cKey as character
    local cRowKey as character

    if (self:Eof())
        return(nil)
    endif

    paramtype 1 var cFieldName as character

    cKey:=Upper(AllTrim(cFieldName))
    if ((self:jResult:HasProperty("header")).and.(self:jResult["header"]:HasProperty(cKey)))
        if (self:jResult:HasProperty("rows"))
            cRowKey:=tlpp.ToStr(self:nRowIndex)
            if ((self:jResult["rows"]:HasProperty(cRowKey)).and.(self:jResult["rows"][cRowKey]:HasProperty(cKey)))
                return(self:jResult["rows"][cRowKey][cKey])
            endif
        endif
    endif

return(nil)

method Skip() class HBBridgeRPCDataSet

    if (!self:Eof())
        self:nRowIndex++
    endif

return

method Eof() as logical class HBBridgeRPCDataSet
return((self:nRowIndex==0).or.(self:nRowIndex>self:nTotalRows))

method Close() class HBBridgeRPCDataSet

    local jResponse:=self:jResult as json
    local jFieldNames:=self:jFieldNames as json

    self:jResult:=nil
    self:jFieldNames:=nil
    self:nRowIndex:=0
    self:nTotalRows:=0
    self:nTotalFields:=0
    self:cSql:=""
    self:cOrderBy:=""
    self:cErrorCode:=""
    self:cErrorMessage:=""

    if (ValType(jResponse)=="J")
        FreeObj(@jResponse)
    endif

    if (ValType(jFieldNames)=="J")
        FreeObj(@jFieldNames)
    endif

return

method RowCount() class HBBridgeRPCDataSet
return(self:nTotalRows)

method ErrorCode() class HBBridgeRPCDataSet
return(self:cErrorCode)

method ErrorMessage() class HBBridgeRPCDataSet
return(self:cErrorMessage)

method GetAliasProfile() class HBBridgeRPCDataSet
return(self:cAliasProfile)

method SetAliasProfile(cAliasProfile) class HBBridgeRPCDataSet
    local cLastAliasProfile:=self:cAliasProfile as character
    paramtype 1 var cAliasProfile as character
    if (!(cAliasProfile==cLastAliasProfile))
        self:Close()
    endif
    self:cAliasProfile:=cAliasProfile
return(cLastAliasProfile)
