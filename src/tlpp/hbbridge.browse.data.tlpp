#include "parmtype.ch"
#include "directry.ch"
#include "dbstruct.ch"
#include "tlpp-core.th"

namespace HBBridge.Client
using namespace HBBridge.SQL.Tools

class HBBridgeBrowseData
    static method Browse(oHBBridgeDataSet as object,cHBBridgeDataSetSQL as character,jHBBridgeDataSetPage as json,/*@*/oFWBrowse as object,/*@*/aFWBrwData as array,cTitle as character,bLDblClick as codeblock,bCustomHeaderClick as codeblock,aCustomButtons as array) as variant
end class

static method Browse(oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,/*@*/oFWBrowse,/*@*/aFWBrwData,cTitle,bLDblClick,bCustomHeaderClick,aCustomButtons) class HBBridgeBrowseData
    paramtype 1 var oHBBridgeDataSet as object
    paramtype 2 var cHBBridgeDataSetSQL as character
    paramtype 3 var jHBBridgeDataSetPage as json optional
    paramtype 4 var oFWBrowse as object optional
    paramtype 5 var aFWBrwData as array optional
    paramtype 6 var cTitle as character
    paramtype 7 var bLDblClick as block optional default {|oSelf|}
    paramtype 8 var bCustomHeaderClick as block optional default {|oSelf|}
    paramtype 9 var aCustomButtons as array optional default array(0)
return(Browse(oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,/*@*/@oFWBrowse,/*@*/@aFWBrwData,cTitle,bLDblClick,bCustomHeaderClick,aCustomButtons))

static function Browse(oHBBridgeDataSet as object,cHBBridgeDataSetSQL as character,jHBBridgeDataSetPage as json,/*@*/oFWBrowse as object,/*@*/aFWBrwData as array,cTitle as character,bLDblClick as codeblock,bCustomHeaderClick as codeblock,aCustomButtons as array) as variant

    local aHeader as array
    local aFWBrwSeek as array
    local aFWBrwModel as array
    local aFWBrwColumn as array
    local aFWBrowseSeek as array

    local aFWGetDialogSizeCoors as array

    local bNext as codeblock
    local bLast as codeblock
    local bFirst as codeblock
    local bFilter as codeblock
    local bPrevius as codeblock
    local bUpdateData as codeblock

    local cFilterExpr:="(1=1)" as character
    local cField as character
    local cFieldTitle as character
    local cFieldPicture as character
    local cFieldType as character

    local jHeader as json

    local lRedefineBottom:=(((Type("__lRedefineBottom")=="L").and.(__lRedefineBottom)).or.FWIsInCallStack("UF.EXECUTE").or.FwIsInCallStack("DNA.TECH.EXECUTE")) as logical
    local lHBBridgeDataSetPage:=(ValType(jHBBridgeDataSetPage)=="J")

    local nField,nFields as numeric
    local nButton,nButtons as numeric
    local nFieldLen,nFieldDec as numeric

    local oPanelMain as object
    local oFWDialogModal as object

    begin sequence

        // The native browse requires an array. It contains independent JSON
        // row snapshots for the current page only, not another query cache.
        aFWBrwData:=BrowseGetData(oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,"all",cFilterExpr)
        if (ValType(aFWBrwData)!="A")
            BrowseQueryError(oHBBridgeDataSet)
            break
        endif
        if (Empty(aFWBrwData))
            break
        endif

        aFWBrwModel:=array(0)
        aFWBrwColumn:=array(0)
        aFWBrowseSeek:=array(0)

        aFWGetDialogSizeCoors:=FWGetDialogSize()

        jHeader:=oHBBridgeDataSet:Header()
        nFields:=oHBBridgeDataSet:FieldCount()
        aHeader:=Array(nFields)
        for nField:=1 to nFields
            aHeader[nField]:=oHBBridgeDataSet:FieldName(nField)
        next nField
        for nField:=1 to nFields
            cField:=aHeader[nField]
            // SX3 is resolved by this Protheus presentation adapter only.
            cFieldTitle:=GetSX3Cache(cField,"X3_TITULO")
            if (Empty(cFieldTitle))
                cFieldTitle:=cField
            endif
            cFieldPicture:=GetSX3Cache(cField,"X3_PICTURE")
            nFieldLen:=GetSX3Cache(cField,"X3_TAMANHO")
            if (Empty(nFieldLen))
                nFieldLen:=jHeader[cField]["length"]
            endif
            nFieldDec:=GetSX3Cache(cField,"X3_DECIMAL")
            if (Empty(nFieldDec))
                nFieldDec:=0
            endif
            cFieldType:=GetSX3Cache(cField,"X3_TIPO")
            if (Empty(cFieldType))
                cFieldType:=__GetFieldType(jHeader[cField]["type"])
            endif
            if ((Empty(cFieldPicture)).and.(cFieldType=="N"))
                // Build the picture from logical metadata, not a synthetic
                // large floating-point value that can round its decimals.
                cFieldPicture:=Replicate("9",Max(1,nFieldLen-if(nFieldDec>0,nFieldDec+1,0)))
                if (nFieldDec>0)
                    cFieldPicture+="."+Replicate("9",nFieldDec)
                endif
            endif
            aAdd(aFWBrwModel,{cFieldTitle,cFieldPicture,nFieldLen,nFieldDec,1,cFieldType})
        next nField

        nFields:=Len(aFWBrwModel)
        for nField:=1 to nFields

            aAdd(aFWBrwColumn,FWBrwColumn():New())

            cField:=aHeader[nField]
            if (aFWBrwModel[nField][6]=="D")
                aFWBrwColumn[nField]:SetData(&('{|oSelf|SToD(aFWBrwData[oFWBrowse:nAT]["'+cField+'"])}'))
            elseif (aFWBrwModel[nField][6]=="C")//TODO: resolver Code Pages and Collations
                aFWBrwColumn[nField]:SetData(&('{|oSelf|OemToAnsi(aFWBrwData[oFWBrowse:nAT]["'+cField+'"])}'))
            else
                aFWBrwColumn[nField]:SetData(&('{|oSelf|aFWBrwData[oFWBrowse:nAT]["'+cField+'"]}'))
            endif
            aFWBrwColumn[nField]:SetTitle(aFWBrwModel[nField][1])
            aFWBrwColumn[nField]:SetType(aFWBrwModel[nField][6])
            aFWBrwColumn[nField]:SetPicture(aFWBrwModel[nField][2])
            aFWBrwColumn[nField]:SetSize(aFWBrwModel[nField][3])
            aFWBrwColumn[nField]:SetDecimal(aFWBrwModel[nField][4])
            aFWBrwColumn[nField]:SetAlign(aFWBrwModel[nField][5])

            aFWBrwSeek:={;
                aFWBrwModel[nField][1];//[n,1] Titulo da pesquisa
                ,{;
                    {;
                        GetSX3Cache(cField,"X3_F3");//[n,2,n,1] LookUp (F3)
                        ,aFWBrwModel[nField][6];//[n,2,n,2] Tipo de dados
                        ,aFWBrwModel[nField][3];//[n,2,n,3] Tamanho
                        ,aFWBrwModel[nField][4];//[n,2,n,4] Decimal
                        ,aFWBrwModel[nField][1];//[n,2,n,5] Titulo do campo
                        ,aFWBrwModel[nField][2];//[n,2,n,6] Mascara
                        ,cField;//[n,2,n,7] Nome Fisico do campo
                    };
                };
                ,nField;//Ordem da pesquisa
                ,.T.;
            }

            aAdd(aFWBrowseSeek,aClone(aFWBrwSeek))
            FWFReeArray(@aFWBrwSeek)

        next nField

        oFWBrowse:=FWBrowse():New()

        oFWBrowse:SetDataArray()
        oFWBrowse:SetArray(aFWBrwData)
        oFWBrowse:SetColumns(aFWBrwColumn)
        oFWBrowse:SetSeek({|oSelf,oFWBrowse|__FWBrowseSeek(oSelf,oFWBrowse,@aFWBrwData,oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,cFilterExpr)},aFWBrowseSeek)
        oFWBrowse:DisableFilter()

        if (valtype(bLDblClick)!="B")
            bLDblClick:={|oSelf|}
        endif
        oFWBrowse:SetDoubleClick(bLDblClick)

        if (valType(bCustomHeaderClick)!="B")
            bCustomHeaderClick:={|oSelf|}
        endif
        oFWBrowse:bCustomHeaderClick:=bCustomHeaderClick

        //https://tdn.totvs.com/display/public/framework/FwDialogModal
        oFWDialogModal:=FWDialogModal():New()
        oFWDialogModal:SetTitle(cTitle)
        oFWDialogModal:SetEscClose(.F.)
        oFWDialogModal:SetSize(aFWGetDialogSizeCoors[3]/(2+if(lRedefineBottom,.15,0)),aFWGetDialogSizeCoors[4]/2)
        oFWDialogModal:CreateDialog()
        oFWDialogModal:EnableFormBar(.T.)
        oFWDialogModal:CreateFormBar()

        oPanelMain:=oFWDialogModal:GetPanelMain()
        oFWBrowse:SetOwner(oPanelMain)

        FWMsgRun(;
            nil,;
            {||oFWBrowse:Activate()},;
            cTitle,;
            "Opening the browse...";
        )

        /*
            FWDialogModal:AddButton
            estrutura:
            [n]
            [n][1] cTitle Titulo do Botao
            [n][2] bBloco Bloco de codigo que sera executado
            [n][3] cToolTip Comentario do botao
            [n][4] nShortCut Tecla para se criar o ShortCurt
            [n][5] lShowBar Indica que o botao estara visivel na barra
            [n][6] lConfig Indica se botao estara visivel na configuracao
            [n][7] ?
        */
        oFWDialogModal:AddButton(;
            "&Close",;//[n][1] cTitle Titulo do Botao
            {|oBrwButton|oFWDialogModal:DeActivate(.T./*lFreeChildren*/)},;//[n][2] bBloco Bloco de codigo que sera executado
            "Close",;//[n][3] cToolTip Comentario do botao
            nil,;//[n][4] nShortCut Tecla para se criar o ShortCurt
            .T.,;//[n][5] lShowBar Indica que o botao estara visivel na barra
            .F.,;//[n][6] lConfig Indica se botao estara visivel na configuracao
            .T.;//[n][7] ?
        )

        bUpdateData:={|oBrwButton|;
            MsgRun(;
                cTitle,;
                "Updating. Please wait...",;
                {||BrowseCallBack(oFWBrowse,@aFWBrwData,oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,"all",cFilterExpr)};
            );
        }

        oFWDialogModal:AddButton(;
            "&Refresh",;//[n][1] cTitle Titulo do Botao
                bUpdateData,;//[n][2] bBloco Bloco de codigo que sera executado
                "Refresh",;//[n][3] cToolTip Comentario do botao
                nil,;//[n][4] nShortCut Tecla para se criar o ShortCurt
                .T.,;//[n][5] lShowBar Indica que o botao estara visivel na barra
                .F.,;//[n][6] lConfig Indica se botao estara visivel na configuracao
                .T.;//[n][7] ?
            )

        bFilter:={|oBrwButton|;
            MsgRun(;
                cTitle,;
                "Updating. Please wait...",;
                {||;
                    BrowseFilter(oFWBrowse,@aFWBrwData,oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,@cFilterExpr);
                };
            );
        }

        oFWDialogModal:AddButton(;
            "&Filter",;//[n][1] cTitle Titulo do Botao
                bFilter,;//[n][2] bBloco Bloco de codigo que sera executado
                "Filter",;//[n][3] cToolTip Comentario do botao
                nil,;//[n][4] nShortCut Tecla para se criar o ShortCurt
                .T.,;//[n][5] lShowBar Indica que o botao estara visivel na barra
                .F.,;//[n][6] lConfig Indica se botao estara visivel na configuracao
                .T.;//[n][7] ?
            )

        if (lHBBridgeDataSetPage)

            bFirst:={|oBrwButton|;
                MsgRun(;
                    cTitle,;
                    "Updating. Please wait...",;
                    {||BrowseCallBack(oFWBrowse,@aFWBrwData,oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,"first",cFilterExpr)};
                );
            }

            oFWDialogModal:AddButton(;
                "< &First",;//[n][1] cTitle Titulo do Botao
                    bFirst,;//[n][2] bBloco Bloco de codigo que sera executado
                    "First",;//[n][3] cToolTip Comentario do botao
                    nil,;//[n][4] nShortCut Tecla para se criar o ShortCurt
                    .T.,;//[n][5] lShowBar Indica que o botao estara visivel na barra
                    .F.,;//[n][6] lConfig Indica se botao estara visivel na configuracao
                    .T.;//[n][7] ?
                )

            bPrevius:={|oBrwButton|;
                MsgRun(;
                    cTitle,;
                    "Updating. Please wait...",;
                    {||BrowseCallBack(oFWBrowse,@aFWBrwData,oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,"previous",cFilterExpr)};
                );
            }

            oFWDialogModal:AddButton(;
                "&<< Previous",;//[n][1] cTitle Titulo do Botao
                    bPrevius,;//[n][2] bBloco Bloco de codigo que sera executado
                    "Previous",;//[n][3] cToolTip Comentario do botao
                    nil,;//[n][4] nShortCut Tecla para se criar o ShortCurt
                    .T.,;//[n][5] lShowBar Indica que o botao estara visivel na barra
                    .F.,;//[n][6] lConfig Indica se botao estara visivel na configuracao
                    .T.;//[n][7] ?
                )

            bNext:={|oBrwButton|;
                MsgRun(;
                    cTitle,;
                    "Updating. Please wait...",;
                    {||BrowseCallBack(oFWBrowse,@aFWBrwData,oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,"next",cFilterExpr)};
                );
            }

            oFWDialogModal:AddButton(;
                "&>> Next",;//[n][1] cTitle Titulo do Botao
                    bNext,;//[n][2] bBloco Bloco de codigo que sera executado
                    "Next",;//[n][3] cToolTip Comentario do botao
                    nil,;//[n][4] nShortCut Tecla para se criar o ShortCurt
                    .T.,;//[n][5] lShowBar Indica que o botao estara visivel na barra
                    .F.,;//[n][6] lConfig Indica se botao estara visivel na configuracao
                    .T.;//[n][7] ?
                )

            bLast:={|oBrwButton|;
                MsgRun(;
                    cTitle,;
                    "Updating. Please wait...",;
                    {||BrowseCallBack(oFWBrowse,@aFWBrwData,oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,"last",cFilterExpr)};
                );
            }

            oFWDialogModal:AddButton(;
                "> &Last",;//[n][1] cTitle Titulo do Botao
                    bLast,;//[n][2] bBloco Bloco de codigo que sera executado
                    "Last",;//[n][3] cToolTip Comentario do botao
                    nil,;//[n][4] nShortCut Tecla para se criar o ShortCurt
                    .T.,;//[n][5] lShowBar Indica que o botao estara visivel na barra
                    .F.,;//[n][6] lConfig Indica se botao estara visivel na configuracao
                    .T.;//[n][7] ?
                )

        endif

        nButtons:=Len(aCustomButtons)
        for nButton:=1 to nButtons
            if (Len(aCustomButtons[nButton])>=7)
                oFWDialogModal:AddButton(;
                    aCustomButtons[nButton][1],;//[n][1] cTitle Titulo do Botao
                    aCustomButtons[nButton][2],;//[n][2] bBloco Bloco de codigo que sera executado
                    aCustomButtons[nButton][3],;//[n][3] cToolTip Comentario do botao
                    aCustomButtons[nButton][4],;//[n][4] nShortCut Tecla para se criar o ShortCurt
                    aCustomButtons[nButton][5],;//[n][5] lShowBar Indica que o botao estara visivel na barra
                    aCustomButtons[nButton][6],;//[n][6] lConfig Indica se botao estara visivel na configuracao
                    aCustomButtons[nButton][7];//?
                )
            endif
        next nButton

        oFWDialogModal:Activate()

    end sequence

    FWFreeArray(@aHeader)
    FWFreeArray(@aFWBrwSeek)
    BrowseReleaseRows(@aFWBrwData)
    FWFreeArray(@aFWBrwModel)
    if (valType(aFWBrwColumn)=="A")
        aEval(aFWBrwColumn,{|o|FreeObj(o)})
        FWFreeArray(@aFWBrwColumn)
    endif
    FWFreeArray(@aFWBrowseSeek)
    FWFreeArray(@aFWGetDialogSizeCoors)

    FreeObj(@jHeader)
    FreeObj(@oFWBrowse)
    FreeObj(@oPanelMain)
    FreeObj(@oFWDialogModal)

return(nil)

static function BrowseGetData(oHBBridgeDataSet as object,cHBBridgeDataSetSQL as character,jHBBridgeDataSetPage as json,cOption as character,cFilterExpr as character) as array
    local aFWBrwData:=Array(0) as array
    local jRows as json
    local jRow as json
    local cSQL:=BrowseSQL(cHBBridgeDataSetSQL,cFilterExpr) as character
    local lOpened:=.F. as logical
    local nRow as numeric
    local nRows as numeric
    if (ValType(jHBBridgeDataSetPage)=="J")
        if (cOption=="previous")
            lOpened:=oHBBridgeDataSet:PreviousPage()
        elseif (cOption=="next")
            lOpened:=oHBBridgeDataSet:NextPage()
        elseif (cOption=="first")
            lOpened:=oHBBridgeDataSet:OpenPage(cSQL,1,jHBBridgeDataSetPage["size"],jHBBridgeDataSetPage["orderBy"])
        elseif (cOption=="last")
            if (oHBBridgeDataSet:TotalPages()<=0)
                return(nil)
            endif
            lOpened:=oHBBridgeDataSet:OpenPage(cSQL,oHBBridgeDataSet:TotalPages(),oHBBridgeDataSet:PageSize(),oHBBridgeDataSet:GetOrderBy())
        else //"all"
            lOpened:=oHBBridgeDataSet:OpenSQL(cSQL,jHBBridgeDataSetPage)
        endif
    else
        lOpened:=oHBBridgeDataSet:OpenSQL(cSQL)
    endif
    if (!lOpened)
        return(nil)
    endif
    nRows:=oHBBridgeDataSet:RowCount()
    jRows:=oHBBridgeDataSet:GetRows()
    for nRow:=1 to nRows
        // The array owns each row independently of the temporary JSON root.
        jRow:=JSONObject():New()
        jRow:FromJSON(jRows[tlpp.ToStr(nRow)]:ToJSON())
        aAdd(aFWBrwData,jRow)
    next
    FreeObj(@jRows)
return(aFWBrwData)

static function BrowseSQL(cSQL as character,cFilterExpr as character) as character
    if ((!Empty(cFilterExpr)).and.(cFilterExpr!="(1=1)"))
        // The presentation adapter accepts a caller SELECT with an existing
        // WHERE and no trailing ORDER BY/semicolon. It is not a SQL parser.
        cSQL+=" AND ("+cFilterExpr+")"
    endif
return(cSQL)

static procedure BrowseReleaseRows(aRows as array)
    local nRow as numeric
    if (ValType(aRows)=="A")
        for nRow:=1 to Len(aRows)
            if (ValType(aRows[nRow])=="J")
                FreeObj(@aRows[nRow])
            endif
        next
        FWFreeArray(@aRows)
    endif
return

static procedure BrowseQueryError(oDataSet as object)
    if (!Empty(oDataSet:ErrorCode()))
        MsgStop(oDataSet:ErrorCode()+": "+oDataSet:ErrorMessage(),"hbBridge query failed")
    endif
return

static procedure BrowseFilter(oFWBrowse as object,aFWBrwData as array,oDataSet as object,cSQL as character,jPage as json,cFilterExpr as character)
    local aNewData as array
    local cNewFilter:=cFilterExpr as character
    aNewData:=BuildCustomFilder(oDataSet,cSQL,jPage,@cNewFilter)
    if (ValType(aNewData)=="A")
        BrowseReleaseRows(@aFWBrwData)
        aFWBrwData:=aNewData
        cFilterExpr:=cNewFilter
        oFWBrowse:SetArray(aFWBrwData)
        oFWBrowse:Refresh(.T.)
    else
        BrowseQueryError(oDataSet)
    endif
return

static function BuildCustomFilder(oHBBridgeDataSet as object,cHBBridgeDataSetSQL as character,jHBBridgeDataSetPage as json,cFilterExpr as character) as array

    local aHeader as array
    local aFields as array
    local aCustomFilter as array

    local cField as character
    local cTitle as character
    local cAliasTmp as character
    local cF3 as character

    local jF3 as json
    local jHeader as json
    local jCustomFilter as json
    local jFilter as json
    local aFWBrwData as array
    local nField,nFields as numeric
    local nFilter,nFilters as numeric

    local oFWTemporaryTable as object

    cFilterExpr:=""

    jF3:=JSONObject():New()
    jHeader:=oHBBridgeDataSet:Header()
    nFields:=oHBBridgeDataSet:FieldCount()
    aHeader:=Array(nFields)
    for nField:=1 to nFields
        aHeader[nField]:=oHBBridgeDataSet:FieldName(nField)
    next nField
    aFields:=Array(0)

    for nField:=1 to nFields
        cField:=aHeader[nField]
        if (cField=="R_E_C_N_O_")
            loop
        endif
        // FWTemporaryTable's native schema is positional. Resolve logical
        // Protheus sizes/types locally rather than treating ODBC as SX3.
        aAdd(aFields,{cField,;
            if(Empty(GetSX3Cache(cField,"X3_TIPO")),__GetFieldType(jHeader[cField]["type"]),GetSX3Cache(cField,"X3_TIPO")),;
            if(Empty(GetSX3Cache(cField,"X3_TAMANHO")),jHeader[cField]["length"],GetSX3Cache(cField,"X3_TAMANHO")),;
            if(Empty(GetSX3Cache(cField,"X3_TIPO")),jHeader[cField]["decimals"],GetSX3Cache(cField,"X3_DECIMAL"))})
        cF3:=GetSX3Cache(cField,"X3_F3")
        if (!Empty(cF3))
            jF3[cField]:=cF3//Adicione + Field:F3 se necessario. Ex.: {"B1_COD":"SB1","B1_GRUPO":"SBM","B1_CODGRU":"SZ4Pro"}
        endif
    next nField

    if (!Empty(aFields))

        nFilters:=Len(aFields)

        // Adiciona Filtros Customizados
        jCustomFilter:=JSONObject():New()
        jCustomFilter:Set(Array(nFilters))
        for nFilter:=1 to nFilters
            cField:=aFields[nFilter][DBS_NAME]
            cTitle:=GetSX3Cache(cField,"X3_TITULO")
            if (Empty(cTitle))
                cTitle:=cField
            endif
            jFilter:=JSONObject():New()
            jFilter["__TITLE__"]:=cTitle
            jFilter["__FIELD_NAME__"]:=cField
            jFilter["__OP_ADVPL__"]:="=="
            jFilter["__OP_SQL__"]:="="
            jFilter["__REAL_VALUE__"]:=FilterGetRealValue(oHBBridgeDataSet:FieldGet(cField),aFields[nFilter][DBS_TYPE])
            jFilter["__VALUE__"]:=FilterLiteral(jFilter["__REAL_VALUE__"],aFields[nFilter][DBS_TYPE],.F.)
            jFilter["__SQL_VALUE__"]:=FilterLiteral(jFilter["__REAL_VALUE__"],aFields[nFilter][DBS_TYPE],.T.)
            jCustomFilter[nFilter]:=jFilter
        next nFilter

        aCustomFilter:=HBBridge.Client.HBBridgeTOTVSFilter():BuildCustomFilder(jCustomFilter)
        FreeObj(@jCustomFilter)

        cAliasTmp:=GetNextAlias()
        oFWTemporaryTable:=FWTemporaryTable():New(@cAliasTmp,@aFields)
        oFWTemporaryTable:Create()
        FWFreeArray(@aFields)

        cFilterExpr:=HBBridge.Client.HBBridgeTOTVSFilter():BuildExpr(cAliasTmp,1,.T.,@jF3,aCustomFilter,1)
        FWFreeArray(@aCustomFilter)
        oFWTemporaryTable:Delete()
        FreeObj(@oFWTemporaryTable)

    endif

    FWFreeArray(@aHeader)
    FWFreeArray(@aFields)
    FreeObj(@jF3)
    FreeObj(@jHeader)

    if (empty(cFilterExpr))
        cFilterExpr:="(1=1)"
    endif

    aFWBrwData:=BrowseGetData(oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,"all",cFilterExpr)

return(aFWBrwData)

static function FilterGetRealValue(xValue,cFieldType)
    if (__GetFieldType(cFieldType)=="D")
        DEFAULT xValue:=""
        if (ValType(xValue)=="C")
            xValue:=SToD(xValue)
        endif
    endif
return(xValue)

static function FilterRealValue2Str(xValue,cFieldType)
    local cType as character
    local cStrRealValueFilter as character
    cFieldType:=__GetFieldType(cFieldType)
    if (cFieldType=="N")
        DEFAULT xValue:=0
        cStrRealValueFilter:=tlpp.ToStr(xValue)
    elseif (cFieldType=="D")
        DEFAULT xValue:=""
        cType:=ValType(xValue)
        if (cType=="D")
            cStrRealValueFilter:=DToS(xValue)
        elseif (cType=="C")
            cStrRealValueFilter:=xValue
        elseif (cType!="C")
            cStrRealValueFilter:=AllToChar(xValue)
        endif
    elseif (cFieldType=="C")
        DEFAULT xValue:=""
        cStrRealValueFilter:=xValue
    else
        if (cFieldType=="L")
            DEFAULT xValue:=".F."
        endif
        cStrRealValueFilter:=AllToChar(xValue)
    endif
return(cStrRealValueFilter)

static function FilterLiteral(xValue,cFieldType,lSQL)
    local cValue:=FilterRealValue2Str(xValue,cFieldType) as character
    cFieldType:=__GetFieldType(cFieldType)
    if (cFieldType=="N")
        return(cValue)
    elseif (cFieldType=="L")
        DEFAULT xValue:=.F.
        return(if(lSQL,if(xValue,"1","0"),if(xValue,".T.",".F.")))
    elseif ((cFieldType=="D").and.(!lSQL))
        return("SToD('"+cValue+"')")
    endif
return("'"+StrTran(cValue,"'","''")+"'")

static function __GetFieldType(cFieldType)
    cFieldType:=StrTran(cFieldType,"I","N")
    cFieldType:=StrTran(cFieldType,"B","N")
    cFieldType:=StrTran(cFieldType,"T","C")
return(Left(cFieldType,1))

static Procedure BrowseCallBack(oFWBrowse,aFWBrwData,oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,cOption,cFilterExpr)

    local lCallBack as logical
    local aNewData as array

    lCallBack:=(cOption=="all")
    if (!lCallBack)
        lCallBack:=((cOption=="previous").and.(oHBBridgeDataSet:HasPreviousPage()))
        if (!lCallBack)
            lCallBack:=((cOption=="next").and.(oHBBridgeDataSet:HasNextPage()))
            if (!lCallBack)
                lCallBack:=(cOption=="first")
                if (!lCallBack)
                    lCallBack:=((cOption=="last").and.(oHBBridgeDataSet:TotalPages()>0))
                endif
            endif
        endif
    endif

    if (lCallBack)
        aNewData:=BrowseGetData(oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,cOption,cFilterExpr)
        if (ValType(aNewData)=="A")
            BrowseReleaseRows(@aFWBrwData)
            aFWBrwData:=aNewData
            oFWBrowse:SetArray(aFWBrwData)
            oFWBrowse:Refresh(.T./*lGoTop*/)
        else
            BrowseQueryError(oHBBridgeDataSet)
        endif
    endif

return

static function __FWBrowseSeek(oFWSeek as object,oFWBrowse as object,aFWBrwData as array,oHBBridgeDataSet as object,cHBBridgeDataSetSQL as character,jHBBridgeDataSetPage as json,cFilterExpr as character)

    local cType as character
    local cSeek as character
    local cSize as character
    local cDecimal as character
    local cSQLSeek as character
    local cField as character
    local dSeek as date

    local nATCol:=0 as numeric

    if (ValType(oFWSeek)=="O")
        cSeek:=AllTrim(oFWSeek:GetSeek())
        if (!Empty(cSeek))
            nATCol:=oFWSeek:GetOrder()
            if ((nATCol>0).and.(nATCol<=oHBBridgeDataSet:FieldCount()))
                cField:=oHBBridgeDataSet:FieldName(nATCol)
                cType:=oFWBrowse:aColumns[nATCol]:GetType()
                if (cType$"C|D")
                    if (cType="C")
                        cSQLSeek:="LOWER("+cField+") LIKE '%"+StrTran(Lower(cSeek),"'","''")+"%'"
                    else
                        if ("/"$cSeek)
                            dSeek:=CToD(cSeek)
                        else
                            dSeek:=SToD(StrTran(cSeek,"-",""))
                        endif
                        if (Empty(dSeek))
                            MsgStop("Enter a valid date.","hbBridge search")
                            return(0)
                        endif
                        cSeek:=DToS(dSeek)
                        cSQLSeek:=cField+"='"+Left(cSeek,4)+"-"+SubStr(cSeek,5,2)+"-"+Right(cSeek,2)+"'"
                    endif
                elseif (cType=="N")
                    if (","$cSeek)
                        if ("."$cSeek)
                            cSeek:=StrTran(cSeek,".","")
                        endif
                        cSeek:=StrTran(cSeek,",",".")
                    endif
                    if (!BrowseNumberValid(cSeek))
                        MsgStop("Enter a valid decimal number.","hbBridge search")
                        return(0)
                    endif
                    cSize:=tlpp.ToStr(oFWBrowse:aColumns[nATCol]:GetSize())
                    cDecimal:=tlpp.ToStr(oFWBrowse:aColumns[nATCol]:GetDecimal())
                    cSQLSeek:="CAST("+cField+" AS DECIMAL("+cSize+","+cDecimal+"))=CAST("+cSeek+" AS DECIMAL("+cSize+","+cDecimal+"))"
                else
                    MsgStop("Search is unsupported for this field type.","hbBridge search")
                    return(0)
                endif
                //TODO: Resolve this Workaround __cPrefixQryAlias
                if (Type("__cPrefixQryAlias")=="C")//TODO: resolver Alias para campos comuns (R_E_C_N_O_,R_E_C_D_E_L_,D_E_L_E_T_,etc) com HBBridgeSqlTools():PrefixQryAlias ou FieldAlias ou FielPrefixdAlias?
                    BrowseCallBack(oFWBrowse,@aFWBrwData,oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,"all",HBBridgeSqlTools():PrefixQryAlias(__cPrefixQryAlias,"("+cFilterExpr+" AND ("+cSQLSeek+"))"))
                else
                    BrowseCallBack(oFWBrowse,@aFWBrwData,oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,"all","("+cFilterExpr+" AND ("+cSQLSeek+"))")
                endif
            endif
        else
            BrowseCallBack(oFWBrowse,@aFWBrwData,oHBBridgeDataSet,cHBBridgeDataSetSQL,jHBBridgeDataSetPage,"all",cFilterExpr)
        endif
    endif

return(1)

static function BrowseNumberValid(cNumber as character) as logical
    local nIndex:=1 as numeric
    local nDigits:=0 as numeric
    local nDots:=0 as numeric
    local cChar as character
    if ((!Empty(cNumber)).and.(Left(cNumber,1)$"+-"))
        nIndex++
    endif
    while (nIndex<=Len(cNumber))
        cChar:=SubStr(cNumber,nIndex,1)
        if (cChar==".")
            nDots++
            if (nDots>1)
                return(.F.)
            endif
        elseif (cChar$"0123456789")
            nDigits++
        else
            return(.F.)
        endif
        nIndex++
    enddo
return(nDigits>0)
