/* Released to Public Domain. */
#include "tlpp-core.th"

namespace HBBridge.Client

class HBBridgeJSON

    static method Encode(jValue as json) as character
    static method Parse(cJSON as character, jResult as json) as logical

endclass

// Keep the native implementation for ordinary documents. The fallback only
// handles embedded NUL; it does not change codepages or numeric semantics.
static method Encode(jValue) class HBBridgeJSON

    local cResult := "" as character

    local jScratch as json

    local lValid := .T. as logical

    local nMode := JSONNulMode(jValue) as numeric

    if nMode == 0
        return jValue:ToJSON()
    endif
    if nMode == 2
        return ""
    endif
    jScratch := JSONObject():New()
    cResult := JSONEncodeValue(jValue, jScratch, @lValid)
    FreeObj(@jScratch)

return if(lValid, cResult, "")

static method Parse(cJSON, jResult) class HBBridgeJSON

    local jScratch as json

    local lValid := .F. as logical

    local nPosition := 1 as numeric

    if Chr(0) $ cJSON
        jResult:FromJSON("{}")
        return .F.
    endif
    if ValType(jResult:FromJSON(cJSON)) != "U"
        jResult:FromJSON("{}")
        return .F.
    endif
    if !("\u0000" $ cJSON)
        return .T.
    endif
    jScratch := JSONObject():New()
    lValid := JSONPatchValue(cJSON, @nPosition, @jResult, jScratch)
    JSONSkipSpace(cJSON, @nPosition)
    lValid := lValid .and. nPosition > Len(cJSON)
    FreeObj(@jScratch)
    if !lValid
        jResult:FromJSON("{}")
    endif

return lValid

// GetNames() is required by the native JSONObject enumeration API. Values
// remain keyed; no intermediate copy of the page/rows is allocated here.
static function JSONNulMode(xValue as variant) as numeric

    local aNames as array

    local cType := ValType(xValue) as character
    local cCHR_0 := Chr(0) as character

    local nIndex := 0, nMode := 0, nChild := 0, nLength := 0 as numeric

    if cType == "C"
        return if(cCHR_0 $ xValue, 1, 0)
    endif
    if cType == "J" .or. cType == "O"
        aNames := xValue:GetNames()
        nLength := Len(aNames)
        for nIndex := 1 to nLength
            if cCHR_0 $ aNames[nIndex]
                nMode := 2
                exit
            endif
            nChild := JSONNulMode(xValue[aNames[nIndex]])
            nMode := Max(nMode, nChild)
            if nMode == 2
                exit
            endif
        next nIndex
        FWFreeArray(@aNames)
    elseif cType == "A"
        nLength := Len(xValue)
        for nIndex := 1 to nLength
            nMode := Max(nMode, JSONNulMode(xValue[nIndex]))
            if nMode == 2
                exit
            endif
        next nIndex
    endif

return nMode

static function JSONScalarToken(xValue as variant, jScratch as json) as character

    local cJSON := "" as character

    local nColon := 0 as numeric

    jScratch["v"] := xValue
    cJSON := jScratch:ToJSON()
    nColon := At(":", cJSON)

return SubStr(cJSON, nColon + 1, Len(cJSON) - nColon - 1)

static function JSONEncodeValue(xValue as variant, jScratch as json, lValid as logical) as character

    local aNames as array

    local cCHR_0 := Chr(0) as character
    local cType := ValType(xValue), cResult := "", cToken := "" as character

    local nIndex := 0, nStart := 1, nPosition := 1, nRun := 0 as numeric
    local nLen as numeric

    if cType == "J" .or. cType == "O"
        aNames := xValue:GetNames()
        cResult := "{"
        nLen := Len(aNames)
        for nIndex := 1 to nLen
            if cCHR_0 $ aNames[nIndex]
                lValid := .F.
                exit
            endif
            if nIndex > 1
                cResult += ","
            endif
            cResult += JSONScalarToken(aNames[nIndex], jScratch) + ":"
            cResult += JSONEncodeValue(xValue[aNames[nIndex]], jScratch, @lValid)
            if !lValid
                exit
            endif
        next nIndex
        cResult += "}"
        FWFreeArray(@aNames)
    elseif cType == "A"
        cResult := "["
        nLen := Len(xValue)
        for nIndex := 1 to nLen
            if nIndex > 1
                cResult += ","
            endif
            cResult += JSONEncodeValue(xValue[nIndex], jScratch, @lValid)
            if !lValid
                exit
            endif
        next nIndex
        cResult += "]"
    elseif cType == "C" .and. cCHR_0 $ xValue
        cResult := '"'
        // Scan forward; repeatedly copying the remaining suffix for each NUL
        // makes dense input unnecessarily expensive. Emit adjacent NULs once.
        nLen:=Len(xValue)
        do while nPosition <= nLen
            if SubStr(xValue, nPosition, 1) != cCHR_0
                nPosition++
                loop
            endif
            if nPosition > nStart
                cToken := JSONScalarToken(SubStr(xValue, nStart, nPosition - nStart), jScratch)
                cResult += SubStr(cToken, 2, Len(cToken) - 2)
            endif
            nRun := 0
            do while nPosition <= nLen
                if SubStr(xValue, nPosition, 1) != cCHR_0
                    exit
                endif
                nRun++
                nPosition++
            enddo
            cResult += Replicate("\u0000", nRun)
            nStart := nPosition
        enddo
        cToken := JSONScalarToken(SubStr(xValue, nStart), jScratch)
        cResult += SubStr(cToken, 2, Len(cToken) - 2) + '"'
    else
        cResult := JSONScalarToken(xValue, jScratch)
    endif

return cResult

static function JSONSkipSpace(cJSON as character, nPosition as numeric)

    local nJSONLen := Len(cJSON), nByte := 0 as numeric

    do while nPosition <= nJSONLen
        nByte := Asc(SubStr(cJSON, nPosition, 1))
        if !(nByte == 32 .or. nByte == 9 .or. nByte == 10 .or. nByte == 13)
            exit
        endif
        nPosition++
    enddo

return

// The native parser has already validated syntax. This scan still checks
// token boundaries so escaped backslashes never become actual NUL escapes.
static function JSONStringToken(cJSON as character, nPosition as numeric, cToken as character) as logical

    local cByte := "" as character

    local nStart := nPosition as numeric
    local nJSONLen := Len(cJSON) as numeric

    if SubStr(cJSON, nPosition, 1) != '"'
        return .F.
    endif
    nPosition++
    do while nPosition <= nJSONLen
        cByte := SubStr(cJSON, nPosition, 1)
        nPosition++
        if cByte == '"'
            cToken := SubStr(cJSON, nStart, nPosition - nStart)
            return .T.
        endif
        if cByte == "\"
            nPosition++
        endif
    enddo

return .F.

static function JSONDecodeToken(cToken as character, jScratch as json, xValue as variant) as logical

    if ValType(jScratch:FromJSON('{"v":' + cToken + '}')) != "U"
        return .F.
    endif
    xValue := jScratch["v"]

return .T.

static function JSONDecodeNulString(cToken as character, jScratch as json, cValue as character, lHasNul as logical) as logical

    local cCHR_0 := Chr(0) as character
    local cSegment := "" as character

    local nPosition := 2, nStart := 2 as numeric
    local nTokenLen:=Len(cToken) as numeric

    local xSegment as variant

    cValue := ""
    lHasNul := .F.
    do while nPosition < nTokenLen
        if SubStr(cToken, nPosition, 1) == "\"
            if SubStr(cToken, nPosition, 6) == "\u0000"
                cSegment := '"' + SubStr(cToken, nStart, nPosition - nStart) + '"'
                if !JSONDecodeToken(cSegment, jScratch, @xSegment)
                    return .F.
                endif
                if ValType(xSegment) != "C"
                    return .F.
                endif
                cValue += xSegment + cCHR_0
                lHasNul := .T.
                nPosition += 6
                nStart := nPosition
                loop
            endif
            nPosition++
        endif
        nPosition++
    enddo
    if !lHasNul
        return .T.
    endif
    cSegment := '"' + SubStr(cToken, nStart, nTokenLen - nStart) + '"'
    if !JSONDecodeToken(cSegment, jScratch, @xSegment)
        return .F.
    endif
    if ValType(xSegment) != "C"
        return .F.
    endif
    cValue += xSegment

return .T.

static function JSONPatchValue(cJSON as character, nPosition as numeric, xValue as variant, jScratch as json) as logical

    local aNames as array

    local cByte := "", cToken := "", cKey := "", cPatched := "", cClose := "" as character
    local cType:=ValType(xValue) as character

    local jSeen as json

    local lHasNul := .F., lObject := .F., lValid := .T. as logical

    local nCount := 0, nStart := 0 as numeric
    local nJSONLen := Len(cJSON), nArrayLen := 0, nByte := 0 as numeric

    local xKey, xChild as variant

    JSONSkipSpace(cJSON, @nPosition)
    cByte := SubStr(cJSON, nPosition, 1)
    if cByte == '"'
        if cType != "C" .or. !JSONStringToken(cJSON, @nPosition, @cToken)
            return .F.
        endif
        if !JSONDecodeNulString(cToken, jScratch, @cPatched, @lHasNul)
            return .F.
        endif
        if lHasNul
            xValue := cPatched
        endif
        return .T.
    endif
    if cByte == "{" .or. cByte == "["
        lObject := cByte == "{"
        if lObject .and. !(cType $ "JO")
            return .F.
        endif
        if !lObject .and. cType != "A"
            return .F.
        endif
        cClose := if(lObject, "}", "]")
        if !lObject
            nArrayLen := Len(xValue)
        endif
        jSeen := JSONObject():New()
        nPosition++
        JSONSkipSpace(cJSON, @nPosition)
        do while SubStr(cJSON, nPosition, 1) != cClose
            if nPosition > nJSONLen
                lValid := .F.
                exit
            endif
            nCount++
            if lObject
                if !JSONStringToken(cJSON, @nPosition, @cToken)
                    lValid := .F.
                    exit
                endif
                if !JSONDecodeNulString(cToken, jScratch, @cPatched, @lHasNul) .or. lHasNul
                    lValid := .F.
                    exit
                endif
                if !JSONDecodeToken(cToken, jScratch, @xKey)
                    lValid := .F.
                    exit
                endif
                if ValType(xKey) != "C"
                    lValid := .F.
                    exit
                endif
                cKey := xKey
                if !xValue:HasProperty(cKey) .or. jSeen:HasProperty(cKey)
                    lValid := .F.
                    exit
                endif
                jSeen[cKey] := .T.
                JSONSkipSpace(cJSON, @nPosition)
                if SubStr(cJSON, nPosition, 1) != ":"
                    lValid := .F.
                    exit
                endif
                nPosition++
                xChild := xValue[cKey]
            else
                if nCount > nArrayLen
                    lValid := .F.
                    exit
                endif
                xChild := xValue[nCount]
            endif
            if !JSONPatchValue(cJSON, @nPosition, @xChild, jScratch)
                lValid := .F.
                exit
            endif
            if lObject
                xValue[cKey] := xChild
            else
                xValue[nCount] := xChild
            endif
            JSONSkipSpace(cJSON, @nPosition)
            if SubStr(cJSON, nPosition, 1) == cClose
                exit
            endif
            if SubStr(cJSON, nPosition, 1) != ","
                lValid := .F.
                exit
            endif
            nPosition++
            JSONSkipSpace(cJSON, @nPosition)
        enddo
        if lObject
            aNames := xValue:GetNames()
            lValid := lValid .and. nCount == Len(aNames)
            FWFreeArray(@aNames)
        else
            lValid := lValid .and. nCount == nArrayLen
        endif
        FreeObj(@jSeen)
        if !lValid
            return .F.
        endif
        nPosition++
        return .T.
    endif
    // Numbers, logicals and NULL stay exactly as parsed by JSONObject.
    nStart := nPosition
    do while nPosition <= nJSONLen
        cByte := SubStr(cJSON, nPosition, 1)
        nByte := Asc(cByte)
        if cByte == "," .or. cByte == "}" .or. cByte == "]" .or. ;
            nByte == 32 .or. nByte == 9 .or. nByte == 10 .or. nByte == 13
            exit
        endif
        nPosition++
    enddo

return nPosition > nStart
