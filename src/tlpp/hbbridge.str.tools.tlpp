            cWebAccentName:=aAccentuation[nAccent]["HTMLName"]
            cWebAccentClean:=HBBridgeStrTools():StrReplaceEx(cWebAccentName,{"&",""},{";",""})
            cWebAccentHBBridgeNumber:=aAccentuation[nAccent]["HTMLHBBridgeNumber"]
            nNoAccent:=aScan(aNoAccent,{|x as array|x[1]==cAccent})
