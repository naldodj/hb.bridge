static __aTokens:={"\","/","|","+","-","_",",",":",";"} as array
static __aAccentuation as array

static __cCHR10:=CHR(10) as character
static __cCHR13:=CHR(13) as character

static __jEmojis as json

static __nAccentuation as numeric

class HBBridgeStrTools

    static method EscapeHTMLScript(cHTML as character) as character
    static method EscapeJavaScript(cScript as character) as character
    static method EscapeHTMLAttribute(cHTML as character) as character

    static method ConvertHeaderToJSObject(cHeaderString as character) as character

    static method GetEmojiHtmlJSON() as json
    static method GetEmojiHtmlCode(cName as character) as character
    static method UpdEmojiHtmlCode(cString as character) as character

    static method StrReplace(cTemplate as character,vSubstitutions as variant) as character
    static method StrReplaceEx(cTemplate as character,vSubstitutions as variadic) as character

    static method NoAccent(cStrAnsi as character) as character
    static method Accentuation(cString as character,vAccentuation as variadic) as character
    static method AsciiToWebAccentuation(cString as character) as character
    static method WebAccentuationToAscii(cString as character) as character

    static method NormalizeStringToken(cString,cNormalizedToken,cIgnoreToken) as character
    static method TokenTrimmer(cString,cToken) as character

end class

static method EscapeHTMLScript(cHTML) class HBBridgeStrTools
    paramtype 1 var cHTML as character
    cHTML:=AllTrim(cHTML)
    cHTML:=HBBridgeStrTools():StrReplace(;
        cHTML;
        ,{;
            {"</","<\/"};
            ,{"\\","\\\\"};
            ,{"'","\\'"};
            ,{'"','\\\"'};
            ,{__cCHR13,"\\r"};
            ,{__cCHR10,"\\n"};
        };
    )
return(cHTML)

static method EscapeJavaScript(cScript) class HBBridgeStrTools
    paramtype 1 var cScript as character
    cScript:=HBBridgeStrTools():StrReplace(;
        cScript;
        ,{;
            {"\\","\\\\"};
            ,{"'","\\'"};
            ,{'"','\\\"'};
            ,{__cCHR13,"\\r"};
            ,{__cCHR10,"\\n"};
        };
    )
return(cScript)

static method EscapeHTMLAttribute(cHTML) class HBBridgeStrTools
    paramtype 1 var cHTML as character
    cHTML:=HBBridgeStrTools():StrReplace(;
        cHTML;
        ,{;
            {"&","&amp;"};
            ,{'"','&quot;'};
            ,{"'","&#39;"};
            ,{"<","&lt;"};
            ,{">","&gt;"};
        };
    )
return(cHTML)

static method ConvertHeaderToJSObject(cHeaderString) class HBBridgeStrTools

    local aHeaderString as array

    paramtype 1 var cHeaderString as character

    aHeaderString:=StrTokArr2(cHeaderString,":",.T.)
    if (Len(aHeaderString)==2)
        cHeaderString:="'"+AllTrim(aHeaderString[1])+"'"
        cHeaderString+=":"
        cHeaderString+="'"+AllTrim(aHeaderString[2])+"'"
    endif

return(cHeaderString)

