static method GetEmojiHtmlCode(cName) class HBBridgeStrTools

    local cEmojiHtmlCode as character

    local jEmojis:=HBBridgeStrTools():GetEmojiHtmlJSON() as json

    paramtype 1 var cName as character

    cName:=Lower(AllTrim(cName))
    if (jEmojis:HasProperty(cName))
        cEmojiHtmlCode:=jEmojis[cName]
    else
        cEmojiHtmlCode:=""
    endif

    FreeObj(@jEmojis)

return(cEmojiHtmlCode)

static method UpdEmojiHtmlCode(cString) class HBBridgeStrTools
    local aEmojis as array

    local jEmojis as json

    local nIndex as numeric
    local nEmojis as numeric

    paramtype 1 var cString as character
    jEmojis:=HBBridgeStrTools():GetEmojiHtmlJSON()
    aEmojis:=jEmojis:GetNames()
    nEmojis:=Len(aEmojis)
    for nIndex:=1 to nEmojis
        if ("__"+aEmojis[nIndex]+"__"$cString)
            cString:=StrTran(cString,"__"+aEmojis[nIndex]+"__",jEmojis[aEmojis[nIndex]])
        elseif (":"+aEmojis[nIndex]+":"$cString)
            cString:=StrTran(cString,":"+aEmojis[nIndex]+":",jEmojis[aEmojis[nIndex]])
        endif
    next nIndex
    FWFreeArray(@aEmojis)
    FreeObj(@jEmojis)
return(cString)

static method StrReplace(cTemplate,vSubstitutions) class HBBridgeStrTools

    local aNames as array

    local cName as character
    local cApplied as character

    local nIndex as numeric
    local nNames as numeric

    paramtype 1 var cTemplate as character
    paramtype 2 var vSubstitutions as array,json

    cApplied:=cTemplate

    if (ValType(vSubstitutions)=="J")
        aNames:=vSubstitutions:GetNames()
        nNames:=Len(aNames)
        for nIndex:=1 to nNames
            cName:=aNames[nIndex]
            if (valType(vSubstitutions[cName])!="C")
                loop
            endif
            cApplied:=StrTran(cApplied,cName,vSubstitutions[cName])
        next nIndex
    else
        aNames:=vSubstitutions
        if ((Len(aNames)==2).and.(ValType(aNames[1])=="C").and.(ValType(aNames[2])=="C"))
            cName:=aNames[1]
            cApplied:=StrTran(cApplied,cName,aNames[2])
        else
            nNames:=Len(vSubstitutions)
            for nIndex:=1 to nNames
                if (Len(aNames[nIndex])!=2).or.(ValType(aNames[nIndex][2])!="C")
                    loop
                endif
                if (ValType(aNames[nIndex][1])!="C")
                    loop
                endif
                cName:=aNames[nIndex][1]
                cApplied:=StrTran(cApplied,cName,aNames[nIndex][2])
            next nIndex
        endif
    endif

return(cApplied)

static function ___HBBridgeStrTools____StrReplaceEx(cString as character,vSubstitutions as variadic) as character

    local aNames as array
    local aTokens as array

    local cType as character
    local cName as character
    local cStrReplace:=cString as character

    local nStr as numeric
    local nName as numeric
    local nNames as numeric
    local nVarg as numeric
    local nToken as numeric
    local nTokens as numeric
    local nValues as numeric
    local nArguments as numeric
    local nSubstitutions as numeric

    local uStr as variant

    begin sequence

        if (vSubstitutions==nil)
            break
        endif

        aTokens:={"=>","->","|",":","="}
        nTokens:=Len(aTokens)

        nSubstitutions:=vSubstitutions:vCount
        for nStr:=1 to nSubstitutions
            uStr:=vSubstitutions:vArgs[nStr]
            cType:=ValType(uStr)
            if (cType=="C")
                for nToken :=1 to nTokens
                    if (aTokens[nToken]$uStr)
                        uStr:=StrTokArr2(uStr,aTokens[nToken],.T.)
                        cType:=ValType(uStr)
                        exit
                    endif
                next nToken
            endif
            if ((cType=="A").and.(Len(uStr)==2))
                if ((ValType(uStr[1])=="A").and.(ValType(uStr[2])=="C"))
                    nValues:=Len(uStr[1])
                    for nToken:=1 to nValues
                        cStrReplace:=HBBridgeStrTools():StrReplaceEx(cStrReplace,{uStr[1][nToken],uStr[2]})
                    next nToken
                elseif ((ValType(uStr[1])=="A").and.(ValType(uStr[2])=="A"))
                    nValues:=Min(Len(uStr[1]),Len(uStr[2]))
                    for nToken:=1 to nValues
                        cStrReplace:=HBBridgeStrTools():StrReplaceEx(cStrReplace,{uStr[1][nToken],uStr[2][nToken]})
                    next nToken
                elseif ((ValType(uStr[1])=="C").and.(ValType(uStr[2])=="C"))
                    cStrReplace:=StrReplaceStable(cStrReplace,uStr[1],uStr[2])
                endif
            elseif (cType=="J")
                if (uStr:HasProperty("VARGS"))
                    cType:=ValType(uStr["VARGS"])
                    if (cType=="A")
                        nArguments:=Len(uStr["VARGS"])
                        for nVArg:=1 to nArguments
                            cType:=ValType(uStr["VARGS"][nVArg])
                            if ((cType=="A").and.(Len(uStr["VARGS"][nVArg])==2))
                                if ((ValType(uStr["VARGS"][nVArg][1])=="A").and.(ValType(uStr["VARGS"][nVArg][2])=="C"))
                                    nValues:=Len(uStr["VARGS"][nVArg][1])
                                    for nToken:=1 to nValues
                                        cStrReplace:=HBBridgeStrTools():StrReplaceEx(cStrReplace,{uStr["VARGS"][nVArg][1][nToken],uStr["VARGS"][nVArg][2]})
                                    next nToken
                                elseif ((ValType(uStr["VARGS"][nVArg][1])=="A").and.(ValType(uStr["VARGS"][nVArg][2])=="A"))
                                    nValues:=Min(Len(uStr["VARGS"][nVArg][1]),Len(uStr["VARGS"][nVArg][2]))
                                    for nToken:=1 to nValues
                                        cStrReplace:=HBBridgeStrTools():StrReplaceEx(cStrReplace,{uStr["VARGS"][nVArg][1][nToken],uStr["VARGS"][nVArg][2][nToken]})
                                    next nToken
                                elseif ((ValType(uStr["VARGS"][nVArg][1])=="C").and.(ValType(uStr["VARGS"][nVArg][2])=="C"))
                                    cStrReplace:=StrReplaceStable(cStrReplace,uStr["VARGS"][nVArg][1],uStr["VARGS"][nVArg][2])
                                endif
                            endif
                        next nVArg
                    endif
                else
                    aNames:=aClone(uStr:GetNames())
                    nNames:=Len(aNames)
                    for nName:=1 to nNames
                        cName:=aNames[nName]
                        if (ValType(uStr[cName])=="C")
                            cStrReplace:=StrReplaceStable(cStrReplace,cName,uStr[cName])
                        endif
                    next nName
                    FWFreeArray(@aNames)
                endif
            endif
        next nStr

    end sequence

    FWFreeArray(@aTokens)

return(cStrReplace)

static function StrReplaceStable(cTemplate as character,cNeedle as character,cReplacement as character) as character
    if ((Len(cNeedle)==0).or.(cNeedle==cReplacement))
        return(cTemplate)
    endif
    if (cNeedle$cReplacement)
        // Expanding replacements must not loop forever ("a" -> "aa").
        return(StrTran(cTemplate,cNeedle,cReplacement))
    endif
    while (cNeedle$cTemplate)
        cTemplate:=StrTran(cTemplate,cNeedle,cReplacement)
    enddo
return(cTemplate)

static method NoAccent(cStrAnsi) class HBBridgeStrTools
    paramtype cStrAnsi as character
return(NoAccent(cStrAnsi))

static function ___HBBridgeStrTools____Accentuation(cString as character,vAccentuation as variadic) as character

    local ai18n as array

    local cIdx as character
    local cChar as character
    local cAccentuation:=cString as character

    local nAT as numeric
    local nIdx as numeric
    local nLen as numeric
    local nATPos as numeric
    local nAccentuation as numeric
    local nArguments as numeric

    begin sequence

        if (vAccentuation==nil)
            break
        endif

        GetAccentuation()
        DEFAULT __nAccentuation:=Len(__aAccentuation)

        ai18n:=array(0)

        nArguments:=vAccentuation:vCount
        for nAccentuation:=1 to nArguments
            cChar:=allTrim(vAccentuation:vArgs[nAccentuation])
            if (Left(cChar,1)=="&")
                cChar:=SubStr(cChar,2)
            endif
            if (Right(cChar,1)==";")
                cChar:=SubStr(cChar,1,Len(cChar)-1)
            endif
            if (cChar!=vAccentuation:vArgs[nAccentuation])
                vAccentuation:vArgs[nAccentuation]:=cChar
            endif
            nAT:=aScan(__aAccentuation,{|x|x[3]==cChar})
            cChar:=if(nAT>0,__aAccentuation[nAT][1],cChar)
            aAdd(ai18n,cChar)
        next nAccentuation

        nIdx:=0
        nLen:=Len(cAccentuation)
        for nAT:=1 to nLen
            nATPos:=AT("#",SubStr(cAccentuation,nAT))
            if (nATPos==0)
                exit
            endif
            nAT+=(nATPos-1)
            cChar:=SubStr(cAccentuation,nAT,1)
            if (cChar=="#")
                cIdx:=tlpp.ToStr(++nIdx)
                cAccentuation:=Stuff(cAccentuation,++nAT,1,cIdx)
            endif
        next nAT

        cAccentuation:=i18n(cAccentuation,ai18n)

        FWFreeArray(@ai18n)

    end sequence

return(cAccentuation)

static method AsciiToWebAccentuation(cString) class HBBridgeStrTools

    local ai18n as array

    local cIdx as character
    local cChar as character
    local cAccent as character
    local cWebAccent as character
    local cWebString as character

    local nIdx as numeric
    local nATPos as numeric
    local nAccent as numeric
    local nAccentLen as numeric

    paramtype 1 var cString as character
    cWebString:=cString

    GetAccentuation()
    DEFAULT __nAccentuation:=Len(__aAccentuation)

    ai18n:=array(0)

    nIdx:=0
    for nAccent:=1 to __nAccentuation
        cAccent:=__aAccentuation[nAccent][1]
        nAccentLen:=Len(cAccent)
        while ((nATPos:=AT(cAccent,cWebString))>0)
            cChar:=SubStr(cWebString,nATPos,nAccentLen)
            if (cChar==cAccent)
                cIdx:=("#"+tlpp.ToStr(++nIdx))
                cWebString:=Stuff(cWebString,nATPos,nAccentLen,cIdx)
                cWebAccent:=__aAccentuation[nAccent][4]
                aAdd(ai18n,cWebAccent)
            endif
        end while
    next nAccent

    cWebString:=i18n(cWebString,ai18n)

    FWFreeArray(@ai18n)

return(cWebString)

static method WebAccentuationToAscii(cWebString) class HBBridgeStrTools

    local ai18n as array

    local cIdx as character
    local cChar as character
    local cAccent as character
    local cWebAccent as character

    local nIdx as numeric
    local nATPos as numeric
    local nAccent as numeric
    local nWebAccentLen as numeric

    paramtype 1 var cWebString as character
    cString:=cWebString

    GetAccentuation()
    DEFAULT __nAccentuation:=Len(__aAccentuation)

    ai18n:=array(0)

    nIdx:=0
    for nAccent:=1 to __nAccentuation
        cWebAccent:=__aAccentuation[nAccent][4]
        nWebAccentLen:=Len(cWebAccent)
        while ((nATPos:=AT(cWebAccent,cString))>0)
            cChar:=SubStr(cString,nATPos,nWebAccentLen)
            if (cChar==cWebAccent)
                cIdx:=("#"+tlpp.ToStr(++nIdx))
                cString:=Stuff(cString,nATPos,nWebAccentLen,cIdx)
                cAccent:=__aAccentuation[nAccent][1]
                aAdd(ai18n,cAccent)
            endif
        end while
    next nAccent

    cString:=i18n(cString,ai18n)

    FWFreeArray(@ai18n)

return(cString)

 //Devera estar no Padrao ANSI utilizar a funcao OemToAnsi() para a conversao
static function NoAccent(cStrAnsi as character) as character

    local cAccent as character
    local cNoAccent as character
    local cStrAnsiNoAc as character

    local nAccent as numeric

    GetAccentuation()
    DEFAULT __nAccentuation:=Len(__aAccentuation)

    begin sequence

        if (empty(cStrAnsi))
            cStrAnsiNoAc:=cStrAnsi
            break
        endif

        cStrAnsiNoAc:=cStrAnsi

        for nAccent:=1 to __nAccentuation
            cAccent:=__aAccentuation[nAccent][1]
            cNoAccent:=__aAccentuation[nAccent][2]
            while (cAccent$cStrAnsiNoAc)
                cStrAnsiNoAc:=HBBridgeStrTools():StrReplaceEx(cStrAnsiNoAc,{cAccent,cNoAccent})
            end while
        next nAccent

    end sequence

return(FwNoAccent(cStrAnsiNoAc))

