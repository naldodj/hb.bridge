// ---------- method HBBridgeStrTools():NormalizeStringToken ----------
//Normalizar os Tokens em uma string Tokenizada
static method NormalizeStringToken(cString,cNormalizedToken,cIgnoreToken) class HBBridgeStrTools
    local cToken as character
    local cNormalizedString as character

    local lIgnoreToken as logical

    local nToken as numeric
    local nTokens as numeric

    paramtype 1 var cString as character
    paramtype 2 var cNormalizedToken as character optional default "/"
    paramtype 3 var cIgnoreToken as character optional
    lIgnoreToken:=(!Empty(cIgnoreToken))
    cNormalizedString:=cString
    nTokens:=Len(__aTokens)
    for nToken:=1 to nTokens
        //Armazena o Token
        cToken:=__aTokens[nToken]
        //Verifica se o Token Sera Ignorado na Normalizacao
        if ((lIgnoreToken).and.(cToken==cIgnoreToken))
            //Ignora
            loop
        endif
        //Normaliza os Tokens
        cNormalizedString:=StrTran(cNormalizedString,cToken,cNormalizedToken)
    next nToken
return(cNormalizedString)

// ---------- method HBBridgeStrTools():TokenTrimmer ----------
//Remover Token aa Direita e a Esquerda em uma string Tokenizada
static method TokenTrimmer(cString,cToken) class HBBridgeStrTools

    local cNewStringToken as character

    paramtype 1 var cString as character
    paramtype 2 var cToken as character

    cNewStringToken:=cString

    while (Right(cNewStringToken,1)==cToken)
        cNewStringToken:=SubStr(cNewStringToken,1,Len(cNewStringToken)-1)
    end while

    while (Left(cNewStringToken,1)==cToken)
        cNewStringToken:=SubStr(cNewStringToken,2)
    end while

return(cNewStringToken)
