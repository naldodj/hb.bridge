/* Released to Public Domain. */
#include "totvs.ch"
#include "dbinfo.ch"
#include "dbstruct.ch"
#include "parmtype.ch"

namespace HBBridge.Client

// Owns one native page only. The dataset/client and their UTF-8 values remain
// caller-owned. No query, cursor movement or dictionary lookup occurs here.
class HBBridgeNativeTable

    private data cRDD as character
    private data cAlias as character
    private data cStorageName as character
    private data cIndexStem as character
    private data cErrorCode as character
    private data cErrorMessage as character
    private data cWriteMode as character

    private data jSchema as json
    private data jFields as json
    private data jColumns as json
    private data jSourceFields as json
    private data jIndexes as json
    private data jCreatedIndexes as json
    private data jOwnedFiles as json

    private data lReady as logical
    private data lVerifyStorage as logical

    private data nRows as numeric

    private data oDataSet as object
    private data oTable as object

    public method New(oDataSet as object,jLogicalSchema as json,lVerifyStorage as logical,cRDD as character) as object
    public method LoadCurrentPage(cRDD as character,jProjectionFields as json) as logical
    public method Alias() as character
    public method FieldPos(xProjection as variant) as numeric
    public method FieldGet(xProjection as variant) as variant
    public method FieldName(cProjection as character) as character
    public method FieldCaption(cProjection as character) as character
    public method SourceFieldPos(cProjection as character,lUseProjetcionRet as logical) as numeric
    public method SourceFieldGet(cProjection as character,lUseProjetcionRet as logical) as variant
    public method SourceFieldName(cProjection as character) as character
    public method SourceFieldCaption(cProjection,lUseProjetcionRet as logical) as character
    public method SetSourceFieldName(jProjectionFields as json,lForce as logical)
    public method SearchFieldName(cProjection as character) as character
    public method IndexOrder(cProjection as character) as numeric
    public method EnsureIndex(cProjection as character) as numeric
    public method RDD() as character
    public method FieldCount() as numeric
    public method ProjectionName(xPosition as variant) as character
    public method Schema() as json
    public method IsOpen() as logical
    public method RowCount() as numeric
    public method WriteMode() as character
    public method ClearPage() as logical
    public method Close() as logical
    public method Destroy() as logical
    public method ErrorCode() as character
    public method ErrorMessage() as character

endclass

method New(oDataSet,jLogicalSchema,lVerifyStorage,cRDD) class HBBridgeNativeTable

    local cJSON:="" as character

    paramtype 1 var oDataSet as object
    paramtype 2 var jLogicalSchema as json optional
    paramtype 3 var lVerifyStorage as logical optional default .F.
    paramtype 4 var cRDD as character optional default "SQLITE_MEM"

    self:cRDD:=Upper(AllTrim(cRDD))
    self:cAlias:=GetNextAlias()
    self:cStorageName:=""
    self:cIndexStem:="HBB"+SubStr(StrTran(UUIDRandom(),"-",""),1,16)
    self:cErrorCode:=""
    self:cErrorMessage:=""
    self:cWriteMode:=""
    self:jSchema:=JSONObject():New()
    self:jFields:=nil
    self:jColumns:=nil
    self:jSourceFields:=nil
    self:jIndexes:=nil
    self:jCreatedIndexes:=JSONObject():New()
    self:jOwnedFiles:=JSONObject():New()
    self:lReady:=.F.
    self:lVerifyStorage:=((ValType(lVerifyStorage)=="L").and.(lVerifyStorage))
    self:nRows:=0
    self:oDataSet:=oDataSet
    self:oTable:=nil
    if (ValType(jLogicalSchema)=="J")
        cJSON:=HBBridgeJSON():Encode(jLogicalSchema)
    endif
    if (Empty(cJSON).or.!HBBridgeJSON():Parse(cJSON,self:jSchema))
        self:cErrorCode:="INVALID_LOGICAL_SCHEMA"
        self:cErrorMessage:="A native table requires an explicit logical schema."
    endif

return(self)

method LoadCurrentPage(cRDD,jProjectionFields) class HBBridgeNativeTable

    // FWTemporaryTable/DbStruct/FWBulk require positional arrays.
    local aFields as array
    local aActual as array

    local cAlias:=self:cAlias as character
    local cCode:="" as character
    local cMessage:="" as character
    local cField:="" as character
    local cNative:="" as character
    local cSearch:="" as character
    local cType:="" as character
    local cWriteMode:="" as character
    local cTableName:="" as character
    local cPreviousProjection:="" as character

    local jHeader as json
    local jRows as json
    local jConverted as json
    local jDefinition as json
    local jFields:=JSONObject():New() as json
    local jColumns:=JSONObject():New() as json
    local jSourceFields:=JSONObject():New() as json
    local jIndexes:=JSONObject():New() as json
    local jWriteColumns:=JSONObject():New() as json
    local jIndex as json
    local jPositions:=JSONObject():New() as json
    local jRow as json

    local lOK:=.F. as logical
    local lClean:=.T. as logical
    local lBulk:=.F. as logical
    local lCreated:=.F. as logical

    local nPreviousArea:=Select() as numeric
    local nFields:=0 as numeric
    local nWriteFields:=0 as numeric
    local nField:=0 as numeric
    local nRows:=0 as numeric
    local nRow:=0 as numeric
    local nPosition:=0 as numeric
    local nOrder:=0 as numeric

    local oPending as object

    local xError as variant

    paramtype 1 var cRDD as character optional default self:cRDD
    paramtype 2 var jProjectionFields as json optional
    cRDD:=Upper(AllTrim(cRDD))

    // A rejected driver request must not evict a page already bound to a UI.
    if (!NativeTableRDD(cRDD).or.;
        (cRDD!=self:cRDD.and.(!Empty(self:cStorageName).or.Select(cAlias)>0.or.ValType(self:oTable)=="O")))
        self:cErrorCode:=if(!NativeTableRDD(cRDD),"INVALID_PRESENTATION_RDD","PRESENTATION_RDD_CHANGE_REJECTED")
        self:cErrorMessage:=if(!NativeTableRDD(cRDD),;
            "Use TOPCONN, SQLITE_MEM or SQLITE_TMP for native storage.",;
            "Close the native table before changing its storage driver.")
        FreeObj(@jFields)
        FreeObj(@jColumns)
        FreeObj(@jSourceFields)
        FreeObj(@jIndexes)
        FreeObj(@jWriteColumns)
        FreeObj(@jPositions)
        return(.F.)
    endif
    if (Select(cAlias)>0)
        nOrder:=(cAlias)->(IndexOrd())
    endif
    // Invalidate the result while retaining the same physical table/workarea.
    // A bound table browse must not have its alias deleted/reopened on paging.
    if (!self:ClearPage())
        FreeObj(@jFields)
        FreeObj(@jColumns)
        FreeObj(@jSourceFields)
        FreeObj(@jIndexes)
        FreeObj(@jWriteColumns)
        FreeObj(@jPositions)
        return(.F.)
    endif
    self:cErrorCode:=""
    self:cErrorMessage:=""
    if (ValType(self:jCreatedIndexes)!="J")
        self:jCreatedIndexes:=JSONObject():New()
    endif
    if (ValType(self:jOwnedFiles)!="J")
        self:jOwnedFiles:=JSONObject():New()
    endif
    try
        cCode:="INVALID_PRESENTATION_METADATA"
        cMessage:="A native table requires an open typed dataset."
        if (ValType(self:oDataSet)!="O".or.ValType(self:jSchema)!="J")
            throw cCode
        endif
        jHeader:=self:oDataSet:Header()
        nFields:=self:oDataSet:FieldCount()
        nRows:=self:oDataSet:RowCount()
        if (nFields<1.or.nFields>999999999)
            throw cCode
        endif
        jRows:=self:oDataSet:GetRows()
        if (!HBBridgePresentationSchema():ConvertPage(jHeader,self:jSchema,jRows,@jConverted,@cCode,@cMessage))
            throw cCode
        endif
        FreeObj(@jRows)
        jRows:=jConverted
        jConverted:=nil
        aFields:=Array(nFields)
        for nField:=1 to nFields
            cField:=self:oDataSet:FieldName(nField)
            jDefinition:=self:jSchema["fields"][cField]
            cType:=NativeTableType(jDefinition["type"])
            cNative:="F"+StrZero(nField,9)
            jFields[cField]:=cNative
            jColumns[cNative]:=cField
            // Snapshot declared origin with this accepted page. The borrowed
            // dataset can later be reopened independently of native storage.
            jSourceFields[cField]:=jHeader[cField]["source"]["column"]
            jWriteColumns[cNative]:=cField
            aFields[nField]:={cNative,cType,jDefinition["length"],jDefinition["decimals"]}
            cSearch:=cNative
            if (cType=="L")
                // FWTemporaryTable skips indexes on logical fields. Keep the
                // real value logical and index a private native text shadow.
                cSearch:="L"+StrZero(nField,9)
                AAdd(aFields,{cSearch,"C",5,0})
                jWriteColumns[cSearch]:=cField
            endif
            jIndex:=JSONObject():New()
            jIndex["field"]:=cSearch
            jIndex["expression"]:=if(cType=="D","DTOS("+cSearch+")",cSearch)
            jIndex["order"]:=0
            // Existing physical orders belong to stable native columns. A
            // borrowed dataset may rename a projection between accepted pages.
            if (ValType(self:jColumns)=="J".and.ValType(self:jIndexes)=="J")
                if (self:jColumns:HasProperty(cNative))
                    cPreviousProjection:=self:jColumns[cNative]
                    if (self:jIndexes:HasProperty(cPreviousProjection))
                        jIndex["order"]:=self:jIndexes[cPreviousProjection]["order"]
                    endif
                endif
            endif
            jIndexes[cField]:=jIndex
            jIndex:=nil
        next nField
        nWriteFields:=Len(aFields)
        cCode:="PRESENTATION_CREATE_FAILED"
        cMessage:="Could not create the native result table."
        if (Select(cAlias)>0)
            oPending:=self:oTable
        else
            lCreated:=.T.
            self:cRDD:=cRDD
            self:cIndexStem:="HBB"+SubStr(StrTran(UUIDRandom(),"-",""),1,16)
            if (cRDD=="TOPCONN")
                oPending:=FWTemporaryTable():New(cAlias,aFields)
                self:cStorageName:=cAlias
                // Create storage without eager indexes. Indexing follows the
                // completed write, and only requested columns are indexed.
                oPending:Create()
                self:cStorageName:=oPending:GetTableNameForTCFunctions()
            else
                cTableName:=Lower("hbb_"+StrTran(UUIDRandom(),"-",""))
                self:cStorageName:=cTableName
                dbCreate(cTableName,aFields,cRDD)
                dbUseArea(.T./*lNewArea*/,cRDD,cTableName,cAlias,.F./*lShared*/,.F./*lReadOnly*/)
                NativeTableRememberFiles(cAlias,self:cStorageName,self:cIndexStem,self:jOwnedFiles)
            endif
        endif
        if (Select(cAlias)==0)
            throw cCode
        endif
        aActual:=(cAlias)->(DbStruct())
        if (Len(aActual)!=nWriteFields)
            cCode:="PRESENTATION_STORAGE_MISMATCH"
            cMessage:="The native table changed the physical field count."
            throw cCode
        endif
        for nField:=1 to nWriteFields
            nPosition:=(cAlias)->(FieldPos(aFields[nField][DBS_NAME]))
            if (nPosition<1)
                throw cCode
            endif
            jPositions[aFields[nField][DBS_NAME]]:=nPosition
            if (aActual[nPosition][DBS_TYPE]!=aFields[nField][DBS_TYPE].or.;
                aActual[nPosition][DBS_LEN]!=aFields[nField][DBS_LEN].or.;
                aActual[nPosition][DBS_DEC]!=aFields[nField][DBS_DEC])
                cCode:="PRESENTATION_STORAGE_MISMATCH"
                cMessage:="The native table changed a requested field definition."
                throw cCode
            endif
        next nField
        cCode:="PRESENTATION_WRITE_FAILED"
        cMessage:="Could not populate the native result table."
        if (nRows>0)
            if (cRDD=="TOPCONN")
                lBulk:=FWBulk():CanBulk()
            endif
            if (lBulk)
                cTableName:=oPending:GetTableNameForTCFunctions()
                if (!NativeTableBulk(cTableName,aFields,jRows,jWriteColumns,nRows))
                    throw cCode
                endif
                cWriteMode:="bulk"
                TCRefresh(cTableName)
            else
                cWriteMode:="record"
                for nRow:=1 to nRows
                    jRow:=jRows[tlpp.ToStr(nRow)]
                    (cAlias)->(DbAppend(.F.))
                    if ((cAlias)->(NetErr()))
                        throw cCode
                    endif
                    for nField:=1 to nWriteFields
                        cField:=jWriteColumns[aFields[nField][DBS_NAME]]
                        nPosition:=jPositions[aFields[nField][DBS_NAME]]
                        (cAlias)->(FieldPut(nPosition,NativeTableWriteValue(jRow[cField],aFields[nField][DBS_TYPE])))
                    next nField
                    (cAlias)->(DbCommit())
                    (cAlias)->(DbUnlock())
                next nRow
            endif
        endif
        // Full readback is opt-in diagnostic validation, not a second
        // production traversal. Native integration tests verify stored rows.
        if (self:lVerifyStorage)
            if (!NativeTableVerify(cAlias,aFields,jRows,jWriteColumns,jPositions,nRows))
                cCode:="PRESENTATION_STORAGE_MISMATCH"
                cMessage:="The native table did not preserve a converted value."
                throw cCode
            endif
        endif
        if (lCreated)
            cCode:="PRESENTATION_INDEX_FAILED"
            cMessage:="Could not create the initial native search index."
            cField:=self:oDataSet:FieldName(1)
            if (NativeTableEnsureOrder(cAlias,self:cIndexStem,self:cStorageName,;
                cField,jIndexes,self:jCreatedIndexes,self:jOwnedFiles)==0)
                throw cCode
            endif
            nOrder:=jIndexes[cField]["order"]
        endif
        (cAlias)->(DbSetOrder(nOrder))
        (cAlias)->(DbGoTop())
        if (lCreated)
            self:oTable:=oPending
            self:cRDD:=cRDD
        endif
        oPending:=nil
        FreeObj(@self:jFields)
        FreeObj(@self:jColumns)
        FreeObj(@self:jSourceFields)
        FreeObj(@self:jIndexes)
        self:jFields:=jFields
        jFields:=nil
        self:jColumns:=jColumns
        jColumns:=nil
        self:jSourceFields:=jSourceFields
        if (ValType(jProjectionFields)=="J")
            self:SetSourceFieldName(jProjectionFields)
        elseif (self:jSchema:HasProperty("projectionFields").and.(ValType(self:jSchema["projectionFields"])=="J"))
            self:SetSourceFieldName(self:jSchema["projectionFields"])
        endif
        jSourceFields:=nil
        self:jIndexes:=jIndexes
        jIndexes:=nil
        self:nRows:=nRows
        self:cWriteMode:=cWriteMode
        self:lReady:=.T.
        lOK:=.T.
    catch xError
        self:cErrorCode:=if(Empty(cCode),"PRESENTATION_FAILED",cCode)
        self:cErrorMessage:=if(Empty(cMessage),"Could not build the native presentation.",cMessage)
        if (ValType(xError)=="O")
            FreeObj(@xError)
        endif
    endtry
    if (!lOK)
        if (lCreated)
            if (cRDD=="TOPCONN".and.ValType(oPending)=="O")
                lClean:=NativeTableDelete(@oPending,cAlias)
                if (!lClean)
                    self:oTable:=oPending
                endif
            elseif (cRDD!="TOPCONN")
                lClean:=NativeTableLocalDelete(cAlias,self:cStorageName,self:cIndexStem,self:jOwnedFiles)
            endif
            if (lClean)
                self:cStorageName:=""
                FreeObj(@self:jCreatedIndexes)
                FreeObj(@self:jOwnedFiles)
            else
                self:cErrorCode:="PRESENTATION_CLOSE_FAILED"
                self:cErrorMessage:="Could not release the unpublished native result table."
            endif
        elseif (Select(cAlias)>0.or.ValType(self:oTable)=="O")
            // Do not publish a partial refill; preserve the empty bound alias.
            lClean:=self:ClearPage()
            oPending:=nil
        endif
    endif
    if (Select(cAlias)>0)
        (cAlias)->(DbSetOrder(nOrder))
    endif
    if (Select()!=nPreviousArea)
        DbSelectArea(if(nPreviousArea>0,nPreviousArea,nil))
    endif

    FWFreeArray(@aFields)
    FWFreeArray(@aActual)

    FreeObj(@jHeader)
    FreeObj(@jRows)
    FreeObj(@jConverted)
    FreeObj(@jFields)
    FreeObj(@jColumns)
    FreeObj(@jSourceFields)
    FreeObj(@jIndexes)
    FreeObj(@jWriteColumns)
    FreeObj(@jIndex)
    FreeObj(@jPositions)

return(lOK.and.lClean)

method ClearPage() class HBBridgeNativeTable

    local lOK:=.T. as logical

    local nPreviousArea:=Select() as numeric
    local nOrder:=0 as numeric

    local xError as variant

    self:lReady:=.F.
    self:nRows:=0
    self:cWriteMode:=""
    if (ValType(self:oTable)=="O")
        try
            if (Empty(self:cAlias).or.Select(self:cAlias)==0)
                throw "PRESENTATION_STORAGE_CLOSED"
            endif
            nOrder:=(self:cAlias)->(IndexOrd())
            // Clear rows without deleting/recreating the alias or its indexes.
            self:oTable:Zap()
            (self:cAlias)->(DbSetOrder(nOrder))
            (self:cAlias)->(DbGoTop())
            if ((self:cAlias)->(!Eof()))
                throw "PRESENTATION_CLEAR_FAILED"
            endif
        catch xError
            lOK:=.F.
            self:cErrorCode:="PRESENTATION_CLEAR_FAILED"
            self:cErrorMessage:="Could not clear the native current-page table."
            if (ValType(xError)=="O")
                FreeObj(@xError)
            endif
        endtry
    elseif (Select(self:cAlias)>0)
        try
            nOrder:=(self:cAlias)->(IndexOrd())
            // Clear rows without deleting/recreating the alias or its indexes.
            (self:cAlias)->(__dbZap())
            (self:cAlias)->(DbSetOrder(nOrder))
            (self:cAlias)->(DbGoTop())
            if ((self:cAlias)->(!Eof()))
                throw "PRESENTATION_CLEAR_FAILED"
            endif
        catch xError
            lOK:=.F.
            self:cErrorCode:="PRESENTATION_CLEAR_FAILED"
            self:cErrorMessage:="Could not clear the native current-page table."
            if (ValType(xError)=="O")
                FreeObj(@xError)
            endif
        endtry
    endif
    if (Select()!=nPreviousArea)
        DbSelectArea(if(nPreviousArea>0,nPreviousArea,nil))
    endif

return(lOK)

method Close() class HBBridgeNativeTable

    local lOK:=.T. as logical

    local nPreviousArea:=if((Alias()!=self:cAlias),Select(),0) as numeric

    self:lReady:=.F.
    self:cWriteMode:=""
    if (ValType(self:oTable)=="O")
        lOK:=NativeTableDelete(@self:oTable,self:cAlias)
    elseif (self:cRDD=="SQLITE_MEM".or.self:cRDD=="SQLITE_TMP")
        lOK:=NativeTableLocalDelete(self:cAlias,self:cStorageName,self:cIndexStem,self:jOwnedFiles)
    endif
    if (Select()!=nPreviousArea)
        DbSelectArea(if(nPreviousArea>0,nPreviousArea,nil))
    endif
    if (lOK)
        if (!Empty(self:cAlias).and.(Select(self:cAlias)>0))
            (self:cAlias)->(dbCloseArea())
        endif
        self:nRows:=0
        self:cStorageName:=""
        FreeObj(@self:jFields)
        FreeObj(@self:jColumns)
        FreeObj(@self:jSourceFields)
        FreeObj(@self:jIndexes)
        FreeObj(@self:jCreatedIndexes)
        FreeObj(@self:jOwnedFiles)
    else
        self:cErrorCode:="PRESENTATION_CLOSE_FAILED"
        self:cErrorMessage:="Could not release the native result table."
    endif

return(lOK)

method Destroy() class HBBridgeNativeTable

    local lOK:=self:Close() as logical
    if (lOK)
        self:cAlias:=""
        FreeObj(@self:jSchema)
        self:oDataSet:=nil
    endif

return(lOK)

method Alias() class HBBridgeNativeTable
return(if(self:IsOpen(),self:cAlias,""))

method FieldPos(xProjection) class HBBridgeNativeTable
    local nFieldPos:=0 as numeric
    paramtype 1 var xProjection as character,numeric
    if (self:IsOpen())
        if (ValType(xProjection)=="N")
            xProjection:=self:ProjectionName(xProjection)
        endif
        nFieldPos:=(self:cAlias)->(FieldPos(self:FieldName(xProjection)))
        return(nFieldPos)
    endif
return(nFieldPos)

method FieldGet(xProjection) class HBBridgeNativeTable
    local nFieldPos as numeric
    local xFieldGet as variant
    paramtype 1 var xProjection as character,numeric
    if (self:IsOpen())
        if (ValType(xProjection)=="N")
            xProjection:=self:ProjectionName(xProjection)
        endif
        nFieldPos:=self:FieldPos(xProjection)
        if (nFieldPos>0)
            xFieldGet:=(self:cAlias)->(FieldGet(nFieldPos))
            return(xFieldGet)
        endif
    endif
return(xFieldGet)

method FieldName(cProjection) class HBBridgeNativeTable
    paramtype 1 var cProjection as character
    if (self:IsOpen().and.ValType(self:jFields)=="J")
        if (self:jFields:HasProperty(cProjection))
            return(self:jFields[cProjection])
        endif
    endif
return("")

method FieldCaption(cProjection) class HBBridgeNativeTable

    paramtype 1 var cProjection as character

    if (self:IsOpen().and.ValType(self:jFields)=="J")
        if (self:jFields:HasProperty(cProjection))
            return(self:jSchema["fields"][cProjection]["caption"])
        endif
    endif

return("")

method SourceFieldPos(cProjection,lUseProjetcionRet) class HBBridgeNativeTable

    local cResolved:="" as character

    paramtype 1 var cProjection as character
    paramtype 2 var lUseProjetcionRet as logical optional default .T.

    if (self:IsOpen().and.ValType(self:jSourceFields)=="J")
        cResolved:=NativeTableSourceProjection(self:jSourceFields,cProjection,lUseProjetcionRet)
        if (!Empty(cResolved))
            return(self:FieldPos(cResolved))
        endif
    endif

return(0)

method SourceFieldGet(cProjection,lUseProjetcionRet) class HBBridgeNativeTable

    local nPosition:=0 as numeric

    paramtype 1 var cProjection as character
    paramtype 2 var lUseProjetcionRet as logical optional default .T.

    nPosition:=self:SourceFieldPos(cProjection,lUseProjetcionRet)
    if (nPosition>0)
        return((self:cAlias)->(FieldGet(nPosition)))
    endif

return(nil)

method SourceFieldName(cProjection) class HBBridgeNativeTable

    paramtype 1 var cProjection as character

    if (self:IsOpen().and.ValType(self:jSourceFields)=="J")
        if (self:jSourceFields:HasProperty(cProjection))
            if (;
                    (ValType(self:jSourceFields[cProjection])=="C");
                    .and.;
                    (!Empty(self:jSourceFields[cProjection]));
            )
                return(self:jSourceFields[cProjection])
            endif
        endif
    endif

return("")

method SourceFieldCaption(cProjection,lUseProjetcionRet) class HBBridgeNativeTable

    local cResolved:="" as character

    paramtype 1 var cProjection as character
    paramtype 2 var lUseProjetcionRet as logical optional default .T.

    if (self:IsOpen().and.ValType(self:jSourceFields)=="J")
        cResolved:=NativeTableSourceProjection(self:jSourceFields,cProjection,lUseProjetcionRet)
        if (!Empty(cResolved))
            return(self:FieldCaption(cResolved))
        endif
    endif

return("")

method SetSourceFieldName(jProjectionFields,lForce) class HBBridgeNativeTable
    local jSourceFields as json
    paramtype 1 var jProjectionFields as json
    paramtype 2 var lForce as logical optional default .F.
    if (ValType(self:jSourceFields)=="J")
        //Fix: "Invalid call to a PRIVATE data named JSOURCEFIELDS"
        jSourceFields:=self:jSourceFields
        aEval(jProjectionFields:GetNames(),;
            {|cName|;
                if(;
                    jSourceFields:HasProperty(cName).and.(Empty(jSourceFields[cName]).or.lForce),;
                    jSourceFields[cName]:=jProjectionFields[cName],;
                    nil;
                );
            };
        )
        jSourceFields:=nil
    else
        self:jSourceFields:=JSONObject():New()
        self:jSourceFields:FromJSON(jProjectionFields:ToJSON())
    endif
return

method SearchFieldName(cProjection) class HBBridgeNativeTable
    paramtype 1 var cProjection as character
    if (self:IsOpen().and.ValType(self:jIndexes)=="J")
        if (self:jIndexes:HasProperty(cProjection))
            return(self:jIndexes[cProjection]["field"])
        endif
    endif
return("")

method IndexOrder(cProjection) class HBBridgeNativeTable
    paramtype 1 var cProjection as character
    if (self:IsOpen().and.ValType(self:jIndexes)=="J")
        if (self:jIndexes:HasProperty(cProjection))
            return(self:jIndexes[cProjection]["order"])
        endif
    endif
return(0)

method EnsureIndex(cProjection) class HBBridgeNativeTable

    local nPreviousArea:=Select() as numeric
    local nOrder:=0 as numeric

    paramtype 1 var cProjection as character

    if (!self:IsOpen())
        self:cErrorCode:="PRESENTATION_STORAGE_CLOSED"
        self:cErrorMessage:="Open a native page before requesting a search index."
        return(0)
    endif
    if (!self:jIndexes:HasProperty(cProjection))
        self:cErrorCode:="PRESENTATION_INDEX_UNKNOWN"
        self:cErrorMessage:="Select a projected native column for indexing."
        return(0)
    endif
    self:cErrorCode:=""
    self:cErrorMessage:=""
    nOrder:=NativeTableEnsureOrder(self:cAlias,self:cIndexStem,self:cStorageName,;
        cProjection,self:jIndexes,self:jCreatedIndexes,self:jOwnedFiles)
    if (nOrder==0)
        self:cErrorCode:="PRESENTATION_INDEX_FAILED"
        self:cErrorMessage:="Could not create the requested native search index."
    endif
    if (Select()!=nPreviousArea)
        DbSelectArea(if(nPreviousArea>0,nPreviousArea,nil))
    endif

return(nOrder)

method RDD() class HBBridgeNativeTable
return(self:cRDD)

method IsOpen() class HBBridgeNativeTable
return(self:lReady.and.!Empty(self:cAlias).and.Select(self:cAlias)>0)

method FieldCount() class HBBridgeNativeTable

    local aNames as array

    local nCount:=0 as numeric

    if (self:IsOpen())
        aNames:=self:jColumns:GetNames()
        nCount:=Len(aNames)
        FWFreeArray(@aNames)
    endif

return(nCount)

method ProjectionName(xPosition) class HBBridgeNativeTable

    if (self:IsOpen())
        if (ValType(xPosition)=="C")
            if (self:jColumns:HasProperty(xPosition))
                return(self:jColumns[xPosition])
            endif
        elseif (ValType(xPosition)=="N")
            if (xPosition>=1.and.xPosition==Int(xPosition).and.xPosition<=999999999)
                if (self:jColumns:HasProperty("F"+StrZero(xPosition,9)))
                    return(self:jColumns["F"+StrZero(xPosition,9)])
                endif
            endif
        endif
    endif
return("")

method Schema() class HBBridgeNativeTable

    local jSnapshot:=JSONObject():New() as json

    if (ValType(self:jSchema)=="J")
        HBBridgeJSON():Parse(HBBridgeJSON():Encode(self:jSchema),jSnapshot)
    endif

return(jSnapshot)

method RowCount() class HBBridgeNativeTable
return(if(self:IsOpen(),self:nRows,0))

method WriteMode() class HBBridgeNativeTable
return(if(self:IsOpen(),self:cWriteMode,""))

method ErrorCode() class HBBridgeNativeTable
return(self:cErrorCode)

method ErrorMessage() class HBBridgeNativeTable
return(self:cErrorMessage)

static function NativeTableType(cType as character) as character
    do case
    case cType=="character"
        return("C")
    case cType=="numeric"
        return("N")
    case cType=="logical"
        return("L")
    case cType=="date"
        return("D")
    endcase
return("")

static function NativeTableSame(xStored as variant,xExpected as variant,cType as character,nLength as numeric) as logical
    if (ValType(xStored)!=ValType(xExpected))
        return(.F.)
    endif
    if (cType=="C")
        // Native fixed-width characters are space padded, never truncated.
        return(xStored==PadR(xExpected,nLength))
    endif
return(xStored==xExpected)

static function NativeTableWriteValue(xValue as variant,cNativeType as character) as variant
    if (cNativeType=="C".and.ValType(xValue)=="L")
        return(if(xValue,"True","False"))
    endif
return(xValue)

static function NativeTableRDD(cRDD as character) as logical
return(cRDD=="TOPCONN".or.cRDD=="SQLITE_MEM".or.cRDD=="SQLITE_TMP")

static function NativeTableCreatedCount(jCreated as json) as numeric

    // GetNames is the JSONObject enumeration boundary.
    local aNames:=jCreated:GetNames() as array

    local nCount:=Len(aNames) as numeric

    FWFreeArray(@aNames)

return(nCount)

static function NativeTableOpenOrders(cAlias as character,jCreated as json,cNewBag as character,cNewExpression as character) as logical

    local cKey:="" as character
    local cExpression:="" as character

    local nOrder:=0 as numeric
    local nOrders:=NativeTableCreatedCount(jCreated) as numeric

    (cAlias)->(DbClearIndex())
    for nOrder:=1 to nOrders
        cKey:=tlpp.ToStr(nOrder)
        (cAlias)->(DbSetIndex(jCreated[cKey]["bag"]))
        cExpression:=Upper(StrTran(AllTrim((cAlias)->(IndexKey(nOrder)))," ",""))
        if (cExpression!=jCreated[cKey]["expression"])
            return(.F.)
        endif
    next nOrder
    if (!Empty(cNewBag))
        (cAlias)->(DbSetIndex(cNewBag))
        cExpression:=Upper(StrTran(AllTrim((cAlias)->(IndexKey(nOrders+1)))," ",""))
        if (cExpression!=cNewExpression)
            return(.F.)
        endif
        nOrders++
    endif

return((cAlias)->(DbOrderInfo(9))==nOrders)

static function NativeTableEnsureOrder(cAlias as character,cIndexStem as character,cStorageName as character,;
    cProjection as character,jIndexes as json,jCreated as json,jOwnedFiles as json) as numeric

    local bExpression as codeblock

    local cBag:="" as character
    local cExpression:="" as character
    local cPath:="" as character

    local jIndex as json
    local jCreatedIndex as json

    local lOK:=.F. as logical

    local nOrder:=0 as numeric
    local nOrders:=NativeTableCreatedCount(jCreated) as numeric
    local nPreviousOrder:=(cAlias)->(IndexOrd()) as numeric
    local nPreviousRecord:=(cAlias)->(RecNo()) as numeric

    local xError as variant

    jIndex:=jIndexes[cProjection]
    nOrder:=jIndex["order"]
    cExpression:=jIndex["expression"]
    if (nOrder>0)
        if (Upper(StrTran(AllTrim((cAlias)->(IndexKey(nOrder)))," ",""))==cExpression)
            return(nOrder)
        endif
        return(0)
    endif
    // The private table owns these orders. Do not close an unexpected external
    // index or infer physical order numbers from projection positions.
    if ((cAlias)->(DbOrderInfo(9))!=nOrders)
        return(0)
    endif
    nOrder:=nOrders+1
    cBag:=cIndexStem+"_"+StrZero(nOrder,9)
    try
        // All identifiers originate in generated native fields. Compile the
        // expression value now; a {||cField} block would return a name string.
        bExpression:=&("{||"+cExpression+"}")
        // No TAG: OrdCreate follows documented DBCreateIndex behavior on
        // TOPCONN and SQLite, including closing previously opened orders.
        (cAlias)->(OrdCreate(cBag,nil,cExpression,bExpression,.F.))
        cPath:=(cAlias)->(DbOrderInfo(20))
        NativeTableRememberPath(cPath,cStorageName,cIndexStem,jOwnedFiles)
        NativeTableRememberPath(cBag,cStorageName,cIndexStem,jOwnedFiles)
        NativeTableRememberPath(cBag+".sdb",cStorageName,cIndexStem,jOwnedFiles)
        NativeTableRememberPath(cBag+".cdx",cStorageName,cIndexStem,jOwnedFiles)
        NativeTableRememberPath(cBag+".idx",cStorageName,cIndexStem,jOwnedFiles)
        if (!NativeTableOpenOrders(cAlias,jCreated,cBag,cExpression))
            throw "PRESENTATION_INDEX_FAILED"
        endif
        jCreatedIndex:=JSONObject():New()
        jCreatedIndex["bag"]:=cBag
        jCreatedIndex["expression"]:=cExpression
        jCreated[tlpp.ToStr(nOrder)]:=jCreatedIndex
        jCreatedIndex:=nil
        jIndex["order"]:=nOrder
        lOK:=.T.
    catch xError
        if (ValType(xError)=="O")
            FreeObj(@xError)
        endif
        // A driver can create an index artifact before reporting failure.
        NativeTableRememberPath(cBag,cStorageName,cIndexStem,jOwnedFiles)
        NativeTableRememberPath(cBag+".sdb",cStorageName,cIndexStem,jOwnedFiles)
        NativeTableRememberPath(cBag+".cdx",cStorageName,cIndexStem,jOwnedFiles)
        NativeTableRememberPath(cBag+".idx",cStorageName,cIndexStem,jOwnedFiles)
        // Reopen only published, owned indexes if creating a new one failed.
        try
            NativeTableOpenOrders(cAlias,jCreated,"","")
        catch xError
            if (ValType(xError)=="O")
                FreeObj(@xError)
            endif
        endtry
    endtry
    if (Select(cAlias)>0)
        (cAlias)->(DbSetOrder(if(nPreviousOrder<=(cAlias)->(DbOrderInfo(9)),nPreviousOrder,0)))
        if (nPreviousRecord>0)
            (cAlias)->(DbGoTo(nPreviousRecord))
        endif
    endif
    FreeObj(@jCreatedIndex)

return(if(lOK,nOrder,0))

static function NativeTableBaseName(cPath as character) as character

    local cName:=StrTran(cPath,"/","\") as character

    local nSeparator:=RAt("\",cName) as numeric

return(if(nSeparator>0,SubStr(cName,nSeparator+1),cName))

static function NativeTableOwnPath(cPath as character,cStorageName as character,cIndexStem as character) as logical

    local cName:=Lower(NativeTableBaseName(cPath)) as character
    local cTable:=Lower(NativeTableBaseName(cStorageName)) as character
    local cIndex:=Lower(cIndexStem) as character

    if (Empty(cName).or.(Chr(0)$cName))
        return(.F.)
    endif
    // A shared SQLite connection/container is never an owned file merely
    // because DBInfo returned it. Match the generated unique owner namespace.
return((!Empty(cTable).and.(cName==cTable.or.Left(cName,Len(cTable)+1)==cTable+".".or.;
    Left(cName,Len(cTable)+1)==cTable+"-")).or.;
    (!Empty(cIndex).and.Left(cName,Len(cIndex)+1)==cIndex+"_"))

static function NativeTableRememberPath(cPath as character,cStorageName as character,cIndexStem as character,jOwnedFiles as json)

    if (ValType(cPath)=="C".and.ValType(jOwnedFiles)=="J")
        if (NativeTableOwnPath(cPath,cStorageName,cIndexStem).and.File(cPath,1,.F.))
            jOwnedFiles[cPath]:=.T.
        endif
    endif

return

static function NativeTableRememberFiles(cAlias as character,cStorageName as character,cIndexStem as character,jOwnedFiles as json)

    local cPath:="" as character

    if (!Empty(cAlias).and.Select(cAlias)>0)
        cPath:=(cAlias)->(DbInfo(DBI_FULLPATH))
        NativeTableRememberPath(cPath,cStorageName,cIndexStem,jOwnedFiles)
    endif
    NativeTableRememberPath(cStorageName,cStorageName,cIndexStem,jOwnedFiles)
    NativeTableRememberPath(cStorageName+".sdb",cStorageName,cIndexStem,jOwnedFiles)
    NativeTableRememberPath(cStorageName+".db",cStorageName,cIndexStem,jOwnedFiles)
    NativeTableRememberPath(cStorageName+".dbf",cStorageName,cIndexStem,jOwnedFiles)

return

static function NativeTableLocalDelete(cAlias as character,cStorageName as character,cIndexStem as character,jOwnedFiles as json) as logical

    local aFiles as array

    local cPath:="" as character

    local lOK:=.T. as logical

    local nFile:=0 as numeric
    local nFiles:=0 as numeric

    local xError as variant

    try
        NativeTableRememberFiles(cAlias,cStorageName,cIndexStem,jOwnedFiles)
        if (!Empty(cAlias).and.Select(cAlias)>0)
            (cAlias)->(DbCloseArea())
        endif
        if (ValType(jOwnedFiles)=="J")
            // Enumerate only exact files captured for this table/index owner.
            aFiles:=jOwnedFiles:GetNames()
            nFiles:=Len(aFiles)
            for nFile:=1 to nFiles
                cPath:=aFiles[nFile]
                if (!NativeTableOwnPath(cPath,cStorageName,cIndexStem))
                    lOK:=.F.
                elseif (File(cPath,1,.F.))
                    if (FErase(cPath,nil,.F.)!=0)
                        lOK:=.F.
                    endif
                endif
            next nFile
        endif
    catch xError
        lOK:=.F.
        if (ValType(xError)=="O")
            FreeObj(@xError)
        endif
    endtry
    FWFreeArray(@aFiles)

return(lOK.and.(Empty(cAlias).or.Select(cAlias)==0))

static function NativeTableVerify(cAlias as character,aFields as array,jRows as json,jColumns as json,jPositions as json,nRows as numeric) as logical

    local cField:="" as character

    local jRow as json

    local nFields:=Len(aFields) as numeric
    local nField:=0 as numeric
    local nRow:=0 as numeric
    local nPosition:=0 as numeric

    local xStored as variant

    (cAlias)->(DbSetOrder(0))
    (cAlias)->(DbGoTop())
    (cAlias)->(DbSkip(0))
    for nRow:=1 to nRows
        if ((cAlias)->(Eof()))
            return(.F.)
        endif
        jRow:=jRows[tlpp.ToStr(nRow)]
        for nField:=1 to nFields
            cField:=jColumns[aFields[nField][DBS_NAME]]
            nPosition:=jPositions[aFields[nField][DBS_NAME]]
            xStored:=(cAlias)->(FieldGet(nPosition))
            if (!NativeTableSame(xStored,NativeTableWriteValue(jRow[cField],aFields[nField][DBS_TYPE]),aFields[nField][DBS_TYPE],aFields[nField][DBS_LEN]))
                return(.F.)
            endif
        next nField
        (cAlias)->(DbSkip())
    next nRow

return((cAlias)->(Eof()))

static function NativeTableSourceProjection(jSourceFields as json,cName as character,lUseProjectionRet as logical) as character

    // JSONObject exposes property names through this native array API. One
    // snapshot avoids repeated allocations while resolving an original name.
    local aNames:=jSourceFields:GetNames() as array

    local cProjection:="" as character
    local cCurrent:="" as character

    local nName:=0 as numeric
    local nNames:=Len(aNames) as numeric
    local nMatches:=0 as numeric

    for nName:=1 to nNames
        cCurrent:=aNames[nName]
        if (ValType(jSourceFields[cCurrent])=="C")
            if (!Empty(jSourceFields[cCurrent]).and.jSourceFields[cCurrent]==cName)
                nMatches++
                cProjection:=cCurrent
                if (nMatches>1)
                    cProjection:=""
                    exit
                endif
            endif
        endif
    next nName
    // A known unique origin takes precedence over a homonymous projection,
    // including when that projection has no reported origin. Ambiguity never
    // falls back silently; callers can use FieldPos/Get/Caption explicitly.
    if (nMatches==0.and.lUseProjectionRet.and.jSourceFields:HasProperty(cName))
        cProjection:=cName
    endif
    FWFreeArray(@aNames)

return(cProjection)

static function NativeTableBulk(cTableName as character,aFields as array,jRows as json,jColumns as json,nRows as numeric) as logical

    // FWBulk requires one positional values array in SetFields order. Only the
    // current row is staged here; the class owns its bounded internal buffer.
    local aValues as array

    local cField:="" as character

    local jRow as json

    local lOK:=.F. as logical
    local lClosed:=.F. as logical

    local nFields:=Len(aFields) as numeric
    local nField:=0 as numeric
    local nRow:=0 as numeric

    local oBulk as object

    local xError as variant

    try
        oBulk:=FWBulk():New(cTableName,1024)
        // Only already validated native values enter the bulk. Option 1
        // formats decimals to the declared scale; readback rejects any loss.
        oBulk:SetOption(1)
        oBulk:SetFields(aFields)
        for nRow:=1 to nRows
            jRow:=jRows[tlpp.ToStr(nRow)]
            aValues:=Array(nFields)
            for nField:=1 to nFields
                cField:=jColumns[aFields[nField][DBS_NAME]]
                aValues[nField]:=NativeTableWriteValue(jRow[cField],aFields[nField][DBS_TYPE])
            next nField
            // True covers both queued data and an automatic buffer flush.
            if (!oBulk:AddData(aValues))
                throw "PRESENTATION_WRITE_FAILED"
            endif
        next nRow
        if (!oBulk:Flush())
            throw "PRESENTATION_WRITE_FAILED"
        endif
        if (!oBulk:Close())
            throw "PRESENTATION_WRITE_FAILED"
        endif
        lClosed:=.T.
        lOK:=.T.
    catch xError
        if (ValType(xError)=="O")
            FreeObj(@xError)
        endif
    endtry
    if (ValType(oBulk)=="O")
        try
            // Close also flushes cached data. After a failed operation, never
            // retry that buffer; destroy it and let the owner delete the table.
            oBulk:Destroy()
        catch xError
            lOK:=.F.
            if (ValType(xError)=="O")
                FreeObj(@xError)
            endif
        endtry
        try
            // Release the object even when its explicit cleanup raised.
            FreeObj(@oBulk)
        catch xError
            lOK:=.F.
            if (ValType(xError)=="O")
                FreeObj(@xError)
            endif
        endtry
    endif
    FWFreeArray(@aValues)

return(lOK.and.lClosed)

static function NativeTableDelete(oTable as object,cAlias as character) as logical

    local lOK:=.T. as logical

    local xResult as variant
    local xError as variant

    try
        xResult:=oTable:Delete()
        if (!Empty(cAlias).and.Select(cAlias)>0)
            (cAlias)->(dbCloseArea())
        endif
        if (ValType(xResult)=="L")
            lOK:=xResult
        endif
        if (!Empty(cAlias).and.Select(cAlias)>0)
            lOK:=.F.
        endif
        if (lOK)
            FreeObj(@oTable)
        endif
    catch xError
        lOK:=.F.
        if (ValType(xError)=="O")
            FreeObj(@xError)
        endif
    endtry

return(lOK)
