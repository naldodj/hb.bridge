*/

#include "totvs.ch"
#include "dbinfo.ch"
#include "dbstruct.ch"
#include "parmtype.ch"

namespace HBBridge.Client

class HBBridgeMsMGetEx
    static method ViewData(cAlias as character,nRecNo as numeric,cTitle as character,aButtons as array,aAcho as array,oNativeTable as object) as variant
end class

static method ViewData(cAlias,nRecNo,cTitle,aButtons,aAcho,oNativeTable) class HBBridgeMsMGetEx

    local aFields as array
    local adbStruct as array
    local aMsMGetPos as array

    local bMsMGet as codeblock
    local bErrorBlock as codeblock

    local cVar as character
    local cField as character
    local cTable as character
    local cDlgTitle as character
    local cFil as character
    local cSVFilAnt as character
    local cFieldFil as character
    local cX3Relacao as character
    local cProjection as character
    local cDictionaryField as character

    local jAcho as json

    local lAcho as logical
    local lMsMGet as logical
    local lProperty:=.T. as logical
    local lNativeTable as logical

    local lMVCOMBOBOX as logical
    local l__MVCOMBOBOX as logical

    local nField as numeric
    local nFields as numeric
    local nATField as numeric
    local nFieldFil as numeric
    local nTop as numeric
    local nLeft as numeric
    local nBottom as numeric
    local nRight as numeric

    local oDlg as object
    local oMsMGet as object
    local oFWDefSize as object

    local xRet as variant
    local xValue as variant

    paramtype 1 var cAlias as character
    paramtype 2 var nRecNo as numeric
    paramtype 3 var cTitle as character
    paramtype 4 var aButtons as array optional
    paramtype 5 var aAcho as array optional
    paramtype 6 var oNativeTable as object optional

    SaveInter()

        lAcho:=(!Empty(aAcho))
        lNativeTable:=((ValType(oNativeTable)=="O").and.(GetClassName(oNativeTable)=="HBBRIDGE.CLIENT.HBBRIDGENATIVETABLE"))

        l__MVCOMBOBOX:=(type("__MVCOMBOBOX")=="L")
        if (l__MVCOMBOBOX)
            lMVCOMBOBOX:=&("__MVCOMBOBOX")
        endif

        (cAlias)->(MsGoTo(nRecNo))

        cFieldFil:=PrefixoCpo(cAlias)
        cFieldFil+="_FILIAL"
        nFieldFil:=(cAlias)->(FieldPos(cFieldFil))

        private cCadastro:=cTitle as character

        //Viewing the record
        cTable:=(cAlias)->(HBBridge.SQL.Tools.HBBridgeSqlTools():GetTableName(cAlias))
        if (FWSX2Util():SeekX2File(cTable).and.(nFieldFil>0))

            //AxVisual

            cSVFilAnt:=&("cFilAnt")
            cFil:=(cAlias)->(FieldGet(nFieldFil))

            if (cSVFilAnt!=cFil)
                RPCSetEmpFil(cEmpAnt,cFil)
            endif

            xRet:=AxVisual(cAlias,nRecNo,2,aAcho,nil,nil,nil,aButtons)

            RPCSetEmpFil(cEmpAnt,cSVFilAnt)

        else //MsMGet

            if (lAcho)
                jAcho:=JSONObject():New()
                aEval(aAcho,{|cField|jAcho[cField]:=.T.})
            endif

            aFields:=Array(0)
            adbStruct:=(cAlias)->(dbStruct())
            nFields:=Len(adbStruct)
            for nField:=1 to nFields
                cField:=adbStruct[nField][DBS_NAME]
                cProjection:=cField
                cDictionaryField:=cField
                if (lNativeTable)
                    cProjection:=oNativeTable:ProjectionName(cField)
                    // Logical search shadows belong to native storage only.
                    if (Empty(cProjection))
                        loop
                    endif
                    cDictionaryField:=oNativeTable:SourceFieldName(cProjection)
                    if (Empty(cDictionaryField))
                        cDictionaryField:=cProjection
                    endif
                endif
                if (lAcho)
                    if (!jAcho:HasProperty(cDictionaryField).and.;
                        !jAcho:HasProperty(cProjection).and.!jAcho:HasProperty(cField))
                        loop
                    endif
                endif
                // Use the original field in MsMGet and M-> so Protheus keeps
                // its dictionary-specific behavior, including RA_BITMAP.
                // The projection still resolves the caption and native value.
                cVar:=("M->"+cDictionaryField)
                xValue:=(cAlias)->(FieldGet(nField))
                if ((empty(xValue).and.!Empty(cX3Relacao:=GetSX3Cache(cDictionaryField,"X3_RELACAO"))))
                    bErrorBlock:=ErrorBlock({|e|Break(e)})
                    begin sequence
                        xValue:=&(cX3Relacao)
                    end sequence
                    ErrorBlock(bErrorBlock)
                endif
                private &(cVar):=xValue as variant
                aAdd(aFields,Array(18))
                nATField:=Len(aFields)
                if (lNativeTable)
                    aFields[nATField][1]:=oNativeTable:FieldCaption(cProjection)//-> caption
                    if (Empty(aFields[nATField][1]))
                        aFields[nATField][1]:=GetSX3Cache(cDictionaryField,"X3_TITULO")//-> caption
                    endif
                else
                    aFields[nATField][1]:=GetSX3Cache(cDictionaryField,"X3_TITULO")//-> caption
                endif
                DEFAULT aFields[nATField][1]:=cDictionaryField//cProjection
                aFields[nATField][2]:=cDictionaryField//-> field
                aFields[nATField][3]:=GetSX3Cache(cDictionaryField,"X3_TIPO")//-> type
                DEFAULT aFields[nATField][3]:=adbStruct[nField][DBS_TYPE]
                if (aFields[nATField][3]<>adbStruct[nField][DBS_TYPE])
                    aFields[nATField][3]:=adbStruct[nField][DBS_TYPE]
                endif
                aFields[nATField][4]:=GetSX3Cache(cDictionaryField,"X3_TAMANHO")//-> length
                DEFAULT aFields[nATField][4]:=adbStruct[nField][DBS_LEN]
                if (aFields[nATField][4]<>adbStruct[nField][DBS_LEN])
                    aFields[nATField][4]:=adbStruct[nField][DBS_LEN]
                endif
                aFields[nATField][5]:=GetSX3Cache(cDictionaryField,"X3_DECIMAL")//-> decimal
                DEFAULT aFields[nATField][5]:=adbStruct[nField][DBS_DEC]
                aFields[nATField][6]:=GetSX3Cache(cDictionaryField,"X3_PICTURE")//-> picture
                DEFAULT aFields[nATField][6]:=""
                aFields[nATField][7]:=GetSX3Cache(cDictionaryField,"X3_VALID")//-> valid
                DEFAULT aFields[nATField][7]:="allWaysTrue()"
                aFields[nATField][8]:=.F.//-> required
                aFields[nATField][9]:=GetSX3Cache(cDictionaryField,"X3_NIVEL")//-> level
                DEFAULT aFields[nATField][9]:=0
                aFields[nATField][10]:=GetSX3Cache(cDictionaryField,"X3_RELACAO")//-> default initializer
                DEFAULT aFields[nATField][10]:=getValType(adbStruct[nField][DBS_TYPE])
                aFields[nATField][11]:=GetSX3Cache(cDictionaryField,"X3_F3")//-> F3
                DEFAULT aFields[nATField][11]:=""
                aFields[nATField][12]:=GetSX3Cache(cDictionaryField,"X3_WHEN")//-> when
                DEFAULT aFields[nATField][12]:=""
                aFields[nATField][13]:=.T.//-> visual
                aFields[nATField][14]:=.F.//-> key
                aFields[nATField][15]:=GetSX3Cache(cDictionaryField,"X3_CBOX") //-> box
                DEFAULT aFields[nATField][15]:=""
                aFields[nATField][16]:=GetSX3Cache(cDictionaryField,"X3_FOLDER")//-> folder
                DEFAULT aFields[nATField][16]:=""
                aFields[nATField][17]:=.T.//-> read-only
                aFields[nATField][18]:=GetSX3Cache(cDictionaryField,"X3_PICTVAR")//-> pictvar
                DEFAULT aFields[nATField][18]:=""
            next nField

            FreeObj(@jAcho)

            oFWDefSize:=FWDefSize():New(.T.,.T.)//With Enchoicebar
            oFWDefSize:lLateral:=.F.//Vertical calculation
            oFWDefSize:AddObject("ENCHOICE",100,60,.T.,.T.)//Add Enchoice

            oFWDefSize:Process()

            nTop:=oFWDefSize:aWindSize[1]
            nLeft:=oFWDefSize:aWindSize[2]
            nBottom:=oFWDefSize:aWindSize[3]
            nRight:=oFWDefSize:aWindSize[4]

            private aTela:=Array(0) as array
            private aGets:=Array(0) as array
            if (Type("lObfuscate")!="L")
                private lObfuscate:=.F. as logical
            endif

            cDlgTitle:=cTitle+" :: View"
            DEFINE MSDIALOG oDlg TITLE cTitle FROM nTop,nLeft TO nBottom,nRight PIXEL OF GetWNDDefault()

                aMsMGetPos:={;
                            oFWDefSize:GetDimension("ENCHOICE","LININI"),;
                            oFWDefSize:GetDimension("ENCHOICE","COLINI"),;
                            oFWDefSize:GetDimension("ENCHOICE","LINEND"),;
                            oFWDefSize:GetDimension("ENCHOICE","COLEND");
                }

                if (Type("aRotina")=="A")
                    if (2>Len(aRotina))
                        lProperty:=.T.
                    endif
                endif

                bMsMGet:={||oMsMGet:=MsMGet():New(;
                    cAlias,;//cAlias
                    nRecNo,;//nReg
                    2,;//nOpc
                    nil,;//aCRA
                    nil,;//cLetras
                    nil,;//cTexto
                    nil,;//aACho
                    aMsMGetPos,;//aPos
                    nil,;//aCpos
                    nil,;//nModelo
                    nil,;//nColMens
                    nil,;//cMensagem
                    nil,;//cTudoOk
                    nil,;//oWnd
                    nil,;//lF3
                    .T.,;//lMemoria
                    nil,;//lColumn
                    nil,;//caTela
                    nil,;//lNoFolder
                    lProperty,;//lProperty
                    aFields,;//aField
                    nil,;//aFolder
                    nil,;//lCreate
                    nil,;//lNoMDIStretch
                    nil;//cTela
                )}

                //An error may occur in creating the MsMGet if the content assigned to a field with X3_CBOX is different from the expected content...
                bErrorBlock:=ErrorBlock({|e|Break(e)})
                begin sequence
                    Eval(bMsMGet)
                    lMsMGet:=.T.
                recover
                    lMsMGet:=.F.
                end sequence
                ErrorBlock(bErrorBlock)
                if (!lMsMGet)
                    //In this case, if an initialization error occurs because of X3_CBOX, disable the variable below.
                    if (l__MVCOMBOBOX)
                        &("__MVCOMBOBOX"):=.F.
                        //Recreate MsMGet without the X3_CBOX contents
                        bErrorBlock:=ErrorBlock({|e|Break(e)})
                        begin sequence
                            Eval(bMsMGet)
                            lMsMGet:=.T.
                        recover
                            lMsMGet:=.F.
                        end sequence
                        ErrorBlock(bErrorBlock)
                    endif
                endif

                lMsMGet:=(((lMsMGet).and.(ValType(oMsMGet)=="O")))

                if (lMsMGet)
                    oMsMGet:oBox:align:=CONTROL_ALIGN_ALLCLIENT
                else
                    oDlg:Hide()
                endif

            if (lMsMGet)
                ACTIVATE MSDIALOG oDlg ON INIT EnchoiceBar(oDlg,{||oDlg:End()},{||oDlg:End()},nil,aButtons)
            else
                oDlg:End()
                MsAguarde({||Sleep(500)},cTitle,"View is unavailable.")
            endif

            xRet:=lMsMGet

        endif

        if (l__MVCOMBOBOX)
            __MVCOMBOBOX:=lMVCOMBOBOX
        endif

        FreeObj(@oDlg)
        FreeObj(@oMsMGet)
        FreeObj(@oFWDefSize)

        FWFreeArray(@aFields)
        FWFreeArray(@adbStruct)
        FWFreeArray(@aMsMGetPos)

        DelClassIntF()

    RestInter()

return(xRet)
