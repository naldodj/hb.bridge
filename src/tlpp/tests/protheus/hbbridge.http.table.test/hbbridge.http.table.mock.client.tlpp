/* Released to Public Domain. */
#include "tlpp-core.th"

namespace HBBridge.Tests

class HBBridgeHTTPTableMockClient

    private data jResponses as json
    private data jRequests as json
    private data nResponses as numeric
    private data nResponsesRead as numeric
    private data nCalls as numeric
    private data nUnexpectedCalls as numeric

    public method New() as object
    public method Queue(jResponse as json)
    public method CallService(cService as character, jParams as json) as json
    public method CallCount() as numeric
    public method UnexpectedCallCount() as numeric
    public method PendingResponseCount() as numeric
    public method Request(nCall as numeric) as json
    public method Close()

endclass

method New() class HBBridgeHTTPTableMockClient

    self:jResponses := JSONObject():New()
    self:jRequests := JSONObject():New()
    self:nResponses := 0
    self:nResponsesRead := 0
    self:nCalls := 0
    self:nUnexpectedCalls := 0

return(self)

method Queue(jResponse) class HBBridgeHTTPTableMockClient

    self:nResponses++
    // Serialized fixtures transfer a fresh response owned by each dataset.
    self:jResponses[tlpp.ToStr(self:nResponses)] := jResponse:ToJSON()

return

method CallService(cService, jParams) class HBBridgeHTTPTableMockClient

    local jResponse := JSONObject():New() as json
    local cKey := "" as character
    local cResponseKey := "" as character

    self:nCalls++
    cKey := tlpp.ToStr(self:nCalls)
    self:jRequests[cKey] := jParams:ToJSON()
    cResponseKey := tlpp.ToStr(self:nResponsesRead + 1)
    // Unexpected calls remain failures without skipping a future fixture.
    if cService == "RPCRDD.Query" .and. self:jResponses:HasProperty(cResponseKey)
        jResponse:FromJSON(self:jResponses[cResponseKey])
        self:nResponsesRead++
    else
        self:nUnexpectedCalls++
        jResponse["success"] := .F.
        jResponse["code"] := "MOCK_RESPONSE_MISSING"
        jResponse["error"] := "No table result was queued for this call."
    endif

return(jResponse)

method CallCount() class HBBridgeHTTPTableMockClient

return(self:nCalls)

method UnexpectedCallCount() class HBBridgeHTTPTableMockClient

return(self:nUnexpectedCalls)

method PendingResponseCount() class HBBridgeHTTPTableMockClient

return(self:nResponses - self:nResponsesRead)

method Request(nCall) class HBBridgeHTTPTableMockClient

    local jRequest := JSONObject():New() as json
    local cKey := tlpp.ToStr(nCall) as character

    if self:jRequests:HasProperty(cKey)
        jRequest:FromJSON(self:jRequests[cKey])
    endif

return(jRequest)

method Close() class HBBridgeHTTPTableMockClient

    local jResponses := self:jResponses as json
    local jRequests := self:jRequests as json

    self:jResponses := Nil
    self:jRequests := Nil
    if ValType(jResponses) == "J"
        FreeObj(@jResponses)
    endif
    if ValType(jRequests) == "J"
        FreeObj(@jRequests)
    endif

return
