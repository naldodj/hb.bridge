#include "totvs.ch"
#include "tbiconn.ch"

namespace HBBridge.Examples

procedure U_HBBridgeBrowseDataTestSX5()
    local cAlias := "SX5" as character

    local jParameters as json

    local lOwnArea as logical

    lOwnArea := (Select(cAlias)==0)
    jParameters := JSONObject():New()
    jParameters["cEmp"]:="99"
    jParameters["cFil"]:="01"
    beginContent var jParameters["cSQL"]
        SELECT SX5.* FROM SX5990 SX5 WHERE SX5.D_E_L_E_T_=' '
    endContent
    jParameters["bOpenTables"]:={||;
        ChkFile(cAlias);
        ,cAlias;
    }
    jParameters["jHBBridgeDataSetPage"]:=JSONObject():New()
    jParameters["jHBBridgeDataSetPage"]["number"]:=1
    jParameters["jHBBridgeDataSetPage"]["size"]:=18
    jParameters["jHBBridgeDataSetPage"]["orderBy"]:="X5_FILIAL,X5_TABELA,X5_CHAVE"
    jParameters["aAcho"]:={;
        "X5_FILIAL";
        ,"X5_TABELA";
        ,"X5_CHAVE";
        ,"X5_DESCRI";
    }
    jParameters["cATRecNoMsMGet"]:="R_E_C_N_O_"
    //TODO: Resolve this Workaround private __cPrefixQryAlias
    private __cPrefixQryAlias:="SX5" as character // TODO: Resolve aliases for common fields through HBBridgeSqlTools.
    U_HBBridgeBrowseDataTest(jParameters)
    if ((lOwnArea).and.(Select(cAlias)>0))
        (cAlias)->(dbCloseArea())
    endif
    FreeObj(@jParameters)
return
