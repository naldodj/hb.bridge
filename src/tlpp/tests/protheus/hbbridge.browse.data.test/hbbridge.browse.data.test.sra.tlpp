#include "totvs.ch"
#include "tbiconn.ch"

namespace HBBridge.Examples

procedure U_HBBridgeBrowseDataTestSRA()
    if (("MSSQL"$TCGetDB()).and.(Select("SX2")>0))
        HBBridgeBrowseDataTestSRA()
    endif
return

static procedure HBBridgeBrowseDataTestSRA()
    local cAliasTmp as character
    local cSRASQLName as character

    local jParameters as json

    local nColumn := 0 as numeric
    local nColumns := 0 as numeric

    cSRASQLName := RetSQLName("SRA")
    jParameters := JSONObject():New()
    jParameters["cEmp"]:=if((Type("cEmpAnt")=="C").and.!Empty(cEmpAnt),cEmpAnt,"99")
    jParameters["cFil"]:=if((Type("cFilAnt")=="C").and.!Empty(cFilAnt),cFilAnt,"01")
    jParameters["cSQLFields"]:=HBBridge.SQL.Tools.HBBridgeSqlTools():GetNonBlobColumns(cSRASQLName)
    if (Empty(jParameters["cSQLFields"]))
        FreeObj(@jParameters)
        return
    endif
    jParameters["cSQL"]:="SELECT "+jParameters["cSQLFields"]+" FROM "+cSRASQLName+" SRA WHERE SRA.D_E_L_E_T_=' '"
    jParameters["bOpenTables"]:={||;
        ChkFile("CTT");
        ,cAliasTmp:=GetNextAlias();
        ,ChkFile("SRA",.F.,cAliasTmp);
        ,cAliasTmp;
    }
    jParameters["jHBBridgeDataSetPage"]:=JSONObject():New()
    jParameters["jHBBridgeDataSetPage"]["number"]:=1
    jParameters["jHBBridgeDataSetPage"]["size"]:=18
    jParameters["jHBBridgeDataSetPage"]["orderBy"]:="RA_FILIAL,RA_MAT"
    jParameters["aAcho"]:=StrTokArr2(StrTran(StrTran(jParameters["cSQLFields"],"[",""),"]",""),",")
    // The browse API requires a native array of field names.
    nColumns := Len(jParameters["aAcho"])
    for nColumn:=1 to nColumns
        jParameters["aAcho"][nColumn]:=AllTrim(jParameters["aAcho"][nColumn])
    next nColumn
    jParameters["cATRecNoMsMGet"]:="R_E_C_N_O_"
    // TODO: Replace the private prefix workaround with an explicit browse option.
    private __cPrefixQryAlias:="SRA" as character
    U_HBBridgeBrowseDataTest(jParameters)
    if (Select(cAliasTmp)>0)
        (cAliasTmp)->(dbCloseArea())
    endif
    FreeObj(@jParameters)
return

procedure U_HBBridgeBrowseDataTestSRAWithCast()
    if (("MSSQL"$TCGetDB()).and.(Select("SX2")>0))
        HBBridgeBrowseDataTestSRAWithCast()
    endif
return

static procedure HBBridgeBrowseDataTestSRAWithCast()
    local cAliasTmp as character

    local jParameters:=JSONObject():New() as json
    jParameters["cEmp"]:=if((Type("cEmpAnt")=="C").and.!Empty(cEmpAnt),cEmpAnt,"99")
    jParameters["cFil"]:=if((Type("cFilAnt")=="C").and.!Empty(cFilAnt),cFilAnt,"01")
    beginContent var jParameters["cSQL"]
        SELECT SRA.RA_FILIAL
            ,SRA.RA_MAT
            ,SRA.RA_NOME
            ,CAST(SRA.RA_SALARIO AS DECIMAL(12,2)) AS RA_SALARIO
            ,CAST(SRA.RA_ADMISSA AS DATE) RA_ADMISSA
            ,SRA.RA_CC
            ,CTT.CTT_DESC01
            ,SRA.R_E_C_N_O_
        FROM SRA990 SRA
        LEFT JOIN CTT990 CTT
        ON CTT.CTT_FILIAL=(CASE CTT.CTT_FILIAL WHEN ' ' THEN ' ' ELSE LEFT(SRA.RA_FILIAL,LEN(SRA.RA_FILIAL)) END)
        AND CTT.CTT_CUSTO=SRA.RA_CC
        WHERE SRA.D_E_L_E_T_=' '
        AND CTT.D_E_L_E_T_=' '
    endContent
    jParameters["cSQL"]:=StrTran(jParameters["cSQL"],"SRA990",RetSQLName("SRA"))
    jParameters["cSQL"]:=StrTran(jParameters["cSQL"],"CTT990",RetSQLName("CTT"))
    jParameters["bOpenTables"]:={||;
        ChkFile("CTT");
        ,cAliasTmp:=GetNextAlias();
        ,ChkFile("SRA",.F.,cAliasTmp);
        ,cAliasTmp;
    }
    jParameters["jHBBridgeDataSetPage"]:=JSONObject():New()
    jParameters["jHBBridgeDataSetPage"]["number"]:=1
    jParameters["jHBBridgeDataSetPage"]["size"]:=18
    jParameters["jHBBridgeDataSetPage"]["orderBy"]:="RA_FILIAL,RA_MAT"
    jParameters["aAcho"]:={;
        "RA_FILIAL";
        ,"RA_MAT";
        ,"RA_NOME";
        ,"RA_SALARIO";
        ,"RA_ADMISSA";
        ,"RA_CC";
        ,"CTT_DESC01";
    }
    jParameters["cATRecNoMsMGet"]:="R_E_C_N_O_"
    // TODO: Replace the private prefix workaround with an explicit browse option.
    private __cPrefixQryAlias:="SRA" as character
    U_HBBridgeBrowseDataTest(jParameters)
    if (Select(cAliasTmp)>0)
        (cAliasTmp)->(dbCloseArea())
    endif
    FreeObj(@jParameters)
return
