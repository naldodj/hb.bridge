#include "totvs.ch"
#include "tbiconn.ch"

procedure U_HBBridgeBrowseDataTest(jParameters as json)
    if ((ValType(jParameters)=="J").and.(!Empty(jParameters:GetNames())))
        HBBridgeBrowseDataTest(jParameters)
    endif
return

static procedure HBBridgeBrowseDataTest(jParameters as json)

    local bExecute:={|jParameters as json|__Execute(jParameters)} as codeblock

    local cTitle as character

    if (Type("oMainWnd")!="O")
        cTitle:="HBBridgeBrowseDataTest"
        private oMainWnd as object
        DEFINE WINDOW oMainWnd FROM 00,00 TO 1024,768 TITLE OemToAnsi(cTitle)
            oMainWnd:oMsgBar:=TMsgBar():New(oMainWnd,Space(2)+OemToAnsi(GetVersao()),.F.,.F.,.F.,.F.,RGB(116,116,116),,,.F.,"fw_rodape_logo")
        ACTIVATE WINDOW oMainWnd MAXIMIZED ON INIT (Eval(bExecute,jParameters),oMainWnd:End())
        FreeObj(@oMainWnd)
    else
        Eval(bExecute,jParameters)
    endif

    DelClassIntF()

return

static procedure __Execute(jParameters as json)

    local aAcho as array
    local aFWBrwData as array
    local aFWGetTopInfo as array
    local aCustomButtons as array

    local cEmp as character
    local cFil as character

    local cSQL as character
    local cHost as character
    local cAlias as character
    local cATRecNoMsMGet as character
    local cIniFile as character
    local cAliasProfile as character

    local bLDblClick as codeblock

    local jHBBridgeDataSetPage as json

    local lAcho as logical
    local lRPCSetEnv:=(Select("SM0")==0) as logical

    local nPort as numeric
    local nTimeout as numeric

    local oClient as object
    local oDataSet as object
    local oFWBrowse as object

    if (lRPCSetEnv)
        cEmp:=if(jParameters:HasProperty("cEmp"),jParameters["cEmp"],"99")
        cFil:=if(jParameters:HasProperty("cFil"),jParameters["cFil"],"01")
        FWMsgRun(nil,{||RPCSetEnv(cEmp,cFil)},"Wait...")
    endif

        __SetCentury("ON")
        Set(4,"DD/MM/YYYY")

        begin sequence

            if (jParameters:HasProperty("cSQL").and.(!Empty(jParameters["cSQL"])))
                cSQL:=jParameters["cSQL"]
            else
                break
            endif

            if (jParameters:HasProperty("bOpenTables"))
                cAlias:=Eval(jParameters["bOpenTables"])
                if ((Empty(cAlias)).or.(Select(cAlias)==0))
                    break
                endif
            else
                break
            endif

            if (jParameters:HasProperty("cATRecNoMsMGet"))
                cATRecNoMsMGet:=jParameters["cATRecNoMsMGet"]
            else
                cATRecNoMsMGet:="R_E_C_N_O_"
            endif

            cIniFile:=GetSrvIniName()
            cHost:=GetPvProfString("hbBridge","Host","127.0.0.1",cIniFile)
            nPort:=Val(GetPvProfString("hbBridge","Port","1512",cIniFile))
            nTimeout:=30000

            oClient:=HBBridge.Client.HBBridgeClient():New(cHost,nPort,nTimeout)
            oDataSet:=HBBridge.RDD.HBBridgeRPCDataSet():New(oClient)

            aFWGetTopInfo:=FWGetTopInfo()
            cAliasProfile:=(aFWGetTopInfo[4]+"/"+aFWGetTopInfo[5])
            FWFreeArray(@aFWGetTopInfo)
            oDataSet:SetAliasProfile(cAliasProfile)

            if (jParameters:HasProperty("jHBBridgeDataSetPage"))
                jHBBridgeDataSetPage:=jParameters["jHBBridgeDataSetPage"]
            endif
            lAcho:=jParameters:HasProperty("aAcho")
            bLDblClick:={||;
                if(lAcho;
                    ,(;
                        aAcho:=if(;
                            MsgYesNo("Consultar todos os campos","HBBridge.Client.HBBridgeBrowseData");
                            ,nil;
                            ,jParameters["aAcho"];
                        );
                    );
                    ,nil;
                );
                ,if(oDataSet:FieldExist(cATRecNoMsMGet),HBBridge.Client.HBBridgeMsMGetEx():ViewData(cAlias,aFWBrwData[oFWBrowse:AT()][cATRecNoMsMGet],"HBBridge.Client.HBBridgeBrowseData",nil,aAcho),nil);
            }

            aCustomButtons:=Array(1,7)
            aCustomButtons[1][1]:="&Visualizar"
            aCustomButtons[1][2]:=bLDblClick
            aCustomButtons[1][3]:="Visualizar"
            aCustomButtons[1][4]:=nil
            aCustomButtons[1][5]:=.T.
            aCustomButtons[1][6]:=.F.
            aCustomButtons[1][7]:=.T.

            private lObfuscate:=.T. as logical
            private __lRedefineBottom:=.T. as logical

            HBBridge.Client.HBBridgeBrowseData():Browse(oDataSet,cSQL,jHBBridgeDataSetPage,@oFWBrowse,@aFWBrwData,"HBBridge.Client.HBBridgeBrowseData",bLDblClick,nil,aCustomButtons)

            FWFreeArray(@aAcho)
            FWFreeArray(@aFWBrwData)
            FWFreeArray(@aCustomButtons)

            FreeObj(@oClient)
            FreeObj(@oDataSet)
            FreeObj(@oFWBrowse)

            FreeObj(@jHBBridgeDataSetPage)

    end sequence

    if (lRPCSetEnv)
        RPCClearEnv()
    endif

return
