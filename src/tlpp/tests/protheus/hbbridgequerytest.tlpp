#include "hbbridge.h"
#include "protheus.ch"

procedure U_HBBridgeQueryTestMSSQL(cAliasProfile, cHost, nPort, nTimeout)
    DEFAULT cAliasProfile:="mssql/pData"
    DEFAULT cHost:="127.0.0.1"
    DEFAULT nPort:=1512
    DEFAULT nTimeout:=30000
    U_HBBridgeQueryTest(cAliasProfile, cHost, nPort, nTimeout)
return

procedure U_HBBridgeQueryTestSQLite(cAliasProfile, cHost, nPort, nTimeout)
    DEFAULT cAliasProfile:="sqlite_demo"
    DEFAULT cHost:="127.0.0.1"
    DEFAULT nPort:=1512
    DEFAULT nTimeout:=30000
    U_HBBridgeQueryTest(cAliasProfile, cHost, nPort, nTimeout)
return

procedure U_HBBridgeQueryTest(cAliasProfile, cHost, nPort, nTimeout)
    local cTimeStart,cTimeEnd as character
    ConOut("hbBridge U_HBBridgeQueryTest Start: "+DTos(Date())+"/"+(cTimeStart:=Time()))
    HBBridgeQueryTest(cAliasProfile, cHost, nPort, nTimeout)
    ConOut("hbBridge U_HBBridgeQueryTest End: "+DTos(Date())+"/"+(cTimeEnd:=Time()))
    ConOut("hbBridge U_HBBridgeQueryTest ElapTime: "+ElapTime(cTimeStart,cTimeEnd))
return

static procedure HBBridgeQueryTest(cAliasProfile, cHost, nPort, nTimeout)

    local oClient as object
    local oDataSet as object
    local jPage as json
    local jHeader as json
    local aHeader as array
    local jChecks := JSONObject():New() as json
    local jOverrides := JSONObject():New() as json
    local jConfig as json
    local cSql := "SELECT 1 AS ID, 'Harbour' AS NAME, 12.5 AS AMOUNT " + ;
        "UNION ALL SELECT 2, 'hbBridge', 0.0 ORDER BY ID" as character
    local cEmptySql := "SELECT 1 AS ID, 'empty' AS NAME WHERE 1 = 0" as character
    local cPageSql := "SELECT 10 AS ID, 'Harbour' AS NAME UNION ALL SELECT 50, 'hbBridge'" as character
    local cField as character
    local lOk := .T. as logical
    local nField as numeric
    local nFields := 0 as numeric
    local nPages as numeric
    local nRecNos as numeric

    if ValType(cAliasProfile) != "U"
        jOverrides["sqlProfile"] := cAliasProfile
    endif
    if ValType(cHost) != "U"
        jOverrides["host"] := cHost
    endif
    if ValType(nPort) != "U"
        jOverrides["port"] := nPort
    endif
    if ValType(nTimeout) != "U"
        jOverrides["timeoutMs"] := nTimeout
    endif
    jConfig := HBBridge.Client.HBBridgeConfig():Read(jOverrides)
    FreeObj(@jOverrides)
    if !jConfig["success"]
        ConOut("hbBridge RPCRDD.Query FAILED: " + jConfig["code"] + "; " + jConfig["error"])
        FreeObj(@jConfig)
        FreeObj(@jChecks)
        return
    endif
    cAliasProfile := jConfig["sqlProfile"]
    cHost := jConfig["host"]
    nPort := jConfig["port"]
    nTimeout := jConfig["timeoutMs"]
    FreeObj(@jConfig)

    if Empty(cAliasProfile)
        ConOut("hbBridge RPCRDD.Query FAILED: PROFILE_REQUIRED; supply a profile alias or configure SQLProfile.")
        ConOut('SQLite example: U_HBBridgeQueryTest("sqlite_demo"). MSSQL example: U_HBBridgeQueryTest("mssql/pData").')
        FreeObj(@jChecks)
        return
    endif

    oClient := HBBridge.Client.HBBridgeClient():New(cHost, nPort, nTimeout)
    oDataSet := HBBridge.RDD.HBBridgeRPCDataSet():New(oClient)
    if !oDataSet:OpenSQL(cAliasProfile, cSql)
        ConOut("hbBridge RPCRDD.Query FAILED: " + oDataSet:ErrorCode() + "; " + oDataSet:ErrorMessage())
        if oDataSet:ErrorCode() == "SERVICE_NOT_FOUND"
            ConOut("hbBridge SQL service is unavailable at " + cHost + ":" + tlpp.ToStr(nPort) + ;
                ". Start the updated server with SQL profiles in its INI/JSON configuration.")
            if cAliasProfile == "sqlite_demo"
                ConOut('hbBridge SQLite example: .\out\hbbridge.exe "-config=config/examples/sqlite.ini"')
            endif
        elseif oDataSet:ErrorCode() == "PROFILE_NOT_FOUND"
            ConOut("hbBridge SQL profile is not configured on the server: " + cAliasProfile)
        endif
        oDataSet:Close()
        FreeObj(@oDataSet)
        FreeObj(@oClient)
        FreeObj(@jChecks)
        return
    endif

    jChecks["rowCount"] := oDataSet:RowCount() == 2
    jChecks["firstId"] := oDataSet:FieldGet("id") == 1
    jChecks["firstName"] := AllTrim(oDataSet:FieldGet("NAME")) == "Harbour"
    jChecks["decimal"] := Abs(oDataSet:FieldGet("amount") - 12.5) < 0.000001
    jChecks["missingField"] := ValType(oDataSet:FieldGet("missing")) == "U"
    oDataSet:Skip()
    jChecks["secondId"] := oDataSet:FieldGet("ID") == 2
    jChecks["secondName"] := AllTrim(oDataSet:FieldGet("name")) == "hbBridge"
    oDataSet:Skip()
    jChecks["eof"] := oDataSet:Eof() .and. ValType(oDataSet:FieldGet("ID")) == "U"
    oDataSet:Close()
    jChecks["close"] := oDataSet:Eof() .and. oDataSet:RowCount() == 0
    jChecks["empty"] := oDataSet:OpenSQL(cAliasProfile, cEmptySql)
    jChecks["emptyState"] := oDataSet:Eof() .and. oDataSet:RowCount() == 0
    jChecks["invalidSql"] := !oDataSet:OpenSQL(cAliasProfile, "SELECT * FROM __HBBridgeMissingTable__")
    jChecks["invalidSqlCode"] := oDataSet:ErrorCode() == "QUERY_FAILED"
    jChecks["unknownProfile"] := !oDataSet:OpenSQL("__HBBridgeMissingProfile__", "SELECT 1 AS ID")
    jChecks["unknownProfileCode"] := oDataSet:ErrorCode() == "PROFILE_NOT_FOUND"
    jChecks["afterFailure"] := oDataSet:OpenSQL(cAliasProfile, "SELECT 7 AS ID")
    jChecks["afterFailureValue"] := oDataSet:FieldGet("ID") == 7
    jChecks["firstPage"] := oDataSet:OpenPage(cAliasProfile, cPageSql, 1, 1, "ID ASC")
    jChecks["firstPageState"] := oDataSet:RowCount() == 1 .and. oDataSet:FieldGet("ID") == 10 .and. ;
        oDataSet:PageNumber() == 1 .and. oDataSet:PageSize() == 1 .and. oDataSet:HasNextPage()
    jChecks["hiddenOrdinal"] := ValType(oDataSet:FieldGet("__HBBRIDGE_ROWNO")) == "U"
    oDataSet:Skip()
    jChecks["pageEof"] := oDataSet:Eof() .and. oDataSet:HasNextPage()
    jChecks["nextPage"] := oDataSet:NextPage()
    jChecks["lastPageState"] := oDataSet:FieldGet("ID") == 50 .and. ;
        oDataSet:PageNumber() == 2 .and. !oDataSet:HasNextPage()
    jChecks["noNextPage"] := !oDataSet:NextPage() .and. oDataSet:FieldGet("ID") == 50
    jChecks["emptyPage"] := oDataSet:OpenPage(cAliasProfile, cPageSql, 3, 1, "ID") .and. ;
        oDataSet:Eof() .and. !oDataSet:HasNextPage()
    jChecks["invalidPage"] := !oDataSet:OpenPage(cAliasProfile, cPageSql, 0, 1, "ID")
    jChecks["invalidPageCode"] := oDataSet:ErrorCode() == "INVALID_PAGE"
    jChecks["invalidOrder"] := !oDataSet:OpenPage(cAliasProfile, cPageSql, 1, 1, "ID; SELECT 1") .and. ;
        oDataSet:ErrorCode() == "INVALID_PAGE"
    oDataSet:Close()
    jChecks["pageClose"] := oDataSet:PageNumber() == 0 .and. oDataSet:PageSize() == 0 .and. !oDataSet:HasNextPage()

    lOk := jChecks["rowCount"] .and. jChecks["firstId"] .and. jChecks["firstName"] .and. ;
        jChecks["decimal"] .and. jChecks["missingField"] .and. jChecks["secondId"] .and. ;
        jChecks["secondName"] .and. jChecks["eof"] .and. jChecks["close"] .and. ;
        jChecks["empty"] .and. jChecks["emptyState"] .and. jChecks["invalidSql"] .and. ;
        jChecks["invalidSqlCode"] .and. jChecks["unknownProfile"] .and. ;
        jChecks["unknownProfileCode"] .and. jChecks["afterFailure"] .and. jChecks["afterFailureValue"] .and. ;
        jChecks["firstPage"] .and. jChecks["firstPageState"] .and. jChecks["hiddenOrdinal"] .and. ;
        jChecks["pageEof"] .and. jChecks["nextPage"] .and. jChecks["lastPageState"] .and. ;
        jChecks["noNextPage"] .and. jChecks["emptyPage"] .and. jChecks["invalidPage"] .and. ;
        jChecks["invalidPageCode"] .and. jChecks["invalidOrder"] .and. jChecks["pageClose"]
    ConOut("hbBridge RPCRDD.Query checks: " + jChecks:ToJSON())
    ConOut("hbBridge RPCRDD.Query Protheus " + IIf(lOk, "OK", "FAILED") + "; profile=" + cAliasProfile)

    if (cAliasProfile=="mssql/pData")
        //resolver Code Pages and Collations
        cSQL:="SELECT TOP 10 * FROM SX5990 WHERE D_E_L_E_T_=' '"
        ConOut("hbBridge RPCRDD.Query SQL: " + cSQL)
        jPage:=JSONObject():New()
        jPage["number"] := 1
        jPage["size"] := 5
        jPage["orderBy"] := "X5_FILIAL,X5_TABELA"
        if (oDataSet:OpenSQL(cAliasProfile, cSql,jPage))
            ConOut("hbBridge RPCRDD.Query jPage: " + jPage:ToJSON())
            nPages:=1
            jHeader:=oDataSet:Header()
            aHeader:=jHeader:GetNames()
            nFields:=Len(aHeader)
            nRecNos := 0
            while (.T.)
                if (oDataSet:Eof())
                    if (!oDataSet:HasNextPage())
                        exit
                    else
                        oDataSet:NextPage()
                        nPages++
                    endif
                else
                    for nField:=1 to nFields
                        cField:=aHeader[nField]
                        ConOut("hbBridge RPCRDD.Query Field["+cField+"] : "+AllToChar(oDataSet:FieldGet(cField)))
                    next nField
                    nRecNos++
                    oDataSet:Skip()
                endif
            end while
            ConOut("hbBridge RPCRDD.Query Fields: " + tlpp.ToStr(nFields))
            ConOut("hbBridge RPCRDD.Query Pages: " + tlpp.ToStr(nPages))
            ConOut("hbBridge RPCRDD.Query RecNos: " + tlpp.ToStr(nRecNos))
            ConOut("hbBridge RPCRDD.Query TotalPages: " + tlpp.ToStr(oDataSet:TotalPages()))
            ConOut("hbBridge RPCRDD.Query ErrorCode: " + oDataSet:ErrorCode())
            ConOut("hbBridge RPCRDD.Query ErrorMessage: " + oDataSet:ErrorMessage())
            FreeObj(@jPage)
            FreeObj(@jHeader)
            FWFReeArray(@aHeader)
        else
            ConOut("hbBridge RPCRDD.Query ErrorCode: " + oDataSet:ErrorCode())
            ConOut("hbBridge RPCRDD.Query ErrorMessage: " + oDataSet:ErrorMessage())
        endif
        //-------------------------------------------------------------------------------------------
        cSQL:="SELECT TOP 10 RA_FILIAL,RA_MAT,RA_NOME,CAST(RA_SALARIO AS DECIMAL(12,2)) AS RA_SALARIO,CAST(RA_ADMISSA AS DATE) RA_ADMISSA,R_E_C_N_O_ FROM SRA990 WHERE D_E_L_E_T_=' '"
        ConOut("hbBridge RPCRDD.Query SQL: " + cSQL)
        jPage:=JSONObject():New()
        jPage["number"] := 1
        jPage["size"] := 5
        jPage["orderBy"] := "RA_FILIAL,RA_MAT"
        if (oDataSet:OpenSQL(cAliasProfile, cSql,jPage))
            ConOut("hbBridge RPCRDD.Query jPage: " + jPage:ToJSON())
            nPages:=1
            jHeader:=oDataSet:Header()
            aHeader:=jHeader:GetNames()
            nFields:=Len(aHeader)
            nRecNos := 0
            __SetCentury("ON")
            Set(4,"DD/MM/YYYY")
            while (oDataSet:MoreToRead())
                for nField:=1 to nFields
                    cField:=aHeader[nField]
                    if (jHeader[cField]["type"]=="N:N")
                        ConOut("hbBridge RPCRDD.Query Field["+cField+"] : "+tlpp.ToStr(oDataSet:FieldGet(cField)))
                    elseif (jHeader[cField]["type"]=="D:N")
                        ConOut("hbBridge RPCRDD.Query Field["+cField+"] : "+DToC(SToD(oDataSet:FieldGet(cField))))
                    elseif (jHeader[cField]["type"]!="C")
                        ConOut("hbBridge RPCRDD.Query Field["+cField+"] : "+AllToChar(oDataSet:FieldGet(cField)))
                    else
                        ConOut("hbBridge RPCRDD.Query Field["+cField+"] : "+oDataSet:FieldGet(cField))
                    endif
                next nField
                nRecNos++
                oDataSet:Skip()
            end while
            nPages:=oDataSet:PageNumber()
            ConOut("hbBridge RPCRDD.Query Fields: " + tlpp.ToStr(nFields))
            ConOut("hbBridge RPCRDD.Query Pages: " + tlpp.ToStr(nPages))
            ConOut("hbBridge RPCRDD.Query RecNos: " + tlpp.ToStr(nRecNos))
            ConOut("hbBridge RPCRDD.Query TotalPages: " + tlpp.ToStr(oDataSet:TotalPages()))
            ConOut("hbBridge RPCRDD.Query ErrorCode: " + oDataSet:ErrorCode())
            ConOut("hbBridge RPCRDD.Query ErrorMessage: " + oDataSet:ErrorMessage())
            FreeObj(@jPage)
            FreeObj(@jHeader)
            FWFReeArray(@aHeader)
        else
            ConOut("hbBridge RPCRDD.Query ErrorCode: " + oDataSet:ErrorCode())
            ConOut("hbBridge RPCRDD.Query ErrorMessage: " + oDataSet:ErrorMessage())
        endif
    endif

    oDataSet:Close()
    FreeObj(@oDataSet)
    FreeObj(@oClient)
    FreeObj(@jChecks)

return
