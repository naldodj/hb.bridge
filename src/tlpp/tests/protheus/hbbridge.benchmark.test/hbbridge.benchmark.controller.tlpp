/* Released to Public Domain. */
#include "totvs.ch"

namespace HBBridge.Examples

class HBBridgeBenchmarkController

    private data bMeasure as codeblock

    private data cInstance as character
    private data cProfile as character
    private data cHost as character
    private data cURL as character
    private data cToken as character
    private data cComparison as character
    private data cLastRequestID as character
    private data cLastResponse as character

    private data lRunning as logical
    private data lClosed as logical

    private data nPort as numeric

    public method New(cInstance as character, cProfile as character, cHost as character, ;
        nPort as numeric, cURL as character, cToken as character, bMeasure as codeblock, jComparison as json) as object
    public method Handle(cContent as character) as json
    public method Close()

endclass

method New(cInstance, cProfile, cHost, nPort, cURL, cToken, bMeasure, jComparison) class HBBridgeBenchmarkController

    self:cInstance := cInstance
    self:cProfile := cProfile
    self:cHost := cHost
    self:nPort := nPort
    self:cURL := cURL
    self:cToken := cToken
    self:cComparison := ""
    if ValType(jComparison) == "J"
        self:cComparison := jComparison:ToJSON()
    endif
    self:bMeasure := bMeasure
    self:cLastRequestID := ""
    self:cLastResponse := ""
    self:lRunning := .F.
    self:lClosed := .F.

return(self)

method Handle(cContent) class HBBridgeBenchmarkController

    local cRequestID := "" as character

    local jEnvelope as json
    local jResponse as json
    local jReport as json
    local jComparison as json
    local jRoutes as json
    local jTimeoutPolicy as json
    local jResolvedPolicy as json

    local lRouted := .F. as logical
    local lValid := .F. as logical

    local nTimeoutSeconds := 0 as numeric

    local xError as variant

    jEnvelope := JSONObject():New()

    try
        if ValType(cContent) == "C"
            // JSONObject may drop NUL during parsing; inspect raw JSON first.
            if BenchmarkJSONHasNul(cContent)
                FreeObj(@jEnvelope)
                return Nil
            endif
            if ValType(jEnvelope:FromJSON(cContent)) == "U"
                if jEnvelope:HasProperty("instance") .and. jEnvelope:HasProperty("requestID")
                    if ValType(jEnvelope["instance"]) == "C"
                        lRouted := jEnvelope["instance"] == self:cInstance .and. ;
                            BenchmarkCorrelationValid(jEnvelope["requestID"])
                    endif
                endif
            endif
        endif
    catch xError
        lRouted := .F.
        if (ValType(xError)=="O")
            FreeObj(@xError)
        endif
    endtry
    if !lRouted
        FreeObj(@jEnvelope)
        return Nil
    endif

    cRequestID := jEnvelope["requestID"]
    if self:lClosed
        FreeObj(@jEnvelope)
        return BenchmarkControllerError(self:cInstance, cRequestID, "CLOSED")
    endif
    if self:lRunning
        FreeObj(@jEnvelope)
        return BenchmarkControllerError(self:cInstance, cRequestID, "BUSY")
    endif
    if cRequestID == self:cLastRequestID .and. !Empty(self:cLastResponse)
        jResponse := JSONObject():New()
        jResponse:FromJSON(self:cLastResponse)
        FreeObj(@jEnvelope)
        return jResponse
    endif

    // One serialized response prevents duplicate execution and alias mutation.
    self:cLastRequestID := cRequestID
    self:cLastResponse := ""
    lValid := BenchmarkEnvelopeValid(jEnvelope)
    if lValid
        if !Empty(self:cComparison)
            jComparison := JSONObject():New()
            jComparison:FromJSON(self:cComparison)
        endif
        if jEnvelope["params"]:HasProperty("routes")
            jRoutes := HBBridge.Test.HBBridgeBenchmarkTest():Routes(jComparison, jEnvelope["params"]["routes"])
        else
            jRoutes := HBBridge.Test.HBBridgeBenchmarkTest():Routes(jComparison)
        endif
        lValid := BenchmarkControllerRoutesAllowed(jComparison, jRoutes)
        if lValid
            if jEnvelope["params"]:HasProperty("timeoutPolicy")
                jTimeoutPolicy := jEnvelope["params"]["timeoutPolicy"]
            endif
            jResolvedPolicy := HBBridge.Test.HBBridgeBenchmarkPolicy():Resolve(;
                jEnvelope["params"]["rows"], jEnvelope["params"]["pageSize"], ;
                jEnvelope["params"]["iterations"], jEnvelope["params"]["warmup"], ;
                jRoutes, jEnvelope["params"]["timeoutSeconds"], jTimeoutPolicy)
            lValid := jResolvedPolicy["success"]
            if lValid
                nTimeoutSeconds := jResolvedPolicy["timeoutSeconds"]
            endif
        endif
    endif
    if !lValid
        jResponse := BenchmarkControllerError(self:cInstance, cRequestID, "INVALID_PARAMETERS")
    else
        self:lRunning := .T.
        try
            if ValType(self:bMeasure) == "B"
                jReport := Eval(self:bMeasure, self:cProfile, self:cHost, self:nPort, ;
                    self:cURL, self:cToken, nTimeoutSeconds, ;
                    jEnvelope["params"]["rows"], jEnvelope["params"]["pageSize"], ;
                    jEnvelope["params"]["iterations"], jEnvelope["params"]["warmup"], jRoutes, jTimeoutPolicy)
            else
                jReport := HBBridge.Test.HBBridgeBenchmarkTest():Measure(self:cProfile, ;
                    self:cHost, self:nPort, self:cURL, self:cToken, ;
                    nTimeoutSeconds, jEnvelope["params"]["rows"], ;
                    jEnvelope["params"]["pageSize"], jEnvelope["params"]["iterations"], ;
                    jEnvelope["params"]["warmup"], jComparison, jRoutes, Nil, jTimeoutPolicy)
            endif
            if self:lClosed
                jResponse := BenchmarkControllerError(self:cInstance, cRequestID, "CLOSED")
            elseif BenchmarkReportValid(jReport)
                if !jReport["success"] .and. ;
                    !BenchmarkReportHasResults(jReport)
                    jResponse := BenchmarkControllerError(self:cInstance, cRequestID, jReport["failureCategory"])
                else
                    jResponse := JSONObject():New()
                    jResponse["instance"] := self:cInstance
                    jResponse["requestID"] := cRequestID
                    jResponse["report"] := jReport
                    jReport := Nil
                endif
            else
                jResponse := BenchmarkControllerError(self:cInstance, cRequestID, "INVALID_REPORT")
            endif
        catch xError
            jResponse := BenchmarkControllerError(self:cInstance, cRequestID, "RUNTIME_EXCEPTION")
            if (ValType(xError)=="O")
                FreeObj(@xError)
            endif
        endtry
        self:lRunning := .F.
    endif
    if ValType(jReport) == "J"
        FreeObj(@jReport)
    endif
    FreeObj(@jEnvelope)
    FreeObj(@jComparison)
    FreeObj(@jRoutes)
    FreeObj(@jResolvedPolicy)
    jTimeoutPolicy := Nil
    if !self:lClosed
        self:cLastResponse := jResponse:ToJSON()
    endif

return(jResponse)

method Close() class HBBridgeBenchmarkController

    self:lClosed := .T.
    self:cProfile := ""
    self:cHost := ""
    self:nPort := 0
    self:cURL := ""
    self:cToken := ""
    self:cComparison := ""
    self:bMeasure := Nil
    self:cLastRequestID := ""
    self:cLastResponse := ""

return

static function BenchmarkControllerError(cInstance as character, cRequestID as character, ;
    cCategory as character) as json

    local jResponse := JSONObject():New() as json

    jResponse["instance"] := cInstance
    jResponse["requestID"] := cRequestID
    jResponse["error"] := cCategory

return(jResponse)

static function BenchmarkCorrelationValid(xValue as variant) as logical

    if ValType(xValue) != "C"
        return .F.
    endif

return(!Empty(AllTrim(xValue)) .and. Len(xValue) <= 128 .and. ;
    !(Chr(0) $ xValue) .and. !(Chr(10) $ xValue) .and. !(Chr(13) $ xValue))

static function BenchmarkJSONHasNul(cJSON as character) as logical

    local cCharacter := "" as character
    local cQuote := Chr(34) as character
    local cBackslash := Chr(92) as character

    local lString := .F. as logical

    local nPosition := 1 as numeric
    local nLength as numeric

    nLength := Len(cJSON)

    if Chr(0) $ cJSON
        return .T.
    endif
    while nPosition <= nLength
        cCharacter := SubStr(cJSON, nPosition, 1)
        if !lString
            if cCharacter == cQuote
                lString := .T.
            endif
        elseif cCharacter == cQuote
            lString := .F.
        elseif cCharacter == cBackslash
            if SubStr(cJSON, nPosition + 1, 5) == "u0000"
                return .T.
            endif
            // Consume the escaped character, including a literal backslash.
            // Thus JSON "\\u0000" remains text rather than a NUL escape.
            nPosition++
        endif
        nPosition++
    enddo

return(.F.)

static function BenchmarkEnvelopeValid(jEnvelope as json) as logical

    // GetNames() requires a native array; no copy or repeated key searches.
    local aNames as array

    local jParams as json

    local nExpected as numeric

    aNames := jEnvelope:GetNames()
    if Len(aNames) != 3 .or. !jEnvelope:HasProperty("params")
        return .F.
    endif
    if ValType(jEnvelope["params"]) != "J"
        return .F.
    endif
    jParams := jEnvelope["params"]
    aNames := jParams:GetNames()
    nExpected := 5
    if jParams:HasProperty("routes")
        nExpected++
    endif
    if jParams:HasProperty("timeoutPolicy")
        nExpected++
        if ValType(jParams["timeoutPolicy"]) != "J"
            return .F.
        endif
    endif
    if Len(aNames) != nExpected
        return .F.
    endif
    if jParams:HasProperty("routes")
        if ValType(jParams["routes"]) != "J"
            return .F.
        endif
    endif
    if !jParams:HasProperty("rows") .or. !jParams:HasProperty("pageSize") .or. ;
        !jParams:HasProperty("iterations") .or. !jParams:HasProperty("warmup") .or. ;
        !jParams:HasProperty("timeoutSeconds")
        return .F.
    endif

return(BenchmarkControllerInteger(jParams["rows"], 1, 100000) .and. ;
    BenchmarkControllerInteger(jParams["pageSize"], 1, 100000) .and. ;
    BenchmarkControllerInteger(jParams["iterations"], 1, 1000000) .and. ;
    BenchmarkControllerInteger(jParams["warmup"], 0, 1000000) .and. ;
    BenchmarkControllerInteger(jParams["timeoutSeconds"], 1, 2147483))

static function BenchmarkControllerRoutesAllowed(jComparison as json, jRoutes as json) as logical

    // GetNames() supplies the native enumeration array; no duplicate route list.
    local aNames as array

    local cName as character

    local jAvailable as json

    local lAllowed := .T. as logical

    local nName as numeric
    local nNames as numeric

    if ValType(jRoutes) != "J"
        return .F.
    endif
    jAvailable := HBBridge.Test.HBBridgeBenchmarkTest():Routes(jComparison)
    if ValType(jAvailable) != "J"
        return .F.
    endif
    jAvailable["protheusServer"] := jAvailable["protheusStartJob"] .or. jAvailable["protheusRest"]
    aNames := jRoutes:GetNames()
    nNames := Len(aNames)
    for nName := 1 to nNames
        cName := aNames[nName]
        if jRoutes[cName] .and. !jAvailable[cName]
            lAllowed := .F.
            exit
        endif
    next nName
    FreeObj(@jAvailable)

return(lAllowed)

static function BenchmarkReportHasResults(jReport as json) as logical

return(ValType(jReport["tcp"]) == "J" .or. ValType(jReport["http"]) == "J" .or. ;
    ValType(jReport["protheusStartJob"]) == "J" .or. ValType(jReport["protheusRest"]) == "J" .or. ;
    ValType(jReport["hbbridgeAddon"]) == "J" .or. ValType(jReport["protheusServer"]) == "J")

static function BenchmarkControllerInteger(xValue as variant, nMinimum as numeric, ;
    nMaximum as numeric) as logical

    if ValType(xValue) != "N"
        return .F.
    endif

return(xValue >= nMinimum .and. xValue <= nMaximum .and. xValue == Int(xValue))

static function BenchmarkReportValid(jReport as variant) as logical

    if ValType(jReport) != "J"
        return .F.
    endif
    if !jReport:HasProperty("schemaVersion") .or. !jReport:HasProperty("success") .or. ;
        !jReport:HasProperty("failureCategory")
        return .F.
    endif
    if ValType(jReport["schemaVersion"]) != "N" .or. ValType(jReport["success"]) != "L" .or. ;
        ValType(jReport["failureCategory"]) != "C"
        return .F.
    endif
    if jReport["schemaVersion"] != 1
        return .F.
    endif
    if jReport["success"]
        return jReport["failureCategory"] == ""
    endif

return(jReport["failureCategory"] == "INVALID_CONFIGURATION" .or. ;
    jReport["failureCategory"] == "SCENARIO_FAILED" .or. ;
    jReport["failureCategory"] == "RUNTIME_EXCEPTION" .or. ;
    jReport["failureCategory"] == "CLIENT_CLEANUP_FAILED" .or. ;
    jReport["failureCategory"] == "CLOCK_REGRESSION")
