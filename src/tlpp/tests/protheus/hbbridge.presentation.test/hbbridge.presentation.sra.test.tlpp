/* Released to Public Domain. */
#include "totvs.ch"

// Deterministic metadata/catalog planning and selected native SQLite storage:
// no employee rows, DBAccess connection or active Protheus company is required.
function U_HBBridgePresentationSRATest()

    // JSONObject exposes its property names through this native array API.
    local aNames as array

    local cMetadata:="" as character
    local cColumns:="" as character
    local cSQL:="" as character
    local cField:="" as character

    local jChecks:=JSONObject():New() as json
    local jMetadata:=PresentationSRATestMetadata() as json
    local jColumns:=PresentationSRATestColumns() as json
    local jResult as json
    local jChanged as json
    local jRead as json
    local jExpected as json

    local lOK:=.T. as logical

    local nCheck:=0 as numeric
    local nChecks:=0 as numeric
    local nField:=0 as numeric
    local nFields:=0 as numeric

    local xError as variant

    try
        jRead:=HBBridge.Protheus.HBBridgeSX3Metadata():Read("invalid alias")
        jChecks["invalidDictionaryAliasNeedsNoEnvironment"]:=ValType(jRead)=="U"
        cMetadata:=HBBridge.Client.HBBridgeJSON():Encode(jMetadata)
        cColumns:=HBBridge.Client.HBBridgeJSON():Encode(jColumns)
        jResult:=HBBridge.Examples.HBBridgePresentationSRA():Plan(jMetadata,jColumns,"SRA990","01")
        jChecks["definitionBuilt"]:=ValType(jResult)=="J"
        if (!jChecks["definitionBuilt"])
            throw "SRA_DEFINITION_MISSING"
        endif
        jChecks["definitionSucceeded"]:=jResult["success"]==.T.
        if (!jChecks["definitionSucceeded"])
            throw "SRA_DEFINITION_REJECTED"
        endif
        cSQL:=jResult["sql"]
        jChecks["metadataInputUnchanged"]:=HBBridge.Client.HBBridgeJSON():Encode(jMetadata)==cMetadata
        jChecks["catalogInputUnchanged"]:=HBBridge.Client.HBBridgeJSON():Encode(jColumns)==cColumns
        jChecks["metadataRetainsAllDictionaryFields"]:=jResult["metadata"]["schemaVersion"]==1.and.;
            jResult["metadata"]["alias"]=="SRA".and.jResult["metadata"]["count"]==19
        jChecks["allStatusesCounted"]:=jResult["includedCount"]==13.and.jResult["excludedCount"]==10
        aNames:=jResult["fieldStatus"]:GetNames()
        jChecks["everyFieldHasVisibleStatus"]:=Len(aNames)==23
        FWFreeArray(@aNames)
        aNames:=jResult["schema"]["fields"]:GetNames()
        jChecks["schemaContainsEveryIncludedColumn"]:=Len(aNames)==13
        jChecks["projectionUsesDictionaryPosition"]:=aNames[1]=="RA_FILIAL".and.;
            aNames[2]=="RA_MAT".and.aNames[3]=="RA_NOME"
        FWFreeArray(@aNames)
        jChecks["sqlUsesExplicitProjection"]:=!Empty(cSQL).and.At("*",cSQL)==0
        jChecks["sqlUsesTrustedPhysicalTable"]:="SRA990" $ cSQL
        jChecks["sqlProjectionFollowsMetadataPosition"]:=At("RA_FILIAL",cSQL)>0.and.;
            At("RA_FILIAL",cSQL)<At("RA_MAT",cSQL).and.At("RA_MAT",cSQL)<At("RA_NOME",cSQL)
        jChecks["numericProjectionUsesDeclaredScale"]:="DECIMAL(12,2)" $ Upper(StrTran(cSQL," ",""))
        jChecks["largeNumericDefinitionIsNotClamped"]:=jResult["schema"]["fields"]["RA_BIG"]["length"]==32.and.;
            jResult["schema"]["fields"]["RA_BIG"]["decimals"]==0.and.;
            "DECIMAL(32,0)" $ Upper(StrTran(cSQL," ",""))
        jChecks["recordNumberUsesBigint"]:="BIGINT" $ Upper(cSQL)
        jChecks["stableOrderIncludesSourceRecord"]:=jResult["orderBy"]==;
            "RA_FILIAL ASC,RA_MAT ASC,R_E_C_N_O_ ASC"
        jChecks["deletedAndBranchAreBound"]:=jResult["bindings"]["1"]["type"]=="text".and.;
            jResult["bindings"]["1"]["isNull"]==.F..and.jResult["bindings"]["1"]["value"]==" ".and.;
            jResult["bindings"]["2"]["type"]=="text".and.;
            jResult["bindings"]["2"]["isNull"]==.F..and.jResult["bindings"]["2"]["value"]=="01"
        jChecks["logicalMetadataKeepsOriginalFieldKeys"]:=;
            jResult["schema"]["fields"]:HasProperty("RA_NOME").and.;
            jResult["schema"]["fields"]:HasProperty("RA_SALARIO").and.;
            !jResult["schema"]["fields"]:HasProperty("NAME")
        jChecks["projectionMappingKeepsOriginalFields"]:=;
            jResult["schema"]["projectionFields"]["RA_NOME"]=="RA_NOME".and.;
            jResult["schema"]["projectionFields"]["RA_SALARIO"]=="RA_SALARIO"
        jChecks["dictionaryWidthScaleAndPicture"]:=;
            jResult["schema"]["fields"]["RA_SALARIO"]["type"]=="numeric".and.;
            jResult["schema"]["fields"]["RA_SALARIO"]["length"]==12.and.;
            jResult["schema"]["fields"]["RA_SALARIO"]["decimals"]==2.and.;
            jResult["schema"]["fields"]["RA_SALARIO"]["picture"]=="@E 999,999,999.99"
        jChecks["dictionaryCaptionIsNativeText"]:=;
            jResult["schema"]["fields"]["RA_NOME"]["caption"]=="Name"
        jChecks["characterDateDeclaresSourceFormat"]:=;
            jResult["schema"]["fields"]["RA_ADMISSA"]["type"]=="date".and.;
            jResult["schema"]["fields"]["RA_ADMISSA"]["inputFormat"]=="YYYYMMDD"
        jChecks["sqlDateDeclaresSourceFormat"]:=;
            jResult["schema"]["fields"]["RA_DATE"]["type"]=="date".and.;
            jResult["schema"]["fields"]["RA_DATE"]["inputFormat"]=="YYYY-MM-DD"
        jChecks["logicalSourcesAreExplicit"]:=;
            jResult["schema"]["fields"]["RA_FLAG"]["type"]=="logical".and.;
            jResult["schema"]["fields"]["RA_NUMFLAG"]["type"]=="logical".and.;
            jResult["schema"]["fields"]["RA_CHARFLAG"]["type"]=="logical".and.;
            "CASE" $ Upper(cSQL)
        jExpected:=JSONObject():New()
        jExpected["RA_MEMO"]:="memo"
        jExpected["RA_VIRTUAL"]:="virtual"
        jExpected["RA_BINARY"]:="binary"
        jExpected["RA_MISSING"]:="missingColumn"
        jExpected["RA_WIDE"]:="invalidDefinition"
        jExpected["RA_LONG"]:="longText"
        jExpected["RA_UNKNOWN"]:="unsupportedStorage"
        jExpected["RA_INVALID"]:="invalidDefinition"
        jExpected["RA_UNSUPPORTED"]:="unsupportedType"
        jExpected["EXTRA_COLUMN"]:="notInDictionary"
        aNames:=jExpected:GetNames()
        nFields:=Len(aNames)
        for nField:=1 to nFields
            cField:=aNames[nField]
            jChecks["exclusion."+cField]:=jResult["fieldStatus"][cField]["status"]=="excluded".and.;
                jResult["fieldStatus"][cField]["reason"]==jExpected[cField].and.;
                !jResult["schema"]["fields"]:HasProperty(cField)
        next nField
        FWFreeArray(@aNames)
        jChecks["ordinaryFieldStatus"]:=jResult["fieldStatus"]["RA_NOME"]["status"]=="included".and.;
            Empty(jResult["fieldStatus"]["RA_NOME"]["reason"])
        jChecks["systemFieldsAreExplicit"]:=;
            jResult["fieldStatus"]["R_E_C_N_O_"]["status"]=="included".and.;
            jResult["fieldStatus"]["R_E_C_N_O_"]["reason"]=="system".and.;
            jResult["fieldStatus"]["D_E_L_E_T_"]["status"]=="included".and.;
            jResult["fieldStatus"]["D_E_L_E_T_"]["reason"]=="system".and.;
            jResult["fieldStatus"]["R_E_C_D_E_L_"]["status"]=="included".and.;
            jResult["fieldStatus"]["R_E_C_D_E_L_"]["reason"]=="system"
        jMetadata["fields"]["RA_NOME"]["caption"]:="Caller changed"
        jChecks["metadataSnapshotIsDefensive"]:=jResult["metadata"]["fields"]["RA_NOME"]["caption"]=="Name"
        jResult["metadata"]["fields"]["RA_NOME"]["description"]:="Result changed"
        jChecks["returnedMetadataDoesNotMutateCaller"]:=;
            jMetadata["fields"]["RA_NOME"]["description"]=="Dictionary RA_NOME"
        FreeObj(@jResult)
        FreeObj(@jMetadata)
        jMetadata:=PresentationSRATestMetadata()
        jResult:=HBBridge.Examples.HBBridgePresentationSRA():Plan(jMetadata,jColumns,"SRA990","'")
        jChecks["branchTextRemainsBound"]:=jResult["success"]==.T..and.;
            jResult["bindings"]["2"]["value"]=="'".and.jResult["sql"]==cSQL
        FreeObj(@jResult)
        jChecks["rejectTableExpression"]:=PresentationSRATestFailure(jMetadata,jColumns,"SRA990;DROP TABLE SRA990","01")
        jChecks["rejectEmptyTable"]:=PresentationSRATestFailure(jMetadata,jColumns,"","01")
        jChecks["rejectOversizeBranch"]:=PresentationSRATestFailure(jMetadata,jColumns,"SRA990","123")
        jChecks["rejectNulBranch"]:=PresentationSRATestFailure(jMetadata,jColumns,"SRA990","0"+Chr(0)+"1")
        jChanged:=PresentationSRATestWithout(jColumns,"RA_FILIAL")
        jChecks["rejectMissingPhysicalBranch"]:=PresentationSRATestFailure(jMetadata,jChanged,"SRA990","01")
        FreeObj(@jChanged)
        jChanged:=PresentationSRATestWithout(jColumns,"RA_MAT")
        jChecks["rejectMissingPhysicalKey"]:=PresentationSRATestFailure(jMetadata,jChanged,"SRA990","01")
        FreeObj(@jChanged)
        jChanged:=PresentationSRATestWithout(jColumns,"R_E_C_N_O_")
        jChecks["rejectMissingRecordNumber"]:=PresentationSRATestFailure(jMetadata,jChanged,"SRA990","01")
        FreeObj(@jChanged)
        jChanged:=PresentationSRATestWithout(jColumns,"D_E_L_E_T_")
        jChecks["rejectMissingDeletedPredicate"]:=PresentationSRATestFailure(jMetadata,jChanged,"SRA990","01")
        FreeObj(@jChanged)
        jChanged:=PresentationSRATestWithout(jMetadata["fields"],"RA_FILIAL")
        jRead:=jMetadata["fields"]
        jMetadata["fields"]:=jChanged
        jChanged:=nil
        jMetadata["count"]:=18
        jChecks["rejectMissingDictionaryBranch"]:=PresentationSRATestFailure(jMetadata,jColumns,"SRA990","01")
        jChanged:=jMetadata["fields"]
        jMetadata["fields"]:=jRead
        jRead:=nil
        jMetadata["count"]:=19
        FreeObj(@jChanged)
        jMetadata["fields"]["RA_MAT"]["virtual"]:=.T.
        jMetadata["fields"]["RA_MAT"]["context"]:="V"
        jChecks["rejectVirtualMandatoryKey"]:=PresentationSRATestFailure(jMetadata,jColumns,"SRA990","01")
        jMetadata["fields"]["RA_MAT"]["virtual"]:=.F.
        jMetadata["fields"]["RA_MAT"]["context"]:="R"
        jMetadata["fields"]["RA_FILIAL"]["type"]:="N"
        jColumns["RA_FILIAL"]["type"]:="int"
        jChecks["rejectNumericBranchDefinition"]:=PresentationSRATestFailure(jMetadata,jColumns,"SRA990","01")
        PresentationPlanningChecks(jChecks)
        PresentationSelectionChecks(jChecks)
    catch xError
        jChecks["unexpectedRuntimeFailure"]:=.F.
        ConOut("hbBridge SRA metadata test failed; inspect the owned local log.")
        if (ValType(xError)=="O")
            FreeObj(@xError)
        endif
    endtry
    FWFreeArray(@aNames)
    FreeObj(@jRead)
    FreeObj(@jResult)
    FreeObj(@jChanged)
    FreeObj(@jExpected)
    FreeObj(@jMetadata)
    FreeObj(@jColumns)
    aNames:=jChecks:GetNames()
    nChecks:=Len(aNames)
    for nCheck:=1 to nChecks
        lOK:=jChecks[aNames[nCheck]].and.lOK
        ConOut("hbBridge SRA metadata check "+aNames[nCheck]+": "+if(jChecks[aNames[nCheck]],"PASS","FAILED"))
    next nCheck
    ConOut("hbBridge SRA metadata checks: "+tlpp.ToStr(nChecks)+"; "+if(lOK,"OK","FAILED"))
    FWFreeArray(@aNames)
    FreeObj(@jChecks)

return(if(lOK,0,1))

static function PresentationSRATestMetadata() as json

    local jMetadata:=JSONObject():New() as json
    local jFields:=JSONObject():New() as json

    // Insert out of ordinal order: planning must use metadata.position.
    jFields["RA_NOME"]:=PresentationSRATestField("RA_NOME",3,"C",40,0)
    jFields["RA_FILIAL"]:=PresentationSRATestField("RA_FILIAL",1,"C",2,0)
    jFields["RA_MAT"]:=PresentationSRATestField("RA_MAT",2,"C",6,0)
    jFields["RA_SALARIO"]:=PresentationSRATestField("RA_SALARIO",4,"N",12,2)
    jFields["RA_SALARIO"]["picture"]:="@E 999,999,999.99"
    jFields["RA_ADMISSA"]:=PresentationSRATestField("RA_ADMISSA",5,"D",8,0)
    jFields["RA_FLAG"]:=PresentationSRATestField("RA_FLAG",6,"L",1,0)
    jFields["RA_MEMO"]:=PresentationSRATestField("RA_MEMO",7,"M",10,0)
    jFields["RA_VIRTUAL"]:=PresentationSRATestField("RA_VIRTUAL",8,"C",20,0)
    jFields["RA_VIRTUAL"]["context"]:="V"
    jFields["RA_VIRTUAL"]["virtual"]:=.T.
    jFields["RA_BINARY"]:=PresentationSRATestField("RA_BINARY",9,"C",10,0)
    jFields["RA_MISSING"]:=PresentationSRATestField("RA_MISSING",10,"C",10,0)
    jFields["RA_WIDE"]:=PresentationSRATestField("RA_WIDE",11,"C",255,0)
    jFields["RA_LONG"]:=PresentationSRATestField("RA_LONG",12,"C",40,0)
    jFields["RA_UNKNOWN"]:=PresentationSRATestField("RA_UNKNOWN",13,"C",10,0)
    jFields["RA_INVALID"]:=PresentationSRATestField("RA_INVALID",14,"N",2,3)
    jFields["RA_UNSUPPORTED"]:=PresentationSRATestField("RA_UNSUPPORTED",15,"X",10,0)
    jFields["RA_BIG"]:=PresentationSRATestField("RA_BIG",16,"N",32,0)
    jFields["RA_DATE"]:=PresentationSRATestField("RA_DATE",17,"D",8,0)
    jFields["RA_NUMFLAG"]:=PresentationSRATestField("RA_NUMFLAG",18,"L",1,0)
    jFields["RA_CHARFLAG"]:=PresentationSRATestField("RA_CHARFLAG",19,"L",1,0)
    jFields["RA_NOME"]["caption"]:="Name"
    jMetadata["schemaVersion"]:=1
    jMetadata["alias"]:="SRA"
    jMetadata["count"]:=19
    jMetadata["fields"]:=jFields

return(jMetadata)

static function PresentationSRATestField(cName as character,nPosition as numeric,cType as character,nLength as numeric,nDecimals as numeric) as json

    local jField:=JSONObject():New() as json

    jField["position"]:=nPosition
    jField["name"]:=cName
    jField["type"]:=cType
    jField["length"]:=nLength
    jField["decimals"]:=nDecimals
    jField["picture"]:=""
    jField["caption"]:=cName
    jField["description"]:="Dictionary "+cName
    jField["context"]:="R"
    jField["virtual"]:=.F.
    jField["dictionaryOrder"]:=StrZero(nPosition,3)

return(jField)

static function PresentationSRATestColumns() as json

    local jColumns:=JSONObject():New() as json

    jColumns["RA_FILIAL"]:=PresentationSRATestColumn("RA_FILIAL",1,"char",2)
    jColumns["RA_MAT"]:=PresentationSRATestColumn("RA_MAT",2,"char",6)
    jColumns["RA_NOME"]:=PresentationSRATestColumn("RA_NOME",3,"varchar",40)
    jColumns["RA_SALARIO"]:=PresentationSRATestColumn("RA_SALARIO",4,"float",8)
    jColumns["RA_ADMISSA"]:=PresentationSRATestColumn("RA_ADMISSA",5,"char",8)
    jColumns["RA_FLAG"]:=PresentationSRATestColumn("RA_FLAG",6,"bit",1)
    jColumns["RA_MEMO"]:=PresentationSRATestColumn("RA_MEMO",7,"varchar",-1)
    jColumns["RA_VIRTUAL"]:=PresentationSRATestColumn("RA_VIRTUAL",8,"varchar",20)
    jColumns["RA_BINARY"]:=PresentationSRATestColumn("RA_BINARY",9,"varbinary",10)
    jColumns["RA_WIDE"]:=PresentationSRATestColumn("RA_WIDE",11,"varchar",255)
    jColumns["RA_LONG"]:=PresentationSRATestColumn("RA_LONG",12,"nvarchar",-1)
    jColumns["RA_UNKNOWN"]:=PresentationSRATestColumn("RA_UNKNOWN",13,"xml",10)
    jColumns["RA_INVALID"]:=PresentationSRATestColumn("RA_INVALID",14,"float",8)
    jColumns["RA_UNSUPPORTED"]:=PresentationSRATestColumn("RA_UNSUPPORTED",15,"char",10)
    jColumns["RA_BIG"]:=PresentationSRATestColumn("RA_BIG",16,"float",8)
    jColumns["RA_DATE"]:=PresentationSRATestColumn("RA_DATE",17,"date",3)
    jColumns["RA_NUMFLAG"]:=PresentationSRATestColumn("RA_NUMFLAG",18,"int",4)
    jColumns["RA_CHARFLAG"]:=PresentationSRATestColumn("RA_CHARFLAG",19,"char",1)
    jColumns["D_E_L_E_T_"]:=PresentationSRATestColumn("D_E_L_E_T_",20,"char",1)
    jColumns["R_E_C_N_O_"]:=PresentationSRATestColumn("R_E_C_N_O_",21,"bigint",8)
    jColumns["R_E_C_D_E_L_"]:=PresentationSRATestColumn("R_E_C_D_E_L_",22,"bigint",8)
    jColumns["EXTRA_COLUMN"]:=PresentationSRATestColumn("EXTRA_COLUMN",23,"char",10)

return(jColumns)

static function PresentationSRATestColumn(cName as character,nPosition as numeric,cType as character,nLength as numeric) as json

    local jColumn:=JSONObject():New() as json

    jColumn["name"]:=cName
    jColumn["type"]:=cType
    jColumn["length"]:=nLength
    jColumn["precision"]:=if(cType=="float",53,0)
    jColumn["scale"]:=0
    jColumn["position"]:=nPosition
    jColumn["binary"]:=("|"+cType+"|")$"|image|binary|varbinary|timestamp|rowversion|"
    jColumn["longText"]:=cType=="text".or.cType=="ntext".or.;
        ((cType=="varchar".or.cType=="nvarchar").and.nLength==-1)

return(jColumn)

static function PresentationSRATestFailure(jMetadata as json,jColumns as json,cTable as character,cBranch as character) as logical

    local jResult:=HBBridge.Examples.HBBridgePresentationSRA():Plan(jMetadata,jColumns,cTable,cBranch) as json

    local lRejected:=.F. as logical

    if (ValType(jResult)=="J")
        lRejected:=jResult["success"]==.F..and.jResult["code"]=="INVALID_SRA_DEFINITION".and.Empty(jResult["sql"])
        FreeObj(@jResult)
    endif

return(lRejected)

static function PresentationPlanningChecks(jChecks as json)

    local jMetadata:=JSONObject():New() as json
    local jColumns:=JSONObject():New() as json
    local jResult as json
    local jChanged as json

    jMetadata["schemaVersion"]:=1
    jMetadata["alias"]:="SRA"
    jMetadata["count"]:=1
    jMetadata["fields"]:=JSONObject():New()
    jMetadata["fields"]["RA_VIRTUAL"]:=PresentationSRATestField("RA_VIRTUAL",1,"C",10,0)
    jMetadata["fields"]["RA_VIRTUAL"]["virtual"]:=.T.
    jColumns["D_E_L_E_T_"]:=PresentationSRATestColumn("D_E_L_E_T_",1,"char",1)
    jColumns["R_E_C_N_O_"]:=PresentationSRATestColumn("R_E_C_N_O_",2,"bigint",8)
    jColumns["R_E_C_D_E_L_"]:=PresentationSRATestColumn("R_E_C_D_E_L_",3,"bigint",8)
    jResult:=HBBridge.Client.HBBridgePresentationTable():Build(jMetadata,jColumns,"SRA","SRA990")
    jChecks["systemOnlyProjectionHasNoLeadingComma"]:=jResult["success"]==.T..and.;
        Left(AllTrim(jResult["projection"]),1)!=",".and.jResult["includedCount"]==3
    jChecks["systemOnlyProjectionKeepsSourceMap"]:=;
        jResult["schema"]["projectionFields"]["R_E_C_N_O_"]=="R_E_C_N_O_"
    FreeObj(@jResult)
    jResult:=HBBridge.Examples.HBBridgePresentationSRA():Plan(jMetadata,jColumns,"SRA990","01")
    jChecks["sraSystemOnlyProjectionCannotCreateQuery"]:=jResult["success"]==.F..and.;
        jResult["code"]=="INVALID_SRA_DEFINITION".and.Empty(jResult["sql"]).and.Empty(jResult["orderBy"])
    FreeObj(@jResult)
    FreeObj(@jColumns)
    jColumns:=JSONObject():New()
    jResult:=HBBridge.Client.HBBridgePresentationTable():Build(jMetadata,jColumns,"SRA","SRA990")
    jChecks["rejectCompletelyExcludedProjection"]:=jResult["success"]==.F.
    jChecks["rejectCompletelyExcludedProjection"]:=jChecks["rejectCompletelyExcludedProjection"].and.jResult["code"]=="INVALID_SRA_DEFINITION"
    jChecks["rejectCompletelyExcludedProjection"]:=jChecks["rejectCompletelyExcludedProjection"].and.Empty(jResult["sql"])
    jChecks["rejectCompletelyExcludedProjection"]:=jChecks["rejectCompletelyExcludedProjection"].and.ValType(jResult["schema"])=="U"
    FreeObj(@jResult)
    FreeObj(@jMetadata)
    FreeObj(@jColumns)

    jMetadata:=JSONObject():New()
    jMetadata["schemaVersion"]:=1
    jMetadata["alias"]:="SX5"
    jMetadata["count"]:=3
    jMetadata["fields"]:=JSONObject():New()
    jMetadata["fields"]["X5_FILIAL"]:=PresentationSRATestField("X5_FILIAL",1,"C",2,0)
    jMetadata["fields"]["X5_TABELA"]:=PresentationSRATestField("X5_TABELA",2,"C",2,0)
    jMetadata["fields"]["X5_CHAVE"]:=PresentationSRATestField("X5_CHAVE",3,"C",6,0)
    jColumns:=JSONObject():New()
    jColumns["X5_FILIAL"]:=PresentationSRATestColumn("X5_FILIAL",1,"char",2)
    jColumns["X5_TABELA"]:=PresentationSRATestColumn("X5_TABELA",2,"char",2)
    jColumns["X5_CHAVE"]:=PresentationSRATestColumn("X5_CHAVE",3,"char",6)
    jColumns["D_E_L_E_T_"]:=PresentationSRATestColumn("D_E_L_E_T_",4,"char",1)
    jColumns["R_E_C_N_O_"]:=PresentationSRATestColumn("R_E_C_N_O_",5,"bigint",8)
    jResult:=HBBridge.Examples.HBBridgePresentationSX5():Plan(jMetadata,jColumns,"SX5990","01")
    jChecks["sx5UsesSharedPlanning"]:=jResult["success"]==.T..and.;
        jResult["orderBy"]=="X5_FILIAL ASC,X5_TABELA ASC,X5_CHAVE ASC,R_E_C_N_O_ ASC"
    jChecks["sx5BranchAndDeletedRemainBound"]:=jResult["bindings"]["1"]["value"]==" ".and.;
        jResult["bindings"]["2"]["value"]=="01".and.At("?",jResult["sql"])>0
    FreeObj(@jResult)
    jResult:=HBBridge.Examples.HBBridgePresentationSX5():Plan(jMetadata,jColumns,"SX5990","")
    jChecks["sx5SharedBranchIsAccepted"]:=jResult["success"]==.T..and.;
        jResult["bindings"]["2"]["value"]==""
    FreeObj(@jResult)
    jResult:=HBBridge.Examples.HBBridgePresentationSX5():Plan(jMetadata,jColumns,"SX5990","123")
    jChecks["sx5RejectOversizeBranch"]:=jResult["success"]==.F..and.Empty(jResult["sql"])
    FreeObj(@jResult)
    jResult:=HBBridge.Examples.HBBridgePresentationSX5():Plan(jMetadata,jColumns,"SX5990","0"+Chr(0)+"1")
    jChecks["sx5RejectNulBranch"]:=jResult["success"]==.F..and.Empty(jResult["sql"])
    FreeObj(@jResult)
    jChanged:=PresentationSRATestWithout(jColumns,"X5_FILIAL")
    jResult:=HBBridge.Examples.HBBridgePresentationSX5():Plan(jMetadata,jChanged,"SX5990","01")
    jChecks["sx5RejectMissingBranch"]:=jResult["success"]==.F..and.Empty(jResult["sql"])
    FreeObj(@jResult)
    FreeObj(@jChanged)
    jChanged:=PresentationSRATestWithout(jColumns,"X5_TABELA")
    jResult:=HBBridge.Examples.HBBridgePresentationSX5():Plan(jMetadata,jChanged,"SX5990","01")
    jChecks["sx5RejectMissingTableKey"]:=jResult["success"]==.F..and.Empty(jResult["sql"])
    FreeObj(@jResult)
    FreeObj(@jChanged)
    jChanged:=PresentationSRATestWithout(jColumns,"X5_CHAVE")
    jResult:=HBBridge.Examples.HBBridgePresentationSX5():Plan(jMetadata,jChanged,"SX5990","01")
    jChecks["sx5RejectMissingItemKey"]:=jResult["success"]==.F..and.Empty(jResult["sql"])
    FreeObj(@jResult)
    FreeObj(@jChanged)
    jChanged:=PresentationSRATestWithout(jColumns,"D_E_L_E_T_")
    jResult:=HBBridge.Examples.HBBridgePresentationSX5():Plan(jMetadata,jChanged,"SX5990","01")
    jChecks["sx5RejectMissingDeletedPredicate"]:=jResult["success"]==.F..and.Empty(jResult["sql"])
    FreeObj(@jResult)
    FreeObj(@jChanged)
    jChanged:=PresentationSRATestWithout(jColumns,"R_E_C_N_O_")
    jResult:=HBBridge.Examples.HBBridgePresentationSX5():Plan(jMetadata,jChanged,"SX5990","01")
    jChecks["sx5RejectMissingRecordOrder"]:=jResult["success"]==.F..and.;
        jResult["code"]=="INVALID_SX5_DEFINITION".and.Empty(jResult["sql"]).and.Empty(jResult["orderBy"])
    FreeObj(@jResult)
    FreeObj(@jChanged)
    jMetadata["fields"]["X5_CHAVE"]["virtual"]:=.T.
    jResult:=HBBridge.Examples.HBBridgePresentationSX5():Plan(jMetadata,jColumns,"SX5990","01")
    jChecks["sx5RejectExcludedOrderField"]:=jResult["success"]==.F..and.Empty(jResult["sql"])
    FreeObj(@jResult)
    FreeObj(@jMetadata)
    FreeObj(@jColumns)

return

static function PresentationSRATestWithout(jObject as json,cRemoved as character) as json

    // JSONObject exposes its property names through this native array API.
    local aNames:=jObject:GetNames() as array

    local cName:="" as character

    local jCopy:=JSONObject():New() as json

    local nName:=0 as numeric
    local nNames:=Len(aNames) as numeric

    for nName:=1 to nNames
        cName:=aNames[nName]
        if (cName!=cRemoved)
            jCopy[cName]:=jObject[cName]
        endif
    next nName
    FWFreeArray(@aNames)

return(jCopy)

static function PresentationSelectionChecks(jChecks as json)

    // GetNames is the native boundary used to verify the published order.
    local aNames as array

    local cDefinition:="" as character
    local cSelection:="" as character
    local cMetadata:="" as character
    local cColumns:="" as character
    local cQuery:="" as character
    local cProjection:="" as character
    local cLiteral:="' OR 1=1 --%_[]~" as character

    local jMetadata:=PresentationSRATestMetadata() as json
    local jColumns:=PresentationSRATestColumns() as json
    local jBase as json
    local jSelected as json
    local jSelection:=PresentationSelectionFixture() as json
    local jInvalid as json
    local jPlan as json
    local jQuery as json

    local oSource as object

    jBase:=HBBridge.Client.HBBridgePresentationTable():Build(jMetadata,jColumns,"SRA","SRA990")
    jChecks["selectionBaseIsUnplanned"]:=jBase["success"]==.T..and.Empty(jBase["sql"])
    if (!jChecks["selectionBaseIsUnplanned"])
        throw "SELECTION_BASE_MISSING"
    endif
    jChecks["selectionBaseRetainsNumericExpression"]:=;
        "CAST(SRA.[RA_SALARIO]ASDECIMAL(12,2))" $ Upper(StrTran(jBase["expressions"]["RA_SALARIO"]," ",""))
    jChecks["selectionBaseRetainsRecordExpression"]:=;
        "CAST(SRA.[R_E_C_N_O_]ASBIGINT)" $ Upper(StrTran(jBase["expressions"]["R_E_C_N_O_"]," ",""))
    cDefinition:=HBBridge.Client.HBBridgeJSON():Encode(jBase)
    cSelection:=HBBridge.Client.HBBridgeJSON():Encode(jSelection)
    jSelected:=HBBridge.Client.HBBridgePresentationTable():Project(jBase,jSelection)
    jChecks["selectedDefinitionSucceeded"]:=jSelected["success"]==.T..and.Empty(jSelected["sql"])
    if (!jChecks["selectedDefinitionSucceeded"])
        throw "SELECTED_DEFINITION_REJECTED"
    endif
    jChecks["selectionDoesNotMutateDefinition"]:=HBBridge.Client.HBBridgeJSON():Encode(jBase)==cDefinition
    jChecks["selectionDoesNotMutateRequest"]:=HBBridge.Client.HBBridgeJSON():Encode(jSelection)==cSelection
    aNames:=jSelected["schema"]["fields"]:GetNames()
    jChecks["selectionOrderUsesExplicitPositions"]:=Len(aNames)==5.and.;
        aNames[1]=="AMOUNT".and.aNames[2]=="EMPLOYEE".and.aNames[3]=="ADMISSION".and.;
        aNames[4]=="FLAG".and.aNames[5]=="RECORD_ID"
    FWFreeArray(@aNames)
    cProjection:=Upper(StrTran(jSelected["projection"]," ",""))
    jChecks["selectionProjectionUsesOutputAliases"]:=;
        "CAST(SRA.[RA_SALARIO]ASDECIMAL(12,2))AS[AMOUNT]" $ cProjection.and.;
        "SRA.[RA_NOME]AS[EMPLOYEE]" $ cProjection.and.;
        "CAST(SRA.[R_E_C_N_O_]ASBIGINT)AS[RECORD_ID]" $ cProjection
    jChecks["selectionProjectionOrderMatchesSchema"]:=At("AS[AMOUNT]",cProjection)<At("AS[EMPLOYEE]",cProjection).and.;
        At("AS[EMPLOYEE]",cProjection)<At("AS[ADMISSION]",cProjection).and.;
        At("AS[ADMISSION]",cProjection)<At("AS[FLAG]",cProjection).and.;
        At("AS[FLAG]",cProjection)<At("AS[RECORD_ID]",cProjection)
    jChecks["selectionKeepsDictionaryScaleAndPicture"]:=;
        jSelected["schema"]["fields"]["AMOUNT"]["type"]=="numeric".and.;
        jSelected["schema"]["fields"]["AMOUNT"]["length"]==12.and.;
        jSelected["schema"]["fields"]["AMOUNT"]["decimals"]==2.and.;
        jSelected["schema"]["fields"]["AMOUNT"]["picture"]=="@E 999,999,999.99"
    jChecks["selectionKeepsDateAndLogicalDefinitions"]:=;
        jSelected["schema"]["fields"]["ADMISSION"]["type"]=="date".and.;
        jSelected["schema"]["fields"]["ADMISSION"]["inputFormat"]=="YYYYMMDD".and.;
        jSelected["schema"]["fields"]["FLAG"]["type"]=="logical"
    jChecks["selectionMapsEveryOutputToOriginal"]:=;
        jSelected["schema"]["projectionFields"]["AMOUNT"]=="RA_SALARIO".and.;
        jSelected["schema"]["projectionFields"]["EMPLOYEE"]=="RA_NOME".and.;
        jSelected["schema"]["projectionFields"]["ADMISSION"]=="RA_ADMISSA".and.;
        jSelected["schema"]["projectionFields"]["FLAG"]=="RA_FLAG".and.;
        jSelected["schema"]["projectionFields"]["RECORD_ID"]=="R_E_C_N_O_"
    jChecks["selectionAddsNoAutomaticSystemFields"]:=;
        !jSelected["schema"]["fields"]:HasProperty("D_E_L_E_T_").and.;
        !jSelected["schema"]["fields"]:HasProperty("R_E_C_D_E_L_").and.;
        !jSelected["schema"]["fields"]:HasProperty("R_E_C_N_O_")
    aNames:=jSelected["fieldStatus"]:GetNames()
    jChecks["selectionRetainsCompleteSourceInventory"]:=Len(aNames)==23.and.;
        jSelected["metadata"]["count"]==19.and.jSelected["includedCount"]==5.and.;
        jSelected["excludedCount"]==18
    FWFreeArray(@aNames)
    jChecks["selectionStatusUsesOriginalNames"]:=;
        jSelected["fieldStatus"]["RA_SALARIO"]["status"]=="included".and.;
        !jSelected["fieldStatus"]:HasProperty("AMOUNT").and.;
        jSelected["fieldStatus"]["RA_FILIAL"]["status"]=="excluded".and.;
        jSelected["fieldStatus"]["RA_FILIAL"]["reason"]=="notSelected"
    jChecks["selectionPreservesPriorExclusionReasons"]:=;
        jSelected["fieldStatus"]["RA_MEMO"]["reason"]=="memo".and.;
        jSelected["fieldStatus"]["RA_MISSING"]["reason"]=="missingColumn"
    jSelected["schema"]["fields"]["AMOUNT"]["decimals"]:=1
    jSelected["metadata"]["fields"]["RA_NOME"]["caption"]:="Selected mutation"
    jSelected["fieldStatus"]["RA_FILIAL"]["reason"]:="Selected mutation"
    jChecks["selectionResultOwnsNestedSnapshots"]:=HBBridge.Client.HBBridgeJSON():Encode(jBase)==cDefinition
    FreeObj(@jSelected)
    jSelected:=HBBridge.Client.HBBridgePresentationTable():Project(jBase,jSelection)
    jSelection["AMOUNT"]["position"]:=5
    jChecks["selectionResultSurvivesRequestMutation"]:=;
        Left(Upper(StrTran(jSelected["projection"]," ","")),Len("CAST(SRA.[RA_SALARIO]ASDECIMAL(12,2))AS[AMOUNT]"))==;
        "CAST(SRA.[RA_SALARIO]ASDECIMAL(12,2))AS[AMOUNT]"
    jSelection["AMOUNT"]["position"]:=1
    FreeObj(@jSelected)

    cMetadata:=HBBridge.Client.HBBridgeJSON():Encode(jMetadata)
    cColumns:=HBBridge.Client.HBBridgeJSON():Encode(jColumns)
    jPlan:=HBBridge.Examples.HBBridgePresentationSRA():Plan(jMetadata,jColumns,"SRA990","01",jSelection)
    jChecks["selectedSraPlanSucceeded"]:=jPlan["success"]==.T..and.!Empty(jPlan["sql"])
    if (!jChecks["selectedSraPlanSucceeded"])
        throw "SELECTED_SRA_PLAN_REJECTED"
    endif
    jChecks["selectedSraUsesProjectedUniqueOrder"]:=jPlan["orderBy"]=="RECORD_ID ASC"
    jChecks["selectedSraRetainsUnselectedBusinessPredicates"]:=;
        "SRA.[D_E_L_E_T_] = ?" $ jPlan["sql"].and."SRA.[RA_FILIAL] = ?" $ jPlan["sql"].and.;
        jPlan["bindings"]["1"]["value"]==" ".and.jPlan["bindings"]["2"]["value"]=="01".and.;
        !jPlan["schema"]["fields"]:HasProperty("RA_FILIAL").and.;
        !jPlan["schema"]["fields"]:HasProperty("RA_MAT")
    jChecks["selectedPlanningOwnsCallerInputs"]:=HBBridge.Client.HBBridgeJSON():Encode(jMetadata)==cMetadata.and.;
        HBBridge.Client.HBBridgeJSON():Encode(jColumns)==cColumns.and.;
        HBBridge.Client.HBBridgeJSON():Encode(jSelection)==cSelection
    PresentationSelectionNativeChecks(jChecks,jPlan)
    oSource:=HBBridge.Examples.HBBridgePresentationSQLSource():New(;
        jPlan["sql"],jPlan["orderBy"],jPlan["schema"],jPlan["bindings"])
    jChecks["selectedAliasNumericFilter"]:=oSource:AddFilter("AMOUNT","at least","10.25")
    jChecks["selectedAliasLiteralSearch"]:=oSource:SetSearch("EMPLOYEE",cLiteral)
    jQuery:=oSource:Query()
    jChecks["selectedAliasCriteriaUseProjectedColumns"]:=;
        "HBBR_SOURCE.[AMOUNT] >= ?" $ jQuery["sql"].and.;
        "HBBR_SOURCE.[EMPLOYEE] LIKE ?" $ jQuery["sql"].and.;
        jQuery["orderBy"]=="RECORD_ID ASC"
    jChecks["selectedAliasLiteralsStayBound"]:=!(cLiteral$jQuery["sql"]).and.;
        jQuery["bindings"]["1"]["value"]==" ".and.jQuery["bindings"]["2"]["value"]=="01".and.;
        jQuery["bindings"]["3"]["type"]=="number".and.jQuery["bindings"]["3"]["value"]==10.25.and.;
        jQuery["bindings"]["4"]["type"]=="text".and.;
        jQuery["bindings"]["4"]["value"]=="%' OR 1=1 --~%~_~[~]~~%"
    cQuery:=HBBridge.Client.HBBridgeJSON():Encode(jQuery)
    FreeObj(@jQuery)
    jChecks["selectedAliasRejectsUnselectedOrigin"]:=!oSource:SetSearch("RA_NOME","Name")
    jChecks["selectedAliasRejectsExpression"]:=!oSource:AddFilter("AMOUNT","equal","1+1")
    jQuery:=oSource:Query()
    jChecks["selectedAliasInvalidCriteriaKeepState"]:=HBBridge.Client.HBBridgeJSON():Encode(jQuery)==cQuery
    FreeObj(@jQuery)
    oSource:Close()
    FreeObj(@oSource)
    FreeObj(@jPlan)

    jInvalid:=JSONObject():New()
    jInvalid["AMOUNT"]:=PresentationSelectionEntry("RA_SALARIO",1)
    jSelected:=HBBridge.Client.HBBridgePresentationTable():Project(jBase,jInvalid)
    aNames:=jSelected["schema"]["fields"]:GetNames()
    jChecks["standaloneSelectionDoesNotRequireSystemFields"]:=jSelected["success"]==.T..and.;
        Len(aNames)==1.and.aNames[1]=="AMOUNT"
    FWFreeArray(@aNames)
    FreeObj(@jSelected)
    jPlan:=HBBridge.Examples.HBBridgePresentationSRA():Plan(jMetadata,jColumns,"SRA990","01",jInvalid)
    jChecks["selectedSraRejectsMissingIdentity"]:=jPlan["success"]==.F..and.;
        jPlan["code"]=="INVALID_SRA_DEFINITION".and.Empty(jPlan["sql"])
    FreeObj(@jPlan)
    FreeObj(@jInvalid)
    jInvalid:=PresentationSRATestWithout(jColumns,"RA_FILIAL")
    jPlan:=HBBridge.Examples.HBBridgePresentationSRA():Plan(jMetadata,jInvalid,"SRA990","01",jSelection)
    jChecks["selectedSraStillValidatesBusinessColumns"]:=jPlan["success"]==.F..and.;
        jPlan["code"]=="INVALID_SRA_DEFINITION".and.Empty(jPlan["sql"])
    FreeObj(@jPlan)
    FreeObj(@jInvalid)

    PresentationSelectionInvalidChecks(jChecks,jBase)
    jChecks["invalidSelectionsLeaveBaseUnchanged"]:=HBBridge.Client.HBBridgeJSON():Encode(jBase)==cDefinition
    FreeObj(@jSelection)
    FreeObj(@jBase)
    FreeObj(@jMetadata)
    FreeObj(@jColumns)

return

static function PresentationSelectionFixture() as json

    local jSelection:=JSONObject():New() as json

    // Deliberately insert in an order different from the requested output.
    jSelection["RECORD_ID"]:=PresentationSelectionEntry("R_E_C_N_O_",5)
    jSelection["EMPLOYEE"]:=PresentationSelectionEntry("RA_NOME",2)
    jSelection["FLAG"]:=PresentationSelectionEntry("RA_FLAG",4)
    jSelection["AMOUNT"]:=PresentationSelectionEntry("RA_SALARIO",1)
    jSelection["ADMISSION"]:=PresentationSelectionEntry("RA_ADMISSA",3)

return(jSelection)

static function PresentationSelectionEntry(cSource as character,nPosition as numeric) as json

    local jEntry:=JSONObject():New() as json

    jEntry["source"]:=cSource
    jEntry["position"]:=nPosition

return(jEntry)

static function PresentationSelectionInvalidChecks(jChecks as json,jBase as json)

    // Native enumeration is required to execute named invalid fixtures.
    local aNames as array

    local cCase:="" as character
    local cSelection:="" as character

    local jCases:=JSONObject():New() as json
    local jCase as json
    local jSelected as json
    local jPlanned as json

    local nCase:=0 as numeric
    local nCases:=0 as numeric

    jCases["empty"]:=JSONObject():New()
    jCases["missingSource"]:={"VALUE":{"position":1}}
    jCases["missingPosition"]:={"VALUE":{"source":"RA_NOME"}}
    jCases["extraMember"]:={"VALUE":{"source":"RA_NOME","position":1,"sql":"RA_NOME"}}
    jCases["nonObjectEntry"]:={"VALUE":"RA_NOME"}
    jCases["numericSource"]:={"VALUE":{"source":1,"position":1}}
    jCases["unknownSource"]:={"VALUE":{"source":"UNKNOWN","position":1}}
    jCases["excludedMemo"]:={"VALUE":{"source":"RA_MEMO","position":1}}
    jCases["excludedVirtual"]:={"VALUE":{"source":"RA_VIRTUAL","position":1}}
    jCases["sourceExpression"]:={"VALUE":{"source":"RA_NOME;DROP TABLE SRA990","position":1}}
    // TLPP JSON literals reject these property names at compile time.
    // Runtime assignment preserves the actual invalid alias without macros.
    jCases["aliasExpression"]:=JSONObject():New()
    jCases["aliasExpression"]["VALUE;DROP"]:=PresentationSelectionEntry("RA_NOME",1)
    jCases["aliasDelimited"]:=JSONObject():New()
    jCases["aliasDelimited"]["[VALUE]"]:=PresentationSelectionEntry("RA_NOME",1)
    jCases["aliasEmpty"]:=JSONObject():New()
    jCases["aliasEmpty"][""]:=PresentationSelectionEntry("RA_NOME",1)
    jChecks["invalidAliasInputsPreserved"]:=;
        jCases["aliasExpression"]:HasProperty("VALUE;DROP").and.;
        jCases["aliasDelimited"]:HasProperty("[VALUE]").and.;
        jCases["aliasEmpty"]:HasProperty("")
    jCases["aliasNul"]:=JSONObject():New()
    jCases["aliasNul"]["VA"+Chr(0)+"LUE"]:=PresentationSelectionEntry("RA_NOME",1)
    jCases["aliasCaseCollision"]:={"VALUE":{"source":"RA_NOME","position":1},;
        "value":{"source":"RA_SALARIO","position":2}}
    jCases["repeatedSource"]:={"FIRST":{"source":"RA_NOME","position":1},;
        "SECOND":{"source":"RA_NOME","position":2}}
    jCases["duplicatePosition"]:={"FIRST":{"source":"RA_NOME","position":1},;
        "SECOND":{"source":"RA_SALARIO","position":1}}
    jCases["positionGap"]:={"FIRST":{"source":"RA_NOME","position":1},;
        "SECOND":{"source":"RA_SALARIO","position":3}}
    jCases["zeroPosition"]:={"VALUE":{"source":"RA_NOME","position":0}}
    jCases["negativePosition"]:={"VALUE":{"source":"RA_NOME","position":-1}}
    jCases["fractionalPosition"]:={"VALUE":{"source":"RA_NOME","position":1.5}}
    jCases["textPosition"]:={"VALUE":{"source":"RA_NOME","position":"1"}}
    jCases["nullPosition"]:={"VALUE":{"source":"RA_NOME","position":nil}}
    aNames:=jCases:GetNames()
    nCases:=Len(aNames)
    for nCase:=1 to nCases
        cCase:=aNames[nCase]
        jCase:=jCases[cCase]
        cSelection:=HBBridge.Client.HBBridgeJSON():Encode(jCase)
        jSelected:=HBBridge.Client.HBBridgePresentationTable():Project(jBase,jCase)
        jChecks["invalidSelection."+cCase]:=PresentationSelectionRejected(jSelected)
        jChecks["invalidSelection."+cCase]:=jChecks["invalidSelection."+cCase].and.HBBridge.Client.HBBridgeJSON():Encode(jCase)==cSelection
        FreeObj(@jSelected)
    next nCase
    FWFreeArray(@aNames)
    // These values deliberately violate the JSON-object selector boundary.
    jSelected:=HBBridge.Client.HBBridgePresentationTable():Project(jBase,nil)
    jChecks["invalidSelection.nullSelector"]:=PresentationSelectionRejected(jSelected)
    FreeObj(@jSelected)
    jSelected:=HBBridge.Client.HBBridgePresentationTable():Project(jBase,"RA_NOME")
    jChecks["invalidSelection.textSelector"]:=PresentationSelectionRejected(jSelected)
    FreeObj(@jSelected)
    jSelected:=HBBridge.Client.HBBridgePresentationTable():Project(jBase,{"RA_NOME"})
    jChecks["invalidSelection.nativeArraySelector"]:=PresentationSelectionRejected(jSelected)
    FreeObj(@jSelected)
    jCase:=JSONObject():New()
    jCase:FromJSON("[]")
    jSelected:=HBBridge.Client.HBBridgePresentationTable():Project(jBase,jCase)
    jChecks["invalidSelection.jsonArraySelector"]:=PresentationSelectionRejected(jSelected)
    FreeObj(@jSelected)
    FreeObj(@jCase)
    jCase:=JSONObject():New()
    jCase["VALUE"]:=PresentationSelectionEntry("RA_NOME",1)
    jPlanned:=JSONObject():New()
    HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(jBase),jPlanned)
    jPlanned["sql"]:="SELECT RA_NOME FROM SRA990"
    jSelected:=HBBridge.Client.HBBridgePresentationTable():Project(jPlanned,jCase)
    jChecks["invalidSelection.alreadyPlannedDefinition"]:=PresentationSelectionRejected(jSelected)
    FreeObj(@jSelected)
    jPlanned["sql"]:=""
    jPlanned["success"]:=.F.
    jSelected:=HBBridge.Client.HBBridgePresentationTable():Project(jPlanned,jCase)
    jChecks["invalidSelection.failedDefinition"]:=PresentationSelectionRejected(jSelected)
    FreeObj(@jSelected)
    FreeObj(@jPlanned)
    jPlanned:=HBBridge.Client.HBBridgePresentationTable():Project(jBase,jCase)
    FreeObj(@jCase)
    jCase:=JSONObject():New()
    jCase["RENAMED"]:=PresentationSelectionEntry("VALUE",1)
    jSelected:=HBBridge.Client.HBBridgePresentationTable():Project(jPlanned,jCase)
    jChecks["invalidSelection.alreadyProjectedDefinition"]:=PresentationSelectionRejected(jSelected)
    FreeObj(@jSelected)
    FreeObj(@jPlanned)
    FreeObj(@jCase)
    FreeObj(@jCases)

return

static function PresentationSelectionRejected(jResult as json) as logical

    if (ValType(jResult)!="J")
        return(.F.)
    endif

return(jResult["success"]==.F..and.jResult["code"]=="INVALID_FIELD_SELECTION".and.;
    Empty(jResult["sql"]).and.ValType(jResult["schema"])=="U")

static function PresentationSelectionNativeChecks(jChecks as json,jDefinition as json)

    local cWireText:="a"+Chr(195)+Chr(167)+Chr(195)+Chr(163)+"o" as character

    local jResponse:=HBBridge.Tests.HBBridgePresentationFixture():Result(0,1,1) as json
    local jHeader:=HBBridge.Tests.HBBridgePresentationFixture():Header() as json
    local jSelectedHeader:=JSONObject():New() as json
    local jRow:=JSONObject():New() as json

    local oClient:=HBBridge.Tests.HBBridgeDataSetMockClient():New() as object
    local oDataSet:=HBBridge.RDD.HBBridgeRPCDataSet():New(oClient) as object
    local oNative as object

    local xError as variant

    try
        jSelectedHeader["AMOUNT"]:=PresentationSelectionWire(jHeader["AMOUNT"],1)
        jSelectedHeader["EMPLOYEE"]:=PresentationSelectionWire(jHeader["TEXT"],2)
        jSelectedHeader["ADMISSION"]:=PresentationSelectionWire(jHeader["TEXT"],3)
        jSelectedHeader["FLAG"]:=PresentationSelectionWire(jHeader["FLAG"],4)
        jSelectedHeader["RECORD_ID"]:=PresentationSelectionWire(jHeader["ID"],5)
        jResponse["header"]:=jSelectedHeader
        jSelectedHeader:=nil
        jRow["AMOUNT"]:="123.25"
        jRow["EMPLOYEE"]:=cWireText
        jRow["ADMISSION"]:="20240229"
        jRow["FLAG"]:=.F.
        jRow["RECORD_ID"]:="42"
        jResponse["rows"]["1"]:=jRow
        jRow:=nil
        oClient:Queue(jResponse)
        oDataSet:SetAliasProfile("presentation/selected")
        jChecks["selectedNativeTypedPage"]:=oDataSet:OpenSQLTyped(jDefinition["sql"],jDefinition["bindings"])
        if (!jChecks["selectedNativeTypedPage"])
            throw "SELECTED_NATIVE_PAGE_REJECTED"
        endif
        oNative:=HBBridge.Client.HBBridgeNativeTable():New(oDataSet,jDefinition["schema"],.T.,"SQLITE_MEM")
        jChecks["selectedNativeStorage"]:=oNative:LoadCurrentPage()
        if (!jChecks["selectedNativeStorage"])
            throw "SELECTED_NATIVE_STORAGE_REJECTED"
        endif
        jChecks["selectedNativeContainsOnlyFiveOutputs"]:=oNative:FieldCount()==5.and.oNative:RowCount()==1
        jChecks["selectedNativePositionsMatchSQL"]:=oNative:FieldPos("AMOUNT")==1.and.;
            oNative:FieldPos("EMPLOYEE")==2.and.oNative:FieldPos("ADMISSION")==3.and.;
            oNative:FieldPos("FLAG")==4.and.oNative:FieldPos("RECORD_ID")==5
        jChecks["selectedNativeAmountAndIdentity"]:=oNative:FieldGet("AMOUNT")==123.25.and.;
            oNative:FieldGet("RECORD_ID")==42
        jChecks["selectedNativeDateAndLogical"]:=oNative:FieldGet("ADMISSION")==SToD("20240229").and.;
            oNative:FieldGet("FLAG")==.F.
        jChecks["selectedNativeUTF8DecodeOnce"]:=RTrim(oNative:FieldGet("EMPLOYEE"))==DecodeUTF8(cWireText)
        jChecks["selectedNativeOriginalDictionaryNames"]:=oNative:SourceFieldName("AMOUNT")=="RA_SALARIO".and.;
            oNative:SourceFieldName("EMPLOYEE")=="RA_NOME".and.;
            oNative:SourceFieldName("RECORD_ID")=="R_E_C_N_O_"
        jChecks["selectedNativeSourceLookup"]:=oNative:SourceFieldPos("RA_SALARIO",.F.)==1.and.;
            oNative:SourceFieldGet("RA_SALARIO",.F.)==123.25.and.;
            oNative:SourceFieldCaption("RA_NOME",.F.)=="Name"
        jChecks["selectedNativeDoesNotExposeOmittedFields"]:=oNative:FieldPos("RA_FILIAL")==0.and.;
            oNative:SourceFieldPos("RA_FILIAL",.F.)==0
        jChecks["selectedNativeCleanup"]:=oNative:Destroy()
        jChecks["selectedNativeKeepsBorrowedDataset"]:=oDataSet:RowCount()==1.and.;
            oDataSet:FieldGet("EMPLOYEE")==cWireText
    catch xError
        jChecks["selectedNativeUnexpectedRuntimeFailure"]:=.F.
        ConOut("hbBridge selected native storage failed; inspect the owned local log.")
        if (ValType(xError)=="O")
            FreeObj(@xError)
        endif
    endtry
    if (ValType(oNative)=="O")
        if (oNative:Destroy())
            FreeObj(@oNative)
        else
            jChecks["selectedNativeFinalCleanup"]:=.F.
        endif
    endif
    oDataSet:Close()
    FreeObj(@oDataSet)
    oClient:Close()
    FreeObj(@oClient)
    FreeObj(@jResponse)
    FreeObj(@jHeader)
    FreeObj(@jSelectedHeader)
    FreeObj(@jRow)

return

static function PresentationSelectionWire(jField as json,nPosition as numeric) as json

    local jCopy:=JSONObject():New() as json

    if (!HBBridge.Client.HBBridgeJSON():Parse(HBBridge.Client.HBBridgeJSON():Encode(jField),jCopy))
        FreeObj(@jCopy)
        return(nil)
    endif
    jCopy["position"]:=nPosition

return(jCopy)
