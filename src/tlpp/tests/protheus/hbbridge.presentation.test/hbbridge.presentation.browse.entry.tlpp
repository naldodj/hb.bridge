#include "totvs.ch"

// Global U_ entries keep AppServer -run and direct test calls independent
// of the example's namespace. Implementation/helpers stay in that module.
function U_HBBridgeNativeBrowse(nRecords,nPageSize)
return(HBBridge.Examples.U_HBBridgeNativeBrowse(nRecords,nPageSize))

function U_HBBridgeNativeBrowseTest()
return(HBBridge.Examples.U_HBBridgeNativeBrowseTest())

function U_HBBridgeNativeBrowseSX5(cProfile,cTransport,nPageSize)
return(HBBridge.Examples.U_HBBridgeNativeBrowseSX5(cProfile,cTransport,nPageSize))

function U_HBBridgeNativeBrowseSRA(cProfile,cTransport,nPageSize)
return(HBBridge.Examples.U_HBBridgeNativeBrowseSRA(cProfile,cTransport,nPageSize))

function U_HBBridgeNativeBrowseSRASRB(cProfile,cTransport,nPageSize)
return(HBBridge.Examples.U_HBBridgeNativeBrowseSRASRB(cProfile,cTransport,nPageSize))

function U_HBBridgeNativeBrowseSRACTT(cProfile,cTransport,nPageSize)
return(HBBridge.Examples.U_HBBridgeNativeBrowseSRACTT(cProfile,cTransport,nPageSize))

function U_HBBridgeNativeBrowseSRASelected(cProfile,cTransport,nPageSize,jSelection)
return(HBBridge.Examples.U_HBBridgeNativeBrowseSRASelected(cProfile,cTransport,nPageSize,jSelection))

function U_HBBridgeSX3Browse(cAlias)
return(HBBridge.Examples.U_HBBridgeSX3Browse(cAlias))

function U_HBBridgeNativeBrowseTempSX5(cProfile)
return(HBBridge.Examples.HBBridgePresentationTemp():Run("SX5",cProfile))

function U_HBBridgeNativeBrowseTempSRA(cProfile)
return(HBBridge.Examples.HBBridgePresentationTemp():Run("SRA",cProfile))

function U_HBBridgeNativeTempIndexTest()
return(HBBridge.Examples.HBBridgePresentationTemp():TestIndexes())
