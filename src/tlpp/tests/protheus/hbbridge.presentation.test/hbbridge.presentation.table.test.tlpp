/* Released to Public Domain. */
#include "totvs.ch"

// AppServer -run entry. The native variadic argument array is borrowed.
function U_HBBridgePresentationTableCLI(oArguments as variadic)

    local aArguments:=oArguments:vArgs as array

    local cArgument:="" as character
    local cValue:="" as character
    local cDigit:="" as character

    local lSeen:=.F. as logical
    local lValid:=.T. as logical

    local nRecords:=1025 as numeric
    local nArgument:=0 as numeric
    local nArguments:=Len(aArguments) as numeric
    local nCharacter:=0 as numeric
    local nCharacters:=0 as numeric

    for nArgument:=1 to nArguments
        if (ValType(aArguments[nArgument])!="C")
            loop
        endif
        cArgument:=aArguments[nArgument]
        if (Left(cArgument,13)!="--native-rows")
            loop
        endif
        if (lSeen.or.Left(cArgument,14)!="--native-rows=")
            lValid:=.F.
            exit
        endif
        lSeen:=.T.
        cValue:=SubStr(cArgument,15)
        nCharacters:=Len(cValue)
        if (nCharacters<1.or.nCharacters>16)
            lValid:=.F.
            exit
        endif
        for nCharacter:=1 to nCharacters
            cDigit:=SubStr(cValue,nCharacter,1)
            if (cDigit<"0".or.cDigit>"9")
                lValid:=.F.
                exit
            endif
        next nCharacter
        if (!lValid)
            exit
        endif
        nRecords:=Val(cValue)
        if (nRecords<1.or.nRecords>9007199254740991.or.tlpp.ToStr(nRecords)!=cValue)
            lValid:=.F.
            exit
        endif
    next nArgument
    if (!lValid)
        ConOut("hbBridge native table CLI: use --native-rows=<positive integer> once, without leading zeros.")
        return(1)
    endif

return(U_HBBridgePresentationTableTest(nRecords))

function U_HBBridgePresentationTableTest(nRecords)

    local aNames as array
    local aTopInfo as array

    local cAlias:="" as character
    local cPreviousAlias:="" as character
    local cDatabase:="" as character
    local cProfile:="" as character
    local cServer:="" as character
    local cRowKey:="" as character
    local cExpectedMode:="" as character
    local cExpectedText:="" as character
    local cIndexKey as character
    local cFieldType as character

    local jChecks:=JSONObject():New() as json
    local jSchema as json
    local jResponse as json
    local jSnapshot as json
    local jBindings:=JSONObject():New() as json

    local lOK:=.T. as logical
    local lOwned:=.F. as logical
    local lOpened:=.F. as logical

    local nConnection:=-1 as numeric
    local nPort:=0 as numeric
    local nArea:=Select() as numeric
    local nCheck:=0 as numeric
    local nChecks:=0 as numeric
    local nRow:=0 as numeric
    local nField:=0 as numeric
    local nFields:=0 as numeric
    local nPreviousWorkArea:=0 as numeric
    local nPreviousOrder:=0 as numeric
    local nLookupArea:=0 as numeric
    local nLookupRecord:=0 as numeric
    local nIDPosition:=0 as numeric
    local nCodePosition:=0 as numeric
    local nAmountPosition:=0 as numeric
    local nTextPosition:=0 as numeric
    local nFlagPosition:=0 as numeric
    local nDayPosition:=0 as numeric
    local nFloatPosition:=0 as numeric

    local oClient as object
    local oDataSet as object
    local oNative as object

    local xError as variant

    DEFAULT nRecords:=1025
    if (ValType(nRecords)!="N")
        ConOut("hbBridge native table test: record count must be a positive integer.")
        FreeObj(@jChecks)
        FreeObj(@jBindings)
        return(1)
    endif
    if (nRecords<1.or.nRecords!=Int(nRecords))
        ConOut("hbBridge native table test: record count must be a positive integer.")
        FreeObj(@jChecks)
        FreeObj(@jBindings)
        return(1)
    endif
    ConOut("hbBridge native table fixture: synthetic typed JSON; no ERP table or hbBridge SQL query; main rows="+tlpp.ToStr(nRecords)+"; fixed paging rows=2+1.")
    ConOut("hbBridge native table target: private DBAccess temporary table; Close/Destroy removes the fixture data.")
    oClient:=HBBridge.Tests.HBBridgeDataSetMockClient():New()
    oDataSet:=HBBridge.RDD.HBBridgeRPCDataSet():New(oClient)
    try
        if (!TCIsConnected())
            // FWGetTopInfo is the framework's active DBAccess boundary.
            aTopInfo:=FWGetTopInfo()
            if (ValType(aTopInfo)!="A".or.Len(aTopInfo)<5)
                throw "DBACCESS_CONFIGURATION_REQUIRED"
            endif
            cServer:=aTopInfo[1]
            nPort:=aTopInfo[3]
            cDatabase:=aTopInfo[4]
            cProfile:=aTopInfo[5]
            FWFreeArray(@aTopInfo)
            if (Empty(cServer).or.Empty(cDatabase).or.Empty(cProfile).or.nPort<1)
                throw "DBACCESS_CONFIGURATION_REQUIRED"
            endif
            nConnection:=TCLink(cDatabase+"/"+cProfile,cServer,nPort)
            if (nConnection<0)
                throw "DBACCESS_CONNECTION_FAILED"
            endif
            lOwned:=.T.
        endif
        jChecks["dbaccessConnected"]:=TCIsConnected()
        oDataSet:SetAliasProfile("presentation/mock")
        jResponse:=HBBridge.Tests.HBBridgePresentationFixture():Result(1,2,3)
        jResponse["header"]["TEXT"]["source"]["column"]:="RA_NOME"
        oClient:Queue(jResponse)
        FreeObj(@jResponse)
        jResponse:=HBBridge.Tests.HBBridgePresentationFixture():Result(2,1,3)
        jResponse["header"]["TEXT"]["source"]["column"]:="RA_APELIDO"
        oClient:Queue(jResponse)
        FreeObj(@jResponse)
        jChecks["typedFixtureOpen"]:=oDataSet:OpenPageTyped("SELECT fixture",jBindings,1,2,"ID ASC")
        jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema()
        // This small fixture opts into production storage verification. The
        // configurable larger fixture is independently traversed below.
        oNative:=HBBridge.Client.HBBridgeNativeTable():New(oDataSet,jSchema,.T.,"TOPCONN")
        jChecks["unpublishedProjectionName"]:=Empty(oNative:ProjectionName("F000000004"))
        jChecks["unpublishedSourceFieldName"]:=Empty(oNative:SourceFieldName("TEXT"))
        jChecks["unpublishedSourceCaption"]:=Empty(oNative:SourceFieldCaption("TEXT"))
        jChecks["unpublishedFieldAccess"]:=oNative:FieldPos("TEXT")==0
        jChecks["unpublishedFieldAccess"]:=jChecks["unpublishedFieldAccess"].and.oNative:SourceFieldPos("RA_NOME")==0
        jChecks["unpublishedFieldAccess"]:=jChecks["unpublishedFieldAccess"].and.ValType(oNative:FieldGet("TEXT"))=="U"
        jSchema["fields"]["TEXT"]["length"]:=1
        nArea:=Select()
        lOpened:=oNative:LoadCurrentPage()
        jChecks["nativePageOpen"]:=lOpened
        jChecks["selectedAreaRestored"]:=Select()==nArea
        if (lOpened)
            cAlias:=oNative:Alias()
            jChecks["explicitTopconnStorage"]:=oNative:RDD()=="TOPCONN"
            jChecks["firstFieldIndexOnly"]:=oNative:IndexOrder("ID_CODE")==1
            jChecks["firstFieldIndexOnly"]:=jChecks["firstFieldIndexOnly"].and.(cAlias)->(IndexKey(1))==oNative:FieldName("ID_CODE")
            jChecks["firstFieldIndexOnly"]:=jChecks["firstFieldIndexOnly"].and.Empty((cAlias)->(IndexKey(2)))
            jChecks["uncreatedIndexIsZero"]:=oNative:IndexOrder("TEXT")==0
            jChecks["uncreatedIndexIsZero"]:=jChecks["uncreatedIndexIsZero"].and.oNative:IndexOrder("DAY")==0
            jChecks["uncreatedIndexIsZero"]:=jChecks["uncreatedIndexIsZero"].and.oNative:IndexOrder("FLAG")==0
            jChecks["firstFieldIndexIsIdempotent"]:=oNative:EnsureIndex("ID_CODE")==1
            jChecks["firstFieldIndexIsIdempotent"]:=jChecks["firstFieldIndexIsIdempotent"].and.oNative:EnsureIndex("ID_CODE")==1
            jChecks["firstFieldIndexIsIdempotent"]:=jChecks["firstFieldIndexIsIdempotent"].and.Empty((cAlias)->(IndexKey(2)))
            cExpectedMode:=if(FWBulk():CanBulk(),"bulk","record")
            jChecks["capabilitySelectsWriteMode"]:=oNative:WriteMode()==cExpectedMode
            jChecks["nativeRows"]:=oNative:RowCount()==2
            jChecks["nativeRows"]:=jChecks["nativeRows"].and.(cAlias)->(LastRec())==2
            jChecks["nativeFields"]:=oNative:FieldCount()==7
            jChecks["projectionOrder"]:=oNative:ProjectionName(2)=="ID"
            jChecks["projectionOrder"]:=jChecks["projectionOrder"].and.oNative:ProjectionName(7)=="FLOAT"
            jChecks["nativeCodeMatchesIdentifier"]:=RTrim((cAlias)->(FieldGet(FieldPos(oNative:FieldName("ID_CODE")))))=="0000000001"
            jChecks["generatedFieldNames"]:=Len(oNative:FieldName("TEXT"))==10
            jChecks["generatedFieldNames"]:=jChecks["generatedFieldNames"].and.oNative:FieldName("missing")==""
            jChecks["nativeToProjectionName"]:=oNative:ProjectionName(oNative:FieldName("TEXT"))=="TEXT"
            jChecks["projectionNameRequiresNativeInput"]:=Empty(oNative:ProjectionName("TEXT"))
            jChecks["projectionToSourceName"]:=oNative:SourceFieldName("TEXT")=="RA_NOME"
            jChecks["nativeToSourceName"]:=oNative:SourceFieldName(oNative:ProjectionName(oNative:FieldName("TEXT")))=="RA_NOME"
            jChecks["nativeSourceCaption"]:=oNative:SourceFieldCaption(oNative:SourceFieldName(oNative:ProjectionName(oNative:FieldName("TEXT"))))=="Text"
            jChecks["projectedSourceCaption"]:=oNative:SourceFieldCaption("TEXT")=="Text"
            jChecks["sourceLookupsRequireProjection"]:=Empty(oNative:SourceFieldName(oNative:FieldName("TEXT")))
            jChecks["sourceLookupsRequireProjection"]:=jChecks["sourceLookupsRequireProjection"].and.Empty(oNative:SourceFieldCaption(oNative:FieldName("TEXT")))
            jChecks["unknownSourceCaption"]:=Empty(oNative:SourceFieldCaption("missing"))
            jChecks["unknownSourceIsEmpty"]:=Empty(oNative:SourceFieldName("AMOUNT"))
            jChecks["unknownSourceIsEmpty"]:=jChecks["unknownSourceIsEmpty"].and.Empty(oNative:SourceFieldName("missing"))
            jChecks["unknownProjectionIsEmpty"]:=Empty(oNative:ProjectionName("missing"))
            jChecks["unknownProjectionIsEmpty"]:=jChecks["unknownProjectionIsEmpty"].and.Empty(oNative:ProjectionName(nil))
            jChecks["privateSearchFieldNotProjected"]:=Empty(oNative:ProjectionName(oNative:SearchFieldName("FLAG")))
            jChecks["privateSearchFieldNotProjected"]:=jChecks["privateSearchFieldNotProjected"].and.Empty(oNative:SourceFieldName(oNative:SearchFieldName("FLAG")))
            jChecks["privateSearchFieldNotProjected"]:=jChecks["privateSearchFieldNotProjected"].and.Empty(oNative:SourceFieldCaption(oNative:SearchFieldName("FLAG")))
            jChecks["utf8DecodedIntoNativeField"]:=RTrim((cAlias)->(FieldGet(FieldPos(oNative:FieldName("TEXT")))))==;
                DecodeUTF8("a"+Chr(195)+Chr(167)+Chr(195)+Chr(163)+"o")
            jChecks["exactNativeAmount"]:=(cAlias)->(FieldGet(FieldPos(oNative:FieldName("AMOUNT"))))==123.25
            jChecks["nativeDate"]:=DToS((cAlias)->(FieldGet(FieldPos(oNative:FieldName("DAY")))))=="20240229"
            jChecks["nativeLogicalFalse"]:=ValType((cAlias)->(FieldGet(FieldPos(oNative:FieldName("FLAG")))))=="L"
            jChecks["nativeLogicalFalse"]:=jChecks["nativeLogicalFalse"].and.(cAlias)->(!FieldGet(FieldPos(oNative:FieldName("FLAG"))))
            jChecks["nativeFloatAligned"]:=ValType((cAlias)->(FieldGet(FieldPos(oNative:FieldName("FLOAT")))))=="N"
            jChecks["nativeFloatAligned"]:=jChecks["nativeFloatAligned"].and.(cAlias)->(FieldGet(FieldPos(oNative:FieldName("FLOAT"))))==1.25
            nLookupArea:=Select()
            nLookupRecord:=(cAlias)->(RecNo())
            jChecks["projectionFieldPosition"]:=oNative:FieldPos("TEXT")==(cAlias)->(FieldPos(oNative:FieldName("TEXT")))
            jChecks["uniqueSourceFieldPosition"]:=oNative:SourceFieldPos("RA_NOME")==oNative:FieldPos("TEXT")
            jChecks["uniqueSourceFieldPosition"]:=jChecks["uniqueSourceFieldPosition"].and.oNative:SourceFieldPos("RA_NOME")==oNative:FieldPos("TEXT")
            jChecks["nativeFieldGetKeepsPaddingAndEncoding"]:=oNative:FieldGet("TEXT")==PadR(DecodeUTF8("a"+Chr(195)+Chr(167)+Chr(195)+Chr(163)+"o"),20)
            jChecks["nativeFieldGetKeepsPaddingAndEncoding"]:=jChecks["nativeFieldGetKeepsPaddingAndEncoding"].and.oNative:SourceFieldGet("RA_NOME")==oNative:FieldGet("TEXT")
            jChecks["nativeFieldGetKeepsDateLogicalAndNumeric"]:=ValType(oNative:FieldGet("DAY"))=="D".and.DToS(oNative:FieldGet("DAY"))=="20240229"
            jChecks["nativeFieldGetKeepsDateLogicalAndNumeric"]:=jChecks["nativeFieldGetKeepsDateLogicalAndNumeric"].and.ValType(oNative:FieldGet("FLAG"))=="L"
            jChecks["nativeFieldGetKeepsDateLogicalAndNumeric"]:=jChecks["nativeFieldGetKeepsDateLogicalAndNumeric"].and.!oNative:FieldGet("FLAG")
            jChecks["nativeFieldGetKeepsDateLogicalAndNumeric"]:=jChecks["nativeFieldGetKeepsDateLogicalAndNumeric"].and.ValType(oNative:FieldGet("AMOUNT"))=="N"
            jChecks["nativeFieldGetKeepsDateLogicalAndNumeric"]:=jChecks["nativeFieldGetKeepsDateLogicalAndNumeric"].and.oNative:FieldGet("AMOUNT")==123.25
            jChecks["computedProjectionHasNoInferredSource"]:=oNative:FieldPos("AMOUNT")>0
            jChecks["computedProjectionHasNoInferredSource"]:=jChecks["computedProjectionHasNoInferredSource"].and.oNative:SourceFieldPos("AMOUNT",.F.)==0
            jChecks["computedProjectionHasNoInferredSource"]:=jChecks["computedProjectionHasNoInferredSource"].and.ValType(oNative:SourceFieldGet("AMOUNT",.F.))=="U"
            jChecks["unknownFieldAccessIsSafe"]:=oNative:FieldPos("NOT_PROJECTED")==0
            jChecks["unknownFieldAccessIsSafe"]:=jChecks["unknownFieldAccessIsSafe"].and.ValType(oNative:FieldGet("NOT_PROJECTED"))=="U"
            jChecks["unknownFieldAccessIsSafe"]:=jChecks["unknownFieldAccessIsSafe"].and.oNative:SourceFieldPos("TEXT",.F.)==0
            jChecks["unknownFieldAccessIsSafe"]:=jChecks["unknownFieldAccessIsSafe"].and.ValType(oNative:SourceFieldGet("TEXT",.F.))=="U"
            jChecks["fieldAccessPreservesCursorAndArea"]:=Select()==nLookupArea
            jChecks["fieldAccessPreservesCursorAndArea"]:=jChecks["fieldAccessPreservesCursorAndArea"].and.(cAlias)->(RecNo())==nLookupRecord
            jChecks["fieldAccessPreservesCursorAndArea"]:=jChecks["fieldAccessPreservesCursorAndArea"].and.oClient:CallCount()==1
            jChecks["nativeFieldIndexes"]:=.T.
            nFields:=oNative:FieldCount()
            for nField:=1 to nFields
                jChecks["nativeFieldIndexes"]:=jChecks["nativeFieldIndexes"].and.oNative:EnsureIndex(oNative:ProjectionName(nField))>0
                cIndexKey:=Upper(AllTrim((cAlias)->(IndexKey(nField))))
                ConOut("hbBridge native table index "+tlpp.ToStr(nField)+": "+cIndexKey)
                cFieldType:=(cAlias)->(Type(oNative:FieldName(oNative:ProjectionName(nField))))
                jChecks["nativeFieldIndexes"]:=jChecks["nativeFieldIndexes"].and.;
                    cIndexKey==if(;
                        cFieldType$"C|N";
                        ,oNative:FieldName(oNative:ProjectionName(nField));
                        ,if(;
                            cFieldType=="D";
                            ,"DTOS("+oNative:FieldName(oNative:ProjectionName(nField))+")";
                            ,"L"+SubStr(oNative:FieldName(oNative:ProjectionName(nField)),2);
                        );
                    )
            next nField
            (cAlias)->(dbSetOrder(2))
            jChecks["firstPageIndexSeek"]:=(cAlias)->(DbSeek(PadR("1",20),.F.))
            jSnapshot:=oNative:Schema()
            jChecks["callerSchemaMutationIsolated"]:=jSnapshot["fields"]["TEXT"]["length"]==20
            jSnapshot["fields"]["TEXT"]["length"]:=2
            FreeObj(@jSnapshot)
            jSnapshot:=oNative:Schema()
            jChecks["returnedSchemaDefensive"]:=jSnapshot["fields"]["TEXT"]["length"]==20
            FreeObj(@jSnapshot)
        endif
        jChecks["noImplicitPageRequest"]:=oClient:CallCount()==1
        jChecks["noImplicitPageRequest"]:=jChecks["noImplicitPageRequest"].and.oDataSet:PageNumber()==1
        jChecks["noImplicitPageRequest"]:=jChecks["noImplicitPageRequest"].and.oDataSet:FieldGet("ID")=="1"
        jChecks["explicitNextPage"]:=oDataSet:NextPage()
        jChecks["sourceNameRetainsAcceptedPage"]:=oNative:SourceFieldName("TEXT")=="RA_NOME"
        jChecks["sourceFieldAccessRetainsAcceptedPage"]:=oNative:SourceFieldPos("RA_NOME")>0
        jChecks["sourceFieldAccessRetainsAcceptedPage"]:=jChecks["sourceFieldAccessRetainsAcceptedPage"].and.oNative:SourceFieldPos("RA_APELIDO")==0
        jChecks["sourceFieldAccessRetainsAcceptedPage"]:=jChecks["sourceFieldAccessRetainsAcceptedPage"].and.oNative:SourceFieldGet("RA_NOME")==oNative:FieldGet("TEXT")
        cPreviousAlias:=cAlias
        nPreviousWorkArea:=Select(cAlias)
        lOpened:=oNative:LoadCurrentPage()
        jChecks["nextNativePage"]:=lOpened.and.oNative:RowCount()==1
        jChecks["sourceNameFollowsRefill"]:=oNative:SourceFieldName("TEXT")=="RA_APELIDO"
        jChecks["sourceFieldAccessFollowsRefill"]:=oNative:SourceFieldPos("RA_NOME")==0
        jChecks["sourceFieldAccessFollowsRefill"]:=jChecks["sourceFieldAccessFollowsRefill"].and.ValType(oNative:SourceFieldGet("RA_NOME"))=="U"
        jChecks["sourceFieldAccessFollowsRefill"]:=jChecks["sourceFieldAccessFollowsRefill"].and.oNative:SourceFieldPos("RA_APELIDO")==oNative:FieldPos("TEXT")
        jChecks["sourceFieldAccessFollowsRefill"]:=jChecks["sourceFieldAccessFollowsRefill"].and.oNative:SourceFieldGet("RA_APELIDO")==oNative:FieldGet("TEXT")
        jChecks["refreshKeepsNativeAlias"]:=oNative:Alias()==cPreviousAlias
        jChecks["refreshKeepsNativeWorkArea"]:=Select(cPreviousAlias)==nPreviousWorkArea
        jChecks["refreshKeepsSelectedIndex"]:=(cPreviousAlias)->(IndexOrd())==2
        cAlias:=oNative:Alias()
        if (oNative:IsOpen())
            jChecks["refreshKeepsFieldIndexes"]:=.T.
            for nField:=1 to oNative:FieldCount()
                cFieldType:=(cAlias)->(Type(oNative:FieldName(oNative:ProjectionName(nField))))
                cIndexKey:=Upper(AllTrim((cAlias)->(IndexKey(nField))))
                jChecks["refreshKeepsFieldIndexes"]:=jChecks["refreshKeepsFieldIndexes"].and.;
                    cIndexKey==if(;
                        cFieldType$"C|N";
                        ,oNative:FieldName(oNative:ProjectionName(nField));
                        ,if(;
                            cFieldType=="D";
                            ,"DTOS("+oNative:FieldName(oNative:ProjectionName(nField))+")";
                            ,"L"+SubStr(oNative:FieldName(oNative:ProjectionName(nField)),2);
                        );
                    )
            next nField
            (cAlias)->(dbSetOrder(2))
            jChecks["refreshRemovesOldIndexedRows"]:=(cAlias)->(!DbSeek(PadR("1",20),.F.))
            jChecks["refreshIndexSeeksNewRows"]:=(cAlias)->(DbSeek(PadR("3",20),.F.))
            jChecks["refreshIndexSeeksNewRows"]:=jChecks["refreshIndexSeeksNewRows"].and.RTrim((cAlias)->(FieldGet(FieldPos(oNative:FieldName("ID")))))=="3"
            jChecks["refreshedCodeMatchesIdentifier"]:=RTrim((cAlias)->(FieldGet(FieldPos(oNative:FieldName("ID_CODE")))))=="0000000003"
            (cAlias)->(DbSetOrder(oNative:IndexOrder("FLAG")))
            jChecks["logicalShadowIndexSeek"]:=(cAlias)->(DbSeek(PadR("False",5),.F.))
            jChecks["logicalShadowIndexSeek"]:=jChecks["logicalShadowIndexSeek"].and.(cAlias)->(!FieldGet(FieldPos(oNative:FieldName("FLAG"))))
            (cAlias)->(dbSetOrder(0))
            (cAlias)->(DbGoBottom())
            (cAlias)->(DbSkip())
            jChecks["eofFieldPositionRetainsMetadata"]:=(cAlias)->(Eof())
            jChecks["eofFieldPositionRetainsMetadata"]:=jChecks["eofFieldPositionRetainsMetadata"].and.oNative:FieldPos("TEXT")>0
            jChecks["eofFieldPositionRetainsMetadata"]:=jChecks["eofFieldPositionRetainsMetadata"].and.oNative:SourceFieldPos("RA_APELIDO")==oNative:FieldPos("TEXT")
            jChecks["eofFieldGetHasNoStaleRow"]:=Empty(oNative:FieldGet("TEXT"))
            jChecks["eofFieldGetHasNoStaleRow"]:=jChecks["eofFieldGetHasNoStaleRow"].and.Empty(oNative:SourceFieldGet("RA_APELIDO"))
            jChecks["eofFieldGetHasNoStaleRow"]:=jChecks["eofFieldGetHasNoStaleRow"].and.Empty(oNative:FieldGet("DAY"))
            (cAlias)->(DbGoTop())
        endif
        jChecks["pageRequestsRemainExplicit"]:=oClient:CallCount()==2
        jChecks["pageRequestsRemainExplicit"]:=jChecks["pageRequestsRemainExplicit"].and.oDataSet:FieldGet("ID")=="3"
        cAlias:=oNative:Alias()
        jChecks["closeReleasesAlias"]:=oNative:Close()
        jChecks["closeReleasesAlias"]:=jChecks["closeReleasesAlias"].and.Select(cAlias)==0
        jChecks["closeReleasesAlias"]:=jChecks["closeReleasesAlias"].and.!oNative:IsOpen()
        jChecks["closeIdempotent"]:=oNative:Close()
        jChecks["closeClearsNameLookups"]:=Empty(oNative:SourceFieldName("TEXT"))
        jChecks["closeClearsNameLookups"]:=jChecks["closeClearsNameLookups"].and.Empty(oNative:ProjectionName("F000000004"))
        jChecks["closeClearsSourceCaption"]:=Empty(oNative:SourceFieldCaption("TEXT"))
        jChecks["closeClearsWriteMode"]:=Empty(oNative:WriteMode())
        jChecks["closeClearsFieldAccess"]:=oNative:FieldPos("TEXT")==0
        jChecks["closeClearsFieldAccess"]:=jChecks["closeClearsFieldAccess"].and.oNative:SourceFieldPos("RA_APELIDO")==0
        jChecks["closeClearsFieldAccess"]:=jChecks["closeClearsFieldAccess"].and.ValType(oNative:FieldGet("TEXT"))=="U"
        jChecks["datasetRemainsOwnedByCaller"]:=oDataSet:FieldCount()==7
        jChecks["datasetRemainsOwnedByCaller"]:=jChecks["datasetRemainsOwnedByCaller"].and.oDataSet:FieldGet("ID")=="3"
        jChecks["destroy"]:=oNative:Destroy()
        if (!jChecks["destroy"])
            throw "NATIVE_TABLE_CLEANUP_FAILED"
        endif
        FreeObj(@oNative)
        // An opaque projection alias can equal another column's native field
        // name. Each mapping API has one direction, so neither column wins by
        // lookup precedence or silently acquires the other's SX3 metadata.
        jResponse:=HBBridge.Tests.HBBridgePresentationFixture():Result(0,1,1)
        jResponse["header"]:=NativeTableTestRename(jResponse["header"],"ID","F000000004")
        jResponse["rows"]["1"]:=NativeTableTestRename(jResponse["rows"]["1"],"ID","F000000004")
        jResponse["header"]["F000000004"]["source"]["column"]:="ORIGINAL_ID"
        jResponse["header"]["TEXT"]["source"]["column"]:="RA_NOME"
        oClient:Queue(jResponse)
        FreeObj(@jResponse)
        jChecks["collidingProjectionFixture"]:=oDataSet:OpenSQLTyped("SELECT colliding_projection_fixture",jBindings)
        FreeObj(@jSchema)
        jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema()
        jSchema["fields"]:=NativeTableTestRename(jSchema["fields"],"ID","F000000004")
        oNative:=HBBridge.Client.HBBridgeNativeTable():New(oDataSet,jSchema,.T.,"TOPCONN")
        jChecks["collidingProjectionLoad"]:=oNative:LoadCurrentPage()
        jChecks["collidingProjectionToNative"]:=oNative:FieldName("F000000004")=="F000000002"
        jChecks["collidingNativeToProjection"]:=oNative:ProjectionName("F000000004")=="TEXT"
        jChecks["collidingNativeToProjection"]:=jChecks["collidingNativeToProjection"].and.oNative:ProjectionName(2)=="F000000004"
        jChecks["collidingProjectionSourceName"]:=oNative:SourceFieldName("F000000004")=="ORIGINAL_ID"
        jChecks["collidingProjectionSourceName"]:=jChecks["collidingProjectionSourceName"].and.oNative:SourceFieldName(oNative:ProjectionName("F000000004"))=="RA_NOME"
        jChecks["collidingProjectionSourceCaption"]:=oNative:SourceFieldCaption("F000000004")=="Identifier"
        jChecks["collidingProjectionSourceCaption"]:=jChecks["collidingProjectionSourceCaption"].and.oNative:SourceFieldCaption(oNative:ProjectionName("F000000004"))=="Text"
        jChecks["collidingProjectionFieldAccess"]:=oNative:FieldPos("F000000004")==2
        jChecks["collidingProjectionFieldAccess"]:=jChecks["collidingProjectionFieldAccess"].and.RTrim(oNative:FieldGet("F000000004"))=="1"
        jChecks["collidingProjectionFieldAccess"]:=jChecks["collidingProjectionFieldAccess"].and.oNative:SourceFieldPos("ORIGINAL_ID")==2
        jChecks["collidingProjectionFieldAccess"]:=jChecks["collidingProjectionFieldAccess"].and.oNative:SourceFieldPos("RA_NOME")==4
        jChecks["collidingProjectionCleanup"]:=oNative:Destroy()
        if (!jChecks["collidingProjectionCleanup"])
            throw "NATIVE_TABLE_CLEANUP_FAILED"
        endif
        FreeObj(@oNative)
        // A projection can also equal another field's original SQL name.
        // Default lookup gives the explicit projection priority; source-only
        // mode selects the other field without guessing between namespaces.
        jResponse:=HBBridge.Tests.HBBridgePresentationFixture():Result(0,1,1)
        jResponse["header"]:=NativeTableTestRename(jResponse["header"],"ID","RA_NOME")
        jResponse["rows"]["1"]:=NativeTableTestRename(jResponse["rows"]["1"],"ID","RA_NOME")
        jResponse["header"]["RA_NOME"]["source"]["column"]:="ORIGINAL_ID"
        jResponse["header"]["TEXT"]["source"]["column"]:="RA_NOME"
        oClient:Queue(jResponse)
        FreeObj(@jResponse)
        jChecks["sourceProjectionCollisionFixture"]:=oDataSet:OpenSQLTyped("SELECT source_projection_collision",jBindings)
        FreeObj(@jSchema)
        jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema()
        jSchema["fields"]:=NativeTableTestRename(jSchema["fields"],"ID","RA_NOME")
        oNative:=HBBridge.Client.HBBridgeNativeTable():New(oDataSet,jSchema,.T.,"TOPCONN")
        jChecks["sourceProjectionCollisionLoad"]:=oNative:LoadCurrentPage()
        jChecks["projectionHasExplicitLookupPriority"]:=oNative:FieldPos("RA_NOME")==2
        jChecks["projectionHasExplicitLookupPriority"]:=jChecks["projectionHasExplicitLookupPriority"].and.RTrim(oNative:FieldGet("RA_NOME"))=="1"
        jChecks["sourceOnlyDisambiguatesLookup"]:=oNative:SourceFieldPos("RA_NOME")==4
        jChecks["sourceOnlyDisambiguatesLookup"]:=jChecks["sourceOnlyDisambiguatesLookup"].and.oNative:SourceFieldGet("RA_NOME")==oNative:FieldGet("TEXT")
        jChecks["sourceProjectionCollisionCleanup"]:=oNative:Destroy()
        if (!jChecks["sourceProjectionCollisionCleanup"])
            throw "NATIVE_TABLE_CLEANUP_FAILED"
        endif
        FreeObj(@oNative)
        // Two projections of the same source cannot identify a unique
        // native position. Both explicit projection keys remain usable.
        jResponse:=HBBridge.Tests.HBBridgePresentationFixture():Result(0,1,1)
        jResponse["header"]["ID"]["source"]["column"]:="RA_NOME"
        jResponse["header"]["TEXT"]["source"]["column"]:="RA_NOME"
        oClient:Queue(jResponse)
        FreeObj(@jResponse)
        jChecks["duplicateSourceFixture"]:=oDataSet:OpenSQLTyped("SELECT duplicate_source_fixture",jBindings)
        FreeObj(@jSchema)
        jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema()
        oNative:=HBBridge.Client.HBBridgeNativeTable():New(oDataSet,jSchema,.T.,"TOPCONN")
        jChecks["duplicateSourceLoad"]:=oNative:LoadCurrentPage()
        jChecks["ambiguousSourcePositionIsRejected"]:=oNative:FieldPos("RA_NOME")==0
        jChecks["ambiguousSourcePositionIsRejected"]:=jChecks["ambiguousSourcePositionIsRejected"].and.oNative:SourceFieldPos("RA_NOME")==0
        jChecks["ambiguousSourceValueIsRejected"]:=ValType(oNative:FieldGet("RA_NOME"))=="U"
        jChecks["ambiguousSourceValueIsRejected"]:=jChecks["ambiguousSourceValueIsRejected"].and.ValType(oNative:SourceFieldGet("RA_NOME"))=="U"
        jChecks["duplicateSourceKeepsProjectionAccess"]:=oNative:FieldPos("ID")==2
        jChecks["duplicateSourceKeepsProjectionAccess"]:=jChecks["duplicateSourceKeepsProjectionAccess"].and.oNative:FieldPos("TEXT")==4
        jChecks["duplicateSourceKeepsProjectionAccess"]:=jChecks["duplicateSourceKeepsProjectionAccess"].and.RTrim(oNative:FieldGet("ID"))=="1"
        jChecks["duplicateSourceKeepsProjectionAccess"]:=jChecks["duplicateSourceKeepsProjectionAccess"].and.RTrim(oNative:FieldGet("TEXT"))==DecodeUTF8("a"+Chr(195)+Chr(167)+Chr(195)+Chr(163)+"o")
        jChecks["duplicateSourceCleanup"]:=oNative:Destroy()
        if (!jChecks["duplicateSourceCleanup"])
            throw "NATIVE_TABLE_CLEANUP_FAILED"
        endif
        FreeObj(@oNative)
        // A valid typed NULL remains accepted by the dataset and is rejected
        // only when this explicit native destination cannot represent it.
        jResponse:=HBBridge.Tests.HBBridgePresentationFixture():Result(0,1,1)
        jResponse["rows"]["1"]["TEXT"]:=nil
        oClient:Queue(jResponse)
        FreeObj(@jResponse)
        jChecks["nullAcceptedByDataset"]:=oDataSet:OpenSQLTyped("SELECT nullable_fixture",jBindings)
        FreeObj(@jSchema)
        jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema()
        oNative:=HBBridge.Client.HBBridgeNativeTable():New(oDataSet,jSchema,.F.,"TOPCONN")
        jChecks["nullRejectedOnlyByPresentation"]:=!oNative:LoadCurrentPage()
        jChecks["nullRejectedOnlyByPresentation"]:=jChecks["nullRejectedOnlyByPresentation"].and.oNative:ErrorCode()=="PRESENTATION_NULL_REJECTED"
        jChecks["nullRejectedOnlyByPresentation"]:=jChecks["nullRejectedOnlyByPresentation"].and.Empty(oNative:Alias())
        jChecks["failedLoadHasNoWriteMode"]:=Empty(oNative:WriteMode())
        jChecks["failedLoadHasNoFieldAccess"]:=oNative:FieldPos("TEXT")==0
        jChecks["failedLoadHasNoFieldAccess"]:=jChecks["failedLoadHasNoFieldAccess"].and.ValType(oNative:FieldGet("TEXT"))=="U"
        jChecks["failedLoadCreatesNoSearchIndex"]:=oNative:EnsureIndex("TEXT")==0
        jChecks["failedLoadCreatesNoSearchIndex"]:=jChecks["failedLoadCreatesNoSearchIndex"].and.oNative:IndexOrder("TEXT")==0
        jChecks["nullDatasetUnchanged"]:=ValType(oDataSet:FieldGet("TEXT"))=="U"
        jChecks["nullDatasetUnchanged"]:=jChecks["nullDatasetUnchanged"].and.oDataSet:FieldExist("TEXT")
        jChecks["destroyAfterFailure"]:=oNative:Destroy()
        if (!jChecks["destroyAfterFailure"])
            throw "NATIVE_TABLE_CLEANUP_FAILED"
        endif
        FreeObj(@oNative)
        jResponse:=HBBridge.Tests.HBBridgePresentationFixture():Result(0,0,0)
        jResponse["header"]["TEXT"]["source"]["column"]:="RA_NOME"
        oClient:Queue(jResponse)
        FreeObj(@jResponse)
        jChecks["emptyDatasetOpen"]:=oDataSet:OpenSQLTyped("SELECT empty_fixture",jBindings)
        oNative:=HBBridge.Client.HBBridgeNativeTable():New(oDataSet,jSchema,.F.,"TOPCONN")
        jChecks["emptyNativeTableKeepsSchema"]:=oNative:LoadCurrentPage()
        jChecks["emptyNativeTableKeepsSchema"]:=jChecks["emptyNativeTableKeepsSchema"].and.oNative:RowCount()==0
        jChecks["emptyNativeTableKeepsSchema"]:=jChecks["emptyNativeTableKeepsSchema"].and.oNative:FieldCount()==7
        jChecks["emptyPageKeepsSourceMetadata"]:=oNative:SourceFieldName("TEXT")=="RA_NOME"
        jChecks["emptyPageNeedsNoWriter"]:=Empty(oNative:WriteMode())
        jChecks["emptyPageFieldPositionWithoutRow"]:=oNative:FieldPos("TEXT")>0
        jChecks["emptyPageFieldPositionWithoutRow"]:=jChecks["emptyPageFieldPositionWithoutRow"].and.oNative:SourceFieldPos("RA_NOME")==oNative:FieldPos("TEXT")
        jChecks["emptyPageFieldPositionWithoutRow"]:=jChecks["emptyPageFieldPositionWithoutRow"].and.Empty(oNative:FieldGet("TEXT"))
        cPreviousAlias:=oNative:Alias()
        nPreviousWorkArea:=Select(cPreviousAlias)
        nPreviousOrder:=oNative:EnsureIndex("TEXT")
        jChecks["emptyTableSearchIndexCreatedOnDemand"]:=nPreviousOrder>0
        jChecks["emptyTableSearchIndexCreatedOnDemand"]:=jChecks["emptyTableSearchIndexCreatedOnDemand"].and.nPreviousOrder!=4
        (cPreviousAlias)->(DbSetOrder(nPreviousOrder))
        jResponse:=HBBridge.Tests.HBBridgePresentationFixture():Result(0,1,1)
        jResponse["rows"]["1"]["TEXT"]:=nil
        oClient:Queue(jResponse)
        FreeObj(@jResponse)
        jChecks["failedRefreshFixture"]:=oDataSet:OpenSQLTyped("SELECT null_refresh",jBindings)
        jChecks["failedRefreshInvalidatesNativePage"]:=!oNative:LoadCurrentPage()
        jChecks["failedRefreshInvalidatesNativePage"]:=jChecks["failedRefreshInvalidatesNativePage"].and.!oNative:IsOpen()
        jChecks["failedRefreshHidesSourceMetadata"]:=Empty(oNative:SourceFieldName("TEXT"))
        jChecks["failedRefreshHidesSourceMetadata"]:=jChecks["failedRefreshHidesSourceMetadata"].and.Empty(oNative:SourceFieldCaption("TEXT")).and.Empty(oNative:ProjectionName("F000000004"))
        jChecks["failedRefreshKeepsOwnedWorkArea"]:=Select(cPreviousAlias)==nPreviousWorkArea
        jChecks["failedRefreshClearsNativeRows"]:=(cPreviousAlias)->(LastRec())==0
        jChecks["failedRefreshKeepsSelectedIndex"]:=(cPreviousAlias)->(IndexOrd())==nPreviousOrder
        jResponse:=HBBridge.Tests.HBBridgePresentationFixture():Result(0,1,1)
        oClient:Queue(jResponse)
        FreeObj(@jResponse)
        jChecks["recoveryFixture"]:=oDataSet:OpenSQLTyped("SELECT recovered_fixture",jBindings)
        jChecks["recoveryAfterPresentationFailure"]:=oNative:LoadCurrentPage()
        jChecks["recoveryAfterPresentationFailure"]:=jChecks["recoveryAfterPresentationFailure"].and.oNative:RowCount()==1
        jChecks["recoveryAfterPresentationFailure"]:=jChecks["recoveryAfterPresentationFailure"].and.Empty(oNative:ErrorCode())
        jChecks["recoveryReusesNativeStorage"]:=oNative:Alias()==cPreviousAlias
        jChecks["recoveryReusesNativeStorage"]:=jChecks["recoveryReusesNativeStorage"].and.Select(cPreviousAlias)==nPreviousWorkArea
        jChecks["recoveryKeepsSelectedIndex"]:=(cPreviousAlias)->(IndexOrd())==nPreviousOrder
        jChecks["emptyTableCleanup"]:=oNative:Destroy()
        if (!jChecks["emptyTableCleanup"])
            throw "NATIVE_TABLE_CLEANUP_FAILED"
        endif
        FreeObj(@oNative)
        // Defaults cross the 1024-row automatic flush boundary. Other sizes
        // exercise the same independent traversal without assuming a flush.
        jResponse:=HBBridge.Tests.HBBridgePresentationFixture():Result(0,nRecords,nRecords)
        for nRow:=1 to nRecords
            cRowKey:=tlpp.ToStr(nRow)
            jResponse["rows"][cRowKey]["FLAG"]:=(nRow%2)==0
            jResponse["rows"][cRowKey]["DAY"]:=if((nRow%2)==0,"2000-02-29","2024-02-29")
            jResponse["rows"][cRowKey]["AMOUNT"]:=if((nRow%2)==0,"-123.25","123.25")
            jResponse["rows"][cRowKey]["FLOAT"]:=nRow/4
        next nRow
        oClient:Queue(jResponse)
        FreeObj(@jResponse)
        jChecks["bufferBoundaryFixture"]:=oDataSet:OpenSQLTyped("SELECT bulk_boundary_fixture",jBindings)
        oNative:=HBBridge.Client.HBBridgeNativeTable():New(oDataSet,jSchema,.F.,"TOPCONN")
        cExpectedMode:=if(FWBulk():CanBulk(),"bulk","record")
        jChecks["bufferBoundaryLoad"]:=oNative:LoadCurrentPage()
        jChecks["bufferBoundaryWriteMode"]:=oNative:WriteMode()==cExpectedMode
        if (oNative:IsOpen())
            cAlias:=oNative:Alias()
            jChecks["bufferBoundaryRowCount"]:=oNative:RowCount()==nRecords
            jChecks["bufferBoundaryRowCount"]:=jChecks["bufferBoundaryRowCount"].and.(cAlias)->(LastRec())==nRecords
            jChecks["bufferBoundaryValues"]:=.T.
            nIDPosition:=(cAlias)->(FieldPos(oNative:FieldName("ID")))
            nCodePosition:=(cAlias)->(FieldPos(oNative:FieldName("ID_CODE")))
            nAmountPosition:=(cAlias)->(FieldPos(oNative:FieldName("AMOUNT")))
            nTextPosition:=(cAlias)->(FieldPos(oNative:FieldName("TEXT")))
            nFlagPosition:=(cAlias)->(FieldPos(oNative:FieldName("FLAG")))
            nDayPosition:=(cAlias)->(FieldPos(oNative:FieldName("DAY")))
            nFloatPosition:=(cAlias)->(FieldPos(oNative:FieldName("FLOAT")))
            cExpectedText:=DecodeUTF8("a"+Chr(195)+Chr(167)+Chr(195)+Chr(163)+"o")
            (cAlias)->(dbSetOrder(0))
            (cAlias)->(DbGoTop())
            for nRow:=1 to nRecords
                if ((cAlias)->(Eof()))
                    jChecks["bufferBoundaryValues"]:=.F.
                    exit
                endif
                jChecks["bufferBoundaryValues"]:=jChecks["bufferBoundaryValues"].and.RTrim((cAlias)->(FieldGet(nIDPosition)))==tlpp.ToStr(nRow)
                jChecks["bufferBoundaryValues"]:=jChecks["bufferBoundaryValues"].and.RTrim((cAlias)->(FieldGet(nCodePosition)))==StrZero(nRow,10)
                jChecks["bufferBoundaryValues"]:=jChecks["bufferBoundaryValues"].and.(cAlias)->(FieldGet(nFlagPosition))==((nRow%2)==0)
                jChecks["bufferBoundaryValues"]:=jChecks["bufferBoundaryValues"].and.DToS((cAlias)->(FieldGet(nDayPosition)))==if((nRow%2)==0,"20000229","20240229")
                jChecks["bufferBoundaryValues"]:=jChecks["bufferBoundaryValues"].and.(cAlias)->(FieldGet(nAmountPosition))==if((nRow%2)==0,-123.25,123.25)
                jChecks["bufferBoundaryValues"]:=jChecks["bufferBoundaryValues"].and.(cAlias)->(FieldGet(nFloatPosition))==nRow/4
                jChecks["bufferBoundaryValues"]:=jChecks["bufferBoundaryValues"].and.RTrim((cAlias)->(FieldGet(nTextPosition)))==cExpectedText
                (cAlias)->(DbSkip())
            next nRow
            jChecks["bufferBoundaryHasNoExtraRows"]:=(cAlias)->(Eof())
            ConOut("hbBridge native table buffer write mode: "+oNative:WriteMode()+"; rows="+tlpp.ToStr(nRecords)+"; crosses1024="+if(nRecords>1024,"true","false"))
        endif
        jChecks["bufferBoundaryKeepsBorrowedDataset"]:=oDataSet:RowCount()==nRecords
        jChecks["bufferBoundaryKeepsBorrowedDataset"]:=jChecks["bufferBoundaryKeepsBorrowedDataset"].and.oDataSet:FieldGet("ID")=="1"
        jChecks["bufferBoundaryKeepsBorrowedDataset"]:=jChecks["bufferBoundaryKeepsBorrowedDataset"].and.oDataSet:FieldGet("DAY")=="2024-02-29"
        jChecks["bufferBoundaryKeepsBorrowedDataset"]:=jChecks["bufferBoundaryKeepsBorrowedDataset"].and.ValType(oDataSet:FieldGet("FLAG"))=="L"
        jChecks["bufferBoundaryCleanup"]:=oNative:Destroy()
        if (!jChecks["bufferBoundaryCleanup"])
            throw "NATIVE_TABLE_CLEANUP_FAILED"
        endif
        FreeObj(@oNative)
    catch xError
        jChecks["unexpectedRuntimeFailure"]:=.F.
        ConOut("hbBridge native table test failed; inspect the owned local log.")
        if (ValType(xError)=="O")
            FreeObj(@xError)
        endif
    endtry
    if (ValType(oNative)=="O")
        jChecks["finalCleanup"]:=oNative:Destroy()
        if (jChecks["finalCleanup"])
            FreeObj(@oNative)
        endif
    endif
    oDataSet:Close()
    FreeObj(@oDataSet)
    oClient:Close()
    FreeObj(@oClient)
    FreeObj(@jSchema)
    FreeObj(@jResponse)
    FreeObj(@jBindings)
    FWFreeArray(@aTopInfo)
    if (lOwned)
        TCUnlink(nConnection)
    endif
    aNames:=jChecks:GetNames()
    nChecks:=Len(aNames)
    for nCheck:=1 to nChecks
        lOK:=jChecks[aNames[nCheck]].and.lOK
        ConOut("hbBridge native table check "+aNames[nCheck]+": "+if(jChecks[aNames[nCheck]],"PASS","FAILED"))
    next nCheck
    ConOut("hbBridge native table checks: "+tlpp.ToStr(nChecks)+"; "+if(lOK,"OK","FAILED"))
    FWFreeArray(@aNames)
    FreeObj(@jChecks)
return(if(lOK,0,1))

static function NativeTableTestRename(jObject as json,cOld as character,cNew as character) as json

    // JSONObject exposes its property names through this native array API.
    local aNames:=jObject:GetNames() as array

    local cName:="" as character

    local jRenamed:=JSONObject():New() as json

    local nName:=0 as numeric
    local nNames:=Len(aNames) as numeric

    for nName:=1 to nNames
        cName:=aNames[nName]
        jRenamed[if(cName==cOld,cNew,cName)]:=jObject[cName]
    next nName
    FWFreeArray(@aNames)

return(jRenamed)
