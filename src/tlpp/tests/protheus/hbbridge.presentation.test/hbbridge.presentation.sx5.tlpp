/* Released to Public Domain. */
#include "totvs.ch"

namespace HBBridge.Examples

// Protheus alone resolves its physical table, branch and dictionary fields.
class HBBridgePresentationSX5
    static method Definition() as json
    static method Plan(jMetadata as json,jColumns as json,cTable as character,cBranch as character) as json
endclass

static method Definition() class HBBridgePresentationSX5

    local jDefinition:=HBBridge.Client.HBBridgePresentationTable():Definition("SX5") as json

    if (ValType(jDefinition)=="J".and.jDefinition["success"]==.T.)
        jDefinition:=PresentationSX5Query(jDefinition,xFilial("SX5"))
    endif

return(jDefinition)

// Deterministic planning uses the same builder and query completion as Definition.
static method Plan(jMetadata,jColumns,cTable,cBranch) class HBBridgePresentationSX5

    local jDefinition:=HBBridge.Client.HBBridgePresentationTable():Build(jMetadata,jColumns,"SX5",cTable) as json

return(PresentationSX5Query(jDefinition,cBranch))

static function PresentationSX5Query(jDefinition as json,cBranch as character) as json

    local jFields as json

    local lValid:=.F. as logical

    if (ValType(jDefinition)!="J")
        return(jDefinition)
    endif
    if (jDefinition["success"]!=.T.)
        return(jDefinition)
    endif
    jFields:=jDefinition["schema"]["fields"]
    if (jFields:HasProperty("X5_FILIAL").and.jFields:HasProperty("X5_TABELA").and.;
        jFields:HasProperty("X5_CHAVE").and.jFields:HasProperty("R_E_C_N_O_").and.;
        jFields:HasProperty("D_E_L_E_T_"))
        lValid:=jFields["X5_FILIAL"]["type"]=="character".and.;
            jFields["X5_TABELA"]["type"]=="character".and.;
            jFields["X5_CHAVE"]["type"]=="character".and.;
            jFields["R_E_C_N_O_"]["type"]=="numeric".and.;
            jFields["R_E_C_N_O_"]["decimals"]==0.and.;
            jFields["D_E_L_E_T_"]["type"]=="character".and.;
            jFields["D_E_L_E_T_"]["length"]==1
    endif
    if (lValid)
        lValid:=ValType(cBranch)=="C"
        if (lValid)
            lValid:=Len(cBranch)<=jFields["X5_FILIAL"]["length"].and.!(Chr(0)$cBranch)
        endif
    endif
    if (lValid)
        jDefinition["bindings"]["1"]:={"type":"text","isNull":.F.,"value":" "}
        jDefinition["bindings"]["2"]:={"type":"text","isNull":.F.,"value":cBranch}
        beginContent var jDefinition["sql"]
            SELECT @@PROJECTION@@ FROM @@TABLE@@ AS @@ALIAS@@
            WHERE @@ALIAS@@.[D_E_L_E_T_] = ?
            AND @@ALIAS@@.[X5_FILIAL] = ?
        endContent
        jDefinition["sql"]:=HBBridge.Helper.HBBridgeStrTools():StrReplaceEx(;
            jDefinition["sql"],;
            {"@@PROJECTION@@",jDefinition["projection"]},;
            {"@@TABLE@@",jDefinition["table"]},;
            {"@@ALIAS@@",jDefinition["alias"]};
        )
        jDefinition["orderBy"]:="X5_FILIAL ASC,X5_TABELA ASC,X5_CHAVE ASC,R_E_C_N_O_ ASC"
    else
        jDefinition["success"]:=.F.
        jDefinition["code"]:="INVALID_SX5_DEFINITION"
        jDefinition["message"]:="The SX5 query requires valid branch, table, item, deleted and record fields."
    endif

return(jDefinition)
