/* Released to Public Domain. */
#include "totvs.ch"

function U_HBBridgePresentationTest()

    local aNames as array

    local cCode:="" as character
    local cMessage:="" as character
    local cOriginal:="" as character
    local cMode:="" as character

    local jHeader as json
    local jSchema as json
    local jRow as json
    local jConverted as json
    local jChecks:=JSONObject():New() as json
    local jCases:=JSONObject():New() as json
    local jBindings as json
    local jQuery as json

    local lOK:=.T. as logical
    local lConverted:=.F. as logical
    local lInputsUnchanged:=.T. as logical

    local nCase:=0 as numeric
    local nCases:=0 as numeric
    local nCheck:=0 as numeric
    local nChecks:=0 as numeric

    local oSource as object

    jHeader:=HBBridge.Tests.HBBridgePresentationFixture():Header()
    jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema()
    jRow:=HBBridge.Tests.HBBridgePresentationFixture():Row()
    cOriginal:=HBBridge.Client.HBBridgeJSON():Encode(jRow)
    jChecks["validSchema"]:=HBBridge.Client.HBBridgePresentationSchema():Validate(jHeader,jSchema,@cCode,@cMessage)
    lConverted:=HBBridge.Client.HBBridgePresentationSchema():ConvertRow(jHeader,jSchema,jRow,@jConverted,@cCode,@cMessage)
    jChecks["convertRow"]:=lConverted
    if (lConverted)
        jChecks["textDecodeOnce"]:=jConverted["TEXT"]==DecodeUTF8(jRow["TEXT"])
        jChecks["nativeDate"]:=ValType(jConverted["DAY"])=="D".and.DToS(jConverted["DAY"])=="20240229"
        jChecks["exactDecimal"]:=jConverted["AMOUNT"]==123.25
        jChecks["booleanFalsePreserved"]:=ValType(jConverted["FLAG"])=="L".and.!jConverted["FLAG"]
        jChecks["int64AsExplicitCharacter"]:=jConverted["ID"]=="42"
    endif
    jChecks["wireInputUnchanged"]:=HBBridge.Client.HBBridgeJSON():Encode(jRow)==cOriginal
    FreeObj(@jConverted)
    FreeObj(@jHeader)
    FreeObj(@jSchema)
    FreeObj(@jRow)
    PresentationTestProjectionFields(jChecks)
    jCases:FromJSON('{"unknownMember":true,"version":true,"composedMember":true,"missingProjection":true,"characterCapacity":true,"numericCapacity":true,"numericScale":true,"dateWidth":true,"logicalWidth":true,"nullPolicy":true,"roundingPolicy":true,"dateFormat":true,"unknownType":true,"wireMismatch":true,"nullableType":true}')
    aNames:=jCases:GetNames()
    nCases:=Len(aNames)
    for nCase:=1 to nCases
        cMode:=aNames[nCase]
        jHeader:=HBBridge.Tests.HBBridgePresentationFixture():Header()
        jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema()
        do case
        case cMode=="unknownMember"
            jSchema["extra"]:=.T.
        case cMode=="version"
            jSchema["schemaVersion"]:=2
        case cMode=="composedMember"
            jSchema["fields"]["TEXT"]:=PresentationTestOmit(jSchema["fields"]["TEXT"],"picture")
            jSchema["fields"]["TEXT"]["caption|picture"]:=""
        case cMode=="missingProjection"
            jSchema["fields"]:=PresentationTestOmit(jSchema["fields"],"TEXT")
        case cMode=="characterCapacity"
            jSchema["fields"]["TEXT"]["length"]:=255
        case cMode=="numericCapacity"
            jSchema["fields"]["AMOUNT"]["length"]:=33
        case cMode=="numericScale"
            jSchema["fields"]["AMOUNT"]["decimals"]:=17
        case cMode=="dateWidth"
            jSchema["fields"]["DAY"]["length"]:=10
        case cMode=="logicalWidth"
            jSchema["fields"]["FLAG"]["length"]:=2
        case cMode=="nullPolicy"
            jSchema["fields"]["TEXT"]["nullPolicy"]:="default"
        case cMode=="roundingPolicy"
            jSchema["fields"]["AMOUNT"]["roundingPolicy"]:="round"
        case cMode=="dateFormat"
            jSchema["fields"]["DAY"]["inputFormat"]:="DD/MM/YYYY"
        case cMode=="unknownType"
            jSchema["fields"]["TEXT"]["type"]:="memo"
        case cMode=="wireMismatch"
            jSchema["fields"]["TEXT"]["type"]:="numeric"
        case cMode=="nullableType"
            jSchema["fields"]["TEXT"]["nullable"]:=0
        endcase
        jChecks["rejectSchema."+cMode]:=!HBBridge.Client.HBBridgePresentationSchema():Validate(jHeader,jSchema,@cCode,@cMessage)
        FreeObj(@jHeader)
        FreeObj(@jSchema)
    next nCase
    FWFreeArray(@aNames)
    FreeObj(@jCases)
    jCases:=JSONObject():New()
    jCases:FromJSON('{"null":true,"nul":true,"tooLong":true,"numericRounding":true,"invalidDate":true,"wrongBoolean":true,"inexactInt64":true,"missingField":true,"invalidUTF8":true}')
    aNames:=jCases:GetNames()
    nCases:=Len(aNames)
    for nCase:=1 to nCases
        cMode:=aNames[nCase]
        jHeader:=HBBridge.Tests.HBBridgePresentationFixture():Header()
        jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema()
        jRow:=HBBridge.Tests.HBBridgePresentationFixture():Row()
        do case
        case cMode=="null"
            jSchema["fields"]["TEXT"]["nullable"]:=.T.
            jRow["TEXT"]:=nil
        case cMode=="nul"
            jRow["TEXT"]:="A"+Chr(0)+"B"
        case cMode=="tooLong"
            jRow["TEXT"]:=Replicate("x",21)
        case cMode=="numericRounding"
            jRow["FLOAT"]:=1.251
        case cMode=="invalidDate"
            jRow["DAY"]:="2023-02-29"
        case cMode=="wrongBoolean"
            jRow["FLAG"]:=1
        case cMode=="inexactInt64"
            jSchema["fields"]["ID"]["type"]:="numeric"
            jRow["ID"]:="9007199254740993"
        case cMode=="missingField"
            jRow:=PresentationTestOmit(jRow,"TEXT")
        case cMode=="invalidUTF8"
            jRow["TEXT"]:=Chr(255)
        endcase
        jChecks["rejectRow."+cMode]:=!HBBridge.Client.HBBridgePresentationSchema():ConvertRow(;
            jHeader,jSchema,jRow,@jConverted,@cCode,@cMessage).and.ValType(jConverted)=="U"
        FreeObj(@jHeader)
        FreeObj(@jSchema)
        FreeObj(@jRow)
    next nCase
    FWFreeArray(@aNames)
    FreeObj(@jCases)
    // Compact physical dates are explicitly caller-declared text, including
    // the Protheus eight-space empty date. They never change SQL NULL policy.
    jHeader:=HBBridge.Tests.HBBridgePresentationFixture():Header()
    jHeader["DAY"]["wire"]["kind"]:="text"
    jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema()
    jSchema["fields"]["DAY"]["inputFormat"]:="YYYYMMDD"
    jRow:=HBBridge.Tests.HBBridgePresentationFixture():Row()
    jRow["DAY"]:="20240229"
    cOriginal:=HBBridge.Client.HBBridgeJSON():Encode(jRow)
    lConverted:=HBBridge.Client.HBBridgePresentationSchema():ConvertRow(;
        jHeader,jSchema,jRow,@jConverted,@cCode,@cMessage)
    jChecks["dateValidYYYYMMDD"]:=.F.
    if (lConverted)
        jChecks["dateValidYYYYMMDD"]:=ValType(jConverted["DAY"])=="D".and.DToS(jConverted["DAY"])=="20240229"
    endif
    jChecks["dateYYYYMMDDInputUnchanged"]:=HBBridge.Client.HBBridgeJSON():Encode(jRow)==cOriginal
    FreeObj(@jConverted)
    jRow["DAY"]:=Space(8)
    cOriginal:=HBBridge.Client.HBBridgeJSON():Encode(jRow)
    lConverted:=HBBridge.Client.HBBridgePresentationSchema():ConvertRow(;
        jHeader,jSchema,jRow,@jConverted,@cCode,@cMessage)
    jChecks["dateExactSpacesIsEmptyNativeDate"]:=.F.
    if (lConverted)
        jChecks["dateExactSpacesIsEmptyNativeDate"]:=ValType(jConverted["DAY"])=="D".and.Empty(jConverted["DAY"])
    endif
    jChecks["dateEmptyInputUnchanged"]:=HBBridge.Client.HBBridgeJSON():Encode(jRow)==cOriginal
    FreeObj(@jConverted)
    jSchema["fields"]["DAY"]["nullable"]:=.T.
    jRow["DAY"]:=nil
    cOriginal:=HBBridge.Client.HBBridgeJSON():Encode(jRow)
    jChecks["dateNullStillRejected"]:=!HBBridge.Client.HBBridgePresentationSchema():ConvertRow(;
        jHeader,jSchema,jRow,@jConverted,@cCode,@cMessage).and.;
        ValType(jConverted)=="U".and.cCode=="PRESENTATION_NULL_REJECTED"
    jChecks["dateNullInputUnchanged"]:=HBBridge.Client.HBBridgeJSON():Encode(jRow)==cOriginal
    jCases:=JSONObject():New()
    jCases["zeroes"]:="00000000"
    jCases["sevenSpaces"]:=Space(7)
    jCases["nineSpaces"]:=Space(9)
    jCases["emptyText"]:=""
    jCases["invalidCalendar"]:="20240230"
    jCases["isoInCompact"]:="2024-02-29"
    jCases["wrongDigits"]:="2024A229"
    jCases["isoSpaces"]:=Space(10)
    aNames:=jCases:GetNames()
    nCases:=Len(aNames)
    for nCase:=1 to nCases
        cMode:=aNames[nCase]
        jSchema["fields"]["DAY"]["inputFormat"]:=if(cMode=="isoSpaces","YYYY-MM-DD","YYYYMMDD")
        jRow["DAY"]:=jCases[cMode]
        cOriginal:=HBBridge.Client.HBBridgeJSON():Encode(jRow)
        jChecks["rejectDate."+cMode]:=!HBBridge.Client.HBBridgePresentationSchema():ConvertRow(;
            jHeader,jSchema,jRow,@jConverted,@cCode,@cMessage).and.;
            ValType(jConverted)=="U".and.cCode=="PRESENTATION_DATE_ERROR"
        lInputsUnchanged:=lInputsUnchanged.and.HBBridge.Client.HBBridgeJSON():Encode(jRow)==cOriginal
    next nCase
    jChecks["dateRejectedInputsUnchanged"]:=lInputsUnchanged
    FWFreeArray(@aNames)
    FreeObj(@jCases)
    FreeObj(@jHeader)
    FreeObj(@jSchema)
    FreeObj(@jRow)
    // SQL dates and compact Protheus character dates need different binding
    // types even though the user enters the same validated ISO calendar date.
    jBindings:=JSONObject():New()
    jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema()
    jSchema["fields"]["DAY"]["inputFormat"]:="YYYYMMDD"
    oSource:=HBBridge.Examples.HBBridgePresentationSQLSource():New("SELECT physical_dates","DAY ASC",jSchema,jBindings)
    jSchema["fields"]["DAY"]["inputFormat"]:="YYYY-MM-DD"
    jChecks["compactDateFilterAcceptsISO"]:=oSource:AddFilter("DAY","equal","2024-02-29")
    jQuery:=oSource:Query()
    jChecks["compactDateBindingUsesText"]:=jQuery["bindings"]["1"]["type"]=="text".and.;
        jQuery["bindings"]["1"]["value"]=="20240229".and.!jQuery["bindings"]["1"]["isNull"]
    jChecks["compactDateKeepsColumnUnconverted"]:=jQuery["sql"]==;
        "SELECT * FROM (SELECT physical_dates"+Chr(10)+") HBBR_SOURCE WHERE HBBR_SOURCE.[DAY] = ?"
    cOriginal:=HBBridge.Client.HBBridgeJSON():Encode(jQuery)
    FreeObj(@jQuery)
    jChecks["compactDateRejectsInvalidCalendar"]:=!oSource:AddFilter("DAY","equal","2023-02-29")
    jQuery:=oSource:Query()
    jChecks["invalidDateFilterKeepsQuery"]:=HBBridge.Client.HBBridgeJSON():Encode(jQuery)==cOriginal
    FreeObj(@jQuery)
    oSource:Close()
    FreeObj(@oSource)
    oSource:=HBBridge.Examples.HBBridgePresentationSQLSource():New("SELECT sql_dates","DAY ASC",jSchema,jBindings)
    jChecks["sqlDateFilterAcceptsISO"]:=oSource:AddFilter("DAY","equal","2024-02-29")
    jQuery:=oSource:Query()
    jChecks["sqlDateBindingRemainsDate"]:=jQuery["bindings"]["1"]["type"]=="date".and.;
        jQuery["bindings"]["1"]["value"]=="2024-02-29".and.!jQuery["bindings"]["1"]["isNull"]
    FreeObj(@jQuery)
    oSource:Close()
    FreeObj(@oSource)
    FreeObj(@jSchema)
    FreeObj(@jBindings)
    aNames:=jChecks:GetNames()
    nChecks:=Len(aNames)
    for nCheck:=1 to nChecks
        lOK:=jChecks[aNames[nCheck]].and.lOK
        ConOut("hbBridge presentation check "+aNames[nCheck]+": "+IIf(jChecks[aNames[nCheck]],"PASS","FAILED"))
    next nCheck
    ConOut("hbBridge presentation checks: "+tlpp.ToStr(nChecks)+"; "+IIf(lOK,"OK","FAILED"))
    FWFreeArray(@aNames)
    FreeObj(@jChecks)
return(IIf(lOK,0,1))

static function PresentationTestProjectionFields(jChecks as json)

    // JSONObject enumeration requires arrays; invalid-array payloads below
    // intentionally exercise the JSON contract rather than a data structure.
    local aNames as array

    local cCode:="" as character
    local cMessage:="" as character
    local cMode:="" as character
    local cName:="" as character
    local cHeaderBefore:="" as character
    local cRowBefore:="" as character
    local cSchemaBefore:="" as character
    local cNul:=Chr(0) as character

    local jHeader:=HBBridge.Tests.HBBridgePresentationFixture():Header() as json
    local jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema() as json
    local jRow:=HBBridge.Tests.HBBridgePresentationFixture():Row() as json
    local jExpected as json
    local jConverted as json
    local jCases:=JSONObject():New() as json

    local lBaseline:=.F. as logical
    local lConverted:=.F. as logical

    local nCase:=0 as numeric
    local nCases:=0 as numeric
    local nField:=0 as numeric
    local nFields:=0 as numeric

    // Preserve the established two-member schema as the conversion baseline.
    lBaseline:=HBBridge.Client.HBBridgePresentationSchema():ConvertRow(;
        jHeader,jSchema,jRow,@jExpected,@cCode,@cMessage)
    jSchema["projectionFields"]:=JSONObject():New()
    jChecks["projectionFieldsEmptyMapAccepted"]:=HBBridge.Client.HBBridgePresentationSchema():Validate(;
        jHeader,jSchema,@cCode,@cMessage)
    jSchema["projectionFields"]["AMOUNT"]:="RA_SALARIO"
    jSchema["projectionFields"]["TEXT"]:="RA_NOME"
    jChecks["projectionFieldsPartialMapAccepted"]:=HBBridge.Client.HBBridgePresentationSchema():Validate(;
        jHeader,jSchema,@cCode,@cMessage)
    cHeaderBefore:=HBBridge.Client.HBBridgeJSON():Encode(jHeader)
    cRowBefore:=HBBridge.Client.HBBridgeJSON():Encode(jRow)
    cSchemaBefore:=HBBridge.Client.HBBridgeJSON():Encode(jSchema)
    lConverted:=HBBridge.Client.HBBridgePresentationSchema():ConvertRow(;
        jHeader,jSchema,jRow,@jConverted,@cCode,@cMessage)
    jChecks["projectionFieldsRowConversion"]:=lConverted
    jChecks["projectionFieldsConvertedValuesUnchanged"]:=lBaseline.and.lConverted
    if (lBaseline.and.lConverted)
        aNames:=jExpected:GetNames()
        nFields:=Len(aNames)
        for nField:=1 to nFields
            cName:=aNames[nField]
            jChecks["projectionFieldsConvertedValuesUnchanged"]:=jChecks["projectionFieldsConvertedValuesUnchanged"].and.;
                jConverted:HasProperty(cName).and.ValType(jConverted[cName])==ValType(jExpected[cName]).and.;
                jConverted[cName]==jExpected[cName]
        next nField
        FWFreeArray(@aNames)
        aNames:=jConverted:GetNames()
        jChecks["projectionFieldsConvertedValuesUnchanged"]:=jChecks["projectionFieldsConvertedValuesUnchanged"].and.Len(aNames)==nFields
        FWFreeArray(@aNames)
    endif
    jChecks["projectionFieldsInputsUnchanged"]:=HBBridge.Client.HBBridgeJSON():Encode(jHeader)==cHeaderBefore.and.;
        HBBridge.Client.HBBridgeJSON():Encode(jRow)==cRowBefore.and.;
        HBBridge.Client.HBBridgeJSON():Encode(jSchema)==cSchemaBefore
    FreeObj(@jExpected)
    FreeObj(@jConverted)
    // A repeated origin is legal metadata; inverse lookup has its own
    // ambiguity policy and must not invalidate the logical schema.
    jSchema["projectionFields"]["TEXT"]:="RA_SALARIO"
    jChecks["projectionFieldsSharedOriginAccepted"]:=HBBridge.Client.HBBridgePresentationSchema():Validate(;
        jHeader,jSchema,@cCode,@cMessage)
    jSchema["projectionFields"]["TEXT"]:="MixedCase.original field"
    jChecks["projectionFieldsGenericOriginAccepted"]:=HBBridge.Client.HBBridgePresentationSchema():Validate(;
        jHeader,jSchema,@cCode,@cMessage)
    FreeObj(@jSchema)
    jCases:FromJSON('{"unknownRootMember":true,"mapNull":true,"mapNumeric":true,"mapText":true,"mapLogical":true,"mapArray":true,"unknownProjection":true,"valueNull":true,"valueNumeric":true,"valueLogical":true,"valueArray":true,"valueObject":true,"valueEmpty":true,"valueSpaces":true,"valueNul":true}')
    aNames:=jCases:GetNames()
    nCases:=Len(aNames)
    for nCase:=1 to nCases
        cMode:=aNames[nCase]
        jSchema:=HBBridge.Tests.HBBridgePresentationFixture():Schema()
        jSchema["projectionFields"]:=JSONObject():New()
        do case
        case cMode=="unknownRootMember"
            jSchema["extra"]:=.T.
        case cMode=="mapNull"
            jSchema["projectionFields"]:=nil
        case cMode=="mapNumeric"
            jSchema["projectionFields"]:=1
        case cMode=="mapText"
            jSchema["projectionFields"]:="RA_NOME"
        case cMode=="mapLogical"
            jSchema["projectionFields"]:=.T.
        case cMode=="mapArray"
            jSchema["projectionFields"]:={"RA_NOME"}
        case cMode=="unknownProjection"
            jSchema["projectionFields"]["MISSING"]:="RA_NOME"
        case cMode=="valueNull"
            jSchema["projectionFields"]["TEXT"]:=nil
        case cMode=="valueNumeric"
            jSchema["projectionFields"]["TEXT"]:=1
        case cMode=="valueLogical"
            jSchema["projectionFields"]["TEXT"]:=.T.
        case cMode=="valueArray"
            jSchema["projectionFields"]["TEXT"]:={"RA_NOME"}
        case cMode=="valueObject"
            jSchema["projectionFields"]["TEXT"]:=JSONObject():New()
        case cMode=="valueEmpty"
            jSchema["projectionFields"]["TEXT"]:=""
        case cMode=="valueSpaces"
            jSchema["projectionFields"]["TEXT"]:=Space(3)
        case cMode=="valueNul"
            jSchema["projectionFields"]["TEXT"]:="RA"+cNul+"NOME"
        endcase
        jChecks["rejectProjectionFields."+cMode]:=!HBBridge.Client.HBBridgePresentationSchema():Validate(;
            jHeader,jSchema,@cCode,@cMessage).and.cCode=="INVALID_LOGICAL_SCHEMA"
        FreeObj(@jSchema)
    next nCase
    FWFreeArray(@aNames)
    FreeObj(@jCases)
    FreeObj(@jHeader)
    FreeObj(@jRow)
return

static function PresentationTestOmit(jValue as json,cOmitted as character) as json

    local aNames:=jValue:GetNames() as array

    local jResult:=JSONObject():New() as json

    local nName:=0 as numeric
    local nNames:=Len(aNames) as numeric

    for nName:=1 to nNames
        if (aNames[nName]!=cOmitted)
            jResult[aNames[nName]]:=jValue[aNames[nName]]
        endif
    next nName
return(jResult)
