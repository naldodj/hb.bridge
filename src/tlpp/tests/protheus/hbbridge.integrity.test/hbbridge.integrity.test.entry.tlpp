/* Released to Public Domain. */
#include "totvs.ch"
#include "tlpp-core.th"

// Borrow the native variadic CLI array without duplicating it.
function U_HBBridgeIntegrityCLI(oArguments as variadic)
    local aDefaults:=Array(0) as array
    local aFWGetTopInfo:=FWGetTopInfo() as array
    local cIniFile:=GetSrvIniName() as character
    local nDefault
    aAdd(aDefaults,{"--profile=",(aFWGetTopInfo[4]+"/"+aFWGetTopInfo[5])})
    FWFreeArray(@aFWGetTopInfo)
    aAdd(aDefaults,{"--host=",GetPvProfString("hbBridge", "Host", "127.0.0.1", cIniFile)})
    aAdd(aDefaults,{"--port=",GetPvProfString("hbBridge", "Port", "1512", cIniFile)})
    aAdd(aDefaults,{"--url=",GetPvProfString("hbBridge", "HTTPURL", "http://127.0.0.1:8080", cIniFile)})
    aAdd(aDefaults,{"--token=",GetPvProfString("hbBridge", "HTTPToken", "", cIniFile)})
    aAdd(aDefaults,{"--timeout=","30"})
    for nDefault:=1 to Len(aDefaults)
        if (aScan(oArguments:vArgs,{|x|Left(Lower(x),Len(aDefaults[nDefault][1]))==aDefaults[nDefault][1]})==0)
            aAdd(oArguments:vArgs,aDefaults[nDefault][1]+aDefaults[nDefault][2])
        endif
    next nDefault
    FWFreeArray(@aDefaults)
return(HBBridge.Test.HBBridgeIntegrityTest():RunCLI(oArguments:vArgs))

// The profile must explicitly select a configured MSSQL connection.
function U_HBBridgeIntegrityTest(cProfile, cHost, nPort, cURL, cToken, nTimeoutSeconds)
    local aFWGetTopInfo:=FWGetTopInfo() as array
    local cIniFile:=GetSrvIniName() as character
    DEFAULT cProfile:=(aFWGetTopInfo[4]+"/"+aFWGetTopInfo[5])
    DEFAULT cHost:=GetPvProfString("hbBridge", "Host", "127.0.0.1", cIniFile)
    DEFAULT nPort:=Val(GetPvProfString("hbBridge", "Port", "1512", cIniFile))
    DEFAULT cURL:=GetPvProfString("hbBridge", "HTTPURL", "http://127.0.0.1:8080", cIniFile)
    DEFAULT cToken:=GetPvProfString("hbBridge", "HTTPToken", "", cIniFile)
    DEFAULT nTimeoutSeconds:=30
    FWFreeArray(@aFWGetTopInfo)
return(HBBridge.Test.HBBridgeIntegrityTest():Run(cProfile, cHost, nPort, cURL, cToken, nTimeoutSeconds))
