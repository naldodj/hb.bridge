#include "protheus.ch"
#include "parmtype.ch"
#include "hbbridge.h"

#define __IS_THE_ADDONS_EXECUTION_ENABLED__ .T.

procedure U_HBBridgeConnectionTest(cHost, nPort, nTimeout, nLargePayloadBytes)

    local jParams := JSONObject():New() as json
    local jProbe := JSONObject():New() as json

    local jAddonParams as json
    local jResponse as json

    local cProbe := "", cCompressed := "" as character

    local lOk := .T. as logical
    local lCompressed := .F. as logical

    local nCompressed := 0 as numeric

    local oClient as object

    // Omitted connection settings are resolved by the client from the AppServer INI.
    paramtype 4 var nLargePayloadBytes as numeric default 0

    if nLargePayloadBytes < 0 .or. nLargePayloadBytes != Int(nLargePayloadBytes)
        ConOut("hbBridge optional Echo payload size must be a non-negative integer.")
        FreeObj(@jProbe)
        FreeObj(@jParams)
        return
    endif

    if !ClockWorks()
        ConOut("hbBridge clock FAILED: validate TimeCounter units on this AppServer before testing RPC.")
        FreeObj(@jProbe)
        FreeObj(@jParams)
        return
    endif

    jParams["source"] := "protheus"
    jParams["company"] := "T1"
    jParams["user"] := "rpc-test"
    jParams["message"] := "Primeira integracao RPC"
    jParams["largePayload"] := Replicate("X", 200000)

    oClient := HBBridge.Client.HBBridgeClient():New(cHost, nPort, nTimeout)
    jResponse := oClient:CallService("Health", jParams)

    if !ResponseSucceeded(jResponse)
        ConOut("hbBridge Health FAILED: " + Left(jResponse:ToJSON(), 1024))
        lOk := .F.
    else
        ConOut("hbBridge Health Protheus OK: " + Left(jResponse:ToJSON(), 1024))
    endif
    FreeObj(@jResponse)

    if (__IS_THE_ADDONS_EXECUTION_ENABLED__)
        jAddonParams := JSONObject():New()
        jAddonParams["module"] := "examples\hbbridgesampleaddon.hb"
        jAddonParams["params"] := jParams
        jResponse := oClient:CallService("ADDON.Execute", jAddonParams)
        FreeObj(@jAddonParams)
        if !ResponseSucceeded(jResponse)
            ConOut("hbBridge ADDON.Execute FAILED: " + Left(jResponse:ToJSON(), 1024))
            lOk := .F.
        else
            ConOut("hbBridge ADDON.Execute Protheus OK: " + Left(jResponse:ToJSON(), 1024))
        endif
        FreeObj(@jResponse)
    endif

    jResponse := oClient:CallService("Echo", jParams)
    if !EchoMatches(jResponse, jParams)
        ConOut("hbBridge Echo exact comparison FAILED: " + Left(jResponse:ToJSON(), 1024))
        lOk := .F.
    else
        ConOut("hbBridge Echo Protheus OK: 200000 bytes, conteudo identico.")
    endif
    FreeObj(@jResponse)

    // Repeated X compresses very well and does not exercise a split gzip.
    jParams["message"] := "Echo with multiple TCP receives"
    jParams["largePayload"] := RandomASCII(200000)
    jProbe["service"] := "Echo"
    jProbe["params"] := jParams
    cProbe := jProbe:ToJSON()
    cProbe := HBBRIDGE_PROTOCOL_SIGNATURE + "|JSON|" + tlpp.ToStr(Len(cProbe)) + Chr(10) + cProbe
    lCompressed := GzStrComp(cProbe, @cCompressed, @nCompressed)
    FreeObj(@jProbe)
    cProbe := ""
    cCompressed := ""

    if !lCompressed .or. nCompressed <= HBBRIDGE_IO_CHUNK_DEFAULT_BYTES
        ConOut("hbBridge Echo fragmented fixture FAILED: gzip must exceed the receive buffer size.")
        lOk := .F.
    else
        jResponse := oClient:CallService("Echo", jParams)
        if !EchoMatches(jResponse, jParams)
            ConOut("hbBridge Echo fragmented FAILED: " + Left(jResponse:ToJSON(), 1024))
            lOk := .F.
        else
            ConOut("hbBridge Echo fragmented Protheus OK: 200000 bytes, conteudo identico; gzip request=" + AllTrim(Str(nCompressed)) + " bytes.")
        endif
        FreeObj(@jResponse)
    endif

    // Opt-in: the operator chooses a size supported by the AppServer runtime.
    if nLargePayloadBytes > 0
        jParams["message"] := "Echo with configured payload size"
        jParams["largePayload"] := Replicate("X", nLargePayloadBytes)
        jResponse := oClient:CallService("Echo", jParams)
        if !EchoMatches(jResponse, jParams)
            ConOut("hbBridge Echo configured size FAILED: " + Left(jResponse:ToJSON(), 1024))
            lOk := .F.
        else
            ConOut("hbBridge Echo configured size Protheus OK: " + tlpp.ToStr(nLargePayloadBytes) + " bytes, conteudo identico.")
        endif
        FreeObj(@jResponse)
    endif

    if lOk
        ConOut("hbBridge RPC Protheus OK: todos os testes solicitados passaram.")
    else
        ConOut("hbBridge RPC Protheus FAILED.")
    endif

    FreeObj(@oClient)
    FreeObj(@jParams)

return

static function ClockWorks() as logical

    local nStarted := HBBridge.Client.HBBridgeTime():HBBridgeTimeMs() as numeric
    local nCurrent := nStarted, nElapsed := 0, nRawElapsed := 0 as numeric
    local nRawStarted := TimeCounter() as numeric
    local nIndex := 0 as numeric
    local lOk := .T. as logical

    // Compare the normalized elapsed value with a known wait duration.
    Sleep(1000)
    nRawElapsed := TimeCounter() - nRawStarted
    nCurrent := HBBridge.Client.HBBridgeTime():HBBridgeTimeMs()
    nElapsed := nCurrent - nStarted
    lOk := nElapsed >= 750 .and. nElapsed < 10000

    for nIndex := 1 to 1000
        nStarted := nCurrent
        nCurrent := HBBridge.Client.HBBridgeTime():HBBridgeTimeMs()
        if nCurrent < nStarted
            lOk := .F.
        endif
    next

    // Boundaries also cover >24h budgets, fractions, and a counter reset.
    lOk := lOk .and. HBBridge.Client.HBBridgeTime():HBBridgeRemainingMs(1000, 100, 1050, 1000) == 50
    lOk := lOk .and. HBBridge.Client.HBBridgeTime():HBBridgeRemainingMs(1000, 100, 1100, 1050) == 0
    lOk := lOk .and. HBBridge.Client.HBBridgeTime():HBBridgeRemainingMs(1000, 100, 1101, 1050) == 0
    lOk := lOk .and. HBBridge.Client.HBBridgeTime():HBBridgeRemainingMs(1000, 100, 999, 1000) == 0
    lOk := lOk .and. HBBridge.Client.HBBridgeTime():HBBridgeRemainingMs(1000, 100, 1050, 1060) == 0
    lOk := lOk .and. HBBridge.Client.HBBridgeTime():HBBridgeRemainingMs(1000, 100, 1000.25, 1000) == 99
    lOk := lOk .and. HBBridge.Client.HBBridgeTime():HBBridgeRemainingMs(1000, 90000000, 86401000, 86400000) == 3600000

    ConOut("hbBridge clock: Unix=" + IIf(IsSrvUnix(), "true", "false") + ;
        "; TimeCounter delta=" + tlpp.ToStr(nRawElapsed) + "; normalized=" + tlpp.ToStr(nElapsed) + ;
        " ms after Sleep(1000); result=" + IIf(lOk, "OK", "FAILED"))

return(lOk)

static function ResponseSucceeded(jResponse as json) as logical

    if !jResponse:HasProperty("success")
        return .F.
    endif
    if ValType(jResponse["success"]) != "L"
        return .F.
    endif

return(jResponse["success"])

static function EchoMatches(jResponse as json, jParams as json) as logical

    if !ResponseSucceeded(jResponse)
        return .F.
    endif
    if !jResponse:HasProperty("params")
        return .F.
    endif
    if !(ValType(jResponse["params"]) $ "JO")
        return .F.
    endif
    if !jResponse["params"]:HasProperty("message") .or. !jResponse["params"]:HasProperty("largePayload")
        return .F.
    endif
    if ValType(jResponse["params"]["message"]) != "C" .or. ValType(jResponse["params"]["largePayload"]) != "C"
        return .F.
    endif

return(jResponse["params"]["message"] == jParams["message"] .and. ;
    jResponse["params"]["largePayload"] == jParams["largePayload"])

static function RandomASCII(nSize as numeric) as character

    local cAlphabet := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.:" as character
    local cPayload := "", cBlock := "" as character

    local nState := 12345, nIndex := 0, nBlockSize := 0 as numeric

    do while Len(cPayload) < nSize
        nBlockSize := Min(1024, nSize - Len(cPayload))
        cBlock := ""
        for nIndex := 1 to nBlockSize
            nState := (nState * 48271) % 2147483647
            cBlock += SubStr(cAlphabet, (nState % Len(cAlphabet)) + 1, 1)
        next
        cPayload += cBlock
    enddo

return(cPayload)
